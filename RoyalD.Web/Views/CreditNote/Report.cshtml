@model IEnumerable<RoyalD.Web.Models.CreditNote>
@{
    ViewData["Title"] = "รายงานการคืนสินค้าและใบลดหนี้ — ตรวจทานโปรแกรม CD Organizer";
    var allReps = ViewBag.AllSalesReps as List<string> ?? new List<string>();
    var commSummaries = ViewBag.CommissionSummaries as List<RoyalD.Web.Controllers.SalesRepCommissionSummary> ?? new List<RoyalD.Web.Controllers.SalesRepCommissionSummary>();
}

<div class="container-fluid px-3 py-2">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
        <div>
            <h4 class="mb-1 text-primary fw-bold">
                <i class="bi bi-journal-check me-2"></i>รายงานการคืนสินค้าและใบลดหนี้ (สำหรับตรวจทานยอดกับโปรแกรมบัญชี CD Organizer)
            </h4>
            <span class="text-muted" style="font-size:0.9rem;">
                รวบรวมประวัติการออกใบลดหนี้และราคาเฉลี่ยสุทธิที่ใช้พิมพ์จริง เพื่อให้บัญชีนำไปตรวจสอบทานยอด (Reconcile) กับที่บันทึกในโปรแกรม CD
            </span>
        </div>
        <div class="d-flex gap-2">
            <a href="/CreditNote/ExportReportExcel?fromDate=@ViewBag.FromDate&toDate=@ViewBag.ToDate&customer=@ViewBag.Customer&productCode=@ViewBag.ProductCode&salesRep=@ViewBag.SalesRep" 
               class="btn btn-sm btn-success fw-bold shadow-sm">
                <i class="bi bi-file-earmark-excel-fill me-1"></i> Export Excel (กระทบยอดกับโปรแกรม CD)
            </a>
            <a href="/CreditNote/Create" class="btn btn-sm btn-primary" style="background:#0d9488; border-color:#0d9488;">
                <i class="bi bi-plus-circle me-1"></i> ออกใบลดหนี้ใหม่
            </a>
        </div>
    </div>

    <!-- CD Organizer Workflow Information Banner -->
    <div class="card shadow-sm border-0 mb-3" style="border-radius:10px; background:#eff6ff; border-left: 5px solid #2563eb !important;">
        <div class="card-body p-2 px-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-shield-lock-fill text-primary fs-4"></i>
                <div class="small text-dark">
                    <strong>แนวปฏิบัติทางบัญชี (CD Organizer Reconciliation):</strong>
                    รายงานหน้านี้เก็บประวัติเฉพาะเอกสารใบลดหนี้ (CN) ที่คำนวณและพิมพ์ออกจากระบบนี้ บัญชีสามารถใช้ตัวเลข <strong>"ราคาเฉลี่ยสุทธิ"</strong> และ <strong>"ยอดรวม"</strong> ไปตรวจสอบทานกับใบลดหนี้ที่บันทึกตัดยอดลูกหนี้ในโปรแกรมบัญชี CD Organizer ได้อย่างถูกต้องครบถ้วน
                </div>
            </div>
        </div>
    </div>

    <!-- Summary KPI Cards -->
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-4 border-primary" style="border-radius:10px;">
                <div class="card-body p-3">
                    <div class="text-muted small">จำนวนเอกสารใบลดหนี้ (CN)</div>
                    <div class="fs-4 fw-bold text-dark">@(ViewBag.TotalCount ?? 0) <span class="fs-6 fw-normal text-muted">ฉบับ</span></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-4 border-info" style="border-radius:10px;">
                <div class="card-body p-3">
                    <div class="text-muted small">มูลค่าสินค้าก่อนภาษี</div>
                    <div class="fs-4 fw-bold text-dark">@((ViewBag.TotalBeforeVat as decimal? ?? 0).ToString("N2")) <span class="fs-6 fw-normal text-muted">บาท</span></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-4 border-warning" style="border-radius:10px;">
                <div class="card-body p-3">
                    <div class="text-muted small">ภาษีมูลค่าเพิ่ม (VAT 7%)</div>
                    <div class="fs-4 fw-bold text-dark">@((ViewBag.TotalVat as decimal? ?? 0).ToString("N2")) <span class="fs-6 fw-normal text-muted">บาท</span></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-4 border-danger" style="border-radius:10px;">
                <div class="card-body p-3">
                    <div class="text-muted small">ยอดเงินรวมสุทธิทั้งสิ้น</div>
                    <div class="fs-4 fw-bold text-danger">@((ViewBag.GrandTotal as decimal? ?? 0).ToString("N2")) <span class="fs-6 fw-normal text-muted">บาท</span></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card shadow-sm border-0 mb-3" style="border-radius:10px;">
        <div class="card-body p-3 bg-light rounded">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">ตั้งแต่วันที่</label>
                    <input type="date" name="fromDate" class="form-control form-control-sm" value="@ViewBag.FromDate" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">ถึงวันที่</label>
                    <input type="date" name="toDate" class="form-control form-control-sm" value="@ViewBag.ToDate" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">ชื่อร้านค้า / รหัสลูกค้า</label>
                    <input type="text" name="customer" class="form-control form-control-sm" placeholder="ค้นหาชื่อร้านค้า..." value="@ViewBag.Customer" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">รหัสสินค้า</label>
                    <input type="text" name="productCode" class="form-control form-control-sm" placeholder="เช่น 100301" value="@ViewBag.ProductCode" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">ผู้แทนขายบน CN</label>
                    <select name="salesRep" class="form-select form-select-sm select2-searchable">
                        <option value="">-- ผู้แทนขายทั้งหมด --</option>
                        @foreach (var rep in allReps)
                        {
                            <option value="@rep" selected="@(rep == ViewBag.SalesRep ? "selected" : null)">@rep</option>
                        }
                    </select>
                </div>
                <div class="col-md-1 d-flex align-items-end pt-3">
                    <button type="submit" class="btn btn-sm btn-primary w-100" style="background:#0d9488; border-color:#0d9488;">
                        <i class="bi bi-funnel"></i> กรอง
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Sales Commission Policy Box & Table -->
    <div class="card shadow-sm border-0 mb-3" style="border-radius:12px; border-left: 5px solid #0d9488 !important;">
        <div class="card-header bg-white py-2 fw-bold text-dark border-bottom d-flex align-items-center justify-content-between">
            <div>
                <i class="bi bi-person-lines-fill text-primary me-2"></i>
                สรุปยอดกระทบยอดขายและค่าคอมมิชชันแยกตามผู้แทนขาย (Sales Commission Summary)
            </div>
            <span class="badge bg-success-subtle text-success border border-success-subtle">
                <i class="bi bi-shield-check me-1"></i> นโยบายบริษัท: ไม่หักยอดเซลส์คนใหม่
            </span>
        </div>
        <div class="card-body p-3">
            <div class="table-responsive">
                <table class="table table-bordered table-sm align-middle mb-0">
                    <thead class="table-light small text-center">
                        <tr>
                            <th>#</th>
                            <th class="text-start">ผู้แทนขาย (Sales Rep)</th>
                            <th style="width: 120px;">จำนวนใบลดหนี้</th>
                            <th style="width: 170px;">ยอดเงินคืนก่อน VAT</th>
                            <th style="width: 170px;">ยอดคืนสุทธิ (หักคอมเซลส์เดิม)</th>
                            <th style="width: 170px;">ยอดเข้าส่วนกลางบริษัท</th>
                            <th style="width: 220px;">สถานะการคุ้มครองเซลส์คนใหม่</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (commSummaries == null || !commSummaries.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-3 text-muted">ไม่พบข้อมูลการคืนสินค้าในช่วงเวลานี้</td>
                            </tr>
                        }
                        else
                        {
                            int cIdx = 1;
                            foreach (var s in commSummaries)
                            {
                                <tr>
                                    <td class="text-center small">@cIdx</td>
                                    <td class="fw-bold text-dark">
                                        <i class="bi bi-person-fill text-muted me-1"></i>@s.SalesRepName
                                    </td>
                                    <td class="text-center">@s.TotalCreditNotes ฉบับ</td>
                                    <td class="text-end fw-semibold">@s.TotalDeductionBeforeVat.ToString("N2")</td>
                                    <td class="text-end fw-bold text-danger">@s.TotalDeductionGrand.ToString("N2")</td>
                                    <td class="text-end text-muted">@s.CentralAbsorbedAmount.ToString("N2")</td>
                                    <td>
                                        @if (s.ProtectedCurrentRepCount > 0)
                                        {
                                            <span class="badge bg-success" title="ยอดคืนของร้านที่โอนย้ายมา จะไม่ถูกนำไปหักลดยอดขายหรือคอมมิชชันของเซลส์คนใหม่">
                                                <i class="bi bi-shield-lock-fill me-1"></i> คุ้มครองเซลส์ใหม่ (@s.ProtectedCurrentRepCount รายการ)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border">ตามปกติ</span>
                                        }
                                    </td>
                                </tr>
                                cIdx++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Detailed Credit Notes & Items Table (Reconciliation with CD Organizer) -->
    <div class="card shadow-sm border-0" style="border-radius:12px;">
        <div class="card-header bg-white py-2 fw-bold text-dark border-bottom d-flex align-items-center justify-content-between">
            <div>
                <i class="bi bi-table text-primary me-2"></i>
                รายละเอียดใบลดหนี้และราคาเฉลี่ยสุทธิที่ใช้พิมพ์ (Reconciliation Table)
            </div>
            <span class="badge bg-light text-muted border">จำนวน @((Model != null) ? Model.Count() : 0) ฉบับ</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th style="width: 140px;">เลขที่ใบลดหนี้</th>
                            <th style="width: 95px;">วันที่คืน</th>
                            <th style="width: 220px;">ร้านค้า / ลูกค้า</th>
                            <th style="width: 150px;">ผู้แทนขายบน CN</th>
                            <th>รายการสินค้าและราคาเฉลี่ยสุทธิที่ใช้พิมพ์ (สำหรับตรวจทานกับโปรแกรม CD)</th>
                            <th class="text-end" style="width: 120px;">ยอดก่อน VAT</th>
                            <th class="text-end" style="width: 90px;">VAT 7%</th>
                            <th class="text-end" style="width: 125px;">ยอดรวมสุทธิ</th>
                            <th class="text-center" style="width: 100px;">พิมพ์</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">ไม่พบข้อมูลใบลดหนี้ตามตัวกรองที่เลือก</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="align-top">
                                        <a href="/CreditNote/Detail?id=@item.Id" class="fw-bold text-primary text-decoration-none">
                                            @item.CreditNoteNo
                                        </a>
                                        @if (item.IsPriceOverridden)
                                        {
                                            <span class="badge bg-warning text-dark d-block mt-1" title="แก้ไขราคา"><i class="bi bi-pencil-fill"></i> Override</span>
                                        }
                                        <div class="text-muted small mt-1 font-monospace" style="font-size:0.75rem;">
                                            บิลเดิม: @(string.IsNullOrEmpty(item.OriginalBillNo) ? "-" : item.OriginalBillNo)
                                        </div>
                                    </td>
                                    <td class="align-top small">@item.CreditNoteDate.ToString("dd/MM/yyyy")</td>
                                    <td class="align-top">
                                        <div class="fw-semibold text-dark">@item.CustomerName</div>
                                        <small class="text-muted font-monospace">@item.CustomerCode</small>
                                    </td>
                                    <td class="align-top">
                                        <span class="badge bg-light text-dark border">@item.SalesRep</span>
                                        @if (!string.IsNullOrEmpty(item.OriginalSalesRep) && item.OriginalSalesRep != item.SalesRep)
                                        {
                                            <small class="text-muted d-block" style="font-size:0.72rem;">(เดิม: @item.OriginalSalesRep)</small>
                                        }
                                    </td>
                                    <!-- Items & Net Unit Price Breakdown for easy CD cross-checking -->
                                    <td class="align-top p-2">
                                        <div class="bg-light rounded p-2 border">
                                            @foreach (var it in item.Items)
                                            {
                                                <div class="d-flex justify-content-between align-items-center py-1 border-bottom border-light-subtle" style="font-size:0.83rem;">
                                                    <div>
                                                        <span class="badge bg-dark font-monospace me-1">@it.ProductCode</span>
                                                        <strong class="text-dark">@it.ProductName</strong>
                                                        <span class="text-muted ms-1">(@it.WarehouseBreakdown)</span>
                                                    </div>
                                                    <div class="text-end">
                                                        <span class="text-primary fw-bold">@it.TotalReturnQty.ToString("N0") @it.Unit</span>
                                                        <span class="text-muted mx-1">×</span>
                                                        <span class="badge @(it.IsPriceOverridden ? "bg-warning text-dark" : "bg-info-subtle text-dark border")" title="ราคาเฉลี่ยสุทธิต่อหน่วย">
                                                            @@@it.UnitPrice.ToString("N4") บ.
                                                        </span>
                                                        <span class="text-muted mx-1">=</span>
                                                        <span class="text-success fw-bold">@it.AmountBeforeVat.ToString("N2")</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                    <td class="align-top text-end fw-semibold">@item.TotalAmountBeforeVat.ToString("N2")</td>
                                    <td class="align-top text-end">@item.VatAmount.ToString("N2")</td>
                                    <td class="align-top text-end fw-bold text-success">@item.GrandTotal.ToString("N2")</td>
                                    <td class="align-top text-center">
                                        <div class="btn-group btn-group-sm">
                                            <a href="/CreditNote/Print?id=@item.Id&paperSize=A4" target="_blank" class="btn btn-outline-primary" title="พิมพ์ A4">
                                                <i class="bi bi-printer"></i>
                                            </a>
                                            <a href="/CreditNote/Print?id=@item.Id&paperSize=Continuous9x11" target="_blank" class="btn btn-outline-info" title="พิมพ์ต่อเนื่อง 9x11">
                                                <i class="bi bi-printer-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>
<script>
    $(document).ready(function() {
        $('.select2-searchable').select2({
            theme: 'bootstrap-5',
            allowClear: true
        });
    });
</script>
}
