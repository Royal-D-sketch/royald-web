@{
    ViewData["Title"] = "คืนสินค้าและออกใบลดหนี้คำนวณราคาเฉลี่ยสุทธิ (Dynamic Credit Note Manager)";
    var salesReps = ViewBag.SalesReps as List<string> ?? new List<string>();
    var customers = ViewBag.Customers as dynamic ?? new List<dynamic>();
    var products = ViewBag.Products as dynamic ?? new List<dynamic>();
}

<div class="container-fluid px-3 py-2">
    <!-- Header Title -->
    <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
        <div>
            <h4 class="mb-1 text-primary fw-bold">
                <i class="bi bi-file-earmark-diff-fill me-2"></i>คืนสินค้าและออกใบลดหนี้คำนวณราคาเฉลี่ยสุทธิ
            </h4>
            <span class="text-muted" style="font-size:0.9rem;">
                Dynamic Credit Note Manager — ดึงประวัติบิลขายเดิมเพื่อคำนวณราคาเฉลี่ยสุทธิ (Read-Only Fetch) สำหรับนำไปคีย์ในโปรแกรม CD Organizer
            </span>
        </div>
        <div class="d-flex gap-2">
            <a href="/CreditNote" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-list-ul me-1"></i> รายการใบลดหนี้
            </a>
            <a href="/CreditNote/Report" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-graph-up me-1"></i> รายงานสินค้าคืน (ตรวจทาน CD)
            </a>
        </div>
    </div>

    <!-- Company Fixed Info & Header Card -->
    <div class="card shadow-sm border-0 mb-3" style="border-radius:12px; background: linear-gradient(135deg, #f0fdfa 0%, #ffffff 100%); border-left: 5px solid #0d9488 !important;">
        <div class="card-body p-3">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-primary px-2 py-1"><i class="bi bi-building"></i> ข้อมูลผู้ขาย (คงที่)</span>
                        <strong class="text-dark" style="font-size:1.05rem;">บริษัท รอแยล-ดี (ไทยแลนด์) จำกัด (สำนักงานใหญ่)</strong>
                    </div>
                    <div class="text-muted small">
                        <i class="bi bi-geo-alt"></i> เลขที่ 127, 129 ถนนจรัญสนิทวงศ์ แขวงบางอ้อ เขตบางพลัด กรุงเทพมหานคร 10700 &nbsp;|&nbsp;
                        <i class="bi bi-card-text"></i> เลขประจำตัวผู้เสียภาษีอากร: <strong>0105560129681</strong>
                    </div>
                </div>
                <div class="col-md-4 text-md-end mt-2 mt-md-0">
                    <div class="d-inline-block text-start p-2 bg-white border rounded shadow-xs" style="min-width: 220px;">
                        <div class="small text-muted">เลขที่ใบลดหนี้ (รันอัตโนมัติ):</div>
                        <div class="fw-bold text-success fs-5">
                            <i class="bi bi-upc-scan me-1"></i> CN@(DateTime.Now.ToString("yy-MM"))-XXXX
                        </div>
                        <small class="text-muted" style="font-size:0.75rem;">(รีเซ็ต 0001 ทุกต้นเดือน)</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CD Organizer Integration Policy Banner -->
    <div class="alert alert-primary py-2 px-3 mb-3 d-flex align-items-center gap-2 border-0 shadow-xs" style="background:#eff6ff; border-left: 4px solid #3b82f6 !important;">
        <i class="bi bi-arrow-repeat text-primary fs-3"></i>
        <div style="font-size:0.88rem;">
            <strong>การทำงานประสานคู่กับโปรแกรมบัญชี CD Organizer:</strong> 
            ระบบนี้ดึงประวัติบิลเดิมมาอ้างอิงและคำนวณราคาเฉลี่ยสุทธิแบบ <em>Read-Only Fetch</em> โดยจะ <strong>ไม่มีการตัดลดยอดหนี้ในระบบหลังบ้านของเว็บนี้</strong>
            เมื่อพิมพ์เอกสารใบลดหนี้ขนาด A4 หรือ 9 x 11 นิ้วแล้ว บัญชีจะนำตัวเลขราคาเฉลี่ยสุทธินี้ไปบันทึกรับคืนในโปรแกรมบัญชี CD Organizer ซึ่งโปรแกรม CD จะเป็นผู้ตัดยอดลูกหนี้ให้อัตโนมัติ
        </div>
    </div>

    <!-- Step 1: Customer & Sales Rep Info -->
    <div class="card shadow-sm border-0 mb-3" style="border-radius:12px;">
        <div class="card-header bg-white py-2 fw-bold text-dark border-bottom d-flex align-items-center justify-content-between">
            <span><i class="bi bi-person-badge me-2 text-primary"></i>1. เลือกร้านค้าและผู้แทนขายที่ดูแล</span>
            <span class="badge bg-light text-muted border">ข้อมูลหัวเอกสาร</span>
        </div>
        <div class="card-body p-3">
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label fw-bold small text-dark mb-1">
                        เลือกร้านค้า / ลูกค้า <span class="text-danger">*</span>
                    </label>
                    <select id="custSelect" class="form-select select2-searchable" style="width:100%;">
                        <option value="">-- พิมพ์ค้นหารหัสลูกค้า หรือชื่อร้านค้า --</option>
                        @if (customers != null)
                        {
                            foreach (var c in customers)
                            {
                                <option value="@c.CustomerCode" 
                                        data-name="@c.Name" 
                                        data-address="@c.Address" 
                                        data-taxid="@c.TaxId" 
                                        data-branch="@c.Branch"
                                        selected="@(c.CustomerCode == ViewBag.PreCustomerCode ? "selected" : null)">
                                    [@c.CustomerCode] @c.Name
                                </option>
                            }
                        }
                    </select>
                    <div class="mt-2 small text-muted p-2 bg-light rounded" id="custDetailBox" style="display:none;">
                        <div><i class="bi bi-geo-alt"></i> ที่อยู่: <span id="lblCustAddress" class="fw-semibold">-</span></div>
                        <div class="mt-1">
                            <i class="bi bi-card-checklist"></i> เลขผู้เสียภาษี: <span id="lblCustTaxId" class="fw-semibold">-</span> | 
                            สาขา: <span id="lblCustBranch" class="fw-semibold">สำนักงานใหญ่</span>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold small text-dark mb-1">
                        ผู้แทนขาย (Sales Representative) <span class="text-danger">*</span>
                        <span class="badge bg-warning text-dark ms-1" style="font-size:0.75rem;">แก้ไขได้อิสระ</span>
                    </label>
                    <select id="salesRepSelect" class="form-select select2-searchable" style="width:100%;">
                        <option value="">-- เลือกผู้แทนขาย --</option>
                        @foreach (var rep in salesReps)
                        {
                            <option value="@rep">@rep</option>
                        }
                    </select>
                    <div class="mt-1 small text-muted">
                        <i class="bi bi-info-circle text-primary"></i> 
                        ระบบจะดึงชื่อเซลส์เจ้าของบิลเดิมให้อัตโนมัติ บัญชีสามารถกดเปลี่ยนเป็นเซลส์คนอื่นหรือคนปัจจุบันได้อิสระ
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold small text-dark mb-1">วันที่ออกใบลดหนี้</label>
                    <input type="date" id="docDate" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    
                    <label class="form-label fw-bold small text-dark mb-1 mt-2 d-flex justify-content-between align-items-center">
                        <span>สาเหตุการคืนสินค้า (ม.86/10)</span>
                        <span class="badge bg-light text-primary border" style="font-size:0.7rem;"><i class="bi bi-pencil"></i> พิมพ์เพิ่มเองได้</span>
                    </label>
                    <div class="input-group input-group-sm">
                        <input type="text" id="returnReason" list="returnReasonList" class="form-control form-control-sm" 
                               value="รับคืนสินค้าชำรุด/เสียหาย/หมดอายุ" 
                               placeholder="พิมพ์ระบุสาเหตุเอง หรือคลิกเลือกจากรายการ..." />
                        <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="เลือกจากรายการ">
                            เลือก
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="font-size:0.85rem; max-width:360px;">
                            <li><h6 class="dropdown-header">สาเหตุมาตรฐาน (ม.86/10)</h6></li>
                            <li><a class="dropdown-item" href="javascript:void(0)" onclick="selectReason('รับคืนสินค้าชำรุด/เสียหาย/หมดอายุ')"><i class="bi bi-check2 text-success"></i> รับคืนสินค้าชำรุด/เสียหาย/หมดอายุ</a></li>
                            <li><a class="dropdown-item" href="javascript:void(0)" onclick="selectReason('รับคืนสินค้าชำรุด/เสียหายจากการขนส่ง')"><i class="bi bi-truck text-primary"></i> รับคืนสินค้าชำรุด/เสียหายจากการขนส่ง</a></li>
                            <li><a class="dropdown-item" href="javascript:void(0)" onclick="selectReason('รับคืนสินค้าหมดอายุจากการเก็บรักษา')"><i class="bi bi-hourglass-bottom text-warning"></i> รับคืนสินค้าหมดอายุจากการเก็บรักษา</a></li>
                            <li><a class="dropdown-item" href="javascript:void(0)" onclick="selectReason('รับคืนสินค้าตามเงื่อนไขสัญญาการค้า')"><i class="bi bi-file-earmark-text text-info"></i> รับคืนสินค้าตามเงื่อนไขสัญญาการค้า</a></li>
                            <li><a class="dropdown-item" href="javascript:void(0)" onclick="selectReason('สินค้าผิดขนาด/ผิดรายการจากคำสั่งซื้อ')"><i class="bi bi-exclamation-triangle text-danger"></i> สินค้าผิดขนาด/ผิดรายการจากคำสั่งซื้อ</a></li>
                            <li><a class="dropdown-item" href="javascript:void(0)" onclick="selectReason('คำนวณราคาสินค้าหรือจำนวนในใบกำกับภาษีเดิมผิด')"><i class="bi bi-calculator text-secondary"></i> คำนวณราคาสินค้าหรือจำนวนผิดในบิลเดิม</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-primary fw-bold" href="javascript:void(0)" onclick="$('#returnReason').focus().select()"><i class="bi bi-pencil-square"></i> ✏️ พิมพ์ระบุสาเหตุอื่น ๆ เอง...</a></li>
                        </ul>
                        <datalist id="returnReasonList">
                            <option value="รับคืนสินค้าชำรุด/เสียหาย/หมดอายุ" />
                            <option value="รับคืนสินค้าชำรุด/เสียหายจากการขนส่ง" />
                            <option value="รับคืนสินค้าหมดอายุจากการเก็บรักษา" />
                            <option value="รับคืนสินค้าตามเงื่อนไขสัญญาการค้า" />
                            <option value="สินค้าผิดขนาด/ผิดรายการจากคำสั่งซื้อ" />
                            <option value="คำนวณราคาสินค้าหรือจำนวนในใบกำกับภาษีเดิมผิด" />
                        </datalist>
                    </div>
                </div>
            </div>

            <!-- Commission Protection Alert -->
            <div class="alert alert-info py-2 px-3 mt-3 mb-0 d-flex align-items-center gap-2 border-0 shadow-xs" style="background:#f0fdfa; border-left:4px solid #0d9488 !important;">
                <i class="bi bi-shield-check text-primary fs-4"></i>
                <div style="font-size:0.87rem;">
                    <strong>นโยบายค่าคอมมิชชันและยอดขาย:</strong> หากเปลี่ยนชื่อผู้แทนขายเป็นคนปัจจุบัน/คนใหม่ ระบบจะบันทึกเป็นผู้ดูแลเอกสาร แต่ยอดคืนนี้จะ 
                    <span class="badge bg-success">ไม่หักยอดขายเซลส์คนใหม่เด็ดขาด</span> 
                    (โดยจะหักเซลส์เดิมตามบิลเดิม หรือบันทึกเข้าส่วนกลางบริษัท)
                </div>
            </div>
        </div>
    </div>

    <!-- Step 2: Multi-Channel Input UI (Tabs) -->
    <div class="card shadow-sm border-0 mb-3" style="border-radius:12px;">
        <div class="card-header bg-white py-2 border-bottom">
            <ul class="nav nav-tabs card-header-tabs" id="inputChannelTabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active fw-bold text-dark" id="tab-manual-btn" data-bs-toggle="tab" data-bs-target="#tab-manual" type="button">
                        <i class="bi bi-pencil-square text-primary me-1"></i> 1) คีย์ข้อมูลด้วยมือแยกคลัง (ตามใบงานกระดาษ)
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link fw-bold text-dark" id="tab-excel-btn" data-bs-toggle="tab" data-bs-target="#tab-excel" type="button">
                        <i class="bi bi-file-earmark-excel text-success me-1"></i> 2) นำเข้าไฟล์ Excel / CSV
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link fw-bold text-dark" id="tab-ocr-btn" data-bs-toggle="tab" data-bs-target="#tab-ocr" type="button">
                        <i class="bi bi-camera text-danger me-1"></i> 3) ถ่ายรูป / อัปโหลดภาพสแกน (AI OCR)
                    </button>
                </li>
            </ul>
        </div>

        <div class="card-body p-3">
            <div class="tab-content" id="inputChannelContent">
                <!-- Channel 1: Manual Grid Entry -->
                <div class="tab-pane fade show active" id="tab-manual" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small text-muted">
                            <i class="bi bi-info-circle"></i> ป้อนรายการสินค้าคืนตามใบงานคลัง มีคอลัมน์ [รหัสสินค้า, เลขคลัง 1/3/7, วันหมดอายุ, จำนวนคืนจริง]
                        </span>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="clearManualGrid()">
                                <i class="bi bi-trash3"></i> ล้างรายการ
                            </button>
                            <button type="button" class="btn btn-sm btn-primary" onclick="addManualRow()">
                                <i class="bi bi-plus-circle me-1"></i> + เพิ่มแถวรายการ
                            </button>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered table-sm align-middle" id="tblManualGrid">
                            <thead class="table-light text-center small">
                                <tr>
                                    <th style="width: 50px;">#</th>
                                    <th style="width: 260px;">รหัสสินค้า / ชื่อสินค้า <span class="text-danger">*</span></th>
                                    <th style="width: 140px;">เลขคลัง <span class="text-danger">*</span></th>
                                    <th style="width: 150px;">วันหมดอายุ (Expiry)</th>
                                    <th style="width: 140px;">จำนวนคืนจริง <span class="text-danger">*</span></th>
                                    <th style="width: 120px;">Lot No.</th>
                                    <th style="width: 60px;">ลบ</th>
                                </tr>
                            </thead>
                            <tbody id="manualGridBody">
                                <!-- Dynamic Rows -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Channel 2: Excel Import -->
                <div class="tab-pane fade" id="tab-excel" role="tabpanel">
                    <div class="row align-items-center justify-content-center py-3">
                        <div class="col-md-7 text-center">
                            <div class="border border-2 border-dashed rounded-3 p-4 bg-light" id="excelDropZone" style="cursor:pointer;" onclick="document.getElementById('excelFileInput').click();">
                                <i class="bi bi-cloud-arrow-up text-success fs-1 mb-2 d-block"></i>
                                <h6 class="fw-bold mb-1">ลากไฟล์ Excel / CSV มาวางที่นี่ หรือคลิกเพื่อเลือกไฟล์</h6>
                                <p class="text-muted small mb-2">รองรับไฟล์ .xlsx, .xls และ .csv (คอลัมน์: รหัสสินค้า, คลัง 1, คลัง 3, คลัง 7, จำนวน)</p>
                                <input type="file" id="excelFileInput" accept=".xlsx,.xls,.csv" class="d-none" onchange="handleExcelUpload(event)">
                                <button type="button" class="btn btn-sm btn-outline-success px-3">
                                    <i class="bi bi-folder2-open me-1"></i> เลือกไฟล์ Excel
                                </button>
                            </div>
                            <div id="excelUploadSpinner" class="mt-3 text-primary d-none">
                                <span class="spinner-border spinner-border-sm me-1"></span> กำลังอ่านและประมวลผลไฟล์...
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Channel 3: AI OCR Scan -->
                <div class="tab-pane fade" id="tab-ocr" role="tabpanel">
                    <div class="row g-3">
                        <div class="col-md-5">
                            <div class="border border-2 border-dashed rounded-3 p-3 bg-light text-center" style="cursor:pointer;" onclick="document.getElementById('ocrImageInput').click();">
                                <i class="bi bi-camera-fill text-danger fs-2 d-block mb-1"></i>
                                <span class="fw-bold small d-block">ถ่ายภาพด้วยกล้อง หรืออัปโหลดภาพสแกน</span>
                                <small class="text-muted" style="font-size:0.75rem;">รองรับไฟล์ภาพ JPG, PNG ใบงานคืนสินค้า</small>
                                <input type="file" id="ocrImageInput" accept="image/*" capture="environment" class="d-none" onchange="handleImageOcr(event)">
                            </div>
                            <div class="mt-2 text-center">
                                <img id="ocrPreviewImg" src="" alt="พรีวิวภาพถ่าย" class="img-fluid rounded border d-none" style="max-height: 240px; object-fit: contain;" />
                            </div>
                        </div>
                        <div class="col-md-7">
                            <label class="form-label fw-bold small text-dark mb-1">
                                <i class="bi bi-cpu text-primary"></i> ผลลัพธ์การแกะข้อความด้วย AI OCR
                            </label>
                            <textarea id="ocrRawText" class="form-control form-control-sm" rows="6" placeholder="ข้อความที่แกะได้จากภาพสแกนจะปรากฏที่นี่..."></textarea>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <small class="text-muted" id="ocrStatusMsg">ยังไม่มีการประมวลผล</small>
                                <button type="button" class="btn btn-sm btn-primary px-3" onclick="applyOcrTextToGrid()">
                                    <i class="bi bi-arrow-down-circle me-1"></i> แปลงข้อความเป็นรายการคืนในตาราง
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Button to Trigger Group By and Calculation -->
            <div class="d-flex justify-content-center mt-3 pt-2 border-top">
                <button type="button" class="btn btn-primary px-4 py-2 fw-bold shadow-sm" style="border-radius:20px;" onclick="calculateAveragePrice()">
                    <i class="bi bi-calculator-fill me-2"></i> คำนวณราคาเฉลี่ยสุทธิและรวมยอด Group By
                </button>
            </div>
        </div>
    </div>

    <!-- Step 3: Calculated Summary, Live Price Override & Audit Log -->
    <div class="card shadow-sm border-0 mb-3" id="summaryCard" style="border-radius:12px; display:none;">
        <div class="card-header bg-white py-2 fw-bold text-dark border-bottom d-flex align-items-center justify-content-between">
            <div>
                <i class="bi bi-table text-primary me-2"></i>3. ตารางสรุปรายการสินค้าคืน คำนวณราคาเฉลี่ยสุทธิ (Group By ทุกคลัง)
            </div>
            <span class="badge bg-info text-dark">ดึงคำนวณจากบิลขายล่าสุด (Read-Only)</span>
        </div>
        <div class="card-body p-3">
            <!-- Warning Alert if Missing Bill -->
            <div id="missingBillAlert" class="alert alert-danger py-2 px-3 mb-3 d-none align-items-center gap-2 border-0 shadow-xs">
                <i class="bi bi-exclamation-triangle-fill fs-4 text-danger"></i>
                <div style="font-size:0.9rem;">
                    <strong>แจ้งเตือน:</strong> มีแถวสินค้า <span class="badge bg-danger">สีแดง</span> ที่ค้นหาบิลเดิมของร้านนี้ไม่พบ กรุณาคลิกคีย์ราคาต่อหน่วยด้วยมือ (Manual Override) และระบุเหตุผล
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0" id="tblSummary">
                    <thead class="table-light small text-center">
                        <tr>
                            <th style="width: 40px;">#</th>
                            <th style="width: 120px;">รหัสสินค้า</th>
                            <th>ชื่อสินค้า</th>
                            <th style="width: 100px;">จำนวนคืนรวม</th>
                            <th style="width: 60px;">หน่วย</th>
                            <th style="width: 150px;">การแยกคลัง</th>
                            <th style="width: 140px;">บิลขายเดิมอ้างอิง</th>
                            <th style="width: 130px;">ราคาเฉลี่ยสุทธิเดิม</th>
                            <th style="width: 150px;" class="bg-warning-subtle">
                                ราคาต่อหน่วยจริง <span class="text-danger">*</span><br/>
                                <small class="text-muted" style="font-size:0.7rem;">(แก้ไขด้วยมือได้)</small>
                            </th>
                            <th style="width: 130px;">ยอดก่อน VAT</th>
                            <th style="width: 100px;">VAT 7%</th>
                            <th style="width: 140px;">ยอดรวมสุทธิ</th>
                        </tr>
                    </thead>
                    <tbody id="summaryTableBody">
                        <!-- Populated by JS -->
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="9" class="text-end">ยอดรวมมูลค่าสินค้าก่อนภาษี (บาท):</td>
                            <td class="text-end text-primary fs-6" id="lblGrandBeforeVat">0.00</td>
                            <td class="text-end text-primary" id="lblGrandVat">0.00</td>
                            <td class="text-end text-success fs-6" id="lblGrandTotal">0.00</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Price Override Reason Box (Mandatory when price changed) -->
            <div id="overrideReasonBox" class="p-3 mt-3 border rounded-3 bg-warning-subtle border-warning d-none">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-pencil-square text-dark fs-5"></i>
                    <strong class="text-dark">บันทึกเหตุผลในการแก้ไขราคา (Audit Log): <span class="text-danger">* บังคับระบุ</span></strong>
                </div>
                <textarea id="txtOverrideReason" class="form-control" rows="2" placeholder="ระบุเหตุผลในการแก้ไขราคาต่อหน่วย เช่น เป็นราคาโปรโมชั่นพิเศษ, สินค้าคืนไม่ครบตามลัง, เจรจาตามใบข้อตกลงพิเศษ..."></textarea>
                <small class="text-muted mt-1 d-block">
                    <i class="bi bi-shield-lock"></i> ข้อมูลนี้จะถูกบันทึกประวัติ Audit Log พร้อมชื่อผู้ใช้งานและวันเวลา เพื่อการตรวจสอบทานกับโปรแกรมบัญชี CD
                </small>
            </div>

            <!-- Printing Settings & CD Organizer Notice -->
            <div class="row g-3 mt-2 pt-2 border-top align-items-center">
                <div class="col-md-7">
                    <div class="p-2 px-3 bg-light border rounded small text-dark d-flex align-items-center gap-2">
                        <i class="bi bi-link-45deg text-primary fs-3"></i>
                        <div>
                            <strong>ประสานงานคู่กับโปรแกรมบัญชี CD Organizer:</strong>
                            <span class="text-muted d-block" style="font-size:0.8rem;">
                                ระบบนี้ใช้สำหรับคำนวณราคาเฉลี่ยสุทธิและพิมพ์เอกสารใบลดหนี้ (CN) เพื่อนำตัวเลขไปคีย์ตัดยอดลูกหนี้ในโปรแกรม CD Organizer โดยตรง (ไม่มีการตัดหนี้ในเว็บนี้)
                            </span>
                        </div>
                    </div>
                </div>
                <div class="col-md-5 text-md-end">
                    <div class="d-inline-flex align-items-center gap-2">
                        <label class="small fw-bold text-dark mb-0">ขนาดกระดาษพิมพ์:</label>
                        <div class="btn-group btn-group-sm" role="group">
                            <input type="radio" class="btn-check" name="paperOption" id="paperA4" value="A4" checked>
                            <label class="btn btn-outline-primary" for="paperA4"><i class="bi bi-file-earmark-text"></i> กระดาษ A4</label>

                            <input type="radio" class="btn-check" name="paperOption" id="paper9x11" value="Continuous9x11">
                            <label class="btn btn-outline-primary" for="paper9x11"><i class="bi bi-printer"></i> ต่อเนื่อง 9 x 11 นิ้ว</label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Final Submission Buttons -->
            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                <button type="button" class="btn btn-light px-3 border" onclick="window.location.reload();">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> เริ่มใหม่
                </button>
                <button type="button" class="btn btn-outline-success px-4 fw-bold" onclick="submitCreditNote(false)">
                    <i class="bi bi-check2-circle me-1"></i> บันทึกออกใบลดหนี้
                </button>
                <button type="button" class="btn btn-primary px-4 fw-bold shadow-sm" style="background:#0d9488; border-color:#0d9488;" onclick="submitCreditNote(true)">
                    <i class="bi bi-printer-fill me-1"></i> บันทึกและพิมพ์เอกสารทันที
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/tesseract.js@4/dist/tesseract.min.js"></script>
<script>
    // Master products in memory
    const masterProducts = [
        @if (products != null)
        {
            foreach (var p in products)
            {
                <text>{ code: "@p.Code", name: "@p.Name.Replace("\"", "\\\"")", unit: "@p.Unit" },</text>
            }
        }
    ];

    let calculatedItems = [];
    let isPriceOverriddenGlobal = false;
    let detectedOriginalBillGlobal = "";
    let detectedOriginalBillDateGlobal = null;
    let detectedOriginalBillTotalGlobal = 0;
    let originalSalesRepGlobal = "";

    $(document).ready(function() {
        $('.select2-searchable').select2({
            theme: 'bootstrap-5',
            placeholder: '-- ค้นหา --',
            allowClear: true
        });

        // Initialize 3 default manual rows
        addManualRow();
        addManualRow();
        addManualRow();

        // Customer selection event
        $('#custSelect').on('change', function() {
            const opt = $(this).find(':selected');
            if (opt.val()) {
                $('#lblCustAddress').text(opt.data('address') || '-');
                $('#lblCustTaxId').text(opt.data('taxid') || '-');
                $('#lblCustBranch').text(opt.data('branch') || 'สำนักงานใหญ่');
                $('#custDetailBox').slideDown();
            } else {
                $('#custDetailBox').slideUp();
            }
        });

        // Trigger if pre-selected
        if ($('#custSelect').val()) {
            $('#custSelect').trigger('change');
        }
    });

    // ==========================================
    // Manual Grid Operations
    // ==========================================
    function addManualRow(item = null) {
        const tbody = $('#manualGridBody');
        const rowIdx = tbody.find('tr').length + 1;
        
        let pCode = item ? item.ProductCode : '';
        let whNo = item ? item.WarehouseNo : '1';
        let qty = item ? item.Qty : '';
        let expDate = item && item.ExpiryDate ? item.ExpiryDate.substring(0, 10) : '';
        let lot = item && item.LotNo ? item.LotNo : '';

        const rowHtml = `
            <tr data-row-idx="${rowIdx}">
                <td class="text-center small text-muted">${rowIdx}</td>
                <td>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control form-control-sm txt-prod-code fw-semibold" placeholder="พิมพ์รหัส หรือชื่อสินค้า..." value="${pCode}" oninput="lookupProdName(this)" onchange="lookupProdName(this)" onkeydown="handleCodeKeydown(event, this)" list="dlMasterProducts" autocomplete="off" />
                    </div>
                    <small class="text-muted d-block lbl-prod-name mt-1" style="font-size:0.75rem;"></small>
                </td>
                <td>
                    <select class="form-select form-select-sm sel-wh">
                        <option value="1" ${whNo === '1' ? 'selected' : ''}>คลัง 1 (ดี)</option>
                        <option value="3" ${whNo === '3' ? 'selected' : ''}>คลัง 3 (คัดแยก)</option>
                        <option value="7" ${whNo === '7' ? 'selected' : ''}>คลัง 7 (ชำรุด/หมดอายุ)</option>
                    </select>
                </td>
                <td>
                    <input type="date" class="form-control form-control-sm txt-exp-date" value="${expDate}" />
                </td>
                <td>
                    <input type="number" step="any" min="0" class="form-control form-control-sm text-end fw-bold txt-qty text-primary" placeholder="0" value="${qty}" onkeydown="handleQtyKeydown(event, this)" />
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm txt-lot" placeholder="Lot No." value="${lot}" />
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-link text-danger p-0" onclick="$(this).closest('tr').remove(); reIndexManualGrid();">
                        <i class="bi bi-x-circle-fill"></i>
                    </button>
                </td>
            </tr>
        `;
        tbody.append(rowHtml);

        if (pCode) {
            const lastRow = tbody.find('tr:last-child');
            lookupProdName(lastRow.find('.txt-prod-code')[0]);
        }
    }

    function reIndexManualGrid() {
        $('#manualGridBody tr').each(function(i) {
            $(this).find('td:first').text(i + 1);
        });
    }

    function clearManualGrid() {
        $('#manualGridBody').empty();
        addManualRow();
    }

    function lookupProdName(input) {
        let val = $(input).val().trim();
        const row = $(input).closest('tr');
        if (!val) {
            row.find('.lbl-prod-name').html('');
            return;
        }

        // Check if input is formatted like "[100301] ..."
        const bracketMatch = val.match(/\[(.*?)\]/);
        if (bracketMatch) {
            val = bracketMatch[1].trim();
            $(input).val(val);
        }

        // Lookup in master by code
        let match = masterProducts.find(p => p.code.toUpperCase() === val.toUpperCase());
        
        // If not matched by code, check if user typed part of product name
        if (!match) {
            const nameMatch = masterProducts.find(p => p.name.trim().toLowerCase() === val.toLowerCase());
            if (nameMatch) {
                match = nameMatch;
                $(input).val(nameMatch.code); // Auto-fill clean code!
            }
        }

        if (match) {
            const unitText = match.unit ? ` (${match.unit})` : '';
            row.find('.lbl-prod-name').html(`<i class="bi bi-check-circle-fill text-success"></i> <span class="fw-bold text-success">${match.name}</span><span class="text-muted small">${unitText}</span>`);
        } else {
            row.find('.lbl-prod-name').html(`<span class="text-secondary"><i class="bi bi-search"></i> รหัสสินค้าใหม่ (จะค้นหาราคาจากบิลเดิม)</span>`);
        }
    }

    function handleCodeKeydown(e, input) {
        if (e.key === 'Enter') {
            e.preventDefault();
            $(input).closest('tr').find('.txt-qty').focus().select();
        }
    }

    function handleQtyKeydown(e, input) {
        if (e.key === 'Enter') {
            e.preventDefault();
            const row = $(input).closest('tr');
            const nextRow = row.next('tr');
            if (nextRow.length > 0) {
                nextRow.find('.txt-prod-code').focus().select();
            } else {
                addManualRow();
                const newRow = $('#manualGridBody tr:last-child');
                newRow.find('.txt-prod-code').focus().select();
            }
        }
    }

    // ==========================================
    // Channel 2: Excel Import Handling
    // ==========================================
    function handleExcelUpload(event) {
        const file = event.target.files[0];
        if (!file) return;

        const formData = new FormData();
        formData.append('file', file);

        $('#excelUploadSpinner').removeClass('d-none');

        fetch('/CreditNote/ParseExcel', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            $('#excelUploadSpinner').addClass('d-none');
            if (data.success && data.entries && data.entries.length > 0) {
                // Auto fill customer if detected
                if (data.detectedCustomer) {
                    $('#custSelect option').each(function() {
                        if ($(this).text().includes(data.detectedCustomer) || $(this).data('name').includes(data.detectedCustomer)) {
                            $('#custSelect').val($(this).val()).trigger('change');
                            return false;
                        }
                    });
                }

                // Add to manual grid
                $('#manualGridBody').empty();
                data.entries.forEach(e => {
                    addManualRow(e);
                });

                // Switch back to manual tab to let user see
                $('#tab-manual-btn').tab('show');
                alert(`นำเข้าข้อมูลจาก Excel สำเร็จ ${data.entries.length} รายการ กรุณากดปุ่ม "คำนวณราคาเฉลี่ยสุทธิ"`);
            } else {
                alert(data.message || 'ไม่สามารถอ่านข้อมูลจากไฟล์ได้');
            }
        })
        .catch(err => {
            $('#excelUploadSpinner').addClass('d-none');
            alert('เกิดข้อผิดพลาดในการอัปโหลดไฟล์: ' + err.message);
        });
    }

    // ==========================================
    // Channel 3: AI OCR Handling
    // ==========================================
    function handleImageOcr(event) {
        const file = event.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function(e) {
            $('#ocrPreviewImg').attr('src', e.target.result).removeClass('d-none');
            $('#ocrStatusMsg').html('<span class="spinner-border spinner-border-sm text-primary"></span> กำลังใช้ AI สแกนแกะข้อความจากภาพ...');
            
            Tesseract.recognize(
                e.target.result,
                'tha+eng',
                { logger: m => console.log(m) }
            ).then(({ data: { text } }) => {
                $('#ocrRawText').val(text);
                $('#ocrStatusMsg').text('แกะข้อความเสร็จสิ้น กรุณากดปุ่มแปลงข้อความเป็นรายการ');
            }).catch(err => {
                $('#ocrStatusMsg').text('เกิดข้อผิดพลาดในการ OCR: ' + err.message);
            });
        };
        reader.readAsDataURL(file);
    }

    function applyOcrTextToGrid() {
        const text = $('#ocrRawText').val();
        if (!text.trim()) {
            alert('กรุณาป้อนหรือสแกนข้อความก่อน');
            return;
        }

        fetch('/CreditNote/ParseOcr', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ rawText: text })
        })
        .then(res => res.json())
        .then(data => {
            if (data.success && data.entries && data.entries.length > 0) {
                if (data.detectedCustomer) {
                    $('#custSelect option').each(function() {
                        if ($(this).text().includes(data.detectedCustomer)) {
                            $('#custSelect').val($(this).val()).trigger('change');
                            return false;
                        }
                    });
                }

                $('#manualGridBody').empty();
                data.entries.forEach(e => addManualRow(e));
                $('#tab-manual-btn').tab('show');
                alert(`แกะรายการได้ ${data.entries.length} รายการ ถูกนำเข้าตารางเรียบร้อยแล้ว`);
            } else {
                alert('ไม่พบรูปแบบรหัสสินค้า Royal-D หรือจำนวนในข้อความ กรุณาตรวจสอบหรือคีย์ในตารางด้วยตนเอง');
            }
        });
    }

    // ==========================================
    // Core Calculation: Group By & Average Price
    // ==========================================
    function calculateAveragePrice() {
        const custCode = $('#custSelect').val();
        const custName = $('#custSelect option:selected').data('name') || '';

        // Gather raw items from grid
        const rawItems = [];
        $('#manualGridBody tr').each(function() {
            const pCode = $(this).find('.txt-prod-code').val().trim();
            const wh = $(this).find('.sel-wh').val();
            const exp = $(this).find('.txt-exp-date').val();
            const qty = parseFloat($(this).find('.txt-qty').val()) || 0;
            const lot = $(this).find('.txt-lot').val().trim();
            const pName = $(this).find('.lbl-prod-name').text();

            if (pCode && qty > 0) {
                rawItems.push({
                    ProductCode: pCode,
                    ProductName: pName,
                    WarehouseNo: wh,
                    ExpiryDate: exp ? exp : null,
                    Qty: qty,
                    LotNo: lot
                });
            }
        });

        if (rawItems.length === 0) {
            alert('กรุณาป้อนรหัสสินค้าและจำนวนคืนอย่างน้อย 1 รายการ');
            return;
        }

        // Call backend API (Read-Only Fetch from SalesBills)
        fetch('/CreditNote/CalculateReturnSummary', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                CustomerCode: custCode,
                CustomerName: custName,
                RawItems: rawItems
            })
        })
        .then(res => res.json())
        .then(data => {
            if (!data.success) {
                alert(data.message || 'เกิดข้อผิดพลาดในการคำนวณ');
                return;
            }

            calculatedItems = data.items;
            detectedOriginalBillGlobal = data.detectedOriginalBillNo || "";
            detectedOriginalBillDateGlobal = data.detectedOriginalBillDate;
            detectedOriginalBillTotalGlobal = data.detectedOriginalBillTotal || 0;
            originalSalesRepGlobal = data.defaultSalesRep || "";

            // Auto-select original sales rep if current select is empty
            if (data.defaultSalesRep && !$('#salesRepSelect').val()) {
                $('#salesRepSelect').val(data.defaultSalesRep).trigger('change');
            }

            renderSummaryTable();
            $('#summaryCard').slideDown();
            $('html, body').animate({
                scrollTop: $("#summaryCard").offset().top - 20
            }, 500);
        })
        .catch(err => {
            alert('เกิดข้อผิดพลาดในการเชื่อมต่อ: ' + err.message);
        });
    }

    function renderSummaryTable() {
        const tbody = $('#summaryTableBody');
        tbody.empty();
        let hasMissingBill = false;
        isPriceOverriddenGlobal = false;

        calculatedItems.forEach((item, index) => {
            const isRed = item.BillNotFound;
            if (isRed) hasMissingBill = true;

            if (item.IsPriceOverridden || item.UnitPrice !== item.OriginalNetUnitPrice) {
                isPriceOverriddenGlobal = true;
            }

            const rowClass = isRed ? 'table-danger border-danger' : '';
            const statusBadge = isRed 
                ? '<span class="badge bg-danger"><i class="bi bi-exclamation-circle me-1"></i>ไม่พบบิลเดิม</span>' 
                : `<span class="badge bg-light text-dark border">${item.ReferenceBillNo}</span>`;

            const rowHtml = `
                <tr class="${rowClass}" data-idx="${index}">
                    <td class="text-center small">${index + 1}</td>
                    <td class="fw-bold">${item.ProductCode}</td>
                    <td>
                        <div class="fw-semibold text-dark">${item.ProductName}</div>
                        <small class="text-muted" style="font-size:0.75rem;">${item.WarehouseBreakdown}</small>
                    </td>
                    <td class="text-center fw-bold text-primary">${item.TotalReturnQty.toLocaleString()}</td>
                    <td class="text-center small">${item.Unit}</td>
                    <td class="small text-muted">${item.WarehouseBreakdown}</td>
                    <td class="text-center">${statusBadge}</td>
                    <td class="text-end text-muted">
                        ${isRed ? '<span class="text-danger fw-bold">0.00</span>' : item.OriginalNetUnitPrice.toFixed(4)}
                    </td>
                    <td class="bg-warning-subtle text-end">
                        <input type="number" step="0.0001" min="0" class="form-control form-control-sm text-end fw-bold txt-unit-price ${isRed ? 'border-danger bg-danger-subtle' : ''}" 
                               value="${item.UnitPrice.toFixed(4)}" 
                               onchange="onUnitPriceChanged(${index}, this.value)" />
                    </td>
                    <td class="text-end fw-semibold lbl-line-before">${item.AmountBeforeVat.toFixed(2)}</td>
                    <td class="text-end lbl-line-vat">${item.VatAmount.toFixed(2)}</td>
                    <td class="text-end fw-bold text-success lbl-line-total">${item.TotalAmount.toFixed(2)}</td>
                </tr>
            `;
            tbody.append(rowHtml);
        });

        if (hasMissingBill) {
            $('#missingBillAlert').removeClass('d-none').addClass('d-flex');
        } else {
            $('#missingBillAlert').addClass('d-none').removeClass('d-flex');
        }

        updateGrandTotals();
    }

    function onUnitPriceChanged(index, newPriceVal) {
        const newPrice = parseFloat(newPriceVal) || 0;
        calculatedItems[index].UnitPrice = newPrice;
        calculatedItems[index].IsPriceOverridden = (newPrice !== calculatedItems[index].OriginalNetUnitPrice);

        // Recalculate line
        const beforeVat = Math.round(calculatedItems[index].TotalReturnQty * newPrice * 100) / 100;
        const vat = Math.round(beforeVat * 0.07 * 100) / 100;
        const total = beforeVat + vat;

        calculatedItems[index].AmountBeforeVat = beforeVat;
        calculatedItems[index].VatAmount = vat;
        calculatedItems[index].TotalAmount = total;

        // Update row display
        const row = $(`#summaryTableBody tr[data-idx="${index}"]`);
        row.find('.lbl-line-before').text(beforeVat.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}));
        row.find('.lbl-line-vat').text(vat.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}));
        row.find('.lbl-line-total').text(total.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}));

        // Check if any price is overridden across all items
        isPriceOverriddenGlobal = calculatedItems.some(i => i.IsPriceOverridden || i.UnitPrice !== i.OriginalNetUnitPrice);
        if (isPriceOverriddenGlobal) {
            $('#overrideReasonBox').removeClass('d-none');
        } else {
            $('#overrideReasonBox').addClass('d-none');
        }

        updateGrandTotals();
    }

    function updateGrandTotals() {
        let totalBefore = 0;
        let totalVat = 0;
        let grand = 0;

        calculatedItems.forEach(i => {
            totalBefore += i.AmountBeforeVat;
            totalVat += i.VatAmount;
            grand += i.TotalAmount;
        });

        $('#lblGrandBeforeVat').text(totalBefore.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}));
        $('#lblGrandVat').text(totalVat.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}));
        $('#lblGrandTotal').text(grand.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}));
    }

    // ==========================================
    // Final Save / Submit
    // ==========================================
    function submitCreditNote(printImmediately) {
        const custCode = $('#custSelect').val();
        const custName = $('#custSelect option:selected').data('name') || '';
        const salesRep = $('#salesRepSelect').val();
        const reason = $('#returnReason').val();
        const docDate = $('#docDate').val();
        const paperSize = $('input[name="paperOption"]:checked').val();
        const overrideReason = $('#txtOverrideReason').val().trim();

        if (!custCode) {
            alert('กรุณาเลือกร้านค้า / ลูกค้า');
            return;
        }

        if (!salesRep) {
            alert('กรุณาระบุหรือเลือกผู้แทนขาย');
            return;
        }

        if (calculatedItems.length === 0) {
            alert('ไม่พบรายการสินค้าที่คำนวณ กรุณากดปุ่มคำนวณราคาก่อนบันทึก');
            return;
        }

        // Validate override reason
        if (isPriceOverriddenGlobal && !overrideReason) {
            alert('มีการแก้ไขราคาต่อหน่วย กรุณาระบุ "เหตุผลในการแก้ไขราคา" เพื่อบันทึกประวัติการตรวจสอบ (Audit Log)');
            $('#txtOverrideReason').focus();
            return;
        }

        const payload = {
            CreditNoteDate: docDate,
            CustomerCode: custCode,
            CustomerName: custName,
            CustomerAddress: $('#lblCustAddress').text(),
            CustomerTaxId: $('#lblCustTaxId').text(),
            CustomerBranch: $('#lblCustBranch').text(),
            OriginalBillNo: detectedOriginalBillGlobal,
            OriginalBillDate: detectedOriginalBillDateGlobal,
            OriginalBillAmount: detectedOriginalBillTotalGlobal,
            OriginalSalesRep: originalSalesRepGlobal || salesRep,
            SalesRep: salesRep, // Selected current rep
            CommissionDeductTarget: "OriginalRep", // กฎเหล็ก: ไม่หักเซลส์คนใหม่
            Reason: reason,
            PriceOverrideReason: overrideReason,
            IsArOffset: false, // [CD Organizer Policy] ไม่มีการตัดหนี้ในเว็บนี้
            PaperSizePreference: paperSize,
            Items: calculatedItems
        };

        const token = $('input[name="__RequestVerificationToken"]').val();

        fetch('/CreditNote/SaveCreditNote', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify(payload)
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                alert(data.message || 'บันทึกสำเร็จ');
                if (printImmediately) {
                    window.location.href = `/CreditNote/Print?id=${data.creditNoteId}&paperSize=${paperSize}`;
                } else {
                    window.location.href = `/CreditNote/Detail?id=${data.creditNoteId}`;
                }
            } else {
                alert(data.message || 'เกิดข้อผิดพลาดในการบันทึก');
            }
        })
        .catch(err => {
            alert('เกิดข้อผิดพลาดในการส่งข้อมูล: ' + err.message);
        });
    }

    function selectReason(val) {
        $('#returnReason').val(val);
    }
</script>

<datalist id="dlMasterProducts">
    @if (products != null)
    {
        foreach (var p in products)
        {
            <option value="@p.Code">[@p.Code] @p.Name (@p.Unit)</option>
        }
    }
</datalist>

@Html.AntiForgeryToken()
}
