@model IEnumerable<RoyalD.Web.Models.CreditNote>
@{
    ViewData["Title"] = "รายการใบลดหนี้ (Credit Notes)";
    var salesReps = ViewBag.SalesReps as List<string> ?? new List<string>();
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="container-fluid px-3 py-2">
    <!-- Header Title -->
    <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
        <div>
            <h4 class="mb-1 text-primary fw-bold">
                <i class="bi bi-file-earmark-diff-fill me-2"></i>รายการใบลดหนี้ (Credit Notes)
            </h4>
            <span class="text-muted" style="font-size:0.9rem;">
                จัดการและตรวจสอบประวัติการออกใบลดหนี้คำนวณราคาเฉลี่ยสุทธิ
            </span>
        </div>
        <div class="d-flex gap-2">
            <a href="/CreditNote/Create" class="btn btn-sm btn-primary shadow-sm" style="background:#0d9488; border-color:#0d9488;">
                <i class="bi bi-plus-circle me-1"></i> + คืนสินค้าและออกใบลดหนี้ใหม่
            </a>
            <a href="/CreditNote/Report" class="btn btn-sm btn-outline-primary">
                <i class="bi bi-graph-up me-1"></i> รายงานสินค้าคืน
            </a>
        </div>
    </div>

    <!-- Summary KPI Cards -->
    <div class="row g-3 mb-3">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-4 border-primary" style="border-radius:10px;">
                <div class="card-body p-3">
                    <div class="text-muted small">จำนวนเอกสารใบลดหนี้</div>
                    <div class="fs-4 fw-bold text-dark">@(ViewBag.TotalCount ?? 0) <span class="fs-6 fw-normal text-muted">ฉบับ</span></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-4 border-info" style="border-radius:10px;">
                <div class="card-body p-3">
                    <div class="text-muted small">มูลค่าสินค้าก่อนภาษี</div>
                    <div class="fs-4 fw-bold text-dark">@((ViewBag.TotalBeforeVat as decimal? ?? 0).ToString("N2")) <span class="fs-6 fw-normal text-muted">บาท</span></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-4 border-warning" style="border-radius:10px;">
                <div class="card-body p-3">
                    <div class="text-muted small">ภาษีมูลค่าเพิ่ม (VAT 7%)</div>
                    <div class="fs-4 fw-bold text-dark">@((ViewBag.TotalVat as decimal? ?? 0).ToString("N2")) <span class="fs-6 fw-normal text-muted">บาท</span></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-4 border-success" style="border-radius:10px;">
                <div class="card-body p-3">
                    <div class="text-muted small">ยอดรวมสุทธิทั้งสิ้น</div>
                    <div class="fs-4 fw-bold text-success">@((ViewBag.GrandTotal as decimal? ?? 0).ToString("N2")) <span class="fs-6 fw-normal text-muted">บาท</span></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card shadow-sm border-0 mb-3" style="border-radius:10px;">
        <div class="card-body p-3 bg-light rounded">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-4">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control" placeholder="ค้นหาเลขที่ CN, ชื่อร้าน, รหัสลูกค้า, บิลเดิม..." value="@ViewBag.Search" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="salesRep" class="form-select form-select-sm select2-searchable">
                        <option value="">-- ผู้แทนขายทั้งหมด --</option>
                        @foreach (var rep in salesReps)
                        {
                            <option value="@rep" selected="@(rep == ViewBag.SalesRep ? "selected" : null)">@rep</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <input type="date" name="fromDate" class="form-control form-control-sm" value="@ViewBag.FromDate" title="ตั้งแต่วันที่" />
                </div>
                <div class="col-md-2">
                    <input type="date" name="toDate" class="form-control form-control-sm" value="@ViewBag.ToDate" title="ถึงวันที่" />
                </div>
                <div class="col-md-1 d-flex gap-1">
                    <button type="submit" class="btn btn-sm btn-primary w-100" style="background:#0d9488; border-color:#0d9488;">
                        <i class="bi bi-funnel"></i> ค้นหา
                    </button>
                    <a href="/CreditNote" class="btn btn-sm btn-outline-secondary" title="ล้างตัวกรอง">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Table List -->
    <div class="card shadow-sm border-0" style="border-radius:12px;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th style="width: 140px;">เลขที่ใบลดหนี้</th>
                            <th style="width: 100px;">วันที่ออก</th>
                            <th>ชื่อลูกค้า / ร้านค้า</th>
                            <th style="width: 160px;">ผู้แทนขายปัจจุบัน</th>
                            <th style="width: 130px;">อ้างอิงบิลเดิม</th>
                            <th class="text-center" style="width: 80px;">รายการ</th>
                            <th class="text-end" style="width: 130px;">ยอดก่อน VAT</th>
                            <th class="text-end" style="width: 130px;">ยอดรวมสุทธิ</th>
                            <th class="text-center" style="width: 100px;">สถานะ</th>
                            <th class="text-center" style="width: 140px;">จัดการ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    ไม่พบรายการใบลดหนี้ตามเงื่อนไขที่ค้นหา
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <a href="/CreditNote/Detail?id=@item.Id" class="fw-bold text-decoration-none text-primary">
                                            @item.CreditNoteNo
                                        </a>
                                        @if (item.IsPriceOverridden)
                                        {
                                            <span class="badge bg-warning text-dark ms-1" title="มีการแก้ไขราคาต่อหน่วย"><i class="bi bi-pencil-fill"></i> Override</span>
                                        }
                                    </td>
                                    <td class="small">@item.CreditNoteDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@item.CustomerName</div>
                                        <small class="text-muted font-monospace">@item.CustomerCode</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-person me-1"></i>@item.SalesRep
                                        </span>
                                        @if (!string.IsNullOrEmpty(item.OriginalSalesRep) && item.OriginalSalesRep != item.SalesRep)
                                        {
                                            <small class="text-muted d-block" style="font-size:0.72rem;">(บิลเดิม: @item.OriginalSalesRep)</small>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.OriginalBillNo))
                                        {
                                            <a href="/SalesBill/Detail?id=@Uri.EscapeDataString(item.OriginalBillNo)" target="_blank" class="text-decoration-none small">
                                                <i class="bi bi-receipt me-1"></i>@item.OriginalBillNo
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill">
                                            @item.Items.Count
                                        </span>
                                    </td>
                                    <td class="text-end fw-semibold">@item.TotalAmountBeforeVat.ToString("N2")</td>
                                    <td class="text-end fw-bold text-success">@item.GrandTotal.ToString("N2")</td>
                                    <td class="text-center">
                                        <span class="badge bg-success">ออกแล้ว</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <a href="/CreditNote/Detail?id=@item.Id" class="btn btn-outline-secondary" title="ดูรายละเอียด">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a href="/CreditNote/Print?id=@item.Id&paperSize=A4" target="_blank" class="btn btn-outline-primary" title="พิมพ์ A4">
                                                <i class="bi bi-printer"></i> A4
                                            </a>
                                            <a href="/CreditNote/Print?id=@item.Id&paperSize=Continuous9x11" target="_blank" class="btn btn-outline-info" title="พิมพ์กระดาษต่อเนื่อง 9x11">
                                                <i class="bi bi-printer-fill"></i> 9x11
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center p-3 border-top">
                    <span class="small text-muted">หน้า @currentPage จาก @totalPages</span>
                    <ul class="pagination pagination-sm mb-0">
                        @for (int p = 1; p <= totalPages; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" href="/CreditNote?page=@p&search=@ViewBag.Search&salesRep=@ViewBag.SalesRep&fromDate=@ViewBag.FromDate&toDate=@ViewBag.ToDate">
                                    @p
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</div>
