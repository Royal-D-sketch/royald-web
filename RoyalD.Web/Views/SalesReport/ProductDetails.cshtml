@using RoyalD.Web.Services
@model RoyalD.Web.Services.ProductDetailsReportViewModel
@{
    ViewData["Title"] = "3. รายการขายสินค้าจำนวนและราคาของแต่ละผู้แทน";
    var months = Model.Months;
    var monthKeys = Model.MonthKeys;
    var reps = Model.SalesReps;
    bool isAdmin = User.IsInRole("admin");
    var canDownloadClaim = ViewContext.HttpContext.User.FindFirst("CanDownload")?.Value;
    bool isSalesRepRole = User.HasClaim(c => c.Type == "Position" && (c.Value.Contains("ผู้แทน") || c.Value.Contains("พนักงานขาย"))) && !isAdmin;
    bool canDownload = (isAdmin || canDownloadClaim == "true") && !isSalesRepRole;
}

<style>
/* Sub-Tabs Nav - Soft Mint Green Theme */
.sales-subnav {
    display: flex; gap: 10px; background: #ecfdf5; padding: 8px;
    border-radius: 14px; margin-bottom: 20px; border: 1px solid #a7f3d0;
}
.sales-subnav .subnav-item {
    flex: 1; text-align: center; padding: 12px 18px; font-weight: 800;
    font-size: 1.02rem; color: #065f46; border-radius: 10px;
    text-decoration: none; transition: all .2s ease-in-out;
}
.sales-subnav .subnav-item:hover { background: rgba(255,255,255,0.9); color: #059669; transform: translateY(-1px); }
.sales-subnav .subnav-item.active { background: #059669; color: white; box-shadow: 0 4px 15px rgba(5,150,105,0.3); }

/* Product Movement Table */
.prod-table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: 12px; box-shadow: 0 4px 18px rgba(0,0,0,0.06); background: white; margin-bottom: 24px; }
.prod-table { width: 100%; min-width: 950px; border-collapse: collapse; font-size: 0.94rem; }
.prod-table th { background: #1e293b !important; color: white !important; padding: 12px 14px; border: 1px solid #334155; white-space: nowrap; font-size: 0.98rem; }
.prod-table td { padding: 11px 14px; border: 1px solid #e9ecef; vertical-align: middle; }
.rep-group-header { background: linear-gradient(135deg, #065f46 0%, #059669 50%, #10b981 100%); color: white; padding: 14px 20px; border-radius: 12px 12px 0 0; font-weight: 800; font-size: 1.18rem; display: flex; justify-content: space-between; align-items: center; }
.month-sub-header { background: #ecfdf5; color: #065f46; padding: 10px 18px; font-weight: 800; font-size: 1.02rem; border-left: 5px solid #059669; }

/* Delivering Strike-through style */
.delivering-strike { text-decoration: line-through; opacity: 0.60; color: #888; }
.badge-delivering { background: #fff3cd; color: #856404; border: 1px solid #ffeeba; font-size: 0.78rem; font-weight: 700; padding: 3px 8px; border-radius: 6px; text-decoration: none !important; }

/* Unit Cards */
.unit-card { border-radius:16px; padding:18px 16px; box-shadow:0 4px 20px rgba(0,0,0,.07); text-align:center; transition:transform .2s; }
.unit-card:hover { transform:translateY(-3px); }
.unit-icon { font-size:2rem; margin-bottom:6px; }
.unit-label { font-size:.8rem; font-weight:700; color:#64748b; text-transform:uppercase; letter-spacing:.5px; }
.unit-value { font-size:1.8rem; font-weight:900; line-height:1.1; }
.unit-sub { font-size:.75rem; color:#94a3b8; margin-top:4px; }
.prod-chart-card { background:white; border-radius:14px; box-shadow:0 4px 18px rgba(0,0,0,.08); padding:20px; margin-bottom:24px; }
.insight-card { background:linear-gradient(135deg,#f0fdfa 0%,#f8fafc 100%); border:1px solid #ccfbf1; border-left:5px solid #0d9488; border-radius:12px; padding:14px 18px; box-shadow:0 2px 10px rgba(15,118,110,0.06); line-height:1.65; }

@@media print {
    .no-print, .sales-subnav, nav, .btn, .filter-card, .export-bar { display: none !important; }
    body { font-size: 9pt; background: #fff !important; }
    .prod-table-wrap { overflow: visible !important; box-shadow: none !important; }
    .prod-table { min-width: 100% !important; }
    .prod-table th { background: #333 !important; color: #fff !important; }
    .signature-area { break-inside: avoid; page-break-inside: avoid; margin-top: 30px; }
}
</style>

<!-- Sub-Tabs Navigation Header -->
<div class="sales-subnav no-print">
    <a href="/SalesReport/Summary" class="subnav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Summary" || ViewContext.RouteData.Values["action"]?.ToString() == "Sales" ? "active" : "")">
        <i class="bi bi-table me-2"></i> 1. สรุปยอดขาย-ยอดเก็บเงิน (Pivot Matrix)
    </a>
    <a href="/SalesReport/Charts" class="subnav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Charts" ? "active" : "")">
        <i class="bi bi-bar-chart-line me-2"></i> 2. กราฟผลงานรายผู้แทน (Charts)
    </a>
    <a href="/SalesReport/ProductDetails" class="subnav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "ProductDetails" ? "active" : "")">
        <i class="bi bi-box-seam me-2"></i> 3. รายละเอียดสินค้าที่ขาย (Product Details)
    </a>
    @if (!isSalesRepRole)
    {
        <a href="/SalesReport/Compare" class="subnav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Compare" ? "active" : "")">
            <i class="bi bi-people me-2"></i> 4. กราฟเปรียบเทียบผู้แทนขาย
        </a>
    }
</div>

<!-- Header Title & Export Toolbar -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2 export-bar">
    <div>
        <h3 class="mb-1 fw-bold" style="color:#065f46;">
            <i class="bi bi-boxes" style="color:#059669;"></i> รายการขายสินค้า จำนวนและราคาของแต่ละผู้แทน (Product Movement)
        </h3>
        <span class="text-muted fw-semibold">แจกแจงตาม ผู้แทนขาย &gt; แยกรายเดือน &gt; รายละเอียดสินค้า </span>
    </div>
    
    @if (canDownload)
    {
        <div class="d-flex gap-2 no-print">
            <button onclick="window.print()" class="btn btn-outline-danger btn-sm fw-bold px-3 py-2 shadow-sm" title="สั่งพิมพ์เป็นเอกสาร PDF">
                <i class="bi bi-file-earmark-pdf me-1"></i> 📥 Export to PDF
            </button>
            <a href="/SalesReport/ExportProductDetailsExcel@(Context.Request.QueryString)" class="btn btn-sm fw-bold px-3 py-2 shadow-sm text-white" title="ดาวน์โหลดไฟล์ Excel" style="background:#059669; border-color:#059669;">
                <i class="bi bi-file-earmark-excel me-1"></i> 📊 Export to Excel (.xlsx)
            </a>
            <button onclick="downloadScreenCapture('product-details-area')" class="btn btn-outline-success btn-sm fw-bold px-3 py-2 shadow-sm" title="บันทึกภาพตารางความละเอียดสูง">
                <i class="bi bi-image me-1"></i> 🖼️ Download Image (PNG)
            </button>
        </div>
    }
</div>

<!-- Filter Bar -->
<div class="card mb-4 no-print border-0 shadow-sm filter-card" style="background:#f8f9fa;">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-bold text-primary mb-1">👤 เลือกผู้แทนขาย</label>
                <select name="salesRep" class="form-select form-select-sm">
                    <option value="">-- ผู้แทนขายทุกคน --</option>
                    @foreach (var r in reps)
                    {
                        if (r == Model.SelectedSalesRep) { <option value="@r" selected>@r</option> }
                        else { <option value="@r">@r</option> }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-primary mb-1">📅 เลือกเดือน</label>
                <select name="month" class="form-select form-select-sm">
                    <option value="">-- ทุกเดือน (ม.ค. - ส.ค. 69) --</option>
                    @for (int mi = 0; mi < monthKeys.Count; mi++)
                    {
                        var mk = monthKeys[mi];
                        var ml = months[mi];
                        if (mk == Model.SelectedMonth) { <option value="@mk" selected>@ml</option> }
                        else { <option value="@mk">@ml</option> }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold">
                    <i class="bi bi-filter"></i> กรองข้อมูล
                </button>
            </div>
            <div class="col-md-2">
                <a href="/SalesReport/ProductDetails" class="btn btn-outline-secondary btn-sm w-100">
                    <i class="bi bi-x-circle"></i> ล้างตัวกรอง
                </a>
            </div>
        </form>
    </div>
</div>

@{
    var allProductsForChart = Model.RepReports
        .SelectMany(r => r.MonthlyMovements)
        .SelectMany(m => m.Products)
        .Where(p => !p.IsAllDelivering)
        .GroupBy(p => new { Name = p.ProductName.Trim(), Unit = (p.Unit ?? "").Trim() })
        .Select(g => new { Name = g.Key.Name, Unit = g.Key.Unit, TotalQty = g.Sum(x => x.NetQty) })
        .OrderByDescending(x => x.TotalQty)
        .Take(15)
        .ToList();

    var unitCounts = new Dictionary<string, decimal> { ["ซอง"] = 0, ["ลัง"] = 0, ["แพ็ค"] = 0, ["ขวด"] = 0 };
    foreach (var rep in Model.RepReports)
    {
        foreach (var mo in rep.MonthlyMovements)
        {
            foreach (var prod in mo.Products.Where(p => !p.IsAllDelivering))
            {
                var u = (prod.Unit ?? "").Trim().ToLower();
                if (u == "ซอง") unitCounts["ซอง"] += prod.NetQty;
                else if (u == "ลัง") unitCounts["ลัง"] += prod.NetQty;
                else if (u.Contains("แพ็ค") || u.Contains("แพค") || u == "pack") unitCounts["แพ็ค"] += prod.NetQty;
                else if (u == "ขวด" || u == "bottle") unitCounts["ขวด"] += prod.NetQty;
            }
        }
    }
}

<!-- Unit Volume Infographic Cards -->
<div class="row g-3 mb-4 no-print" id="unit-cards">
    <div class="col-6 col-md-3">
        <div class="unit-card" style="background:linear-gradient(135deg,#fef3c7,#fffbeb);border-left:5px solid #f59e0b;">
            <div class="unit-icon">📩</div>
            <div class="unit-label">ยอดขาย (ซอง)</div>
            <div class="unit-value" style="color:#d97706;">@unitCounts["ซอง"].ToString("N0")</div>
            <div class="unit-sub">ซองที่ขายได้ทั้งหมด</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="unit-card" style="background:linear-gradient(135deg,#ede9fe,#f5f3ff);border-left:5px solid #8b5cf6;">
            <div class="unit-icon">📦</div>
            <div class="unit-label">ยอดขาย (ลัง)</div>
            <div class="unit-value" style="color:#7c3aed;">@unitCounts["ลัง"].ToString("N0")</div>
            <div class="unit-sub">ลังที่ขายได้ทั้งหมด</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="unit-card" style="background:linear-gradient(135deg,#dbeafe,#eff6ff);border-left:5px solid #3b82f6;">
            <div class="unit-icon">🗂️</div>
            <div class="unit-label">ยอดขาย (แพ็ค)</div>
            <div class="unit-value" style="color:#1d4ed8;">@unitCounts["แพ็ค"].ToString("N0")</div>
            <div class="unit-sub">แพ็คที่ขายได้ทั้งหมด</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="unit-card" style="background:linear-gradient(135deg,#dcfce7,#f0fdf4);border-left:5px solid #22c55e;">
            <div class="unit-icon">🍶</div>
            <div class="unit-label">ยอดขาย (ขวด)</div>
            <div class="unit-value" style="color:#15803d;">@unitCounts["ขวด"].ToString("N0")</div>
            <div class="unit-sub">ขวดที่ขายได้ทั้งหมด</div>
        </div>
    </div>
</div>

@if (allProductsForChart.Any())
{
    <div class="prod-chart-card no-print">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="fw-bold" style="color:#1a1a2e;font-size:1.05rem;">
                <i class="bi bi-bar-chart-fill text-primary"></i> กราฟแท่งจัดอันดับสินค้าขายดี (Top @allProductsForChart.Count รายการ)
            </span>
        </div>
        <canvas id="productBarChart" height="@(Math.Max(allProductsForChart.Count * 30, 200))"></canvas>
        <div class="insight-card mt-3" id="product-insight-box"></div>
    </div>
}

<!-- ================= REPORT CONTENT ================= -->
<div id="product-capture-area">
@if (!Model.RepReports.Any())
{
    <div class="text-center py-5 text-muted bg-white rounded shadow-sm">
        <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
        ไม่พบข้อมูลรายการขายสินค้าที่ตรงกับเงื่อนไข
    </div>
}
else
{
    @foreach (var repReport in Model.RepReports)
    {
        <div class="mb-4">
            <!-- Rep Header -->
            <div class="rep-group-header">
                <div>
                    <i class="bi bi-person-fill text-warning me-2"></i>ผู้แทนขาย: @repReport.SalesRep
                </div>
                <div class="fs-6 fw-normal">
                    ยอดขายสุทธิรวม: <strong class="text-warning fs-5">@repReport.TotalNetSales.ToString("N0")</strong> บาท 
                    <small class="opacity-75">(@repReport.TotalNetQty.ToString("N0") ชิ้น/กล่อง)</small>
                </div>
            </div>

            @foreach (var monthGroup in repReport.MonthlyMovements)
            {
                <div class="month-sub-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-calendar-event me-2"></i>ประจำเดือน: @monthGroup.MonthNameThai</span>
                    <span class="small">
                        ยอดขายสุทธิเดือนนี้: <strong class="text-success fs-6">@monthGroup.MonthNetAmount.ToString("N0")</strong> บาท
                        @if (monthGroup.MonthDeliveringDeduction > 0)
                        {
                            <span class="text-muted ms-2">(หักบิลอยู่จัดส่ง -@monthGroup.MonthDeliveringDeduction.ToString("N0") บ.)</span>
                        }
                    </span>
                </div>

                <div class="prod-table-wrap">
                    <table class="table prod-table mb-0">
                        <thead>
                            <tr>
                                <th style="width:45px;" class="text-center">#</th>
                                <th style="min-width:340px;">1. รหัสสินค้า และ ชื่อสินค้า</th>
                                <th style="width:170px;" class="text-end">2. จำนวนขายรวม (หน่วย)</th>
                                <th style="width:170px;" class="text-end">3. ราคาต่อหน่วย (บาท)</th>
                                <th style="width:200px;" class="text-end">4. ยอดเงินรวมสุทธิ (บาท)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{int pIdx = 1;}
                            @foreach (var prod in monthGroup.Products)
                            {
                                bool isDelivering = prod.IsAllDelivering;
                                bool hasPartialDelivering = prod.HasDelivering && !prod.IsAllDelivering;

                                <tr class="@(isDelivering ? "table-light" : "")">
                                    <td class="text-center text-muted">@(pIdx++)</td>
                                    
                                    <!-- 1. รหัส และ ชื่อสินค้า -->
                                    <td>
                                        <div class="fw-bold @(isDelivering ? "delivering-strike" : "text-dark")" style="font-size:1rem;">
                                            <span class="badge bg-secondary me-1">@prod.ProductCode</span>
                                            @prod.ProductName
                                        </div>
                                        @if (isDelivering)
                                        {
                                            <div class="badge-delivering mt-1 d-inline-block">
                                                🚚 บิลอยู่จัดส่ง — ขีดฆ่าไม่รวมยอดขาย (-@prod.TotalAmount.ToString("N0") บ.)
                                            </div>
                                        }
                                        else if (hasPartialDelivering)
                                        {
                                            <div class="badge-delivering mt-1 d-inline-block">
                                                🚚 รวมบิลอยู่จัดส่ง @prod.DeliveringQty.ToString("N0") @prod.Unit (หักลบ -@prod.DeliveringAmount.ToString("N0") บ.)
                                            </div>
                                        }
                                    </td>

                                    <!-- 2. จำนวนขาย -->
                                    <td class="text-end @(isDelivering ? "delivering-strike" : "fw-bold text-dark")" style="font-size:0.98rem;">
                                        @if (isDelivering)
                                        {
                                            <span>@prod.TotalQty.ToString("N0") @prod.Unit</span>
                                        }
                                        else
                                        {
                                            <span>@prod.NetQty.ToString("N0") <small class="text-muted">@prod.Unit</small></span>
                                        }
                                    </td>

                                    <!-- 3. ราคาเฉลี่ย -->
                                    <td class="text-end text-muted fw-semibold">
                                        @prod.Price.ToString("N2")
                                    </td>

                                    <!-- 4. ยอดเงินรวมภาษีสุทธิ -->
                                    <td class="text-end @(isDelivering ? "delivering-strike" : "fw-bold text-primary")" style="font-size:1.05rem;">
                                        @if (isDelivering)
                                        {
                                            <span>@prod.TotalAmount.ToString("N0")</span>
                                        }
                                        else
                                        {
                                            <span>@prod.NetAmount.ToString("N0")</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold" style="border-top:2px solid #dee2e6;">
                            <tr>
                                <td colspan="2" class="text-end fs-6">
                                    รวมสุทธิเดือน @monthGroup.MonthNameThai
                                </td>
                                <td class="text-end text-dark fs-6">
                                    @monthGroup.MonthNetQty.ToString("N0")
                                </td>
                                <td class="text-end text-muted">-</td>
                                <td class="text-end text-success" style="font-size:1.15rem;">
                                    @monthGroup.MonthNetAmount.ToString("N0") บ.
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    }
}
</div>

