@model RoyalD.Web.Models.ProductGroupSalesReportViewModel
@{
    ViewData["Title"] = "รายงานผู้แทนขายแยกตามกลุ่มสินค้า";
}

<style>
    /* ปลดล็อกให้ปุ่ม Export Excel ของหน้ารายงานผู้แทนขายแยกตามกลุ่มสินค้าแสดงผลได้สำหรับทุกคนที่มีสิทธิ์เข้าหน้านี้ */
    .btn-export-groupsales, a[href*="ExportProductGroupSalesExcel"] {
        display: inline-flex !important;
    }
</style>

<div class="container-fluid px-3 py-2">
    <!-- Breadcrumb & Header -->
    <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a href="/SalesBill" class="text-decoration-none">บิลขาย</a></li>
                    <li class="breadcrumb-item active">รายงานผู้แทนขายแยกตามกลุ่มสินค้า</li>
                </ol>
            </nav>
            <h4 class="mb-0 text-primary fw-bold">
                <i class="bi bi-collection me-2"></i>รายงานผู้แทนขายแยกตามกลุ่มสินค้า
            </h4>
            <div class="text-muted small mt-1">
                สรุปยอดขายปิดทริปทุกวันที่ 25 และหักลดยอดใบลดหนี้รายตัวสินค้า (อ้างอิง 20 กลุ่มสินค้า Master | ไม่นำสินค้า Tester จัดกลุ่ม)
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("ExportProductGroupSalesExcel", new { salesRep = Model.SelectedSalesRep, month25 = Model.SelectedMonth25, startDate = Model.StartDate.ToString("yyyy-MM-dd"), endDate = Model.EndDate.ToString("yyyy-MM-dd") })" 
               class="btn btn-sm btn-success shadow-sm fw-bold btn-export-groupsales">
                <i class="bi bi-file-earmark-excel me-1"></i> ส่งออก Excel (.xlsx)
            </a>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.print()">
                <i class="bi bi-printer me-1"></i> พิมพ์หน้านี้
            </button>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card shadow-sm border-0 mb-3" style="border-radius:10px;">
        <div class="card-header bg-white py-2 fw-bold text-dark border-bottom d-flex justify-content-between align-items-center">
            <span><i class="bi bi-funnel-fill text-primary me-1"></i> ตัวกรองรายงานปิดทริปยอดขาย</span>
            <a href="@Url.Action("ExportProductGroupSalesExcel", new { salesRep = Model.SelectedSalesRep, month25 = Model.SelectedMonth25, startDate = Model.StartDate.ToString("yyyy-MM-dd"), endDate = Model.EndDate.ToString("yyyy-MM-dd") })" 
               class="btn btn-sm btn-outline-success fw-bold btn-export-groupsales py-0 px-2">
                <i class="bi bi-file-earmark-excel me-1"></i> Export Excel
            </a>
        </div>
        <div class="card-body p-3">
            <form method="get" action="/SalesReport/ProductGroupSales" id="filterForm">
                <div class="row g-2 align-items-end">
                    <!-- Sales Rep Dropdown -->
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-dark mb-1">
                            <i class="bi bi-person me-1"></i>ผู้แทนขาย (Sales Rep)
                        </label>
                        @if (Model.IsRestrictedRep && Model.SalesReps.Count <= 1)
                        {
                            <input type="hidden" name="salesRep" value="@Model.SelectedSalesRep" />
                            <select class="form-select form-select-sm" disabled style="background-color:#f1f5f9; cursor:not-allowed;">
                                <option selected>@(string.IsNullOrEmpty(Model.SelectedSalesRep) ? "เฉพาะผู้แทนขายตนเอง" : Model.SelectedSalesRep)</option>
                            </select>
                        }
                        else
                        {
                            <select name="salesRep" class="form-select form-select-sm">
                                @if (!Model.IsRestrictedRep || Model.SalesReps.Count > 1)
                                {
                                    <option value="" selected="@(string.IsNullOrEmpty(Model.SelectedSalesRep) ? "selected" : null)">-- ผู้แทนขายทุกคน (ภาพรวม) --</option>
                                }
                                @foreach (var rep in Model.SalesReps)
                                {
                                    <option value="@rep" selected="@(rep == Model.SelectedSalesRep ? "selected" : null)">@rep</option>
                                }
                            </select>
                        }
                    </div>

                    <!-- Cut-Off 25th Month Selector -->
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-dark mb-1">
                            <i class="bi bi-calendar-check me-1 text-primary"></i>รอบปิดทริปตัด 25 (ประจำเดือน)
                        </label>
                        <select name="month25" id="month25Select" class="form-select form-select-sm" onchange="onMonth25Change(this)">
                            <option value="">-- กำหนดช่วงวันที่เอง (Custom) --</option>
                            @foreach (var m in Model.AvailableMonths25)
                            {
                                <option value="@m.Key" 
                                        data-start="@m.StartDate.ToString("yyyy-MM-dd")" 
                                        data-end="@m.EndDate.ToString("yyyy-MM-dd")"
                                        selected="@(m.Key == Model.SelectedMonth25 ? "selected" : null)">
                                    @m.Label
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Start Date -->
                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-dark mb-1">วันที่เริ่มต้น</label>
                        <input type="date" name="startDate" id="startDateInput" class="form-control form-control-sm" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                    </div>

                    <!-- End Date -->
                    <div class="col-md-2">
                        <label class="form-label small fw-bold text-dark mb-1">วันที่สิ้นสุด</label>
                        <input type="date" name="endDate" id="endDateInput" class="form-control form-control-sm" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                    </div>

                    <!-- Submit Button -->
                    <div class="col-md-2 d-flex gap-1">
                        <button type="submit" class="btn btn-sm btn-primary w-100 shadow-sm fw-bold">
                            <i class="bi bi-search me-1"></i> แสดงรายงาน
                        </button>
                        <a href="/SalesReport/ProductGroupSales" class="btn btn-sm btn-outline-secondary" title="รีเซ็ต">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Active Filter Summary Banner -->
    <div class="alert alert-info py-2 px-3 mb-3 d-flex justify-content-between align-items-center shadow-xs border-0" style="background:#f0fdfa; border-left:4px solid #0d9488 !important; border-radius:8px;">
        <div class="small text-dark">
            <i class="bi bi-info-circle-fill text-primary me-1"></i>
            <strong>ผู้แทนขาย:</strong> <span class="text-primary fw-bold">@(string.IsNullOrEmpty(Model.SelectedSalesRep) ? "ทุกคน (ภาพรวม)" : Model.SelectedSalesRep)</span> &nbsp;|&nbsp;
            <strong>ช่วงวันที่:</strong> <span class="fw-bold">@Model.StartDate.ToString("dd/MM/yyyy")</span> ถึง <span class="fw-bold">@Model.EndDate.ToString("dd/MM/yyyy")</span> &nbsp;|&nbsp; <span class="badge bg-secondary"><i class="bi bi-funnel me-1"></i>ไม่รวมสินค้า Tester</span>
            @if (!string.IsNullOrEmpty(Model.SelectedMonth25))
            {
                <span class="badge bg-primary ms-1">รอบตัด 25 (@Model.SelectedMonth25)</span>
            }
        </div>
        <div class="small text-muted">
            พบกลุ่มสินค้าที่มีการขาย: <strong class="text-dark">@Model.Groups.Count</strong> กลุ่ม &nbsp;|&nbsp;
            ใบลดหนี้ในรอบ: <strong class="text-danger">@Model.TotalCreditNoteCount</strong> ฉบับ
        </div>
    </div>

    <!-- KPI Summary Cards -->
    <div class="row g-2 mb-3">
        <!-- 1. Gross Sales -->
        <div class="col-md">
            <div class="card shadow-sm border-0 h-100 p-3" style="border-radius:10px; border-left: 4px solid #0284c7 !important;">
                <div class="text-muted small fw-bold">ยอดขายรวม (Gross Sales)</div>
                <div class="fs-4 fw-bold text-primary mt-1">@Model.TotalGrossSales.ToString("N2") <small class="fs-6 text-muted">บาท</small></div>
                <div class="text-muted small mt-1"><i class="bi bi-box-seam me-1"></i>@Model.TotalSalesQty.ToString("N0") ชิ้น</div>
            </div>
        </div>

        <!-- 2. Credit Note Deductions -->
        <div class="col-md">
            <div class="card shadow-sm border-0 h-100 p-3" style="border-radius:10px; border-left: 4px solid #dc2626 !important; background: #fff5f5;">
                <div class="text-danger small fw-bold">หัก ใบลดหนี้ (Credit Notes)</div>
                <div class="fs-4 fw-bold text-danger mt-1">-@Model.TotalCreditNotes.ToString("N2") <small class="fs-6 text-muted">บาท</small></div>
                <div class="text-danger small mt-1"><i class="bi bi-arrow-return-left me-1"></i>คืน @Model.TotalReturnQty.ToString("N0") ชิ้น (@Model.TotalCreditNoteCount ฉบับ)</div>
            </div>
        </div>

        <!-- 3. Net Sales -->
        <div class="col-md">
            <div class="card shadow-sm border-0 h-100 p-3" style="border-radius:10px; border-left: 4px solid #16a34a !important; background: #f0fdf4;">
                <div class="text-success small fw-bold">ยอดขายสุทธิปิดทริป (Net Sales)</div>
                <div class="fs-4 fw-bold text-success mt-1">@Model.TotalNetSales.ToString("N2") <small class="fs-6 text-muted">บาท</small></div>
                <div class="text-muted small mt-1"><i class="bi bi-check2-circle text-success me-1"></i>ยอดสุทธิ @Model.TotalNetQty.ToString("N0") ชิ้น</div>
            </div>
        </div>
    </div>

    <!-- Product Groups Accordion List -->
    @if (!Model.Groups.Any())
    {
        <div class="card shadow-sm border-0 p-5 text-center my-4" style="border-radius:10px;">
            <div class="text-muted fs-1 mb-2"><i class="bi bi-inbox"></i></div>
            <h5 class="fw-bold text-secondary">ไม่พบรายการขายและใบลดหนี้ในช่วงเวลานี้</h5>
            <p class="text-muted small mb-0">กรุณาลองเปลี่ยนผู้แทนขาย หรือปรับช่วงวันที่ในการค้นหา</p>
        </div>
    }
    else
    {
        <div class="accordion" id="groupsAccordion">
            @{ int groupIdx = 1; }
            @foreach (var g in Model.Groups)
            {
                var collapseId = $"collapseGroup_{g.GroupCode}";
                <div class="card shadow-sm border-0 mb-3" style="border-radius:10px; overflow:hidden;">
                    <!-- Group Header -->
                    <div class="card-header bg-white py-2 px-3 d-flex flex-wrap justify-content-between align-items-center" 
                         style="cursor:pointer;" 
                         data-bs-toggle="collapse" 
                         data-bs-target="#@collapseId" 
                         aria-expanded="true">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-secondary">กลุ่ม @g.GroupCode</span>
                            <span class="fw-bold text-dark fs-6">@g.GroupName</span>
                            <span class="badge bg-light text-muted border">@g.Items.Count รายการสินค้า</span>
                        </div>
                        <div class="d-flex align-items-center gap-3 small">
                            <div>
                                <span class="text-muted">ยอดขาย:</span>
                                <strong class="text-primary">@g.GroupSalesAmount.ToString("N2")</strong>
                            </div>
                            @if (g.GroupCreditAmount > 0)
                            {
                                <div>
                                    <span class="text-danger">หักใบลดหนี้:</span>
                                    <strong class="text-danger">-@g.GroupCreditAmount.ToString("N2")</strong>
                                </div>
                            }
                            <div class="border-start ps-3">
                                <span class="text-muted">สุทธิ:</span>
                                <strong class="text-success fs-6">@g.GroupNetSalesAmount.ToString("N2")</strong> บาท
                            </div>
                            <i class="bi bi-chevron-down text-muted"></i>
                        </div>
                    </div>

                    <!-- Group Items Table (Collapsible) -->
                    <div id="@collapseId" class="collapse show" data-bs-parent="#groupsAccordion">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0" style="font-size:0.87rem;">
                                    <thead class="table-light text-center small text-muted">
                                        <tr>
                                            <th style="width: 40px;">#</th>
                                            <th style="width: 100px;">รหัสสินค้า</th>
                                            <th>รายการสินค้า</th>
                                            <th style="width: 70px;">หน่วย</th>
                                            <th style="width: 90px;" class="text-end">จำนวนขาย</th>
                                            <th style="width: 120px;" class="text-end">ยอดขาย (บาท)</th>
                                            <th style="width: 130px;" class="text-center">เลขที่ใบลดหนี้</th>
                                            <th style="width: 80px;" class="text-end">จำนวนคืน</th>
                                            <th style="width: 110px;" class="text-end">ยอดลดหนี้ (บาท)</th>
                                            <th style="width: 130px;" class="text-end">ยอดขายสุทธิ (บาท)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{ int itemIdx = 1; }
                                        @foreach (var item in g.Items)
                                        {
                                            <tr class="@(item.HasCreditNote ? "table-warning-subtle" : "")">
                                                <td class="text-center text-muted small">@itemIdx++</td>
                                                <td class="text-center font-monospace fw-semibold">@item.ProductCode</td>
                                                <td>
                                                    <span class="fw-semibold text-dark">@item.ProductName</span>
                                                </td>
                                                <td class="text-center text-muted small">@item.Unit</td>
                                                <td class="text-end fw-semibold">@item.SalesQty.ToString("N0")</td>
                                                <td class="text-end text-primary fw-bold">@item.SalesAmount.ToString("N2")</td>
                                                
                                                <!-- Credit Note Details -->
                                                <td class="text-center">
                                                    @if (item.HasCreditNote && item.CreditNoteNos.Any())
                                                    {
                                                        foreach (var cnNo in item.CreditNoteNos)
                                                        {
                                                            <a href="/CreditNote?search=@Uri.EscapeDataString(cnNo)" target="_blank" class="badge bg-danger text-decoration-none shadow-xs" title="คลิกเพื่อดูใบลดหนี้">
                                                                <i class="bi bi-file-earmark-diff"></i> @cnNo
                                                            </a>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td class="text-end text-danger fw-semibold">
                                                    @(item.ReturnQty > 0 ? $"-{item.ReturnQty:N0}" : "-")
                                                </td>
                                                <td class="text-end text-danger fw-semibold">
                                                    @(item.CreditAmount > 0 ? $"-{item.CreditAmount:N2}" : "0.00")
                                                </td>

                                                <!-- Net Sales -->
                                                <td class="text-end fw-bold text-success fs-6">
                                                    @item.NetSalesAmount.ToString("N2")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <!-- Group Subtotal Footer -->
                                    <tfoot class="table-light fw-bold small">
                                        <tr>
                                            <td colspan="4" class="text-center text-muted">รวมกลุ่ม @g.GroupCode (@g.GroupName)</td>
                                            <td class="text-end">@g.GroupSalesQty.ToString("N0")</td>
                                            <td class="text-end text-primary">@g.GroupSalesAmount.ToString("N2")</td>
                                            <td class="text-center text-muted">-</td>
                                            <td class="text-end text-danger">@(g.GroupReturnQty > 0 ? $"-{g.GroupReturnQty:N0}" : "-")</td>
                                            <td class="text-end text-danger">@(g.GroupCreditAmount > 0 ? $"-{g.GroupCreditAmount:N2}" : "0.00")</td>
                                            <td class="text-end text-success fs-6">@g.GroupNetSalesAmount.ToString("N2")</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Grand Summary Card -->
        <div class="card shadow-sm border-0 mb-4 bg-white" style="border-radius:10px;">
            <div class="card-body p-3">
                <div class="row align-items-center text-center">
                    <div class="col-md-3 border-end">
                        <div class="text-muted small">รวมสินค้าที่ขายทั้งหมด</div>
                        <div class="fs-5 fw-bold text-primary mt-1">@Model.TotalSalesQty.ToString("N0") <span class="fs-6 text-muted">ชิ้น</span></div>
                    </div>
                    <div class="col-md-3 border-end">
                        <div class="text-muted small">ยอดขายรวมตามราคาขาย</div>
                        <div class="fs-5 fw-bold text-primary mt-1">@Model.TotalGrossSales.ToString("N2") <span class="fs-6 text-muted">บาท</span></div>
                    </div>
                    <div class="col-md-3 border-end">
                        <div class="text-muted small">หักยอดใบลดหนี้ (@Model.TotalCreditNoteCount ฉบับ)</div>
                        <div class="fs-5 fw-bold text-danger mt-1">-@Model.TotalCreditNotes.ToString("N2") <span class="fs-6 text-muted">บาท</span></div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-success small fw-bold">ยอดขายสุทธิปิดทริปทั้งสิ้น</div>
                        <div class="fs-4 fw-bold text-success mt-1">@Model.TotalNetSales.ToString("N2") <span class="fs-6 text-muted">บาท</span></div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script>
    function onMonth25Change(select) {
        const opt = select.options[select.selectedIndex];
        if (opt.value) {
            const start = opt.getAttribute('data-start');
            const end = opt.getAttribute('data-end');
            if (start) document.getElementById('startDateInput').value = start;
            if (end) document.getElementById('endDateInput').value = end;
        }
    }
</script>
