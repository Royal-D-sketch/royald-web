@model RoyalD.Web.Models.ProductGroupSalesReportViewModel
@{
    ViewData["Title"] = "รายงานผู้แทนขายแยกตามกลุ่มสินค้า";
    var posClaim = ViewContext.HttpContext.User.FindFirst("Position")?.Value ?? "";
    var repCodeClaim = ViewContext.HttpContext.User.FindFirst("SalesRepCode")?.Value;
    bool isSalesRepUser = posClaim == "ผู้แทนขาย" || posClaim == "พนักงานขาย" || posClaim.Contains("ผู้แทน") || posClaim.Contains("พนักงานขาย") || !string.IsNullOrWhiteSpace(repCodeClaim);
    bool isAdminUser = User.IsInRole("admin") || (User.Identity?.Name?.ToLower() == "admin") || (User.Identity?.Name?.ToLower() == "art");
    bool canDownloadUser = (isAdminUser || ViewContext.HttpContext.User.FindFirst("CanDownload")?.Value == "true") && !isSalesRepUser;
}

<div class="container-fluid px-3 py-2">
    <!-- Breadcrumb & Header -->
    <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a href="/SalesBill" class="text-decoration-none">บิลขาย</a></li>
                    <li class="breadcrumb-item active">รายงานผู้แทนขายแยกตามกลุ่มสินค้า</li>
                </ol>
            </nav>
            <h4 class="mb-0 text-primary fw-bold">
                <i class="bi bi-collection me-2"></i>รายงานผู้แทนขายแยกตามกลุ่มสินค้า
            </h4>
            <div class="text-muted small mt-1">
                สรุปยอดขายปิดทริปทุกวันที่ 25 และหักลดยอดใบลดหนี้รายตัวสินค้า (อ้างอิง 20 กลุ่มสินค้า Master | รวมสินค้า Tester)
            </div>
        </div>
        @if (canDownloadUser)
        {
            <div class="d-flex gap-2">
                <a href="@Url.Action("ExportProductGroupSalesExcel", new { salesRep = Model.SelectedSalesRep, month25 = Model.SelectedMonth25, startDate = Model.StartDate.ToString("yyyy-MM-dd"), endDate = Model.EndDate.ToString("yyyy-MM-dd"), region = Model.SelectedRegion, province = Model.SelectedProvince, district = Model.SelectedDistrict })" 
                   class="btn btn-sm btn-success shadow-sm fw-bold">
                    <i class="bi bi-file-earmark-excel me-1"></i> ส่งออก Excel (.xlsx)
                </a>
                <a href="@Url.Action("PrintProductGroupSalesPdf", new { salesRep = Model.SelectedSalesRep, month25 = Model.SelectedMonth25, startDate = Model.StartDate.ToString("yyyy-MM-dd"), endDate = Model.EndDate.ToString("yyyy-MM-dd"), region = Model.SelectedRegion, province = Model.SelectedProvince, district = Model.SelectedDistrict })" 
                   target="_blank" class="btn btn-sm btn-danger shadow-sm fw-bold">
                    <i class="bi bi-file-earmark-pdf-fill me-1"></i> พิมพ์ / ออก PDF (1 หน้า A4)
                </a>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> พิมพ์หน้านี้
                </button>
            </div>
        }
    </div>

    <!-- Filter Card -->
    <div class="card shadow-sm border-0 mb-3" style="border-radius:10px;">
        <div class="card-header bg-white py-2 fw-bold text-dark border-bottom d-flex justify-content-between align-items-center">
            <span><i class="bi bi-funnel-fill text-primary me-1"></i> ตัวกรองรายงานปิดทริปยอดขาย</span>
            @if (canDownloadUser)
            {
                <div class="d-flex gap-1">
                    <a href="@Url.Action("ExportProductGroupSalesExcel", new { salesRep = Model.SelectedSalesRep, month25 = Model.SelectedMonth25, startDate = Model.StartDate.ToString("yyyy-MM-dd"), endDate = Model.EndDate.ToString("yyyy-MM-dd"), region = Model.SelectedRegion, province = Model.SelectedProvince, district = Model.SelectedDistrict })" 
                       class="btn btn-sm btn-outline-success fw-bold py-0 px-2">
                        <i class="bi bi-file-earmark-excel me-1"></i> Export Excel
                    </a>
                    <a href="@Url.Action("PrintProductGroupSalesPdf", new { salesRep = Model.SelectedSalesRep, month25 = Model.SelectedMonth25, startDate = Model.StartDate.ToString("yyyy-MM-dd"), endDate = Model.EndDate.ToString("yyyy-MM-dd"), region = Model.SelectedRegion, province = Model.SelectedProvince, district = Model.SelectedDistrict })" 
                       target="_blank" class="btn btn-sm btn-outline-danger fw-bold py-0 px-2">
                        <i class="bi bi-file-earmark-pdf-fill me-1"></i> พิมพ์ PDF (1 หน้า A4)
                    </a>
                </div>
            }
        </div>
        <div class="card-body p-3">
            <form method="get" action="/SalesReport/ProductGroupSales" id="filterForm">
                <div class="row g-2 align-items-end mb-2">
                    <!-- Sales Rep Dropdown -->
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-dark mb-1">
                            <i class="bi bi-person me-1"></i>ผู้แทนขาย (Sales Rep)
                        </label>
                        <select name="salesRep" class="form-select form-select-sm select2-searchable">
                            <option value="">@(Model.IsRestrictedRep ? "-- ทุกผู้แทนที่รับผิดชอบ --" : "-- ผู้แทนขายทุกคน (ภาพรวม) --")</option>
                            @foreach (var rep in Model.SalesReps)
                            {
                                <option value="@rep" selected="@(rep == Model.SelectedSalesRep ? "selected" : null)">@rep</option>
                            }
                        </select>
                    </div>

                    <!-- Region Selector -->
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-dark mb-1">
                            <i class="bi bi-geo me-1 text-primary"></i>ภาค / เขต
                        </label>
                        <select name="region" id="region-select" class="form-select form-select-sm" onchange="onRegionChange()">
                            <option value="">@(Model.HasRegionRestriction ? "-- ทุกภาคที่รับผิดชอบ --" : "-- ทุกภาค --")</option>
                            @foreach (var reg in Model.AvailableRegions)
                            {
                                <option value="@reg" selected="@(reg == Model.SelectedRegion ? "selected" : null)">@reg</option>
                            }
                        </select>
                    </div>

                    <!-- Province Selector -->
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-dark mb-1">
                            <i class="bi bi-geo-alt me-1 text-primary"></i>จังหวัด
                        </label>
                        <select name="province" id="province-select" class="form-select form-select-sm select2-searchable" onchange="onProvinceChange()">
                            <option value="">@(Model.HasProvinceRestriction ? "-- ทุกจังหวัดที่รับผิดชอบ --" : "-- ทุกจังหวัด --")</option>
                            @foreach (var p in Model.AvailableProvinces)
                            {
                                <option value="@p" selected="@(p == Model.SelectedProvince ? "selected" : null)">@p</option>
                            }
                        </select>
                    </div>

                    <!-- District Selector (for BKK) -->
                    <div class="col-md-3" id="district-filter-col" style="@(Model.SelectedProvince == "กรุงเทพมหานคร" || Model.SelectedProvince == "กรุงเทพฯ" || Model.SelectedProvince == "กรุงเทพ" ? "" : "display:none;")">
                        <label class="form-label small fw-bold text-dark mb-1">
                            <i class="bi bi-compass me-1 text-primary"></i>เขต / อำเภอ
                        </label>
                        <select name="district" id="district-select" class="form-select form-select-sm select2-searchable">
                            <option value="">-- ทุกเขต (กรุงเทพฯ) --</option>
                            @if (Model.ProvinceDistricts.ContainsKey("กรุงเทพมหานคร"))
                            {
                                foreach (var d in Model.ProvinceDistricts["กรุงเทพมหานคร"])
                                {
                                    string dLabel = "เขต" + d.Replace("เขต", "").Trim();
                                    bool isDSelected = Model.SelectedDistrict == d || Model.SelectedDistrict == dLabel;
                                    <option value="@dLabel" selected="@(isDSelected ? "selected" : null)">@dLabel</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="row g-2 align-items-end">
                    <!-- Cut-Off 25th Month Selector -->
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-dark mb-1">
                            <i class="bi bi-calendar-check me-1 text-primary"></i>รอบปิดทริปตัด 25 (ประจำเดือน)
                        </label>
                        <select name="month25" id="month25Select" class="form-select form-select-sm" onchange="onMonth25Change(this)">
                            <option value="">-- กำหนดช่วงวันที่เอง (Custom) --</option>
                            @foreach (var m in Model.AvailableMonths25)
                            {
                                <option value="@m.Key" 
                                        data-start="@m.StartDate.ToString("yyyy-MM-dd")" 
                                        data-end="@m.EndDate.ToString("yyyy-MM-dd")"
                                        selected="@(m.Key == Model.SelectedMonth25 ? "selected" : null)">
                                    @m.Label
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Start Date -->
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-dark mb-1">วันที่เริ่มต้น</label>
                        <input type="date" name="startDate" id="startDateInput" class="form-control form-control-sm" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                    </div>

                    <!-- End Date -->
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-dark mb-1">วันที่สิ้นสุด</label>
                        <input type="date" name="endDate" id="endDateInput" class="form-control form-control-sm" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                    </div>

                    <!-- Submit Button -->
                    <div class="col-md-2 d-flex gap-1">
                        <button type="submit" class="btn btn-sm btn-primary w-100 shadow-sm fw-bold">
                            <i class="bi bi-search me-1"></i> แสดงรายงาน
                        </button>
                        <a href="/SalesReport/ProductGroupSales" class="btn btn-sm btn-outline-secondary" title="รีเซ็ต">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Active Filter Summary Banner -->
    <div class="alert alert-info py-2 px-3 mb-3 d-flex justify-content-between align-items-center shadow-xs border-0" style="background:#f0fdfa; border-left:4px solid #0d9488 !important; border-radius:8px;">
        <div class="small text-dark">
            <i class="bi bi-info-circle-fill text-primary me-1"></i>
            <strong>ผู้แทนขาย:</strong> <span class="text-primary fw-bold">@(string.IsNullOrEmpty(Model.SelectedSalesRep) ? "ทุกคน (ภาพรวม)" : Model.SelectedSalesRep)</span> &nbsp;|&nbsp;
            <strong>ช่วงวันที่:</strong> <span class="fw-bold">@Model.StartDate.ToString("dd/MM/yyyy")</span> ถึง <span class="fw-bold">@Model.EndDate.ToString("dd/MM/yyyy")</span> &nbsp;|&nbsp; <span class="badge" style="background:#0d9488;"><i class="bi bi-check-circle me-1"></i>รวมสินค้า Tester</span>
            @if (!string.IsNullOrEmpty(Model.SelectedMonth25))
            {
                <span class="badge bg-primary ms-1">รอบตัด 25 (@Model.SelectedMonth25)</span>
            }
        </div>
        <div class="small text-muted">
            พบกลุ่มสินค้าที่มีการขาย: <strong class="text-dark">@Model.Groups.Count</strong> กลุ่ม &nbsp;|&nbsp;
            ใบลดหนี้ในรอบ: <strong class="text-danger">@Model.TotalCreditNoteCount</strong> ฉบับ
        </div>
    </div>

    <!-- KPI Summary Cards -->
    <div class="row g-2 mb-3">
        <!-- 1. Gross Sales -->
        <div class="col-md">
            <div class="card shadow-sm border-0 h-100 p-3" style="border-radius:10px; border-left: 4px solid #0284c7 !important;">
                <div class="text-muted small fw-bold">ยอดขายรวม (Gross Sales)</div>
                <div class="fs-4 fw-bold text-primary mt-1">@Model.TotalGrossSales.ToString("N2") <small class="fs-6 text-muted">บาท</small></div>
                <div class="text-muted small mt-1"><i class="bi bi-box-seam me-1"></i>@Model.TotalSalesQty.ToString("N0") ชิ้น</div>
            </div>
        </div>

        <!-- 2. Credit Note Deductions -->
        <div class="col-md">
            <div class="card shadow-sm border-0 h-100 p-3" style="border-radius:10px; border-left: 4px solid #dc2626 !important; background: #fff5f5;">
                <div class="text-danger small fw-bold">หัก ใบลดหนี้ (Credit Notes)</div>
                <div class="fs-4 fw-bold text-danger mt-1">-@Model.TotalCreditNotes.ToString("N2") <small class="fs-6 text-muted">บาท</small></div>
                <div class="text-danger small mt-1"><i class="bi bi-arrow-return-left me-1"></i>คืน @Model.TotalReturnQty.ToString("N0") ชิ้น (@Model.TotalCreditNoteCount ฉบับ)</div>
            </div>
        </div>

        <!-- 3. Net Sales -->
        <div class="col-md">
            <div class="card shadow-sm h-100 p-3" style="border-radius:10px; border: 1.5px solid #059669; border-left: 5px solid #047857 !important; background: linear-gradient(135deg, #ecfdf5 0%, #f0fdf4 100%); box-shadow: 0 4px 12px rgba(5,150,105,0.12) !important;">
                <div class="small fw-bold d-flex justify-content-between align-items-center" style="color:#065f46;">
                    <span><i class="bi bi-award-fill me-1" style="color:#059669;"></i> ยอดขายสุทธิปิดทริป (Net Sales)</span>
                    <span class="badge" style="background:#059669; color:#ffffff; font-size:0.7rem; font-weight:600;">ยอดสุดท้าย</span>
                </div>
                <div class="fs-4 fw-bolder mt-1" style="color:#044e39; letter-spacing: -0.3px;">
                    @Model.TotalNetSales.ToString("N2") <span class="fs-6 fw-bold" style="color:#065f46;">บาท</span>
                </div>
                <div class="small mt-1" style="color:#065f46; font-weight:600;">
                    <i class="bi bi-check-circle-fill me-1" style="color:#059669;"></i> ยอดสุทธิ <strong>@Model.TotalNetQty.ToString("N0")</strong> ชิ้น
                </div>
            </div>
        </div>
    </div>

    <!-- Product Groups Accordion List -->
    @if (!Model.Groups.Any())
    {
        <div class="card shadow-sm border-0 p-5 text-center my-4" style="border-radius:10px;">
            <div class="text-muted fs-1 mb-2"><i class="bi bi-inbox"></i></div>
            <h5 class="fw-bold text-secondary">ไม่พบรายการขายและใบลดหนี้ในช่วงเวลานี้</h5>
            <p class="text-muted small mb-0">กรุณาลองเปลี่ยนผู้แทนขาย หรือปรับช่วงวันที่ในการค้นหา</p>
        </div>
    }
    else
    {
        <div class="accordion" id="groupsAccordion">
            @{ int groupIdx = 1; }
            @foreach (var g in Model.Groups)
            {
                var collapseId = $"collapseGroup_{g.GroupCode}";
                <div class="card shadow-sm mb-3" style="border-radius:10px; overflow:hidden; border: 1px solid #99f6e4;">
                    <!-- Group Header (หัวกลุ่มสินค้า — ใช้สีเขียวเข้ม Teal และสีทอง ตัดกับรายการสินค้าสีขาวอย่างชัดเจน) -->
                    <div class="card-header py-2 px-3 d-flex flex-wrap justify-content-between align-items-center" 
                         style="cursor:pointer; background: linear-gradient(135deg, #0f766e 0%, #115e59 100%); color: #ffffff; border-bottom: 2px solid #0d9488;" 
                         data-bs-toggle="collapse" 
                         data-bs-target="#@collapseId" 
                         aria-expanded="true">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge shadow-xs" style="background:#f59e0b; color:#1e293b; font-weight:800; font-size:0.85rem; padding: 4px 8px;">กลุ่ม @g.GroupCode</span>
                            <span class="fw-bold fs-6 text-white">@g.GroupName</span>
                            <span class="badge" style="background:rgba(255,255,255,0.18); color:#ffffff; border:1px solid rgba(255,255,255,0.3); font-weight:500;">@g.Items.Count รายการสินค้า</span>
                        </div>
                        <div class="d-flex align-items-center gap-3 small">
                            <div>
                                <span style="color: rgba(255,255,255,0.85);">ยอดขาย:</span>
                                <strong class="text-white">@g.GroupSalesAmount.ToString("N2")</strong>
                            </div>
                            @if (g.GroupCreditAmount > 0)
                            {
                                <div style="background: rgba(239, 68, 68, 0.3); padding: 2px 8px; border-radius: 4px;">
                                    <span style="color: #fecaca;">หักใบลดหนี้:</span>
                                    <strong style="color: #fee2e2;">-@g.GroupCreditAmount.ToString("N2")</strong>
                                </div>
                            }
                            <div class="ps-2 pe-3 py-1 d-flex align-items-center gap-1 shadow-xs" style="background: #ffffff; border-radius: 6px;">
                                <span style="color: #475569; font-size: 0.8rem; font-weight: 600;">สุทธิ:</span>
                                <strong class="fs-6" style="color: #047857; font-weight: 800;">@g.GroupNetSalesAmount.ToString("N2")</strong>
                                <span style="color: #64748b; font-size: 0.75rem;">บาท</span>
                            </div>
                            <i class="bi bi-chevron-down text-white-50 ms-1"></i>
                        </div>
                    </div>

                    <!-- Group Items Table (Collapsible) -->
                    <div id="@collapseId" class="collapse show" data-bs-parent="#groupsAccordion">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0" style="font-size:0.87rem;">
                                    <thead style="background:#f1f5f9; color:#334155; border-bottom: 2px solid #cbd5e1;" class="text-center small">
                                        <tr>
                                            <th style="width: 40px;">#</th>
                                            <th style="width: 100px;">รหัสสินค้า</th>
                                            <th>รายการสินค้า</th>
                                            <th style="width: 70px;">หน่วย</th>
                                            <th style="width: 90px;" class="text-end">จำนวนขาย</th>
                                            <th style="width: 120px;" class="text-end">ยอดขาย (บาท)</th>
                                            <th style="width: 130px;" class="text-center">เลขที่ใบลดหนี้</th>
                                            <th style="width: 80px;" class="text-end">จำนวนคืน</th>
                                            <th style="width: 110px;" class="text-end">ยอดลดหนี้ (บาท)</th>
                                            <th style="width: 130px;" class="text-end">ยอดขายสุทธิ (บาท)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{ int itemIdx = 1; }
                                        @foreach (var item in g.Items)
                                        {
                                            <tr class="@(item.HasCreditNote ? "table-warning-subtle" : "")">
                                                <td class="text-center text-muted small">@itemIdx++</td>
                                                <td class="text-center font-monospace fw-semibold">@item.ProductCode</td>
                                                <td>
                                                    <span class="fw-semibold text-dark">@item.ProductName</span>
                                                </td>
                                                <td class="text-center text-muted small">@item.Unit</td>
                                                <td class="text-end fw-semibold">@item.SalesQty.ToString("N0")</td>
                                                <td class="text-end text-primary fw-bold">@item.SalesAmount.ToString("N2")</td>
                                                
                                                <!-- Credit Note Details -->
                                                <td class="text-center">
                                                    @if (item.HasCreditNote && item.CreditNoteNos.Any())
                                                    {
                                                        foreach (var cnNo in item.CreditNoteNos)
                                                        {
                                                            <a href="/CreditNote?search=@Uri.EscapeDataString(cnNo)" target="_blank" class="badge bg-danger text-decoration-none shadow-xs" title="คลิกเพื่อดูใบลดหนี้">
                                                                <i class="bi bi-file-earmark-diff"></i> @cnNo
                                                            </a>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td class="text-end text-danger fw-semibold">
                                                    @(item.ReturnQty > 0 ? $"-{item.ReturnQty:N0}" : "-")
                                                </td>
                                                <td class="text-end text-danger fw-semibold">
                                                    @(item.CreditAmount > 0 ? $"-{item.CreditAmount:N2}" : "0.00")
                                                </td>

                                                <!-- Net Sales -->
                                                <td class="text-end fw-bold fs-6" style="color:#047857;">
                                                    @item.NetSalesAmount.ToString("N2")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <!-- Group Subtotal Footer -->
                                    <tfoot style="background:#f0fdf4; border-top:2px solid #0d9488; color:#0f766e;" class="fw-bold small">
                                        <tr>
                                            <td colspan="4" class="text-center text-muted">รวมกลุ่ม @g.GroupCode (@g.GroupName)</td>
                                            <td class="text-end">@g.GroupSalesQty.ToString("N0")</td>
                                            <td class="text-end text-primary">@g.GroupSalesAmount.ToString("N2")</td>
                                            <td class="text-center text-muted">-</td>
                                            <td class="text-end text-danger">@(g.GroupReturnQty > 0 ? $"-{g.GroupReturnQty:N0}" : "-")</td>
                                            <td class="text-end text-danger">@(g.GroupCreditAmount > 0 ? $"-{g.GroupCreditAmount:N2}" : "0.00")</td>
                                            <td class="text-end fs-6 fw-bold" style="color:#047857;">@g.GroupNetSalesAmount.ToString("N2")</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Grand Summary Card -->
        <div class="card shadow-sm border-0 mb-4 bg-white" style="border-radius:10px;">
            <div class="card-body p-3">
                <div class="row align-items-center text-center">
                    <div class="col-md-3 border-end">
                        <div class="text-muted small">รวมสินค้าที่ขายทั้งหมด</div>
                        <div class="fs-5 fw-bold text-primary mt-1">@Model.TotalSalesQty.ToString("N0") <span class="fs-6 text-muted">ชิ้น</span></div>
                    </div>
                    <div class="col-md-3 border-end">
                        <div class="text-muted small">ยอดขายรวมตามราคาขาย</div>
                        <div class="fs-5 fw-bold text-primary mt-1">@Model.TotalGrossSales.ToString("N2") <span class="fs-6 text-muted">บาท</span></div>
                    </div>
                    <div class="col-md-3 border-end">
                        <div class="text-muted small">หักยอดใบลดหนี้ (@Model.TotalCreditNoteCount ฉบับ)</div>
                        <div class="fs-5 fw-bold text-danger mt-1">-@Model.TotalCreditNotes.ToString("N2") <span class="fs-6 text-muted">บาท</span></div>
                    </div>
                    <div class="col-md-3">
                        <div class="small fw-bold" style="color:#065f46;">ยอดขายสุทธิปิดทริปทั้งสิ้น</div>
                        <div class="fs-4 fw-bolder mt-1" style="color:#044e39;">@Model.TotalNetSales.ToString("N2") <span class="fs-6 fw-bold" style="color:#065f46;">บาท</span></div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script>
    const allProvincesMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RegionProvincesMap));
    const allAvailableProvinces = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AvailableProvinces));
    const provinceDistrictsMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ProvinceDistricts));
    const hasProvRestriction = @(Model.HasProvinceRestriction ? "true" : "false");

    function onProvinceChange() {
        const pSel = document.getElementById('province-select');
        const selectedProv = pSel ? pSel.value : '';
        const distCol = document.getElementById('district-filter-col');
        const distSel = document.getElementById('district-select');

        const isBkk = selectedProv === 'กรุงเทพมหานคร' || selectedProv === 'กรุงเทพฯ' || selectedProv === 'กรุงเทพ' || selectedProv === 'กทม';
        if (distCol) {
            distCol.style.display = isBkk ? '' : 'none';
        }
        if (distSel) {
            if (!isBkk) {
                distSel.value = '';
            } else if (distSel.options.length <= 1) {
                const bkkDists = provinceDistrictsMap['กรุงเทพมหานคร'] || [];
                distSel.innerHTML = '<option value="">-- ทุกเขต (กรุงเทพฯ) --</option>';
                bkkDists.forEach(d => {
                    const dLabel = 'เขต' + d.replace(/^เขต/, '').trim();
                    const opt = document.createElement('option');
                    opt.value = dLabel;
                    opt.textContent = dLabel;
                    distSel.appendChild(opt);
                });
            }
        }
    }

    function onRegionChange() {
        const reg = document.getElementById('region-select').value;
        const pSel = document.getElementById('province-select');
        pSel.innerHTML = '<option value="">' + (hasProvRestriction ? '-- ทุกจังหวัดที่รับผิดชอบ --' : '-- ทุกจังหวัด --') + '</option>';
        let provList = [];
        if (!reg) {
            provList = allAvailableProvinces;
        } else if (allProvincesMap[reg]) {
            provList = allProvincesMap[reg];
        }
        provList.sort().forEach(p => {
            const opt = document.createElement('option');
            opt.value = p;
            opt.textContent = p;
            pSel.appendChild(opt);
        });
        if (window.jQuery && $(pSel).data('select2')) {
            $(pSel).val('').trigger('change.select2');
        }
        onProvinceChange();
    }

    function onMonth25Change(select) {
        const opt = select.options[select.selectedIndex];
        if (opt.value) {
            const start = opt.getAttribute('data-start');
            const end = opt.getAttribute('data-end');
            if (start) document.getElementById('startDateInput').value = start;
            if (end) document.getElementById('endDateInput').value = end;
        }
    }
</script>
