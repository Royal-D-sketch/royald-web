@using RoyalD.Web.Services
@model RoyalD.Web.Services.CustomerProductViewModel
@{
    ViewData["Title"] = "รายการขายรายลูกค้า";
    bool isAdmin = User.IsInRole("admin") || (User.Identity?.Name?.ToLower() == "admin");
    var canDownloadClaim = ViewContext.HttpContext.User.FindFirst("CanDownload")?.Value;
    bool canDownload = isAdmin || canDownloadClaim == "True";
}

<style>
.report-table th { background-color: #065f46 !important; color: #fff !important; white-space: nowrap; text-align: center; }
.report-table td { vertical-align: middle; }
.report-table tbody tr:hover { background-color: #f1f8f5; }
</style>

<div class="card shadow-sm border-0 mb-4 no-print">
    <div class="card-body bg-light rounded">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-2">
                <label class="form-label fw-bold">ระบุวันที่</label>
                <input type="date" name="date" class="form-control" value="@Model.SelectedDate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">เลือกเดือน</label>
                <select name="month" class="form-select">
                    <option value="">-- ดูทั้งหมด / ดูตามวันที่ --</option>
                    @foreach (var m in Model.AllMonths)
                    {
                        if (Model.SelectedMonth == m.Key)
                        {
                            <option value="@m.Key" selected>@m.Value</option>
                        }
                        else
                        {
                            <option value="@m.Key">@m.Value</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">ผู้แทนขาย (Sales Rep)</label>
                <select name="rep" class="form-select select2-searchable">
                    <option value="">-- ทุกคน --</option>
                    @foreach (var r in Model.AllReps)
                    {
                        if (Model.SelectedRep == r)
                        {
                            <option value="@r" selected>@r</option>
                        }
                        else
                        {
                            <option value="@r">@r</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 fw-bold"><i class="bi bi-search me-1"></i> ค้นหา</button>
            </div>
            <div class="col-md-2 text-end">
                @if (canDownload)
                {
                    <div class="dropdown">
                      <button class="btn btn-success dropdown-toggle w-100" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-download"></i> ดาวน์โหลด
                      </button>
                      <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                        <li><a class="dropdown-item" href="#" onclick="window.print();"><i class="bi bi-file-pdf text-danger"></i> PDF / พิมพ์</a></li>
                        <li><a class="dropdown-item" href="/SalesReport/ExportCustomerProductExcel?rep=@(Model.SelectedRep)&month=@(Model.SelectedMonth)&date=@(Model.SelectedDate?.ToString("yyyy-MM-dd"))"><i class="bi bi-file-earmark-excel text-success"></i> Excel</a></li>
                      </ul>
                    </div>
                }
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered table-hover report-table mb-0">
                <thead>
                    <tr>
                        <th>ลำดับ</th>
                        <th class="text-center">เดือน</th>
                        <th class="text-start">รหัสลูกค้า</th>
                        <th class="text-start">ชื่อลูกค้า</th>
                        <th class="text-start">รหัสสินค้า : ชื่อสินค้า</th>
                        <th>ราคาต่อหน่วย</th>
                        <th>ชื่อผู้แทนขาย</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">ไม่พบข้อมูลการขายตามเงื่อนไขที่ระบุ</td></tr>
                    }
                    else
                    {
                        int idx = 1;
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="text-center">@(idx++)</td>
                                <td class="text-center text-muted">@item.Month</td>
                                <td class="text-start fw-bold text-success">@item.CustomerCode</td>
                                <td class="text-start fw-bold text-success">@item.CustomerName</td>
                                <td class="text-start">@item.ProductCode : @item.ProductName</td>
                                <td class="text-end fw-bold">@item.Price.ToString("N2")</td>
                                <td class="text-center">@item.SalesRep</td>
                            </tr>
                        }
                        <tr class="bg-light fw-bold" style="font-size:1.1rem;">
                            <td colspan="4" class="text-end text-success">รวมยอดเงินทั้งหมด (Total Amount)</td>
                            <td class="text-end text-success"></td>
                            <td class="text-end text-success">@Model.Items.Sum(x => x.Qty).ToString("N0")</td>
                            <td class="text-end text-success">@Model.Items.Sum(x => x.TotalAmount).ToString("N2")</td>
                            <td></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>