@using RoyalD.Web.Services
@model RoyalD.Web.Services.CustomerProductViewModel
@{
    ViewData["Title"] = "รายการขายรายลูกค้า";
    bool isAdmin = User.IsInRole("admin") || (User.Identity?.Name?.ToLower() == "admin");
    bool isSalesRep = User.HasClaim(c => c.Type == "Position" && (c.Value.Contains("ผู้แทน") || c.Value.Contains("พนักงานขาย"))) && !isAdmin;
    var canDownloadClaim = ViewContext.HttpContext.User.FindFirst("CanDownload")?.Value;
    bool canDownload = (isAdmin || canDownloadClaim == "True" || canDownloadClaim == "true") && !isSalesRep;
    var allowedPagesClaim = ViewContext.HttpContext.User.FindFirst("AllowedPages")?.Value ?? "";
    var allowedPagesList = allowedPagesClaim.Split(',', StringSplitOptions.RemoveEmptyEntries)
                                           .Select(p => p.Trim().ToLower())
                                           .ToList();
    bool hasSalesReport = isAdmin || allowedPagesList.Contains("salesreport");
    bool hasCustPurchaseSum = isAdmin || allowedPagesList.Contains("customerpurchasesummary");
}

<style>
/* Sub-Tabs Nav - Soft Mint Green Theme */
.sales-subnav {
    display: flex; gap: 10px; background: #ecfdf5; padding: 8px;
    border-radius: 14px; margin-bottom: 20px; border: 1px solid #a7f3d0; flex-wrap: wrap;
}
.sales-subnav .subnav-item {
    flex: 1; text-align: center; padding: 12px 18px; font-weight: 800;
    font-size: 1.02rem; color: #065f46; border-radius: 10px;
    text-decoration: none; transition: all .2s ease-in-out; white-space: nowrap;
}
.sales-subnav .subnav-item:hover { background: rgba(255,255,255,0.9); color: #059669; transform: translateY(-1px); }
.sales-subnav .subnav-item.active { background: #059669; color: white; box-shadow: 0 4px 15px rgba(5,150,105,0.3); }

.report-table th {
    background-color: #065f46 !important;
    color: #fff !important;
    white-space: nowrap;
    text-align: center;
    position: sticky;
    top: 0;
    z-index: 10;
}
.report-table td { vertical-align: middle; }
.report-table tbody tr:hover { background-color: #f1f8f5; }
.smart-search-box {
    border: 2px solid #059669;
    border-radius: 12px;
    padding: 8px 16px;
    font-size: 1rem;
    transition: box-shadow 0.2s;
}
.smart-search-box:focus {
    box-shadow: 0 0 0 3px rgba(5,150,105,0.2);
    outline: none;
}
</style>

@if (hasSalesReport || hasCustPurchaseSum)
{
    <div class="sales-subnav no-print">
        @if (hasSalesReport)
        {
            <a href="/SalesReport/Summary" class="subnav-item">
                <i class="bi bi-table me-2"></i> 1. สรุปยอดขาย-ยอดเก็บเงิน
            </a>
            <a href="/SalesReport/Charts" class="subnav-item">
                <i class="bi bi-bar-chart-line me-2"></i> 2. กราฟผลงานรายผู้แทน
            </a>
            <a href="/SalesReport/ProductDetails" class="subnav-item">
                <i class="bi bi-box-seam me-2"></i> 3. รายละเอียดสินค้าที่ขาย
            </a>
            @if (!isSalesRep)
            {
                <a href="/SalesReport/Compare" class="subnav-item">
                    <i class="bi bi-people me-2"></i> 4. กราฟเปรียบเทียบผู้แทนขาย
                </a>
            }
        }
        <a href="/SalesReport/CustomerProduct" class="subnav-item active">
            <i class="bi bi-shop me-2"></i> @(hasSalesReport ? "5. " : "")รายการขายรายลูกค้า
        </a>
        @if (hasCustPurchaseSum)
        {
            <a href="/SalesReport/CustomerPurchaseSummary" class="subnav-item">
                <i class="bi bi-person-lines-fill me-2"></i> @(hasSalesReport ? "6. " : "2. ")สรุปการซื้อรายลูกค้า
            </a>
        }
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h3 class="mb-1 fw-bold" style="color:#065f46;">
            <i class="bi bi-shop" style="color:#059669;"></i> รายการขายรายลูกค้า
        </h3>
        <span class="text-muted small">ค้นหาสินค้าที่ขายแยกตามลูกค้า รหัสสินค้า และชื่อสินค้า</span>
    </div>
    @if (canDownload)
    {
        <div class="d-flex gap-2 no-print">
            <div class="dropdown">
                <button class="btn btn-success dropdown-toggle fw-bold px-3" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-download"></i> ดาวน์โหลด
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="#" onclick="window.print();"><i class="bi bi-file-pdf text-danger"></i> PDF / พิมพ์</a></li>
                    <li><a class="dropdown-item" href="/SalesReport/ExportCustomerProductExcel?rep=@(Model.SelectedRep)&q=@(Model.SearchQuery)&startDate=@(Model.StartDate?.ToString("yyyy-MM-dd"))&endDate=@(Model.EndDate?.ToString("yyyy-MM-dd"))&credit=@(Model.Credit)"><i class="bi bi-file-earmark-excel text-success"></i> Excel</a></li>
                    <li><a class="dropdown-item" href="/SalesReport/ExportCustomerProductCsv?rep=@(Model.SelectedRep)&q=@(Model.SearchQuery)&startDate=@(Model.StartDate?.ToString("yyyy-MM-dd"))&endDate=@(Model.EndDate?.ToString("yyyy-MM-dd"))&credit=@(Model.Credit)"><i class="bi bi-filetype-csv text-primary"></i> CSV</a></li>
                </ul>
            </div>
        </div>
    }
</div>

<div class="card shadow-sm border-0 mb-4 no-print" style="border: 1.5px solid #a7f3d0 !important; background:#f0fdf4; border-radius:14px;">
    <div class="card-body py-3 px-4">
        <form method="get" class="row g-3 align-items-end">
            <input type="hidden" name="pageSize" value="@(ViewBag.PageSize ?? 100)" />
            <div class="col-md-4">
                <label class="form-label fw-bold text-success">
                    <i class="bi bi-search me-1"></i> ค้นหาอัจฉริยะ
                </label>
                <input type="text" name="q" class="form-control smart-search-box" 
                    placeholder="พิมพ์ชื่อลูกค้า, รหัส, ชื่อสินค้า..."
                    value="@Model.SearchQuery" autofocus autocomplete="off" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold text-success"><i class="bi bi-person me-1"></i> ผู้แทนขาย</label>
                @if (isSalesRep && Model.AllReps.Count <= 1)
                {
                    <input type="hidden" name="rep" value="@Model.SelectedRep" />
                    <input type="text" class="form-control fw-bold text-success bg-white" value="@(Model.SelectedRep ?? "ผู้แทนขาย")" readonly />
                }
                else
                {
                    <select name="rep" class="form-select select2-searchable">
                        <option value="">@(isSalesRep ? "-- ทุกผู้แทนที่รับผิดชอบ --" : "-- ทุกคน --")</option>
                        @foreach (var r in Model.AllReps)
                        {
                            if (Model.SelectedRep == r)
                            {
                                <option value="@r" selected>@r</option>
                            }
                            else
                            {
                                <option value="@r">@r</option>
                            }
                        }
                    </select>
                }
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold text-success"><i class="bi bi-calendar-event me-1"></i> ตั้งแต่วันที่</label>
                <input type="date" name="startDate" class="form-control" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold text-success"><i class="bi bi-calendar-event me-1"></i> ถึงวันที่</label>
                <input type="date" name="endDate" class="form-control" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-1">
                <label class="form-label fw-bold text-success"><i class="bi bi-clock-history me-1"></i> เครดิต</label>
                <input type="number" name="credit" class="form-control" placeholder="วัน" value="@Model.Credit" min="0" />
            </div>
            <div class="col-12 d-flex justify-content-end gap-2 mt-2">
                <button type="submit" class="btn btn-success fw-bold shadow-sm px-4">
                    <i class="bi bi-search me-1"></i> ค้นหา
                </button>
                <a href="/SalesReport/CustomerProduct" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> ล้าง
                </a>
            </div>
        </form>
    </div>
</div>

@{
    var pagedList = ViewBag.PagedItems as List<CustomerProductItem> ?? Model.Items.Take(100).ToList();
    int curPage = ViewBag.Page ?? 1;
    int pSize = ViewBag.PageSize ?? 100;
    int totRecords = ViewBag.TotalRecords ?? Model.Items.Count;
    int totPages = ViewBag.TotalPages ?? 1;
    int startItem = totRecords == 0 ? 0 : ((curPage - 1) * pSize) + 1;
    int endItem = Math.Min(curPage * pSize, totRecords);
    int idx = startItem;
}

<div class="card shadow-sm border-0">
    <div class="card-header d-flex justify-content-between align-items-center py-2 flex-wrap gap-2" style="background:#f8fafc;">
        <span class="fw-bold text-success"><i class="bi bi-table me-1"></i> แสดง <strong>@startItem - @endItem</strong> จากทั้งหมด <strong>@totRecords.ToString("N0")</strong> รายการ (หน้า @curPage / @totPages)</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive" style="max-height: 650px; overflow-y: auto;">
            <table class="table table-bordered table-hover report-table mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>เดือน</th>
                        <th class="text-start">รหัสลูกค้า</th>
                        <th class="text-start col-customer-name" style="min-width: 260px; white-space: normal !important;">ชื่อลูกค้า</th>
                        <th class="text-start">รหัสสินค้า : ชื่อสินค้า</th>
                        <th class="text-center">หน่วยสินค้า</th>
                        <th>ราคา/หน่วย</th>
                        <th>เครดิต(วัน)</th>
                        <th>ผู้แทนขาย</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!pagedList.Any())
                    {
                        <tr><td colspan="9" class="text-center text-muted py-4">
                            <i class="bi bi-search me-2 fs-4"></i><br/>
                            ไม่พบข้อมูล — @(isSalesRep ? "ไม่มีรายการขายในขอบเขตของผู้แทนขาย" : "ลองพิมพ์คำค้นหาในช่องด้านบน")
                        </td></tr>
                    }
                    else
                    {
                        foreach (var item in pagedList)
                        {
                            <tr>
                                <td class="text-center text-muted">@(idx++)</td>
                                <td class="text-center text-muted">@item.Month</td>
                                <td class="text-start fw-bold text-success">@item.CustomerCode</td>
                                <td class="text-start fw-bold col-customer-name" style="min-width: 260px; white-space: normal !important; word-break: break-word !important;">@item.CustomerName</td>
                                <td class="text-start">
                                    <span class="badge bg-light text-dark border me-1">@item.ProductCode</span>@item.ProductName
                                </td>
                                <td class="text-center"><span class="badge bg-info bg-opacity-10 text-dark border border-info border-opacity-25 px-2 py-1">@(string.IsNullOrWhiteSpace(item.Unit) ? "-" : item.Unit)</span></td>
                                <td class="text-end">@item.Price.ToString("N2")</td>
                                <td class="text-center">@(item.Credit == 0 || item.Credit == 7 ? "เงินสด" : item.Credit.ToString())</td>
                                <td class="text-center">@item.SalesRep</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Pagination & Summary -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-3 py-2 bg-white rounded shadow-sm border mt-3 mb-4 no-print">
    <div class="d-flex align-items-center gap-3">
        <div class="text-muted small">
            แสดง <strong>@startItem - @endItem</strong> จากทั้งหมด <strong>@totRecords.ToString("N0")</strong> รายการ (หน้า <strong>@curPage / @totPages</strong>)
        </div>
        <div class="d-flex align-items-center gap-1 text-muted small">
            <label>แถวต่อหน้า:</label>
            <select class="form-select form-select-sm" style="width: auto; padding: 2px 24px 2px 8px; font-size: 0.8rem;" onchange="changePageSize(this.value)">
                <option value="50" selected="@(pSize == 50)">50</option>
                <option value="100" selected="@(pSize == 100)">100</option>
                <option value="200" selected="@(pSize == 200)">200</option>
                <option value="500" selected="@(pSize == 500)">500</option>
            </select>
        </div>
    </div>

    @if (totPages > 1)
    {
        <nav class="no-print">
            <ul class="pagination pagination-sm mb-0">
                @if (curPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("CustomerProduct", new { rep = Model.SelectedRep, q = Model.SearchQuery, startDate = Model.StartDate?.ToString("yyyy-MM-dd"), endDate = Model.EndDate?.ToString("yyyy-MM-dd"), credit = Model.Credit, page = 1, pageSize = pSize })" title="หน้าแรก">«</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("CustomerProduct", new { rep = Model.SelectedRep, q = Model.SearchQuery, startDate = Model.StartDate?.ToString("yyyy-MM-dd"), endDate = Model.EndDate?.ToString("yyyy-MM-dd"), credit = Model.Credit, page = curPage - 1, pageSize = pSize })">‹ ก่อนหน้า</a>
                    </li>
                }

                @for (int p = Math.Max(1, curPage - 2); p <= Math.Min(totPages, curPage + 2); p++)
                {
                    if (p == curPage)
                    {
                        <li class="page-item active"><span class="page-link" style="background:#059669; border-color:#059669;">@p</span></li>
                    }
                    else
                    {
                        <li class="page-item"><a class="page-link" href="@Url.Action("CustomerProduct", new { rep = Model.SelectedRep, q = Model.SearchQuery, startDate = Model.StartDate?.ToString("yyyy-MM-dd"), endDate = Model.EndDate?.ToString("yyyy-MM-dd"), credit = Model.Credit, page = p, pageSize = pSize })">@p</a></li>
                    }
                }

                @if (curPage < totPages)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("CustomerProduct", new { rep = Model.SelectedRep, q = Model.SearchQuery, startDate = Model.StartDate?.ToString("yyyy-MM-dd"), endDate = Model.EndDate?.ToString("yyyy-MM-dd"), credit = Model.Credit, page = curPage + 1, pageSize = pSize })">ถัดไป ›</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("CustomerProduct", new { rep = Model.SelectedRep, q = Model.SearchQuery, startDate = Model.StartDate?.ToString("yyyy-MM-dd"), endDate = Model.EndDate?.ToString("yyyy-MM-dd"), credit = Model.Credit, page = totPages, pageSize = pSize })" title="หน้าสุดท้าย">»</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

@section Scripts {
<script>
    function changePageSize(size) {
        const url = new URL(window.location.href);
        url.searchParams.set('pageSize', size);
        url.searchParams.set('page', '1');
        window.location.href = url.toString();
    }
</script>
}