@model RoyalD.Web.Models.ProductGroupSalesReportViewModel
@{
    Layout = null;
    string printedBy = ViewBag.PrintedBy as string ?? "Admin";
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>รายงานผู้แทนขายแยกตามกลุ่มสินค้า — บริษัท รอแยล-ดี (ไทยแลนด์) จำกัด</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700;800&display=swap" />
    <style>
        @@page {
            size: A4 portrait;
            margin: 7mm 8mm 7mm 8mm;
        }

        * {
            box-sizing: border-box;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        html, body {
            background-color: #ffffff;
            color: #0f172a;
            font-family: 'Sarabun', 'Noto Sans Thai', Tahoma, Arial, sans-serif;
            font-size: 11px;
            line-height: 1.35;
            margin: 0;
            padding: 0;
            width: 100%;
        }

        .screen-topbar {
            background: #f8fafc;
            border-bottom: 1px solid #cbd5e1;
            padding: 10px 16px;
            margin-bottom: 12px;
        }

        /* 1-Page A4 Container: จัดให้เต็มพอดี 1 หน้า A4 อัตโนมัติ */
        .page-a4 {
            width: 100%;
            max-width: 194mm;
            margin: 0 auto;
            padding: 0;
            page-break-inside: avoid !important;
            page-break-after: avoid !important;
        }

        .header-box {
            border-bottom: 2px solid #0f766e;
            padding-bottom: 8px;
            margin-bottom: 8px;
        }

        .company-title {
            color: #0f766e;
            font-size: 16px;
            font-weight: 800;
            margin: 0;
            letter-spacing: 0.3px;
        }

        .doc-title {
            color: #1e293b;
            font-size: 13.5px;
            font-weight: 700;
            margin: 3px 0 4px 0;
        }

        .meta-line {
            font-size: 10.5px;
            color: #334155;
            line-height: 1.4;
        }

        /* KPI summary strip */
        .kpi-strip {
            display: grid;
            grid-template-columns: 1fr 1fr 1.15fr;
            gap: 8px;
            margin-bottom: 8px;
        }

        .kpi-cell {
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            padding: 6px 10px;
            background: #f8fafc;
        }

        .kpi-cell.kpi-gross {
            border-left: 4px solid #0284c7;
            background: #f0f9ff;
        }

        .kpi-cell.kpi-credit {
            border-left: 4px solid #dc2626;
            background: #fef2f2;
        }

        .kpi-cell.kpi-net {
            border: 1.5px solid #10b981;
            border-left: 4px solid #047857;
            background: #ecfdf5;
        }

        .kpi-label {
            font-size: 10px;
            font-weight: 700;
            color: #475569;
            margin-bottom: 2px;
        }

        .kpi-val {
            font-size: 13px;
            font-weight: 800;
            letter-spacing: -0.2px;
        }

        /* Group Summary Table: ปรับระยะห่างบรรทัดให้อ่านง่าย โปร่งสบาย พอดี 1 หน้า A4 */
        .table-a4 {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
            margin-bottom: 8px;
        }

        .table-a4 th {
            background-color: #0f766e !important;
            color: #ffffff !important;
            font-weight: 700;
            text-align: center;
            vertical-align: middle;
            padding: 6px 5px;
            border: 1px solid #0d655e;
            font-size: 10.5px;
            line-height: 1.3;
        }

        .table-a4 td {
            padding: 4.8px 6px; /* ปรับระยะห่างบรรทัดให้พอดี ไม่ชิดเกินไป */
            border: 1px solid #cbd5e1;
            vertical-align: middle;
            line-height: 1.35;
        }

        .table-a4 tr:nth-child(even) td {
            background-color: #f8fafc !important;
        }

        .table-a4 tr.total-row td {
            background-color: #ccfbf1 !important;
            font-weight: 800;
            border-top: 2px solid #0f766e !important;
            border-bottom: 2px solid #0f766e !important;
            color: #0f766e;
            padding: 6px 6px;
            font-size: 11.5px;
        }

        /* Signatures Block: ปรับตำแหน่งไม่ให้ลงต่ำเกินไป และปรับระยะห่างแต่ละบรรทัดให้โปร่งสบาย ชัดเจน */
        .signatures-box {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-top: 24px;
            padding-top: 16px;
            border-top: 1.5px dashed #cbd5e1;
        }

        .sign-cell {
            text-align: center;
            font-size: 11px;
            color: #334155;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .sign-title {
            font-weight: 700;
            color: #1e293b;
            font-size: 11.5px;
            margin-bottom: 8px;
        }

        .sign-space {
            height: 48px; /* พื้นที่เซ็นชื่อ ปรับให้โปร่งกว้างสำหรับเซ็นจริง */
            width: 100%;
        }

        .sign-line {
            border-bottom: 1.5px dotted #64748b;
            width: 85%;
            margin: 0 auto 18px auto; /* เพิ่มระยะห่างระหว่างเส้นประเซ็นชื่อกับชื่อพิมพ์ในวงเล็บ */
        }

        .sign-name {
            font-size: 11px;
            color: #1e293b;
            margin: 0 auto 16px auto; /* เพิ่มระยะห่างระหว่างชื่อพิมพ์ในวงเล็บกับวันที่ */
            letter-spacing: 0.3px;
            line-height: 1.4;
        }

        .sign-date {
            font-size: 10.5px;
            color: #475569;
            font-weight: 500;
            line-height: 1.4;
            margin: 0;
        }

        @@media print {
            .no-print {
                display: none !important;
            }

            html, body {
                width: 100% !important;
                height: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
                overflow: hidden !important;
            }

            .page-a4 {
                width: 100% !important;
                max-width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
                page-break-inside: avoid !important;
                page-break-after: avoid !important;
            }

            .table-a4 th {
                background-color: #0f766e !important;
                color: #ffffff !important;
            }

            .table-a4 tr.total-row td {
                background-color: #ccfbf1 !important;
                color: #0f766e !important;
            }

            .kpi-cell.kpi-gross { background: #f0f9ff !important; }
            .kpi-cell.kpi-credit { background: #fef2f2 !important; }
            .kpi-cell.kpi-net { background: #ecfdf5 !important; }

            .signatures-box {
                display: grid !important;
                grid-template-columns: repeat(3, 1fr) !important;
                gap: 20px !important;
                margin-top: 24px !important;
                padding-top: 16px !important;
                border-top: 1.5px dashed #cbd5e1 !important;
            }

            .sign-cell {
                display: flex !important;
                flex-direction: column !important;
                align-items: center !important;
                text-align: center !important;
            }

            .sign-title {
                font-weight: 700 !important;
                font-size: 11.5px !important;
                margin-bottom: 8px !important;
            }

            .sign-space {
                height: 48px !important;
            }

            .sign-line {
                border-bottom: 1.5px dotted #64748b !important;
                width: 85% !important;
                margin: 0 auto 18px auto !important;
            }

            .sign-name {
                font-size: 11px !important;
                margin: 0 auto 16px auto !important;
            }

            .sign-date {
                font-size: 10.5px !important;
            }
        }
    </style>
</head>
<body>
    <!-- Screen View Control Bar (Hidden when printed) -->
    <div class="screen-topbar no-print d-flex justify-content-between align-items-center shadow-xs">
        <div>
            <h6 class="mb-0 fw-bold" style="color:#0f766e;">
                <i class="bi bi-file-earmark-pdf-fill text-danger me-1"></i> รายงานผู้แทนขายแยกตามกลุ่มสินค้าและใบลดหนี้ (PDF / Print พอดี 1 หน้า A4)
            </h6>
            <span class="text-muted" style="font-size:0.8rem;">
                💡 ระบบจัดหน้ากระดาษพอดี 1 หน้า A4 อัตโนมัติ (ขนาดกระดาษ A4 แนวตั้ง | รวมสินค้า Tester เรียบร้อย)
            </span>
        </div>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-sm btn-danger fw-bold px-3 shadow-sm">
                <i class="bi bi-printer-fill me-1"></i> สั่งพิมพ์ / บันทึก PDF (1 หน้า A4)
            </button>
            <button onclick="window.close()" class="btn btn-sm btn-outline-secondary px-3">
                <i class="bi bi-x-circle me-1"></i> ปิดหน้านี้
            </button>
        </div>
    </div>

    <!-- 1-Page A4 Container: ขยายเต็ม 1 หน้า A4 พอดี -->
    <div class="page-a4">
        <div>
            <!-- Header -->
            <div class="header-box text-center">
                <h1 class="company-title">บริษัท รอแยล-ดี (ไทยแลนด์) จำกัด</h1>
                <h2 class="doc-title">รายงานสรุปยอดขายแยกตามกลุ่มสินค้าและกระทบยอดใบลดหนี้</h2>
                <div class="meta-line d-flex justify-content-between align-items-center">
                    <span>
                        <strong>ผู้แทนขาย:</strong> @(string.IsNullOrEmpty(Model.SelectedSalesRep) ? "ทุกคน (ภาพรวม)" : Model.SelectedSalesRep)
                        &nbsp;|&nbsp;
                        <strong>ช่วงวันที่:</strong> @Model.StartDate.ToString("dd/MM/yyyy") - @Model.EndDate.ToString("dd/MM/yyyy")
                        @if (!string.IsNullOrEmpty(Model.SelectedMonth25))
                        {
                            <span>(รอบตัด 25: @Model.SelectedMonth25)</span>
                        }
                        @if (!string.IsNullOrEmpty(Model.SelectedProvince))
                        {
                            <span>&nbsp;|&nbsp;<strong>จังหวัด:</strong> @Model.SelectedProvince</span>
                        }
                        @if (!string.IsNullOrEmpty(Model.SelectedDistrict))
                        {
                            <span>&nbsp;|&nbsp;<strong>เขต/อำเภอ:</strong> @Model.SelectedDistrict</span>
                        }
                        @if (!string.IsNullOrEmpty(Model.SelectedRegion) && string.IsNullOrEmpty(Model.SelectedProvince))
                        {
                            <span>&nbsp;|&nbsp;<strong>ภาค:</strong> @Model.SelectedRegion</span>
                        }
                    </span>
                    <span>
                        <strong>พิมพ์เมื่อ:</strong> @DateTime.Now.ToString("dd/MM/yyyy HH:mm") น. &nbsp;|&nbsp; <strong>ผู้พิมพ์:</strong> @printedBy
                    </span>
                </div>
            </div>

            <!-- KPI Summary Strip -->
            <div class="kpi-strip">
                <div class="kpi-cell kpi-gross">
                    <div class="kpi-label">ยอดขายรวม (Gross Sales)</div>
                    <div class="kpi-val" style="color: #0284c7;">
                        @Model.TotalGrossSales.ToString("N2") <small style="font-size:9.5px; font-weight:normal; color:#475569;">บาท (@Model.TotalSalesQty.ToString("N0") ชิ้น)</small>
                    </div>
                </div>
                <div class="kpi-cell kpi-credit">
                    <div class="kpi-label">หัก ใบลดหนี้ (Credit Notes @Model.TotalCreditNoteCount ฉบับ)</div>
                    <div class="kpi-val" style="color: #dc2626;">
                        -@Model.TotalCreditNotes.ToString("N2") <small style="font-size:9.5px; font-weight:normal; color:#b91c1c;">บาท (คืน @Model.TotalReturnQty.ToString("N0") ชิ้น)</small>
                    </div>
                </div>
                <div class="kpi-cell kpi-net">
                    <div class="kpi-label" style="color: #065f46;">ยอดขายสุทธิปิดทริป (Net Sales)</div>
                    <div class="kpi-val" style="color: #044e39;">
                        @Model.TotalNetSales.ToString("N2") <small style="font-size:9.5px; font-weight:bold; color:#065f46;">บาท (สุทธิ @Model.TotalNetQty.ToString("N0") ชิ้น)</small>
                    </div>
                </div>
            </div>

            <!-- Groups Summary Table -->
            <table class="table-a4">
                <thead>
                    <tr>
                        <th style="width: 28px;">#</th>
                        <th style="width: 52px;">รหัสกลุ่ม</th>
                        <th style="text-align: left; padding-left: 8px;">ชื่อกลุ่มสินค้า (20 กลุ่ม Master)</th>
                        <th style="width: 72px;" class="text-end">จำนวนขาย</th>
                        <th style="width: 102px;" class="text-end">ยอดขาย (บาท)</th>
                        <th style="width: 65px;" class="text-end">จำนวนคืน</th>
                        <th style="width: 95px;" class="text-end">ยอดลดหนี้ (บาท)</th>
                        <th style="width: 110px;" class="text-end">ยอดขายสุทธิ (บาท)</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int seq = 1; }
                    @foreach (var g in Model.Groups)
                    {
                        <tr>
                            <td class="text-center text-muted">@(seq++)</td>
                            <td class="text-center font-monospace fw-bold">@g.GroupCode</td>
                            <td style="text-align: left; padding-left: 8px;" class="fw-semibold text-dark">
                                @g.GroupName
                                <span style="font-size:9px; color:#64748b; font-weight:normal;">(@g.Items.Count รายการ)</span>
                            </td>
                            <td class="text-end">@g.GroupSalesQty.ToString("N0")</td>
                            <td class="text-end fw-bold" style="color: #0284c7;">@g.GroupSalesAmount.ToString("N2")</td>
                            <td class="text-end text-danger">@(g.GroupReturnQty > 0 ? $"-{g.GroupReturnQty:N0}" : "-")</td>
                            <td class="text-end text-danger">@(g.GroupCreditAmount > 0 ? $"-{g.GroupCreditAmount:N2}" : "0.00")</td>
                            <td class="text-end fw-bold" style="color: #047857;">@g.GroupNetSalesAmount.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="total-row">
                        <td colspan="3" class="text-center">รวมยอดทั้งสิ้น (Grand Total)</td>
                        <td class="text-end">@Model.TotalSalesQty.ToString("N0")</td>
                        <td class="text-end">@Model.TotalGrossSales.ToString("N2")</td>
                        <td class="text-end text-danger">@(Model.TotalReturnQty > 0 ? $"-{Model.TotalReturnQty:N0}" : "-")</td>
                        <td class="text-end text-danger">@(Model.TotalCreditNotes > 0 ? $"-{Model.TotalCreditNotes:N2}" : "0.00")</td>
                        <td class="text-end" style="color: #044e39; font-weight: 800;">@Model.TotalNetSales.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- Signatures Section: ปรับระยะห่างลงชื่อในวงเล็บและวันที่ตามคำขอ -->
        <div class="signatures-box" style="margin-top: 24px; padding-top: 16px; border-top: 1.5px dashed #cbd5e1;">
            <div class="sign-cell" style="display: flex; flex-direction: column; align-items: center; text-align: center;">
                <div class="sign-title" style="font-weight: 700; font-size: 11.5px; margin-bottom: 8px;">ผู้จัดทำรายงาน</div>
                <div class="sign-space" style="height: 48px;"></div>
                <div class="sign-line" style="border-bottom: 1.5px dotted #64748b; width: 85%; margin: 0 auto 18px auto;"></div>
                <div class="sign-name" style="font-size: 11px; margin-bottom: 16px;">( ................................................................ )</div>
                <div class="sign-date" style="font-size: 10.5px;">วันที่ .......... / .......... / ..............</div>
            </div>
            <div class="sign-cell" style="display: flex; flex-direction: column; align-items: center; text-align: center;">
                <div class="sign-title" style="font-weight: 700; font-size: 11.5px; margin-bottom: 8px;">ผู้ตรวจสอบ (ฝ่ายบัญชี / การเงิน)</div>
                <div class="sign-space" style="height: 48px;"></div>
                <div class="sign-line" style="border-bottom: 1.5px dotted #64748b; width: 85%; margin: 0 auto 18px auto;"></div>
                <div class="sign-name" style="font-size: 11px; margin-bottom: 16px;">( ................................................................ )</div>
                <div class="sign-date" style="font-size: 10.5px;">วันที่ .......... / .......... / ..............</div>
            </div>
            <div class="sign-cell" style="display: flex; flex-direction: column; align-items: center; text-align: center;">
                <div class="sign-title" style="font-weight: 700; font-size: 11.5px; margin-bottom: 8px;">ผู้จัดการฝ่ายขาย / ผู้อนุมัติ</div>
                <div class="sign-space" style="height: 48px;"></div>
                <div class="sign-line" style="border-bottom: 1.5px dotted #64748b; width: 85%; margin: 0 auto 18px auto;"></div>
                <div class="sign-name" style="font-size: 11px; margin-bottom: 16px;">( ................................................................ )</div>
                <div class="sign-date" style="font-size: 10.5px;">วันที่ .......... / .......... / ..............</div>
            </div>
        </div>
    </div>
</body>
</html>
