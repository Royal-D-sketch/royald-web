@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
<script>
const productChartData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(allProductsForChart.Select(p => new { name = p.Name, unit = p.Unit, qty = p.TotalQty }).ToList()));

if (productChartData && productChartData.length > 0) {
    const top5Data = productChartData.slice(0, 5);
    const top5El = document.getElementById('top5Doughnut');
    
    if (top5El) {
        const unitColors = { 'ซอง':'#f59e0b', 'ลัง':'#8b5cf6', 'แพ็ค':'#3b82f6', 'ขวด':'#22c55e' };
        const bgColors = top5Data.map(p => unitColors[p.unit] || '#94a3b8');
        
        new Chart(top5El, {
            type: 'doughnut',
            data: {
                labels: top5Data.map(p => p.name.length > 15 ? p.name.substring(0, 15) + '...' : p.name),
                datasets: [{
                    data: top5Data.map(p => p.qty),
                    backgroundColor: bgColors,
                    borderWidth: 2,
                    borderColor: '#ffffff',
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '65%',
                plugins: {
                    legend: { position: 'right', labels: { boxWidth: 12, font: { size: 11 } } },
                    tooltip: {
                        callbacks: {
                            label: ctx => {
                                const p = top5Data[ctx.dataIndex];
                                return ' ' + p.qty.toLocaleString('th-TH') + ' ' + p.unit;
                            }
                        }
                    }
                }
            }
        });

        // Generate Insight Box
        const insightBox = document.getElementById('product-insight-box');
        if (insightBox) {
            const top = top5Data[0];
            const unitSummary = {};
            productChartData.forEach(p => { unitSummary[p.unit] = (unitSummary[p.unit] || 0) + p.qty; });
            const topUnit = Object.entries(unitSummary).sort((a,b)=>b[1]-a[1])[0];
            insightBox.innerHTML = `<i class="bi bi-star-fill text-warning me-1"></i> สินค้ายอดนิยมอันดับ 1 คือ <b>${top.name}</b> ยอดขายรวม <span class="text-success">${top.qty.toLocaleString('th-TH')} ${top.unit}</span>`;
        }
    }
}
                    }
                },
                scales: {
                    x: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.05)' } },
                    y: { grid: { display: false } }
                }
            }
        });

        // Generate Insight Box
        const insightBox = document.getElementById('product-insight-box');
        if (insightBox) {
            const top = productChartData[0];
            const unitSummary = {};
            productChartData.forEach(p => { unitSummary[p.unit] = (unitSummary[p.unit] || 0) + p.qty; });
            const topUnit = Object.entries(unitSummary).sort((a,b)=>b[1]-a[1])[0];
            insightBox.innerHTML = `<i class="bi bi-lightbulb-fill text-warning me-1"></i> <b>วิเคราะห์สินค้าขายดี:</b> สินค้าที่ขายได้มากที่สุดคือ <b>${top.name}</b> (${top.qty.toLocaleString('th-TH')} ${top.unit}) | หน่วยนับที่ขายออกมากที่สุดคือ <b>${topUnit[0]}</b> (จำนวนรวม ${topUnit[1].toLocaleString('th-TH')} ${topUnit[0]})`;
        }
    }
}

function downloadScreenCapture(elementId) {
    const target = document.getElementById(elementId);
    if (!target) return;
    html2canvas(target, { scale: 2, useCORS: true }).then(canvas => {
        const link = document.createElement('a');
        link.download = 'SalesReport_ProductMovement_' + new Date().toISOString().slice(0,10) + '.png';
        link.href = canvas.toDataURL('image/png', 1.0);
        link.click();
    });
}

function toggleSignatures() {
    const el = document.getElementById('signature-block');
    el.style.display = document.getElementById('toggle-sig').checked ? 'block' : 'none';
}
</script>
}



