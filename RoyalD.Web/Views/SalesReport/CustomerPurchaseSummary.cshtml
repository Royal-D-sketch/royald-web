@using RoyalD.Web.Services
@model RoyalD.Web.Services.CustomerPurchaseSummaryViewModel
@{
    ViewData["Title"] = "รายงานสรุปการซื้อสินค้าของลูกค้าแต่ละราย";
    bool isAdmin = User.IsInRole("admin");
    var canDownloadClaim = ViewContext.HttpContext.User.FindFirst("CanDownload")?.Value;
    bool isSalesRepRole = User.HasClaim(c => c.Type == "Position" && (c.Value.Contains("ผู้แทน") || c.Value.Contains("พนักงานขาย"))) && !isAdmin;
    bool canDownload = (isAdmin || canDownloadClaim == "true") && !isSalesRepRole;
    var allowedPagesClaim = ViewContext.HttpContext.User.FindFirst("AllowedPages")?.Value ?? "";
    var allowedPagesList = allowedPagesClaim.Split(',', StringSplitOptions.RemoveEmptyEntries)
                                           .Select(p => p.Trim().ToLower())
                                           .ToList();
    bool hasSalesReport = isAdmin || allowedPagesList.Contains("salesreport");
    bool hasCustProd = isAdmin || allowedPagesList.Contains("customerproduct");
}

<style>
.sales-subnav {
    display: flex; gap: 10px; background: #ecfdf5; padding: 8px;
    border-radius: 14px; margin-bottom: 20px; border: 1px solid #a7f3d0; flex-wrap: wrap;
}
.sales-subnav .subnav-item {
    flex: 1; text-align: center; padding: 12px 18px; font-weight: 800;
    font-size: 1.02rem; color: #065f46; border-radius: 10px;
    text-decoration: none; transition: all .2s ease-in-out; white-space: nowrap;
}
.sales-subnav .subnav-item:hover { background: rgba(255,255,255,0.9); color: #059669; transform: translateY(-1px); }
.sales-subnav .subnav-item.active { background: #059669; color: white; box-shadow: 0 4px 15px rgba(5,150,105,0.3); }
.prod-table-wrap { overflow-x: auto; border-radius: 12px; box-shadow: 0 4px 18px rgba(0,0,0,0.06); background: white; margin-bottom: 24px; }
.prod-table { width: 100%; min-width: 950px; border-collapse: collapse; font-size: 0.94rem; }
.prod-table th { background: #1e293b !important; color: white !important; padding: 12px 14px; border: 1px solid #334155; white-space: nowrap; font-size: 0.98rem; }
.prod-table td { padding: 11px 14px; border: 1px solid #e9ecef; vertical-align: middle; }
.insight-card { background:linear-gradient(135deg,#f0fdfa 0%,#f8fafc 100%); border:1px solid #ccfbf1; border-left:5px solid #0d9488; border-radius:12px; padding:18px; box-shadow:0 2px 10px rgba(15,118,110,0.06); line-height:1.65; }
.autocomplete-item { padding: 8px 14px; cursor: pointer; font-size: 0.93rem; }
.autocomplete-item:hover { background: #f0fdfa; color: #059669; }
@@media print {
    .no-print, .sales-subnav, nav, .btn, .filter-card, .export-bar { display: none !important; }
    body { font-size: 9pt; background: #fff !important; }
    .prod-table-wrap { box-shadow: none !important; }
}
</style>

@if (hasSalesReport || hasCustProd)
{
    <div class="sales-subnav no-print">
        @if (hasSalesReport)
        {
            <a href="/SalesReport/Summary" class="subnav-item"><i class="bi bi-table me-2"></i> 1. สรุปยอดขาย-ยอดเก็บเงิน</a>
            <a href="/SalesReport/Charts" class="subnav-item"><i class="bi bi-bar-chart-line me-2"></i> 2. กราฟผลงานรายผู้แทน</a>
            <a href="/SalesReport/ProductDetails" class="subnav-item"><i class="bi bi-box-seam me-2"></i> 3. รายละเอียดสินค้าที่ขาย</a>
            @if (!isSalesRepRole)
            {
                <a href="/SalesReport/Compare" class="subnav-item"><i class="bi bi-people me-2"></i> 4. กราฟเปรียบเทียบผู้แทนขาย</a>
            }
        }
        @if (hasCustProd)
        {
            <a href="/SalesReport/CustomerProduct" class="subnav-item"><i class="bi bi-shop me-2"></i> @(hasSalesReport ? "5. " : "")รายการขายรายลูกค้า</a>
        }
        <a href="/SalesReport/CustomerPurchaseSummary" class="subnav-item active">
            <i class="bi bi-person-lines-fill me-2"></i> @(hasSalesReport ? (hasCustProd ? "6. " : "5. ") : (hasCustProd ? "2. " : "1. "))สรุปการซื้อรายลูกค้า
        </a>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2 export-bar">
    <div>
        <h3 class="mb-1 fw-bold" style="color:#065f46;">
            <i class="bi bi-person-check-fill" style="color:#059669;"></i> รายงานสรุปการซื้อสินค้าของลูกค้าแต่ละราย
        </h3>
        <span class="text-muted fw-semibold">ค้นหาตามรหัสลูกค้า / ชื่อลูกค้า / รหัสสินค้า</span>
    </div>
    @if (canDownload)
    {
        <div class="d-flex gap-2 no-print">
            <button onclick="window.print()" class="btn btn-outline-danger btn-sm fw-bold px-3 py-2 shadow-sm">
                <i class="bi bi-file-earmark-pdf me-1"></i> Export PDF
            </button>
            <button onclick="exportTableToExcel('purchase-table', 'CustomerPurchaseSummary')" class="btn btn-sm fw-bold px-3 py-2 shadow-sm text-white" style="background:#059669; border-color:#059669;">
                <i class="bi bi-file-earmark-excel me-1"></i> Export Excel
            </button>
        </div>
    }
</div>

<div class="card mb-4 no-print border-0 shadow-sm filter-card" style="background:#f8f9fa;">
    <div class="card-body py-3">
        <form method="get" id="searchForm" class="row g-2 align-items-end">
            <input type="hidden" name="pageSize" value="@(ViewBag.PageSize ?? 100)" />
            <div class="col-md-2">
                <label class="form-label small fw-bold text-primary mb-1">🔢 รหัสลูกค้า</label>
                <input type="text" name="searchCustomerCode" class="form-control form-control-sm" placeholder="เช่น 192738" value="@Model.SearchCustomerCode" />
            </div>
            <div class="col-md-3 position-relative">
                <label class="form-label small fw-bold text-primary mb-1">👤 ชื่อลูกค้า (พิมพ์เพื่อค้นหา)</label>
                <input type="text" name="searchCustomerName" id="customerNameInput" class="form-control form-control-sm" placeholder="พิมพ์ชื่อลูกค้า..." value="@Model.SearchCustomerName" autocomplete="off" />
                <div id="customerNameDropdown" class="dropdown-menu w-100 shadow-sm" style="max-height:220px;overflow-y:auto;display:none;position:absolute;z-index:9999;top:100%;left:0;border-radius:8px;"></div>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-primary mb-1">📦 รหัสสินค้า</label>
                <input type="text" name="searchProductCode" class="form-control form-control-sm" placeholder="เช่น 308534" value="@Model.SearchProductCode" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-primary mb-1">📅 ตั้งแต่วันที่</label>
                <input type="date" name="startDate" class="form-control form-control-sm" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-primary mb-1">📅 ถึงวันที่</label>
                <input type="date" name="endDate" class="form-control form-control-sm" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-1">
                <label class="form-label small fw-bold text-primary mb-1">💳 เครดิต</label>
                <input type="number" name="credit" class="form-control form-control-sm" placeholder="วัน" value="@Model.Credit" min="0" />
            </div>
            <div class="col-12 d-flex justify-content-end gap-2 mt-2">
                <button type="submit" class="btn btn-primary btn-sm fw-bold px-3"><i class="bi bi-search me-1"></i> ค้นหา</button>
                <a href="/SalesReport/CustomerPurchaseSummary" class="btn btn-outline-secondary btn-sm px-3" title="ล้างตัวกรอง"><i class="bi bi-arrow-counterclockwise me-1"></i> ล้าง</a>
            </div>
        </form>
    </div>
</div>

@{
    var customersJson = System.Text.Json.JsonSerializer.Serialize(
        Model.AllCustomers.Select(c => new { code = c.Code, name = c.Name }).ToList()
    );
    var pagedRows = ViewBag.PagedRows as List<CustomerPurchaseSummaryRow> ?? Model.Rows.Take(100).ToList();
    int curPage = ViewBag.Page ?? 1;
    int pSize = ViewBag.PageSize ?? 100;
    int totRecords = ViewBag.TotalRecords ?? Model.Rows.Count;
    int totPages = ViewBag.TotalPages ?? 1;
    int startItem = totRecords == 0 ? 0 : ((curPage - 1) * pSize) + 1;
    int endItem = Math.Min(curPage * pSize, totRecords);
    decimal totalGrandAmount = Model.Rows.Sum(r => r.Amount);
}
<script id="customers-data" type="application/json">@Html.Raw(customersJson)</script>

<div class="d-flex justify-content-between align-items-center mb-2 px-1 text-muted small">
    <span><i class="bi bi-table me-1"></i> แสดง <strong>@startItem - @endItem</strong> จากทั้งหมด <strong>@totRecords.ToString("N0")</strong> รายการ (หน้า <strong>@curPage / @totPages</strong>)</span>
</div>

<div class="prod-table-wrap">
    <table class="table prod-table mb-0" id="purchase-table">
        <thead>
            <tr>
                <th style="width:120px;">รหัสลูกค้า</th>
                <th class="col-customer-name" style="min-width: 260px; white-space: normal !important;">ชื่อลูกค้า</th>
                <th style="width:120px;">รหัสสินค้า</th>
                <th style="min-width:180px;">ชื่อสินค้า</th>
                <th style="width:100px;" class="text-center">หน่วยสินค้า</th>
                <th style="width:100px;" class="text-center">เครดิต (วัน)</th>
                <th style="width:120px;" class="text-end">จำนวนที่ซื้อ</th>
                <th style="width:120px;" class="text-end">ราคา/หน่วย</th>
                <th style="width:150px;" class="text-end">จำนวนเงินรวม</th>
            </tr>
        </thead>
        <tbody>
            @if (!pagedRows.Any())
            {
                <tr><td colspan="9" class="text-center py-4 text-muted">ไม่พบข้อมูล — กรุณาใส่รหัสลูกค้า ชื่อลูกค้า หรือรหัสสินค้าเพื่อค้นหา</td></tr>
            }
            else
            {
                string lastCustomerId = "";
                foreach (var row in pagedRows)
                {
                    bool isNewCustomer = (row.CustomerId != lastCustomerId);
                    <tr>
                        <td class="@(isNewCustomer ? "fw-bold text-primary" : "text-muted")" style="@(isNewCustomer ? "" : "border-top:none;")">
                            @(isNewCustomer ? row.CustomerId : "")
                        </td>
                        <td class="@(isNewCustomer ? "fw-bold text-dark" : "text-muted") col-customer-name" style="min-width: 260px; white-space: normal !important; word-break: break-word !important; @(isNewCustomer ? "" : "border-top:none;")">
                            @(isNewCustomer ? row.CustomerName : "")
                        </td>
                        <td class="text-secondary">@row.ProductCode</td>
                        <td class="fw-semibold text-dark">@row.ProductName</td>
                        <td class="text-center"><span class="badge bg-secondary bg-opacity-10 text-dark border px-2 py-1">@(string.IsNullOrWhiteSpace(row.Unit) ? "-" : row.Unit)</span></td>
                        <td class="text-center">@(row.Credit == 0 ? "เงินสด" : $"{row.Credit} วัน")</td>
                        <td class="text-end fw-bold text-info">@row.Quantity.ToString("N0")</td>
                        <td class="text-end">@row.UnitPrice.ToString("N2")</td>
                        <td class="text-end fw-bold text-success">@row.Amount.ToString("N2")</td>
                    </tr>
                    lastCustomerId = row.CustomerId;
                }
                <tr class="table-light fw-bold" style="border-top:2px solid #334155;">
                    <td colspan="8" class="text-end fs-6">รวมจำนวนเงินดิบทั้งสิ้น (ก่อนหักลด/ไม่รวม VAT - ทั้งหมด @totRecords.ToString("N0") รายการ):</td>
                    <td class="text-end text-success fs-5">@totalGrandAmount.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination & Summary -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-3 py-2 bg-white rounded shadow-sm border mt-3 mb-4 no-print">
    <div class="d-flex align-items-center gap-3">
        <div class="text-muted small">
            แสดง <strong>@startItem - @endItem</strong> จากทั้งหมด <strong>@totRecords.ToString("N0")</strong> รายการ (หน้า <strong>@curPage / @totPages</strong>)
        </div>
        <div class="d-flex align-items-center gap-1 text-muted small">
            <label>แถวต่อหน้า:</label>
            <select class="form-select form-select-sm" style="width: auto; padding: 2px 24px 2px 8px; font-size: 0.8rem;" onchange="changePageSize(this.value)">
                <option value="50" selected="@(pSize == 50)">50</option>
                <option value="100" selected="@(pSize == 100)">100</option>
                <option value="200" selected="@(pSize == 200)">200</option>
                <option value="500" selected="@(pSize == 500)">500</option>
            </select>
        </div>
    </div>

    @if (totPages > 1)
    {
        <nav class="no-print">
            <ul class="pagination pagination-sm mb-0">
                @if (curPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("CustomerPurchaseSummary", new { salesRep = ViewBag.SelectedSalesRep, month = ViewBag.SelectedMonth, startDate = Model.StartDate?.ToString("yyyy-MM-dd"), endDate = Model.EndDate?.ToString("yyyy-MM-dd"), credit = Model.Credit, searchCustomerCode = ViewBag.SearchCustomerCode, searchCustomerName = ViewBag.SearchCustomerName, searchProductCode = ViewBag.SearchProductCode, page = 1, pageSize = pSize })" title="หน้าแรก">«</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("CustomerPurchaseSummary", new { salesRep = ViewBag.SelectedSalesRep, month = ViewBag.SelectedMonth, startDate = Model.StartDate?.ToString("yyyy-MM-dd"), endDate = Model.EndDate?.ToString("yyyy-MM-dd"), credit = Model.Credit, searchCustomerCode = ViewBag.SearchCustomerCode, searchCustomerName = ViewBag.SearchCustomerName, searchProductCode = ViewBag.SearchProductCode, page = curPage - 1, pageSize = pSize })">‹ ก่อนหน้า</a>
                    </li>
                }

                @for (int p = Math.Max(1, curPage - 2); p <= Math.Min(totPages, curPage + 2); p++)
                {
                    if (p == curPage)
                    {
                        <li class="page-item active"><span class="page-link" style="background:#0d9488; border-color:#0d9488;">@p</span></li>
                    }
                    else
                    {
                        <li class="page-item"><a class="page-link" href="@Url.Action("CustomerPurchaseSummary", new { salesRep = ViewBag.SelectedSalesRep, month = ViewBag.SelectedMonth, startDate = Model.StartDate?.ToString("yyyy-MM-dd"), endDate = Model.EndDate?.ToString("yyyy-MM-dd"), credit = Model.Credit, searchCustomerCode = ViewBag.SearchCustomerCode, searchCustomerName = ViewBag.SearchCustomerName, searchProductCode = ViewBag.SearchProductCode, page = p, pageSize = pSize })">@p</a></li>
                    }
                }

                @if (curPage < totPages)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("CustomerPurchaseSummary", new { salesRep = ViewBag.SelectedSalesRep, month = ViewBag.SelectedMonth, startDate = Model.StartDate?.ToString("yyyy-MM-dd"), endDate = Model.EndDate?.ToString("yyyy-MM-dd"), credit = Model.Credit, searchCustomerCode = ViewBag.SearchCustomerCode, searchCustomerName = ViewBag.SearchCustomerName, searchProductCode = ViewBag.SearchProductCode, page = curPage + 1, pageSize = pSize })">ถัดไป ›</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("CustomerPurchaseSummary", new { salesRep = ViewBag.SelectedSalesRep, month = ViewBag.SelectedMonth, startDate = Model.StartDate?.ToString("yyyy-MM-dd"), endDate = Model.EndDate?.ToString("yyyy-MM-dd"), credit = Model.Credit, searchCustomerCode = ViewBag.SearchCustomerCode, searchCustomerName = ViewBag.SearchCustomerName, searchProductCode = ViewBag.SearchProductCode, page = totPages, pageSize = pSize })" title="หน้าสุดท้าย">»</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

@if (Model.Rows.Any())
{
    var custCount = Model.Rows.Select(r => r.CustomerId).Distinct().Count();
    var grandTotal = Model.Rows.Sum(r => r.Amount);
    var topCust = Model.Rows.GroupBy(r => r.CustomerName)
                            .Select(g => new { Name = g.Key, Total = g.Sum(x => x.Amount) })
                            .OrderByDescending(x => x.Total).FirstOrDefault();
    <div class="insight-card no-print mt-3">
        <div class="d-flex align-items-center mb-2">
            <i class="bi bi-lightbulb-fill text-warning fs-5 me-2"></i>
            <span class="fw-bold" style="color:#065f46; font-size:1.1rem;">สรุปข้อมูลอัตโนมัติ</span>
        </div>
        <p class="mb-0 text-dark">
            พบลูกค้าทั้งหมด <b>@custCount.ToString("N0")</b> ราย ยอดเงินรวม (ดิบ) <b class="text-success fs-5">@grandTotal.ToString("N2")</b> บาท
            @if (topCust != null) {
                <text> โดยลูกค้ารายใหญ่สุดคือ <b>@topCust.Name</b> ยอด <b>@topCust.Total.ToString("N2")</b> บาท</text>
            }
            <br/><small class="text-muted">* คัดกรองสินค้าแจกฟรี (ราคา 0 บาท) ออกจากการคำนวณแล้ว</small>
        </p>
    </div>
}

@section Scripts {
<script>
(function() {
    var input = document.getElementById('customerNameInput');
    var dropdown = document.getElementById('customerNameDropdown');
    if (!input || !dropdown) return;
    var dataEl = document.getElementById('customers-data');
    var customers = [];
    try { customers = JSON.parse(dataEl.textContent); } catch(e) {}
    input.addEventListener('input', function() {
        var q = this.value.trim().toLowerCase();
        dropdown.innerHTML = '';
        if (q.length < 1) { dropdown.style.display = 'none'; return; }
        var matches = customers.filter(function(c) {
            return c.name.toLowerCase().includes(q) || c.code.toLowerCase().includes(q);
        }).slice(0, 30);
        if (matches.length === 0) { dropdown.style.display = 'none'; return; }
        matches.forEach(function(c) {
            var item = document.createElement('div');
            item.className = 'autocomplete-item';
            item.innerHTML = '<span class="text-muted small me-2">' + c.code + '</span>' + c.name;
            item.addEventListener('mousedown', function(e) {
                e.preventDefault();
                input.value = c.name;
                dropdown.style.display = 'none';
            });
            dropdown.appendChild(item);
        });
        dropdown.style.display = 'block';
    });
    input.addEventListener('blur', function() {
        setTimeout(function() { dropdown.style.display = 'none'; }, 200);
    });
    input.addEventListener('focus', function() {
        if (input.value.trim().length > 0) input.dispatchEvent(new Event('input'));
    });
})();

function exportTableToExcel(tableID, filename) {
    filename = filename ? filename + '.xls' : 'excel_data.xls';
    var dataType = 'application/vnd.ms-excel';
    var tableHTML = document.getElementById(tableID).outerHTML.replace(/ /g, '%20');
    var a = document.createElement('a');
    document.body.appendChild(a);
    a.href = 'data:' + dataType + ', ' + tableHTML;
    a.download = filename;
    a.click();
}

function changePageSize(size) {
    const url = new URL(window.location.href);
    url.searchParams.set('pageSize', size);
    url.searchParams.set('page', '1');
    window.location.href = url.toString();
}
</script>
}

