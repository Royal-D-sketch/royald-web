@using RoyalD.Web.Services
@model RoyalD.Web.Services.CustomerPurchaseSummaryViewModel
@{
    ViewData["Title"] = "11. รายงานสรุปการซื้อสินค้าของลูกค้าแต่ละราย";
    bool isAdmin = User.IsInRole("admin");
    var canDownloadClaim = ViewContext.HttpContext.User.FindFirst("CanDownload")?.Value;
    bool isSalesRepRole = User.HasClaim(c => c.Type == "Position" && (c.Value.Contains("ผู้แทน") || c.Value.Contains("พนักงานขาย"))) && !isAdmin;
    bool canDownload = (isAdmin || canDownloadClaim == "true") && !isSalesRepRole;
}

<style>
/* Sub-Tabs Nav - Soft Mint Green Theme */
.sales-subnav {
    display: flex; gap: 10px; background: #ecfdf5; padding: 8px;
    border-radius: 14px; margin-bottom: 20px; border: 1px solid #a7f3d0; flex-wrap: wrap;
}
.sales-subnav .subnav-item {
    flex: 1; text-align: center; padding: 12px 18px; font-weight: 800;
    font-size: 1.02rem; color: #065f46; border-radius: 10px;
    text-decoration: none; transition: all .2s ease-in-out; white-space: nowrap;
}
.sales-subnav .subnav-item:hover { background: rgba(255,255,255,0.9); color: #059669; transform: translateY(-1px); }
.sales-subnav .subnav-item.active { background: #059669; color: white; box-shadow: 0 4px 15px rgba(5,150,105,0.3); }

.prod-table-wrap { overflow-x: auto; border-radius: 12px; box-shadow: 0 4px 18px rgba(0,0,0,0.06); background: white; margin-bottom: 24px; }
.prod-table { width: 100%; min-width: 950px; border-collapse: collapse; font-size: 0.94rem; }
.prod-table th { background: #1e293b !important; color: white !important; padding: 12px 14px; border: 1px solid #334155; white-space: nowrap; font-size: 0.98rem; }
.prod-table td { padding: 11px 14px; border: 1px solid #e9ecef; vertical-align: middle; }

.insight-card { background:linear-gradient(135deg,#f0fdfa 0%,#f8fafc 100%); border:1px solid #ccfbf1; border-left:5px solid #0d9488; border-radius:12px; padding:18px; box-shadow:0 2px 10px rgba(15,118,110,0.06); line-height:1.65; }

@@media print {
    .no-print, .sales-subnav, nav, .btn, .filter-card, .export-bar { display: none !important; }
    body { font-size: 9pt; background: #fff !important; }
    .prod-table-wrap { box-shadow: none !important; }
}
</style>

<!-- Sub-Tabs Navigation Header -->
<div class="sales-subnav no-print">
    <a href="/SalesReport/Summary" class="subnav-item">
        <i class="bi bi-table me-2"></i> 1. สรุปยอดขาย-ยอดเก็บเงิน
    </a>
    <a href="/SalesReport/Charts" class="subnav-item">
        <i class="bi bi-bar-chart-line me-2"></i> 2. กราฟผลงานรายผู้แทน
    </a>
    <a href="/SalesReport/ProductDetails" class="subnav-item">
        <i class="bi bi-box-seam me-2"></i> 3. รายละเอียดสินค้าที่ขาย
    </a>
    @if (!isSalesRepRole)
    {
        <a href="/SalesReport/Compare" class="subnav-item">
            <i class="bi bi-people me-2"></i> 4. กราฟเปรียบเทียบผู้แทนขาย
        </a>
    }
    <a href="/SalesReport/CustomerPurchaseSummary" class="subnav-item active">
        <i class="bi bi-person-lines-fill me-2"></i> 5. สรุปการซื้อรายลูกค้า
    </a>
</div>

<!-- Header Title & Export Toolbar -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2 export-bar">
    <div>
        <h3 class="mb-1 fw-bold" style="color:#065f46;">
            <i class="bi bi-person-check-fill" style="color:#059669;"></i> รายงานสรุปการซื้อสินค้าของลูกค้าแต่ละราย
        </h3>
        <span class="text-muted fw-semibold">แจกแจงตามลูกค้า &gt; แยกบรรทัดตามราคาสินค้าจริง (ไม่รวมสินค้าแจกแถม)</span>
    </div>
    
    @if (canDownload)
    {
        <div class="d-flex gap-2 no-print">
            <button onclick="window.print()" class="btn btn-outline-danger btn-sm fw-bold px-3 py-2 shadow-sm" title="สั่งพิมพ์เป็นเอกสาร PDF">
                <i class="bi bi-file-earmark-pdf me-1"></i> 📥 Export PDF
            </button>
            <button onclick="exportTableToExcel('purchase-table', 'CustomerPurchaseSummary')" class="btn btn-sm fw-bold px-3 py-2 shadow-sm text-white" title="ดาวน์โหลดไฟล์ Excel" style="background:#059669; border-color:#059669;">
                <i class="bi bi-file-earmark-excel me-1"></i> 📊 Export Excel
            </button>
        </div>
    }
</div>

<!-- Filter Bar -->
<div class="card mb-4 no-print border-0 shadow-sm filter-card" style="background:#f8f9fa;">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-bold text-primary mb-1">👤 เลือกผู้แทนขาย</label>
                <select name="salesRep" class="form-select form-select-sm" @(isSalesRepRole ? "disabled" : "")>
                    @if(!isSalesRepRole) { <option value="">-- ผู้แทนขายทุกคน --</option> }
                    @foreach (var r in Model.SalesReps)
                    {
                        if (r == Model.SelectedSalesRep) { <option value="@r" selected>@r</option> }
                        else { <option value="@r">@r</option> }
                    }
                </select>
                @if(isSalesRepRole) { <input type="hidden" name="salesRep" value="@Model.SelectedSalesRep" /> }
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-primary mb-1">📅 เลือกเดือน</label>
                <select name="month" class="form-select form-select-sm">
                    <option value="">-- ทุกเดือน --</option>
                    @for (int mi = 0; mi < Model.MonthKeys.Count; mi++)
                    {
                        var mk = Model.MonthKeys[mi];
                        var ml = Model.Months[mi];
                        if (mk == Model.SelectedMonth) { <option value="@mk" selected>@ml</option> }
                        else { <option value="@mk">@ml</option> }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold">
                    <i class="bi bi-filter"></i> กรองข้อมูล
                </button>
            </div>
            <div class="col-md-2">
                <a href="/SalesReport/CustomerPurchaseSummary" class="btn btn-outline-secondary btn-sm w-100">
                    <i class="bi bi-x-circle"></i> ล้างตัวกรอง
                </a>
            </div>
        </form>
    </div>
</div>

<div class="prod-table-wrap">
    <table class="table prod-table mb-0" id="purchase-table">
        <thead>
            <tr>
                <th style="width:120px;">รหัสลูกค้า</th>
                <th style="min-width:200px;">ชื่อลูกค้า</th>
                <th style="width:120px;">รหัสสินค้า</th>
                <th style="min-width:180px;">ชื่อสินค้า</th>
                <th style="width:140px;" class="text-end">จำนวนที่ซื้อ (หน่วย)</th>
                <th style="width:120px;" class="text-end">ราคา/หน่วย</th>
                <th style="width:150px;" class="text-end">จำนวนเงินรวม</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Rows.Any())
            {
                <tr>
                    <td colspan="7" class="text-center py-4 text-muted">ไม่พบข้อมูล หรือไม่มีรายการที่เข้าเงื่อนไข</td>
                </tr>
            }
            else
            {
                string lastCustomerId = "";
                decimal totalGrandAmount = 0;
                
                foreach (var row in Model.Rows)
                {
                    totalGrandAmount += row.Amount;
                    bool isNewCustomer = (row.CustomerId != lastCustomerId);
                    
                    <tr>
                        <td class="@(isNewCustomer ? "fw-bold text-primary" : "text-muted")" style="@(isNewCustomer ? "" : "border-top:none;")">
                            @(isNewCustomer ? row.CustomerId : "")
                        </td>
                        <td class="@(isNewCustomer ? "fw-bold text-dark" : "text-muted")" style="@(isNewCustomer ? "" : "border-top:none;")">
                            @(isNewCustomer ? row.CustomerName : "")
                        </td>
                        <td class="text-secondary">@row.ProductCode</td>
                        <td class="fw-semibold text-dark">@row.ProductName</td>
                        <td class="text-end fw-bold text-info">@row.Quantity.ToString("N0") <small class="text-muted fw-normal">@row.Unit</small></td>
                        <td class="text-end">@row.UnitPrice.ToString("N2")</td>
                        <td class="text-end fw-bold text-success">@row.Amount.ToString("N2")</td>
                    </tr>
                    
                    lastCustomerId = row.CustomerId;
                }
                
                <tr class="table-light fw-bold" style="border-top:2px solid #334155;">
                    <td colspan="6" class="text-end fs-6">รวมจำนวนเงินดิบทั้งสิ้น (ก่อนหักลด/ไม่รวม VAT):</td>
                    <td class="text-end text-success fs-5">@totalGrandAmount.ToString("N2")</td>
                </tr>
            }
        </tbody>
    }
    </table>
</div>

<!-- Executive Summary Box -->
@if (Model.Rows.Any())
{
    var custCount = Model.Rows.Select(r => r.CustomerId).Distinct().Count();
    var grandTotal = Model.Rows.Sum(r => r.Amount);
    var topCust = Model.Rows.GroupBy(r => r.CustomerName)
                            .Select(g => new { Name = g.Key, Total = g.Sum(x => x.Amount) })
                            .OrderByDescending(x => x.Total).FirstOrDefault();
                            
    <div class="insight-card no-print mt-3">
        <div class="d-flex align-items-center mb-2">
            <i class="bi bi-lightbulb-fill text-warning fs-5 me-2"></i> 
            <span class="fw-bold" style="color:#065f46; font-size:1.1rem;">สรุปข้อมูลอัตโนมัติ (Executive Summary)</span>
        </div>
        <p class="mb-0 text-dark">
            จากเงื่อนไขที่เลือก พบว่ามีลูกค้าที่มีการสั่งซื้อจริงทั้งหมด <b>@custCount.ToString("N0")</b> ราย 
            สร้างยอดเงินรวม (ดิบ) ทั้งสิ้น <b class="text-success fs-5">@grandTotal.ToString("N2")</b> บาท 
            @if(topCust != null) {
                <text>โดยลูกค้ารายใหญ่ที่สุดคือ <b>@topCust.Name</b> มียอดสั่งซื้อรวม <b>@topCust.Total.ToString("N2")</b> บาท</text>
            }
            <br/><small class="text-muted">* หมายเหตุ: ระบบได้ทำการแยกบรรทัดรายการสินค้าอัตโนมัติหากพบว่ามีราคาต่อหน่วยต่างกัน และทำการคัดกรองสินค้าแจกฟรี/ชดเชย (ราคา 0 บาท) ออกจากการคำนวณทั้งหมดแล้ว เพื่อให้การประมวลผลยอดเงินมีความแม่นยำสูงสุด</small>
        </p>
    </div>
}

@section Scripts {
<script>
function exportTableToExcel(tableID, filename = ''){
    var downloadLink;
    var dataType = 'application/vnd.ms-excel';
    var tableSelect = document.getElementById(tableID);
    // Clone table to remove non-printable elements if needed, but here simple outerHTML is fine
    var tableHTML = tableSelect.outerHTML.replace(/ /g, '%20');
    
    filename = filename?filename+'.xls':'excel_data.xls';
    
    downloadLink = document.createElement("a");
    document.body.appendChild(downloadLink);
    
    if(navigator.msSaveOrOpenBlob){
        var blob = new Blob(['\ufeff', tableHTML], {
            type: dataType
        });
        navigator.msSaveOrOpenBlob( blob, filename);
    }else{
        downloadLink.href = 'data:' + dataType + ', ' + tableHTML;
        downloadLink.download = filename;
        downloadLink.click();
    }
}
</script>
}
