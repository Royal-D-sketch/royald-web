@using RoyalD.Web.Services
@model RoyalD.Web.Services.AnnualPerformanceViewModel
@{
    ViewData["Title"] = "1. รายงานสรุปประสิทธิภาพยอดขายผู้แทน";
    var months = Model.Months;
    var allReps = Model.RepReports;
    var overall = Model.OverallCompany;
    bool isAdmin = User.IsInRole("admin");
    var canDownloadClaim = ViewContext.HttpContext.User.FindFirst("CanDownload")?.Value;
    bool isSalesRepRole = User.HasClaim(c => c.Type == "Position" && (c.Value.Contains("ผู้แทน") || c.Value.Contains("พนักงานขาย"))) && !isAdmin;
    bool canDownload = (isAdmin || canDownloadClaim == "true") && !isSalesRepRole;
}

<style>
/* Sub-Tabs Nav */
.sales-subnav { display:flex; gap:10px; background:#ecfdf5; padding:8px; border-radius:14px; margin-bottom:20px; border:1px solid #a7f3d0; flex-wrap:wrap; }
.sales-subnav .subnav-item { flex:1; text-align:center; padding:12px 18px; font-weight:800; font-size:1.02rem; color:#065f46; border-radius:10px; text-decoration:none; transition:all .2s ease-in-out; white-space:nowrap; }
.sales-subnav .subnav-item:hover { background:rgba(255,255,255,0.9); color:#059669; transform:translateY(-1px); }
.sales-subnav .subnav-item.active { background:#059669; color:white; box-shadow:0 4px 15px rgba(5,150,105,0.3); }
/* Matrix Table */
.matrix-scroll-wrap { overflow-x:auto; -webkit-overflow-scrolling:touch; border-radius:12px; box-shadow:0 4px 18px rgba(0,0,0,0.06); background:white; margin-bottom:24px; }
.matrix-table { width:100%; border-collapse:collapse; font-size:0.93rem; }
.matrix-table th { background:#1e293b !important; color:white !important; padding:12px 14px; border:1px solid #334155; white-space:nowrap; font-size:0.98rem; }
.rep-row-header { background:linear-gradient(135deg,#f0fdf4,#ecfdf5); font-weight:800; color:#065f46; font-size:1.02rem; }
/* KPI row colors */
.val-bf { color:#0891b2; font-weight:700; }
.val-sales { color:#0369a1; font-weight:700; }
.val-resp { color:#6366f1; font-weight:800; background-color:#f8fafc; }
.val-collected { color:#059669; font-weight:700; }
.val-debt { color:#e11d48; font-weight:700; }
/* Percentage badge */
.pct-badge { display:inline-block; padding:4px 10px; border-radius:8px; font-weight:800; font-size:0.95rem; }
.pct-good { background:#dcfce7; color:#166534; }
.pct-mid { background:#fef9c3; color:#854d0e; }
.pct-bad { background:#fee2e2; color:#991b1b; }
/* Overdue tag */
.overdue-tag { display:inline-block; background:#fee2e2; color:#b91c1c; font-size:0.72rem; font-weight:700; padding:2px 7px; border-radius:6px; border:1px solid #fca5a5; margin-top:2px; }
/* Chart Card */
.chart-card { border-radius:14px; border:none; box-shadow:0 4px 18px rgba(0,0,0,0.08); background:white; padding:22px; }
/* Insight */
.insight-card { background:linear-gradient(135deg,#f0fdfa 0%,#f8fafc 100%); border:1px solid #ccfbf1; border-left:5px solid #0d9488; border-radius:12px; padding:14px 18px; box-shadow:0 2px 10px rgba(15,118,110,0.06); line-height:1.65; }
@@media print {
    .no-print, .sales-subnav, nav, .btn, .export-bar { display:none !important; }
    body { font-size:10pt; background:#fff !important; }
    .matrix-scroll-wrap { overflow:visible !important; }
    .signature-area { break-inside:avoid; margin-top:30px; }
}

/* Cycle Buttons */
.cycle-btn-active { background:#0284c7 !important; color:#ffffff !important; border-color:#0284c7 !important; box-shadow:0 2px 8px rgba(2,132,199,0.2) !important; font-weight:700 !important; }
.cycle-btn-inactive { background:#ffffff !important; color:#475569 !important; border-color:#cbd5e1 !important; font-weight:600 !important; }
.cycle-btn-inactive:hover { background:#f8fafc !important; color:#0284c7 !important; }

</style>

<!-- Sub-Tabs Navigation -->
<div class="sales-subnav no-print">
    <a href="/SalesReport/Summary" class="subnav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Summary" || ViewContext.RouteData.Values["action"]?.ToString() == "Sales" ? "active" : "")">
        <i class="bi bi-table me-2"></i> 1. สรุปยอดขาย
    </a>
    <a href="/SalesReport/Charts" class="subnav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Charts" ? "active" : "")">
        <i class="bi bi-bar-chart-line me-2"></i> 2. กราฟ
    </a>
    <a href="/SalesReport/ProductDetails" class="subnav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "ProductDetails" ? "active" : "")">
        <i class="bi bi-box-seam me-2"></i> 3. สินค้าขาย (ปริมาณ)
    </a>
    <a href="/SalesReport/ProductDetailsAmount" class="subnav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "ProductDetailsAmount" ? "active" : "")">
        <i class="bi bi-currency-dollar me-2"></i> 4. สินค้าขาย (จำนวนเงิน)
    </a>
    @if (!isSalesRepRole)
    {
        <a href="/SalesReport/Compare" class="subnav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Compare" ? "active" : "")">
            <i class="bi bi-people me-2"></i> 5. เปรียบเทียบ
        </a>
    }
</div>

<!-- Header & Export -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2 export-bar">
    <div>
        <h3 class="mb-1 fw-bold" style="color:#065f46;">
            <i class="bi bi-table" style="color:#059669;"></i> Pivot Matrix — ยอดยกมา / ยอดขาย / รวมฐานหนี้ / ยอดเก็บ / หนี้ค้าง รายผู้แทน × รายเดือน
        </h3>
        <span class="text-muted fw-semibold">คำนวณตามมาตรฐานบัญชีลูกหนี้ (ยอดยกมา + ยอดขายใหม่ = ฐานหนี้ที่ต้องติดตาม) วัดผล KPI รายผู้แทนอย่างเป็นธรรม</span>
    </div>
    @if (canDownload)
    {
        <div class="d-flex gap-2 no-print flex-wrap">
            <button type="button" class="btn btn-sm fw-bold px-3 py-2 shadow-sm text-white" onclick="openSummaryAiModal()" style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); border:none; border-radius:10px;">
                <i class="bi bi-robot me-1"></i> ข้อมูลสำหรับ AI ทำสไลด์
            </button>
            <a href="/SalesReport/ExportSummaryExcel" class="btn btn-sm fw-bold px-3 py-2 shadow-sm text-white" style="background:#059669; border-radius:10px;">
                <i class="bi bi-file-earmark-excel me-1"></i> Export Excel
            </a>
            <button type="button" onclick="window.print()" class="btn btn-outline-danger btn-sm fw-bold px-3 py-2 shadow-sm bg-white" style="border-radius:10px;">
                <i class="bi bi-file-earmark-pdf me-1"></i> Export PDF
            </button>
            <button type="button" onclick="downloadScreenCapture('capture-area')" class="btn btn-outline-success btn-sm fw-bold px-3 py-2 shadow-sm bg-white" style="border-radius:10px;">
                <i class="bi bi-image me-1"></i> Download PNG
            </button>
        </div>
    }
</div>

<!-- Rep Selector -->
<div class="card border-0 shadow-sm mb-3 no-print" style="background:#f0fdf4; border:1.5px solid #a7f3d0 !important; border-radius:14px;">
    <div class="card-body py-2 px-3">
        <div class="row align-items-center g-2">
            <div class="col-md-auto">
                <span class="fw-bold" style="color:#065f46; font-size:0.95rem;">
                    <i class="bi bi-person-badge-fill me-1 text-success"></i> เลือกผู้แทนขาย:
                </span>
            </div>
            <div class="col-md-4 col-lg-3">
                <select class="form-select form-select-sm fw-bold shadow-sm" id="repSelectDropdown" onchange="selectRep(this.value)" style="border:2px solid #10b981; border-radius:10px; color:#065f46;">
                    <option value="overall" selected>🏢 ภาพรวมทุกคน (รวมทั้งบริษัท)</option>
                    @for (int ri = 0; ri < allReps.Count; ri++)
                    {
                        <option value="@ri">👤 @allReps[ri].SalesRep</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <input type="text" class="form-control form-control-sm border-success" id="repQuickSearch" placeholder="พิมพ์ชื่อผู้แทนเพื่อค้นหา..." oninput="filterRepByName(this.value)" />
            </div>
            <div class="col-md-auto d-flex gap-1">
                <button class="btn btn-sm btn-outline-success fw-semibold" onclick="selectPrevRep()" style="border-radius:8px;"><i class="bi bi-chevron-left"></i> ก่อนหน้า</button>
                <button class="btn btn-sm btn-outline-success fw-semibold" onclick="selectNextRep()" style="border-radius:8px;">ถัดไป <i class="bi bi-chevron-right"></i></button>
            </div>
                        
            <div class="col-md-auto d-flex align-items-center gap-1">
                <span class="fw-bold small text-muted me-1">รอบ:</span>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn cycle-btn-active" id="btn-sum-25" onclick="setSummaryCycle('sales25')">
                        <i class="bi bi-lightning-charge-fill me-1"></i> ตัดยอด 25
                    </button>
                    <button type="button" class="btn cycle-btn-inactive" id="btn-sum-cal" onclick="setSummaryCycle('calendar')">
                        <i class="bi bi-calendar-event me-1"></i> สิ้นเดือนปฏิทิน
                    </button>
                </div>
            </div>

            <div class="col-md-auto d-flex flex-wrap gap-1 align-items-center">
                <span class="fw-bold small text-muted me-1">ทีม:</span>
                <div class="btn-group btn-group-sm" role="group">
                    <button type="button" class="btn btn-outline-success fw-bold" onclick="selectRep('overall')">ทั้งหมด</button>
                    <button type="button" class="btn btn-outline-primary fw-bold" onclick="filterSummaryByTeam('sunya')">👥 ทีมสัญญา</button>
                    <button type="button" class="btn btn-outline-success fw-bold" onclick="filterSummaryByTeam('weeranut')">👥 ทีมวีรนุช</button>
                    <button type="button" class="btn btn-outline-warning text-dark fw-bold" onclick="filterSummaryByTeam('nampetch')">👥 ทีมน้ำเพชร</button>
                </div>
            </div>
            <div class="col-md text-end">
                <span class="badge shadow-sm" style="background:#d1fae5; color:#065f46; font-size:0.85rem; padding:6px 12px; border-radius:10px; border:1px solid #a7f3d0;">
                    <i class="bi bi-people-fill me-1"></i> ผู้แทนทั้งหมด: <strong>@allReps.Count</strong> ท่าน
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Capture area -->
<div id="capture-area">
    <!-- Overall Panel -->
    <div id="panel-overall" class="rep-panel">
        <div id="panel-overall-25" class="cycle-panel-25">
            @{ RenderRepMatrix(overall, "overall-25", true); }
        </div>
        <div id="panel-overall-cal" class="cycle-panel-cal" style="display:none;">
            @{ RenderRepMatrix(overall, "overall-cal", false); }
        </div>
    </div>
    @for (int ri = 0; ri < allReps.Count; ri++)
    {
        <div id="panel-@ri" class="rep-panel" style="display:none;">
            <div id="panel-@ri-25" class="cycle-panel-25">
                @{ RenderRepMatrix(allReps[ri], ri.ToString() + "-25", true); }
            </div>
            <div id="panel-@ri-cal" class="cycle-panel-cal" style="display:none;">
                @{ RenderRepMatrix(allReps[ri], ri.ToString() + "-cal", false); }
            </div>
        </div>
    }
</div>

<!-- Signature -->
<div class="card shadow-sm border-0 mb-3 no-print" style="background:#f8f9fa;">
    <div class="card-body py-2">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="toggle-sig" checked onchange="toggleSignatures()">
            <label class="form-check-label small fw-bold" for="toggle-sig">แสดงช่องลงนาม 4 ฝ่าย</label>
        </div>
    </div>
</div>
<div class="signature-area" id="signature-block">
    <div class="row text-center mt-3 pt-3" style="border-top:1.5px dashed #ccc;">
        <div class="col-3">
            <div style="border-bottom:1px solid #333; margin:45px 15px 6px;">&nbsp;</div>
            <p class="mb-0 fw-bold">(ผู้รายงาน)</p>
            <small class="text-muted">วันที่ ...... / ...... / ..........</small>
        </div>
        <div class="col-3">
            <div style="border-bottom:1px solid #333; margin:45px 15px 6px;">&nbsp;</div>
            <p class="mb-0 fw-bold">(ผู้ตรวจสอบ)</p>
            <small class="text-muted">วันที่ ...... / ...... / ..........</small>
        </div>
        <div class="col-3">
            <div style="border-bottom:1px solid #333; margin:45px 15px 6px;">&nbsp;</div>
            <p class="mb-0 fw-bold">(ผู้มีอำนาจลงนาม)</p>
            <small class="text-muted">วันที่ ...... / ...... / ..........</small>
        </div>
        <div class="col-3">
            <div style="border-bottom:1px solid #333; margin:45px 15px 6px;">&nbsp;</div>
            <p class="mb-0 fw-bold">(ผู้แทนขาย)</p>
            <small class="text-muted">วันที่ ...... / ...... / ..........</small>
        </div>
    </div>
</div>

@functions {
    void RenderRepMatrix(SalesRepMonthlyReport data, string key, bool is25 = true)
    {
        var mList = is25 ? data.MonthlyData25 : data.MonthlyData;
        var initBf = is25 ? data.InitialBroughtForward25 : data.InitialBroughtForward;
        var totSales = is25 ? data.TotalSales25 : data.TotalSales;
        var totResp = is25 ? data.TotalResponsible25 : data.TotalResponsible;
        var totCol = is25 ? data.TotalCollected25 : data.TotalCollected;
        var totDebt = is25 ? data.TotalOutstanding25 : data.TotalOutstanding;
        var totRate = is25 ? data.OverallCollectionRateOnBase25 : data.OverallCollectionRateOnBase;
        var overdue120 = is25 ? data.TotalOverdue120_25 : data.TotalOverdue120;
        string cycleTitle = is25 ? "รอบฝ่ายขาย (ตัดยอดทุกวันที่ 25)" : "รอบสิ้นเดือนปฏิทิน (1 - 30/31)";

        <div class="card border-0 mb-3" style="background:linear-gradient(135deg, #1d4ed8 0%, #2563eb 50%, #3b82f6 100%); color:white; border-radius:14px; padding:18px 22px; box-shadow:0 4px 18px rgba(37,99,235,.25);">
            <div class="d-flex justify-content-between align-items-center">
                <div class="fw-bold" style="font-size:1.15rem; opacity:.95; margin-bottom:4px;">
                    <i class="bi bi-journal-bookmark-fill me-2 text-warning"></i>@data.SalesRep
                </div>
                <span class="badge bg-white text-primary px-3 py-1 fw-bold">@cycleTitle</span>
            </div>
            <div class="small" style="opacity:.9;">สรุปยอดขายและการเก็บเงิน ไทม์ไลน์ @(Model.Months.Count) เดือน ปี 2569 (รวมยอดยกมาจากปีก่อนหน้าและการยกยอดรายเดือน)</div>
        </div>
        
        <div class="matrix-scroll-wrap mb-4">
            <table class="matrix-table" id="tbl-@key">
                <thead>
                    <tr>
                        <th style="min-width:210px;">รายการ</th>
                        @foreach (var m in Model.Months) { <th class="text-end" style="min-width:120px;">@m</th> }
                        <th class="text-end" style="min-width:140px; background:#334155 !important;">รวมตลอดปี (YTD)</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Row 1: Brought Forward (ลูกหนี้ยกมา) -->
                    <tr id="rowBF-@key">
                        <td class="rep-row-header" style="background:#f0f9ff; color:#0369a1;"><i class="bi bi-clock-history text-info me-1"></i> 1. ลูกหนี้ยกมาต้นงวด (บาท)</td>
                        @foreach (var m in mList)
                        {
                            <td class="text-end val-bf">@m.BroughtForward.ToString("N0")</td>
                        }
                        <td class="text-end val-bf bg-light" style="font-size:1.05rem;" title="ยอดยกมาเริ่มต้นปี 2569">@initBf.ToString("N0")</td>
                    </tr>
                    <!-- Row 2: Sales (ยอดขายระหว่างเดือน) -->
                    <tr id="rowSales-@key">
                        <td class="rep-row-header"><i class="bi bi-bag-fill text-primary me-1"></i> 2. ยอดขายระหว่างเดือน (บาท)</td>
                        @foreach (var m in mList)
                        {
                            <td class="text-end val-sales">@m.TotalSales.ToString("N0")</td>
                        }
                        <td class="text-end val-sales bg-light" style="font-size:1.15rem;">@totSales.ToString("N0")</td>
                    </tr>
                    <!-- Row 3: Total Responsible (รวมฐานหนี้ที่ต้องรับผิดชอบ = ยกมา + ขายใหม่) -->
                    <tr id="rowResp-@key" style="border-top:1.5px solid #cbd5e1; border-bottom:1.5px solid #cbd5e1;">
                        <td class="rep-row-header" style="background:#f8fafc; color:#312e81; font-weight:800;"><i class="bi bi-stack text-indigo me-1"></i> 3. รวมฐานหนี้ที่ต้องติดตาม (1+2)</td>
                        @foreach (var m in mList)
                        {
                            <td class="text-end val-resp">@m.TotalResponsible.ToString("N0")</td>
                        }
                        <td class="text-end val-resp" style="font-size:1.15rem; background:#ede9fe; color:#4338ca;">@totResp.ToString("N0")</td>
                    </tr>
                    <!-- Row 4: Collected (ยอดเก็บได้) -->
                    <tr id="rowCollected-@key">
                        <td class="rep-row-header"><i class="bi bi-cash-coin text-success me-1"></i> 4. ยอดเก็บเงินได้ (บาท)</td>
                        @foreach (var m in mList)
                        {
                            <td class="text-end val-collected">@m.TotalCollected.ToString("N0")</td>
                        }
                        <td class="text-end val-collected bg-light" style="font-size:1.15rem;">@totCol.ToString("N0")</td>
                    </tr>
                    <!-- Row 5: Debt Outstanding (หนี้คงค้างปลายงวด) -->
                    <tr id="rowDebt-@key">
                        <td class="rep-row-header"><i class="bi bi-exclamation-octagon text-danger me-1"></i> 5. หนี้คงค้างปลายงวด (3-4)</td>
                        @foreach (var m in mList)
                        {
                            <td class="text-end val-debt">@m.Outstanding.ToString("N0")</td>
                        }
                        <td class="text-end val-debt bg-light" style="font-size:1.15rem;" title="หนี้คงค้างสะสมล่าสุด">@totDebt.ToString("N0")</td>
                    </tr>
                    <!-- Row 6: KPI Rate on Responsible Base (% ประสิทธิภาพจัดเก็บจริง) -->
                    <tr id="rowRate-@key">
                        <td class="rep-row-header"><i class="bi bi-trophy-fill text-warning me-1"></i> 6. % ประสิทธิภาพจัดเก็บ (KPI)</td>
                        @foreach (var m in mList)
                        {
                            string bc = m.CollectionRateOnBase >= 60 ? "pct-good" : (m.CollectionRateOnBase >= 40 ? "pct-mid" : "pct-bad");
                            <td class="text-center" title="เก็บได้ @m.TotalCollected.ToString("N0") / ฐานหนี้ @m.TotalResponsible.ToString("N0")"><span class="pct-badge @bc">@m.CollectionRateOnBase%</span></td>
                        }
                        <td class="text-center bg-light">
                            @{
                                string obc = data.OverallCollectionRateOnBase >= 60 ? "pct-good" : (data.OverallCollectionRateOnBase >= 40 ? "pct-mid" : "pct-bad");
                            }
                            <span class="pct-badge @obc" style="font-size:1.05rem; padding:6px 14px;" title="รวมยอดเก็บ / รวมฐานหนี้ทั้งหมด">@totRate%</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Financial Health & Audit Summary Cards (แทนที่กราฟเดิมที่ไม่จำเป็นในหน้าตาราง) -->
        <div class="row g-3 mb-4">
            <div class="col-md-3 col-sm-6">
                <div class="p-3 bg-white rounded-3 border shadow-sm h-100" style="border-left: 4px solid #0891b2 !important;">
                    <div class="text-muted small fw-bold">1. ลูกหนี้ยกมาต้นปี 2569</div>
                    <div class="fs-4 fw-black my-1" style="color:#0891b2;">@initBf.ToString("N0")</div>
                    <div class="text-muted small">หนี้ค้างเก่าก่อน 01/01/2569</div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="p-3 bg-white rounded-3 border shadow-sm h-100" style="border-left: 4px solid #0284c7 !important;">
                    <div class="text-muted small fw-bold">2. ยอดขายสะสมปี 2569 (YTD)</div>
                    <div class="fs-4 fw-black my-1" style="color:#0284c7;">@totSales.ToString("N0")</div>
                    <div class="text-muted small">บิลขายใหม่ระหว่างงวด</div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="p-3 bg-white rounded-3 border shadow-sm h-100" style="border-left: 4px solid #059669 !important;">
                    <div class="text-muted small fw-bold">3. ยอดเก็บเงินได้สำเร็จ</div>
                    <div class="fs-4 fw-black my-1" style="color:#059669;">@totCol.ToString("N0")</div>
                    <div class="text-muted small">ประสิทธิภาพเก็บจริง: <span class="fw-bold text-success">@totRate%</span></div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="p-3 bg-white rounded-3 border shadow-sm h-100" style="border-left: 4px solid #e11d48 !important;">
                    <div class="text-muted small fw-bold">4. หนี้คงค้างสะสมล่าสุด</div>
                    <div class="fs-4 fw-black my-1" style="color:#e11d48;">@totDebt.ToString("N0")</div>
                    <div class="text-muted small">หนี้ค้างเกิน 120 วัน: <span class="fw-bold @(data.TotalOverdue120 > 0 ? "text-danger" : "text-success")">@overdue120 บิล</span></div>
                </div>
            </div>
        </div>

        <!-- กล่องบันทึกการตรวจสอบบัญชีลูกหนี้ (Audit Summary Note) -->
        <div class="p-3 rounded-3 mb-4 border shadow-sm" style="background:linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%); border-color:#a7f3d0 !important;">
            <div class="d-flex align-items-center mb-1">
                <i class="bi bi-shield-check text-success fs-5 me-2"></i>
                <span class="fw-bold" style="color:#065f46; font-size:0.95rem;">บันทึกการตรวจสอบและการติดตามลูกหนี้ — @data.SalesRep</span>
            </div>
            <div class="small" style="color:#047857; line-height:1.6;">
                • รวมฐานหนี้ทั้งหมดที่ต้องรับผิดชอบ: <b>@totResp.ToString("N0")</b> บาท (ยกมา @initBf.ToString("N0") + ขายใหม่ @totSales.ToString("N0"))<br>
                • ยอดจัดเก็บเงินสดเข้าบัญชีเรียบร้อย: <b>@totCol.ToString("N0")</b> บาท (@totRate% ของฐานหนี้) | คงเหลือหนี้ค้างยกไป: <b>@totDebt.ToString("N0")</b> บาท<br>
                • คำแนะนำฝ่ายบัญชี: @(data.TotalOutstanding > 0 ? "ให้ผู้แทนขายเร่งรัดติดตามการชำระเงินตามรอบบิลขาย และส่งใบเสร็จ/สลิปโอนให้ฝ่ายบัญชีตัดยอดทันที" : "สถานะหนี้เรียบร้อย ไม่มีหนี้ค้างสะสม")
            </div>
        </div>
    }
}


