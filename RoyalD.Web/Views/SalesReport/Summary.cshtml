@using RoyalD.Web.Services
@model RoyalD.Web.Services.AnnualPerformanceViewModel
@{
    ViewData["Title"] = "1. รายงานสรุปประสิทธิภาพยอดขายผู้แทน";
    var months = Model.Months;
    var allReps = Model.RepReports;
    var overall = Model.OverallCompany;
    bool isAdmin = User.IsInRole("admin");
    var canDownloadClaim = ViewContext.HttpContext.User.FindFirst("CanDownload")?.Value;
    bool isSalesRepRole = User.HasClaim(c => c.Type == "Position" && (c.Value.Contains("ผู้แทน") || c.Value.Contains("พนักงานขาย"))) && !isAdmin;
    bool canDownload = (isAdmin || canDownloadClaim == "true") && !isSalesRepRole;
}

<style>
/* Sub-Tabs Nav */
.sales-subnav { display:flex; gap:10px; background:#ecfdf5; padding:8px; border-radius:14px; margin-bottom:20px; border:1px solid #a7f3d0; flex-wrap:wrap; }
.sales-subnav .subnav-item { flex:1; text-align:center; padding:12px 18px; font-weight:800; font-size:1.02rem; color:#065f46; border-radius:10px; text-decoration:none; transition:all .2s ease-in-out; white-space:nowrap; }
.sales-subnav .subnav-item:hover { background:rgba(255,255,255,0.9); color:#059669; transform:translateY(-1px); }
.sales-subnav .subnav-item.active { background:#059669; color:white; box-shadow:0 4px 15px rgba(5,150,105,0.3); }
/* Matrix Table */
.matrix-scroll-wrap { overflow-x:auto; -webkit-overflow-scrolling:touch; border-radius:12px; box-shadow:0 4px 18px rgba(0,0,0,0.06); background:white; margin-bottom:24px; }
.matrix-table { width:100%; border-collapse:collapse; font-size:0.93rem; }
.matrix-table th { background:#1e293b !important; color:white !important; padding:12px 14px; border:1px solid #334155; white-space:nowrap; font-size:0.98rem; }
.matrix-table td { padding:10px 14px; border:1px solid #e9ecef; vertical-align:middle; }
.rep-row-header { background:linear-gradient(135deg,#f0fdf4,#ecfdf5); font-weight:800; color:#065f46; font-size:1.02rem; }
/* KPI row colors */
.val-sales { color:#0369a1; font-weight:700; }
.val-collected { color:#059669; font-weight:700; }
.val-debt { color:#e11d48; font-weight:700; }
/* Percentage badge */
.pct-badge { display:inline-block; padding:4px 10px; border-radius:8px; font-weight:800; font-size:0.95rem; }
.pct-good { background:#dcfce7; color:#166534; }
.pct-mid { background:#fef9c3; color:#854d0e; }
.pct-bad { background:#fee2e2; color:#991b1b; }
/* Overdue tag */
.overdue-tag { display:inline-block; background:#fee2e2; color:#b91c1c; font-size:0.72rem; font-weight:700; padding:2px 7px; border-radius:6px; border:1px solid #fca5a5; margin-top:2px; }
/* Chart Card */
.chart-card { border-radius:14px; border:none; box-shadow:0 4px 18px rgba(0,0,0,0.08); background:white; padding:22px; }
/* Insight */
.insight-card { background:linear-gradient(135deg,#f0fdfa 0%,#f8fafc 100%); border:1px solid #ccfbf1; border-left:5px solid #0d9488; border-radius:12px; padding:14px 18px; box-shadow:0 2px 10px rgba(15,118,110,0.06); line-height:1.65; }
@@media print {
    .no-print, .sales-subnav, nav, .btn, .export-bar { display:none !important; }
    body { font-size:10pt; background:#fff !important; }
    .matrix-scroll-wrap { overflow:visible !important; }
    .signature-area { break-inside:avoid; margin-top:30px; }
}
</style>

<!-- Sub-Tabs Navigation -->
<div class="sales-subnav no-print">
    <a href="/SalesReport/Summary" class="subnav-item active">
        <i class="bi bi-table me-2"></i> 1. สรุปยอดขาย-ยอดเก็บเงิน (Pivot Matrix)
    </a>
    <a href="/SalesReport/Charts" class="subnav-item">
        <i class="bi bi-bar-chart-line me-2"></i> 2. กราฟผลงานรายผู้แทน (Charts)
    </a>
    <a href="/SalesReport/ProductDetails" class="subnav-item">
        <i class="bi bi-box-seam me-2"></i> 3. รายละเอียดสินค้าที่ขาย (Product Details)
    </a>
    @if (!isSalesRepRole)
    {
        <a href="/SalesReport/Compare" class="subnav-item">
            <i class="bi bi-people me-2"></i> 4. กราฟเปรียบเทียบผู้แทนขาย
        </a>
    }
    <a href="/SalesReport/CustomerPurchaseSummary" class="subnav-item">
        <i class="bi bi-person-lines-fill me-2"></i> 5. สรุปการซื้อรายลูกค้า
    </a>
</div>

<!-- Header & Export -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2 export-bar">
    <div>
        <h3 class="mb-1 fw-bold" style="color:#065f46;">
            <i class="bi bi-table" style="color:#059669;"></i> Pivot Matrix — ยอดขาย / ยอดเก็บ / หนี้ค้าง รายผู้แทน × รายเดือน
        </h3>
        <span class="text-muted fw-semibold">กรองดูผู้แทนรายบุคคล หรือภาพรวมทั้งบริษัท พร้อมตัวชี้วัด % ประสิทธิภาพ</span>
    </div>
    @if (canDownload)
    {
        <div class="d-flex gap-2 no-print">
            <button onclick="window.print()" class="btn btn-outline-danger btn-sm fw-bold px-3 py-2 shadow-sm">
                <i class="bi bi-file-earmark-pdf me-1"></i> Export PDF
            </button>
            <a href="/SalesReport/ExportSummaryExcel" class="btn btn-sm fw-bold px-3 py-2 shadow-sm text-white" style="background:#059669;">
                <i class="bi bi-file-earmark-excel me-1"></i> Export Excel
            </a>
            <button onclick="downloadScreenCapture('capture-area')" class="btn btn-outline-success btn-sm fw-bold px-3 py-2 shadow-sm">
                <i class="bi bi-image me-1"></i> Download PNG
            </button>
        </div>
    }
</div>

<!-- Rep Selector -->
<div class="card border-0 shadow-sm mb-3 no-print" style="background:#f0fdf4; border:1.5px solid #a7f3d0 !important; border-radius:14px;">
    <div class="card-body py-2 px-3">
        <div class="row align-items-center g-2">
            <div class="col-md-auto">
                <span class="fw-bold" style="color:#065f46; font-size:0.95rem;">
                    <i class="bi bi-person-badge-fill me-1 text-success"></i> เลือกผู้แทนขาย:
                </span>
            </div>
            <div class="col-md-4 col-lg-3">
                <select class="form-select form-select-sm fw-bold shadow-sm" id="repSelectDropdown" onchange="selectRep(this.value)" style="border:2px solid #10b981; border-radius:10px; color:#065f46;">
                    <option value="overall" selected>🏢 ภาพรวมทุกคน (รวมทั้งบริษัท)</option>
                    @for (int ri = 0; ri < allReps.Count; ri++)
                    {
                        <option value="@ri">👤 @allReps[ri].SalesRep</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <input type="text" class="form-control form-control-sm border-success" id="repQuickSearch" placeholder="พิมพ์ชื่อผู้แทนเพื่อค้นหา..." oninput="filterRepByName(this.value)" />
            </div>
            <div class="col-md-auto d-flex gap-1">
                <button class="btn btn-sm btn-outline-success fw-semibold" onclick="selectPrevRep()" style="border-radius:8px;"><i class="bi bi-chevron-left"></i> ก่อนหน้า</button>
                <button class="btn btn-sm btn-outline-success fw-semibold" onclick="selectNextRep()" style="border-radius:8px;">ถัดไป <i class="bi bi-chevron-right"></i></button>
            </div>
            <div class="col-md text-end">
                <span class="badge shadow-sm" style="background:#d1fae5; color:#065f46; font-size:0.85rem; padding:6px 12px; border-radius:10px; border:1px solid #a7f3d0;">
                    <i class="bi bi-people-fill me-1"></i> ผู้แทนทั้งหมด: <strong>@allReps.Count</strong> ท่าน
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Capture area -->
<div id="capture-area">
    <!-- Overall Panel -->
    <div id="panel-overall" class="rep-panel">
        @{ RenderRepMatrix(overall, "overall"); }
    </div>
    @for (int ri = 0; ri < allReps.Count; ri++)
    {
        <div id="panel-@ri" class="rep-panel" style="display:none;">
            @{ RenderRepMatrix(allReps[ri], ri.ToString()); }
        </div>
    }
</div>

<!-- Signature -->
<div class="card shadow-sm border-0 mb-3 no-print" style="background:#f8f9fa;">
    <div class="card-body py-2">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="toggle-sig" checked onchange="toggleSignatures()">
            <label class="form-check-label small fw-bold" for="toggle-sig">แสดงช่องลงนาม 4 ฝ่าย</label>
        </div>
    </div>
</div>
<div class="signature-area" id="signature-block">
    <div class="row text-center mt-3 pt-3" style="border-top:1.5px dashed #ccc;">
        <div class="col-3">
            <div style="border-bottom:1px solid #333; margin:45px 15px 6px;">&nbsp;</div>
            <p class="mb-0 fw-bold">(ผู้รายงาน)</p>
            <small class="text-muted">วันที่ ...... / ...... / ..........</small>
        </div>
        <div class="col-3">
            <div style="border-bottom:1px solid #333; margin:45px 15px 6px;">&nbsp;</div>
            <p class="mb-0 fw-bold">(ผู้ตรวจสอบ)</p>
            <small class="text-muted">วันที่ ...... / ...... / ..........</small>
        </div>
        <div class="col-3">
            <div style="border-bottom:1px solid #333; margin:45px 15px 6px;">&nbsp;</div>
            <p class="mb-0 fw-bold">(ผู้มีอำนาจลงนาม)</p>
            <small class="text-muted">วันที่ ...... / ...... / ..........</small>
        </div>
        <div class="col-3">
            <div style="border-bottom:1px solid #333; margin:45px 15px 6px;">&nbsp;</div>
            <p class="mb-0 fw-bold">(ผู้แทนขาย)</p>
            <small class="text-muted">วันที่ ...... / ...... / ..........</small>
        </div>
    </div>
</div>

@functions {
    void RenderRepMatrix(SalesRepMonthlyReport data, string key)
    {
        <div class="card border-0 mb-3" style="background:linear-gradient(135deg,#0f172a 0%,#1e3a5f 60%,#0070B9 100%); color:white; border-radius:14px; padding:18px 22px; box-shadow:0 4px 18px rgba(0,112,185,.25);">
            <div class="fw-bold" style="font-size:1.1rem; opacity:.85; margin-bottom:4px;">
                <i class="bi bi-person-badge me-2 text-warning"></i>@data.SalesRep
            </div>
            <div class="small" style="opacity:.7;">สรุปยอดขายและการเก็บเงิน ไทม์ไลน์ 8 เดือน ปี 2569</div>
        </div>
        
        <div class="matrix-scroll-wrap mb-4">
            <table class="matrix-table" id="tbl-@key">
                <thead>
                    <tr>
                        <th style="min-width:180px;">รายการ</th>
                        @foreach (var m in Model.Months) { <th class="text-end" style="min-width:120px;">@m</th> }
                        <th class="text-end" style="min-width:130px; background:#334155 !important;">รวมทั้งหมด</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Row 1: Sales -->
                    <tr id="rowSales-@key">
                        <td class="rep-row-header"><i class="bi bi-bag-fill text-primary me-1"></i> ยอดขาย (บาท)</td>
                        @foreach (var m in data.MonthlyData)
                        {
                            <td class="text-end val-sales">@m.TotalSales.ToString("N0")</td>
                        }
                        <td class="text-end val-sales bg-light" style="font-size:1.15rem;">@data.TotalSales.ToString("N0")</td>
                    </tr>
                    <!-- Row 2: Collected -->
                    <tr id="rowCollected-@key">
                        <td class="rep-row-header"><i class="bi bi-cash-coin text-success me-1"></i> ยอดเก็บได้ (บาท)</td>
                        @foreach (var m in data.MonthlyData)
                        {
                            <td class="text-end val-collected">@m.TotalCollected.ToString("N0")</td>
                        }
                        <td class="text-end val-collected bg-light" style="font-size:1.15rem;">@data.TotalCollected.ToString("N0")</td>
                    </tr>
                    <!-- Row 3: Debt -->
                    <tr id="rowDebt-@key">
                        <td class="rep-row-header"><i class="bi bi-exclamation-octagon text-danger me-1"></i> หนี้คงค้าง (บาท)</td>
                        @foreach (var m in data.MonthlyData)
                        {
                            <td class="text-end val-debt">@m.Outstanding.ToString("N0")</td>
                        }
                        <td class="text-end val-debt bg-light" style="font-size:1.15rem;">@data.TotalOutstanding.ToString("N0")</td>
                    </tr>
                    <!-- Row 4: Rate -->
                    <tr id="rowRate-@key">
                        <td class="rep-row-header"><i class="bi bi-percent text-warning me-1"></i> % ประสิทธิภาพ</td>
                        @foreach (var m in data.MonthlyData)
                        {
                            string bc = m.CollectionRate >= 85 ? "pct-good" : (m.CollectionRate >= 50 ? "pct-mid" : "pct-bad");
                            <td class="text-center"><span class="pct-badge @bc">@m.CollectionRate%</span></td>
                        }
                        <td class="text-center bg-light">
                            @{
                                string obc = data.OverallCollectionRate >= 85 ? "pct-good" : (data.OverallCollectionRate >= 50 ? "pct-mid" : "pct-bad");
                            }
                            <span class="pct-badge @obc" style="font-size:1.05rem; padding:6px 14px;">@data.OverallCollectionRate%</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Charts -->
        <div class="row g-3 mb-4">
            <div class="col-md-7">
                <div class="chart-card">
                    <div class="fw-bold mb-2" style="color:#1a1a2e; font-size:1.02rem;">
                        <i class="bi bi-bar-chart-fill text-primary"></i> กราฟแท่ง ยอดขาย vs ยอดเก็บ vs หนี้ค้าง
                    </div>
                    <canvas id="barChart-@key" height="130"></canvas>
                    <div class="insight-card mt-3" id="insight-@key"></div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="chart-card">
                    <div class="fw-bold mb-2" style="color:#1a1a2e; font-size:1.02rem;">
                        <i class="bi bi-graph-up-arrow text-success"></i> เส้นแนวโน้ม % ประสิทธิภาพ
                    </div>
                    <canvas id="lineChart-@key" height="130"></canvas>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/html2canvas@@1.4.1/dist/html2canvas.min.js"></script>
<script>
const monthsLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Months));
const repsDataStore = {
    "overall": {
        sales: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OverallCompany.MonthlyData.Select(m => m.TotalSales).ToList())),
        collected: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OverallCompany.MonthlyData.Select(m => m.TotalCollected).ToList())),
        debt: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OverallCompany.MonthlyData.Select(m => m.Outstanding).ToList())),
        rates: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OverallCompany.MonthlyData.Select(m => m.CollectionRate).ToList()))
    }
    @for (int ri = 0; ri < allReps.Count; ri++)
    {
        var rep = allReps[ri];
        <text>, "@ri": {
            sales: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(rep.MonthlyData.Select(m => m.TotalSales).ToList())),
            collected: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(rep.MonthlyData.Select(m => m.TotalCollected).ToList())),
            debt: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(rep.MonthlyData.Select(m => m.Outstanding).ToList())),
            rates: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(rep.MonthlyData.Select(m => m.CollectionRate).ToList()))
        }</text>
    }
};

const chartInstances = {};

function getRateBadgeClass(r) {
    return r >= 85 ? 'pct-good' : (r >= 50 ? 'pct-mid' : 'pct-bad');
}

function initChartsForKey(key) {
    if (chartInstances['bar-' + key]) return;
    const d = repsDataStore[key];
    if (!d) return;

    // Auto insight
    const insightEl = document.getElementById('insight-' + key);
    if (insightEl && !insightEl.dataset.done) {
        const totalSales = d.sales.reduce((a,b) => a+b, 0);
        const maxSale = Math.max(...d.sales);
        const maxIdx = d.sales.indexOf(maxSale);
        const validRates = d.rates.filter(r => r > 0);
        const avgRate = validRates.length ? (validRates.reduce((a,b) => a+b, 0) / validRates.length) : 0;
        let txt = `<b>สรุปผลงาน:</b> ยอดขายรวม <b>${totalSales.toLocaleString('th-TH')}</b> บาท | เดือนที่ดีที่สุดคือ <b>${monthsLabels[maxIdx] || ''}</b> (${maxSale.toLocaleString('th-TH')} บาท)<br>`;
        txt += `• ประสิทธิภาพเฉลี่ย <b>${avgRate.toFixed(1)}%</b> `;
        if (avgRate >= 85) txt += `<span class="text-success fw-bold">(ผ่านเกณฑ์ 85% ✓)</span>`;
        else if (avgRate >= 50) txt += `<span class="text-warning fw-bold">(ปานกลาง — ควรเร่งติดตาม)</span>`;
        else txt += `<span class="text-danger fw-bold">(ต่ำกว่าเกณฑ์ — ต้องเร่งด่วน ⚠️)</span>`;
        insightEl.innerHTML = `<i class="bi bi-lightbulb-fill text-warning me-1"></i> ${txt}`;
        insightEl.dataset.done = '1';
    }

    // Bar chart
    const barEl = document.getElementById('barChart-' + key);
    if (barEl) {
        chartInstances['bar-' + key] = new Chart(barEl, {
            type: 'bar',
            data: {
                labels: monthsLabels,
                datasets: [
                    { label: 'ยอดขาย (บาท)', data: d.sales, backgroundColor: 'rgba(2,132,199,0.85)', borderColor: '#0284c7', borderWidth:1.5, borderRadius:8, borderSkipped:false },
                    { label: 'ยอดเก็บได้ (บาท)', data: d.collected, backgroundColor: 'rgba(13,148,136,0.85)', borderColor: '#0d9488', borderWidth:1.5, borderRadius:8, borderSkipped:false },
                    { label: 'หนี้คงค้าง (บาท)', data: d.debt, backgroundColor: 'rgba(225,29,72,0.85)', borderColor: '#e11d48', borderWidth:1.5, borderRadius:8, borderSkipped:false }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { position: 'top', labels: { font: { weight: 'bold', size: 12 } } },
                    tooltip: { callbacks: { label: ctx => '  ' + ctx.dataset.label + ': ' + ctx.parsed.y.toLocaleString('th-TH') + ' บาท' } }
                },
                scales: { y: { beginAtZero:true, ticks: { callback: v => v >= 1000000 ? (v/1000000).toFixed(1)+'M' : (v/1000).toFixed(0)+'K' } } }
            }
        });
    }

    // Line chart
    const lineEl = document.getElementById('lineChart-' + key);
    if (lineEl) {
        chartInstances['line-' + key] = new Chart(lineEl, {
            type: 'line',
            data: {
                labels: monthsLabels,
                datasets: [
                    { label: '% ประสิทธิภาพการเก็บเงิน', data: d.rates, borderColor: '#0d9488', backgroundColor: 'rgba(13,148,136,0.15)', borderWidth:3.5, pointBackgroundColor: d.rates.map(r => r>0 && r<85 ? '#ef4444' : '#0d9488'), pointRadius: d.rates.map(r => r>0 && r<85 ? 8 : 6), fill:true, tension:0.3 },
                    { label: 'เป้าหมายมาตรฐาน (85%)', data: monthsLabels.map(() => 85), borderColor: '#ef4444', borderWidth:2, borderDash:[7,4], pointRadius:0, fill:false }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { position: 'top', labels: { font: { weight: 'bold', size: 12 } } },
                    tooltip: { callbacks: { label: ctx => '  ' + ctx.dataset.label + ': ' + ctx.parsed.y + '%' } }
                },
                scales: { y: { min:0, max:100, ticks: { callback: v => v + '%' } } }
            }
        });
    }
}

function selectRep(val) {
    const dd = document.getElementById('repSelectDropdown');
    if (dd && dd.value !== val) dd.value = val;
    document.querySelectorAll('.rep-panel').forEach(p => p.style.display = 'none');
    const show = document.getElementById(val === 'overall' ? 'panel-overall' : 'panel-' + val);
    if (show) show.style.display = 'block';
    setTimeout(() => initChartsForKey(val), 100);
}

function selectPrevRep() {
    const dd = document.getElementById('repSelectDropdown');
    if (!dd || dd.selectedIndex <= 0) return;
    dd.selectedIndex--;
    selectRep(dd.value);
}

function selectNextRep() {
    const dd = document.getElementById('repSelectDropdown');
    if (!dd || dd.selectedIndex >= dd.options.length - 1) return;
    dd.selectedIndex++;
    selectRep(dd.value);
}

function filterRepByName(keyword) {
    if (!keyword) return;
    const kw = keyword.toLowerCase().trim();
    const dd = document.getElementById('repSelectDropdown');
    if (!dd) return;
    for (let i = 0; i < dd.options.length; i++) {
        if (dd.options[i].text.toLowerCase().includes(kw)) {
            dd.selectedIndex = i;
            selectRep(dd.options[i].value);
            break;
        }
    }
}

function downloadScreenCapture(id) {
    const el = document.getElementById(id);
    if (!el) return;
    html2canvas(el, { scale:2, useCORS:true }).then(canvas => {
        const a = document.createElement('a');
        a.download = 'SalesReport_Matrix_' + new Date().toISOString().slice(0,10) + '.png';
        a.href = canvas.toDataURL('image/png', 1.0);
        a.click();
    });
}

function toggleSignatures() {
    const el = document.getElementById('signature-block');
    el.style.display = document.getElementById('toggle-sig').checked ? 'block' : 'none';
}

window.addEventListener('DOMContentLoaded', () => { initChartsForKey('overall'); });
</script>
}