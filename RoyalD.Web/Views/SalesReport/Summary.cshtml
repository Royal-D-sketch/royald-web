    const repName = currentRepIndex === 'overall' ? 'ภาพรวมทั้งบริษัท' : (allRepsData[currentRepIndex]?.name || 'ผู้แทนขาย');
    
    let prompt = `คำสั่งสำหรับ AI (Prompt for Executive Presentation):\n`;
    prompt += `--------------------------------------------------\n`;
    prompt += `คุณคือผู้เชี่ยวชาญการจัดทำสไลด์นำเสนอรายงานการเงินและบัญชีลูกหนี้ระดับ C-Level\n`;
    prompt += `กรุณานำข้อมูลตารางบัญชีลูกหนี้ (Pivot Matrix) และผลงานการจัดเก็บหนี้ของ บริษัท รอยัล ดี (ไทยแลนด์) จำกัด ด้านล่างนี้ ไปสร้างสไลด์นำเสนอผลการดำเนินงาน 5 สไลด์\n\n`;
    prompt += `บริบทรายงาน:\n`;
    prompt += `- ผู้แทน/กลุ่ม: ${repName}\n`;
    prompt += `- รอบการตัดยอด: ${cycleText}\n`;
    prompt += `- ปีงบประมาณ: 2569 (สะสมตลอดปี YTD)\n\n`;
    prompt += `สมการบัญชี 4 องค์ประกอบสำคัญ:\n`;
    prompt += `1. ลูกหนี้ยกมาต้นงวด + 2. ยอดขายสะสมระหว่างงวด = รวมฐานหนี้ที่ต้องรับผิดชอบ\n`;
    prompt += `รวมฐานหนี้ - 3. ยอดเก็บเงินได้สำเร็จ = 4. หนี้คงค้างปลายงวดสะสม\n\n`;
    prompt += `คำแนะนำในการสร้างสไลด์:\n`;
    prompt += `1. สไลด์ที่ 1: ภาพรวมสถานะทางการเงินและสภาพคล่อง (Cash Collection Rate)\n`;
    prompt += `2. สไลด์ที่ 2: วิเคราะห์แนวโน้มยอดขายเทียบกับยอดเก็บเงินรายเดือน\n`;
    prompt += `3. สไลด์ที่ 3: รายงานอายุหนี้และบิลค้างเกิน 120 วันที่ต้องจับตา\n`;
    prompt += `4. สไลด์ที่ 4: สรุปผลการประเมินสินเชื่อและคำแนะนำฝ่ายบัญชี\n`;
    prompt += `5. สไลด์ที่ 5: แผนปฏิบัติการเร่งรัดหนี้สินของฝ่ายขายในรอบถัดไป\n\n`;
    prompt += `โปรดจัดทำเป็น Bullet Points, ไฮไลต์ตัวเลขสำคัญ, และบทพูดผู้นำเสนอ (Speaker Notes) ให้กระชับ สุภาพ พร้อมนำเข้าโปรแกรมสร้างสไลด์ AI ได้ทันที\n`;
    prompt += `--------------------------------------------------`;
    
    document.getElementById('aiSummaryTextArea').value = prompt;
    const modalEl = document.getElementById('aiSummaryModal');
    if (modalEl) {
        const modal = new bootstrap.Modal(modalEl);
        modal.show();
    }
}

function copySumAiPromptToClipboard() {
    const area = document.getElementById('aiSummaryTextArea');
    area.select();
    navigator.clipboard.writeText(area.value).then(() => {
        const btn = document.getElementById('btnCopySumAiPrompt');
        const origText = btn.innerHTML;
        btn.innerHTML = '<i class="bi bi-check2-circle me-1"></i> คัดลอกสำเร็จแล้ว!';
        btn.className = 'btn btn-success btn-sm fw-bold px-4 py-2 shadow';
        setTimeout(() => {
            btn.innerHTML = origText;
            btn.className = 'btn btn-primary btn-sm fw-bold px-4 py-2 shadow';
        }, 2500);
    }).catch(err => {
        document.execCommand('copy');
        alert('คัดลอกข้อมูลเรียบร้อยแล้ว!');
    });
}

</script>
}
