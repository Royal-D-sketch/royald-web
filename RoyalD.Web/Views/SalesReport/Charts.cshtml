async function applyCustomDateRange() {
    const sDate = document.getElementById('filterStartDate').value;
    const eDate = document.getElementById('filterEndDate').value;
    if (!sDate || !eDate) {
        alert('กรุณาเลือกวันที่เริ่มต้นและสิ้นสุด');
        return;
    }
    if (sDate > eDate) {
        alert('วันที่เริ่มต้นต้องไม่เกินวันที่สิ้นสุด');
        return;
    }

    const btn = document.getElementById('btnApplyCustomRange');
    const origText = btn.innerHTML;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> กำลังกรอง...';
    btn.disabled = true;

    try {
        const resp = await fetch(`/SalesReport/GetChartCustomRange?startDate=${sDate}&endDate=${eDate}`);
        if (!resp.ok) throw new Error('API request failed');
        const data = await resp.json();

        customRangeData = {};
        if (data.items) {
            data.items.forEach(it => {
                customRangeData[it.salesRep] = {
                    bf: it.broughtForward,
                    sales: it.sales,
                    resp: it.totalResponsible,
                    collected: it.collected,
                    debt: it.outstanding,
                    rate: it.collectionRate
                };
            });
        }
        isCustomRange = true;

        // Visual feedback
        document.getElementById('btn-cycle-25').className = 'btn cycle-btn-inactive';
        document.getElementById('btn-cycle-cal').className = 'btn cycle-btn-inactive';
        btn.className = 'btn btn-sm btn-primary fw-bold shadow-sm';

        updateDashboardView();
    } catch (err) {
        console.error(err);
        alert('ไม่สามารถโหลดข้อมูลช่วงวันที่ได้ กรุณาลองใหม่อีกครั้ง');
    } finally {
        btn.innerHTML = origText;
        btn.disabled = false;
    }
}

function getActiveReps() {
    if (selectedIndividualId !== 'team-all') {
        const rep = allRepsList.find(r => r.id === parseInt(selectedIndividualId));
        return rep ? [rep] : allRepsList;
    }
    
    const teamMembers = supervisorTeams[currentTeam] || [];
    if (currentTeam === 'overall') return allRepsList;
    
    return allRepsList.filter(r => {
        const rName = r.name.trim();
        return teamMembers.some(m => rName === m || rName.includes(m) || m.includes(rName));
    });
}

function getRepValues(r, mIdx) {
    if (isCustomRange && customRangeData && customRangeData[r.name]) {
        const c = customRangeData[r.name];
        return {
            bf: c.bf,
            sales: c.sales,
            resp: c.resp,
            collected: c.collected,
            debt: c.debt,
            rate: c.rate
        };
    }

    const is25 = currentCycleMode === 'sales25';
    if (mIdx === -1) {
        return {
            bf: is25 ? r.initBf25 : r.initBfCal,
            sales: is25 ? r.totSales25 : r.totSalesCal,
            resp: is25 ? r.totResp25 : r.totRespCal,
            collected: is25 ? r.totCol25 : r.totColCal,
            debt: is25 ? r.totDebt25 : r.totDebtCal,
            rate: is25 ? r.totRate25 : r.totRateCal
        };
    } else {
        const bfVal = is25 ? (r.bf25[mIdx] || 0) : (r.bfCal[mIdx] || 0);
        const sVal = is25 ? (r.sales25[mIdx] || 0) : (r.salesCal[mIdx] || 0);
        const respVal = is25 ? (r.resp25[mIdx] || 0) : (r.respCal[mIdx] || 0);
        const cVal = is25 ? (r.collected25[mIdx] || 0) : (r.collectedCal[mIdx] || 0);
        const dVal = is25 ? (r.debt25[mIdx] || 0) : (r.debtCal[mIdx] || 0);
        const rtVal = is25 ? (r.rates25[mIdx] || 0) : (r.ratesCal[mIdx] || 0);
        return {
            bf: bfVal,
            sales: sVal,
            resp: respVal,
            collected: cVal,
            debt: dVal,
            rate: rtVal
        };
    }
}

function getRepMonthlySeries(r) {
    const is25 = currentCycleMode === 'sales25';
    return {
        bf: is25 ? r.bf25 : r.bfCal,
        sales: is25 ? r.sales25 : r.salesCal,
        resp: is25 ? r.resp25 : r.respCal,
        collected: is25 ? r.collected25 : r.collectedCal,
        debt: is25 ? r.debt25 : r.debtCal,
        rates: is25 ? r.rates25 : r.ratesCal
    };
}

function updateDashboardView() {
    const activeReps = getActiveReps();
    const mSelect = document.getElementById('cycleMonthSelect');
    const mVal = mSelect.value;
    const mIdx = mVal === 'all' ? -1 : parseInt(mVal);

    // Update active badge & title
    const teamTitle = currentTeam === 'weeranut' ? 'ทีมคุณวีรนุช' :
                     (currentTeam === 'sunya' ? 'ทีมคุณสัญญา' :
                     (currentTeam === 'nampetch' ? 'ทีมคุณน้ำเพชร' : 'ภาพรวมทั้งบริษัท'));
    
    const sDate = document.getElementById('filterStartDate').value;
    const eDate = document.getElementById('filterEndDate').value;
    
    let cycleTitle = currentCycleMode === 'sales25' ? 'รอบฝ่ายขายตัดยอด 25' : 'รอบสิ้นเดือนปฏิทิน';
    if (isCustomRange) cycleTitle = 'กำหนดช่วงวันที่เอง';

    const monthTitle = mIdx === -1 ? 'สะสมทั้งปี (YTD)' : monthsLabels[mIdx];
    document.getElementById('activeFilterBadge').innerHTML = `<i class="bi bi-check-circle-fill text-success me-1"></i> ${teamTitle} | ${cycleTitle} (${sDate} ถึง ${eDate})`;
    document.getElementById('chartCycleBadge').innerText = isCustomRange ? `ช่วงวันที่: ${sDate} ถึง ${eDate}` : (currentCycleMode === 'sales25' ? 'ตัดรอบยอดขายทุกวันที่ 25' : 'ตัดรอบสิ้นเดือนปฏิทิน');

    // 1. Calculate Aggregates (Complete 4-component accounting)
    let totalBf = 0, totalSales = 0, totalResp = 0, totalCol = 0, totalDebt = 0;
    activeReps.forEach(r => {
        const vals = getRepValues(r, mIdx);
        totalBf += vals.bf;
        totalSales += vals.sales;
        totalResp += vals.resp;
        totalCol += vals.collected;
        totalDebt += vals.debt;
    });
    const avgRate = totalResp > 0 ? Math.round(totalCol / totalResp * 100) : 0;

    // 2. Render KPIs with dynamic values: 1.ยกมา + 2.ขาย - 3.เก็บ = 4.หนี้คงค้าง
    document.getElementById('kpi-bf-val').innerText = formatNum(totalBf);
    document.getElementById('kpi-sales-val').innerText = formatNum(totalSales);
    document.getElementById('kpi-collect-val').innerText = formatNum(totalCol);
    document.getElementById('kpi-debt-val').innerText = formatNum(totalDebt);
    
    const rateValEl = document.getElementById('kpi-rate-val');
    rateValEl.innerText = avgRate + '%';
    if (avgRate >= 60) {
        rateValEl.className = 'fw-bold text-success';
    } else if (avgRate >= 40) {
        rateValEl.className = 'fw-bold text-warning';
    } else {
        rateValEl.className = 'fw-bold text-danger';
    }

    const debtSubEl = document.getElementById('kpi-debt-sub');
    if (totalDebt === 0) {
        debtSubEl.innerHTML = '<span class="text-success fw-bold">สถานะ: ปลอดหนี้ครบ 100% ✓</span>';
    } else if (totalDebt >= 5000000) {
        debtSubEl.innerHTML = '<span class="text-danger fw-bold">ประเมิน: หนี้ค้างสะสมสูงมาก ⚠️</span>';
    } else if (totalDebt >= 1000000) {
        debtSubEl.innerHTML = '<span class="text-warning fw-bold">ประเมิน: เฝ้าระวังหนี้ก้อนใหญ่</span>';
    } else {
        debtSubEl.innerHTML = '<span class="text-success fw-bold">ประเมิน: อยู่ในเกณฑ์วางบิลปกติ</span>';
    }

    // 3. Render Main Bar Chart (Monthly breakdown per rep)
    renderMainBarChart(activeReps, mIdx);

    // 4. Render Doughnut Chart
    renderDoughnutChart(totalCol, totalDebt);

    // 5. Render Trend Line Chart
    renderTrendLineChart(activeReps);

    // 6. Render Individual Assessment Cards (Harmonized with Summary)
    renderIndividualAssessmentCards(activeReps, mIdx);

    // 7. Auto Smart Insight
    renderSmartInsight(activeReps, teamTitle, totalBf, totalSales, totalCol, totalDebt, avgRate, mIdx);
}

function renderMainBarChart(activeReps, mIdx) {
    const ctx = document.getElementById('mainBarChart');
    if (mainBarChart) mainBarChart.destroy();

    let chartLabels = [];
    let datasets = [];

    if (mIdx === -1 && !isCustomRange) {
        // Show all months on X-axis, with bars for each active rep
        chartLabels = monthsLabels;
        datasets = activeReps.map((r, idx) => {
            const series = getRepMonthlySeries(r);
            return {
                label: r.name,
                data: monthsLabels.map((m, mi) => series.sales[mi] || 0),
                backgroundColor: repColors[idx % repColors.length],
                borderRadius: 4
            };
        });
    } else {
        // Single selected month or custom date range: show active reps on X-axis with Sales vs Debt bars
        chartLabels = activeReps.map(r => r.name);
        const titleSuffix = isCustomRange ? 'ช่วงวันที่เลือก' : monthsLabels[mIdx];
        datasets = [
            {
                label: 'ยอดขาย (' + titleSuffix + ')',
                data: activeReps.map(r => getRepValues(r, mIdx).sales),
                backgroundColor: '#0284c7',
                borderRadius: 4
            },
            {
                label: 'หนี้คงค้าง',
                data: activeReps.map(r => getRepValues(r, mIdx).debt),
                backgroundColor: '#f43f5e',
                borderRadius: 4
            }
        ];
    }

    mainBarChart = new Chart(ctx, {
        type: 'bar',
        data: { labels: chartLabels, datasets: datasets },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'top', labels: { boxWidth: 12, font: { weight: 'bold', size: 12 } } },
                tooltip: {
                    callbacks: {
                        label: c => `${c.dataset.label}: ${Number(c.parsed.y).toLocaleString('th-TH')} บาท`
                    }
                }
            },
            scales: {
                x: { ticks: { font: { weight: 'bold' } } },
                y: { beginAtZero: true, ticks: { callback: v => formatNum(v) } }
            }
        }
    });
}

function renderDoughnutChart(collected, debt) {
    const ctx = document.getElementById('doughnutChart');
    if (doughnutChart) doughnutChart.destroy();

    doughnutChart = new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: ['เก็บเงินสำเร็จ', 'หนี้คงค้าง'],
            datasets: [{
                data: [collected, debt],
                backgroundColor: ['#10b981', '#f43f5e'],
                borderWidth: 2,
                borderColor: '#ffffff'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '68%',
            plugins: {
                legend: { position: 'bottom', labels: { boxWidth: 12, font: { weight: 'bold' } } },
                tooltip: {
                    callbacks: {
                        label: c => `${c.label}: ${Number(c.parsed).toLocaleString('th-TH')} บาท`
                    }
                }
            }
        }
    });
}

function renderTrendLineChart(activeReps) {
    const ctx = document.getElementById('trendLineChart');
    if (trendLineChart) trendLineChart.destroy();

    // Average collection rate per month across active reps
    const avgMonthlyRates = monthsLabels.map((m, mi) => {
        let sumS = 0, sumC = 0;
        activeReps.forEach(r => {
            const series = getRepMonthlySeries(r);
            sumS += (series.resp[mi] || series.sales[mi] || 0);
            sumC += (series.collected[mi] || 0);
        });
        return sumS > 0 ? Math.round(sumC / sumS * 100) : 0;
    });

    trendLineChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: monthsLabels,
            datasets: [
                {
                    label: '% ประสิทธิภาพจัดเก็บจริง (ทีม)',
                    data: avgMonthlyRates,
                    borderColor: '#f59e0b',
                    backgroundColor: 'rgba(245,158,11,0.12)',
                    borderWidth: 3,
                    pointBackgroundColor: '#f59e0b',
                    pointRadius: 5,
                    fill: true,
                    tension: 0.35
                },
                {
                    label: 'เกณฑ์มาตรฐาน (60%)',
                    data: monthsLabels.map(() => 60),
                    borderColor: '#10b981',
                    borderDash: [5, 4],
                    borderWidth: 2,
                    pointRadius: 0,
                    fill: false
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { position: 'top', labels: { font: { weight: 'bold' } } } },
            scales: {
                y: { min: 0, max: 100, ticks: { callback: v => v + '%' } }
            }
        }
    });
}

function renderIndividualAssessmentCards(activeReps, mIdx) {
    const grid = document.getElementById('repCardsGrid');
    let html = '';

    activeReps.forEach(r => {
        const vals = getRepValues(r, mIdx);
        const bf = vals.bf;
        const s = vals.sales;
        const c = vals.collected;
        const d = vals.debt;
        const rate = vals.rate;
        const resp = bf + s;

        let statusBadge = '';
        let commentText = '';

        // 1. สัญญา T หรือผู้แทนที่ไม่มีหนี้ค้างและไม่มียอดขาย
        if (d === 0 && s === 0 && bf === 0) {
            statusBadge = '<span class="badge bg-secondary">สถานะปกติ (ไม่มีหนี้ค้าง)</span>';
            commentText = '• ไม่มียอดหนี้คงค้าง และไม่มีการเปิดบิลขายใหม่ในรอบนี้ (สถานะปกติ)';
        }
        // 2. ชำระครบถ้วน 100% ไม่มีหนี้ค้างเหลือ
        else if (d === 0 && resp > 0) {
            statusBadge = '<span class="badge bg-success">ชำระครบ 100% ✓</span>';
            commentText = '• บริหารจัดเก็บยอดเยี่ยม เรียกเก็บเงินครบถ้วน ไม่มีหนี้ค้างสะสมในรอบ';
        }
        // 3. หนี้คงค้างสะสมสูงวิกฤต (เกิน 1,000,000 บาท เช่น วีรนุช 8 มีหนี้ค้าง 1.92M)
        else if (d >= 1000000) {
            statusBadge = '<span class="badge bg-danger">หนี้ค้างสูงมาก (' + formatNum(d) + ') ⚠️</span>';
            commentText = `• มียอดหนี้คงค้างสะสมสูงมาก <b>${formatMoney(d)}</b> บาท (เก็บได้ ${rate}% จากฐานหนี้ ${formatNum(resp)}) ให้เร่งรัดติดตามการชำระเงินตามรอบบิลขายโดยด่วนที่สุด`;
        }
        // 4. หนี้สูงระดับอันตราย (>= 300,000 บาท) หรือจัดเก็บได้ต่ำกว่า 40% -> ต้องเป็นสีแดง (เร่งรัดด่วน)
        else if (d >= 300000 || rate < 40) {
            statusBadge = '<span class="badge bg-danger">ต้องเร่งรัดหนี้ด่วน (' + formatNum(d) + ') ⚠️</span>';
            commentText = `• มียอดหนี้คงค้างระดับสูง <b>${formatMoney(d)}</b> บาท หรืออัตราจัดเก็บต่ำกว่า 40% (${rate}%) แนะนำให้หัวหน้าทีมกำชับผู้แทนเข้าพบลูกค้าและเร่งรัดชำระเงินทันที`;
        }
        // 5. หนี้ค้างยกมาเก่าแต่ยังไม่มียอดขายใหม่ (และยอดไม่เกิน 300,000) -> เฝ้าระวังสีเหลือง (ไม่ตกใจเกินจริง)
        else if (s === 0 && bf > 0) {
            statusBadge = '<span class="badge bg-warning text-dark">เฝ้าระวังหนี้ยกมา (' + formatNum(d) + ')</span>';
            commentText = `• มียอดหนี้คงค้างยกมาจากปีก่อนหน้า <b>${formatMoney(d)}</b> บาท (ยังไม่มียอดขายใหม่ในรอบนี้) ให้เฝ้าระวังและติดตามเคลียร์ยอดหนี้เดิม`;
        }
        // 6. เฝ้าระวังหนี้คงค้างปานกลาง (100,000 - 299,999 บาท) หรือเก็บได้ 40-59%
        else if (d >= 100000 || rate < 60) {
            statusBadge = '<span class="badge bg-warning text-dark">เฝ้าระวังติดตาม (' + formatNum(d) + ')</span>';
            commentText = `• มีหนี้คงค้าง <b>${formatMoney(d)}</b> บาท (เก็บได้ ${rate}%) แนะนำให้ติดตามใบวางบิลและรอบนัดชำระเงินตามกำหนด`;
        }
        // 7. สุขภาพหนี้ดีจริง (เก็บได้ >= 60% และหนี้คงค้างเหลือต่ำกว่า 100,000 บาท)
        else if (rate >= 60 && d < 100000) {
            statusBadge = '<span class="badge bg-success">สุขภาพหนี้ดี (เก็บได้ ' + rate + '%) ✓</span>';
            commentText = '• ผลการจัดเก็บผ่านเกณฑ์มาตรฐาน หนี้คงค้างอยู่ในระดับต่ำตามรอบวางบิลปกติ';
        }
        // 8. ปกติทั่วไป
        else {
            statusBadge = '<span class="badge bg-info text-dark">ติดตามตามรอบบิลปกติ</span>';
            commentText = `• หนี้คงค้าง <b>${formatMoney(d)}</b> บาท อยู่ในเกณฑ์วางบิลปกติ`;
        }

        html += `
        <div class="col-md-6 col-lg-4">
            <div class="rep-summary-card h-100 d-flex flex-column justify-content-between shadow-sm">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold text-dark fs-6"><i class="bi bi-person-circle text-primary me-1"></i> ${r.name}</span>
                        ${statusBadge}
                    </div>
                    <!-- ครบ 4 องค์ประกอบบัญชีลูกหนี้: ยกมา + ขาย - เก็บ = หนี้คงค้าง -->
                    <div class="row g-1 text-center py-2 bg-light rounded-3 mb-2" style="font-size:0.8rem;">
                        <div class="col-3 border-end">
                            <div class="text-muted" style="font-size:0.73rem;">1. ยกมา</div>
                            <div class="fw-bold small" style="color:#0891b2;">${formatNum(bf)}</div>
                        </div>
                        <div class="col-3 border-end">
                            <div class="text-muted" style="font-size:0.73rem;">2. ยอดขาย</div>
                            <div class="fw-bold text-primary small">${formatNum(s)}</div>
                        </div>
                        <div class="col-3 border-end">
                            <div class="text-muted" style="font-size:0.73rem;">3. ยอดเก็บ</div>
                            <div class="fw-bold text-success small">${formatNum(c)}</div>
                        </div>
                        <div class="col-3">
                            <div class="text-muted" style="font-size:0.73rem;">4. หนี้ค้าง (1+2-3)</div>
                            <div class="fw-bold ${d > 0 ? 'text-danger' : 'text-secondary'} small">${formatNum(d)}</div>
                        </div>
                    </div>
                    <div class="small text-muted" style="line-height:1.5;">
                        <b>ความเห็นสินเชื่อ:</b><br>${commentText}
                    </div>
                </div>
            </div>
        </div>
        `;
    });

    grid.innerHTML = html;
}

function renderSmartInsight(activeReps, teamTitle, totalBf, totalSales, totalCol, totalDebt, avgRate, mIdx) {
    const box = document.getElementById('main-insight-box');
    
    // Find Top Sales & Top Debt in current view
    let topSeller = null, maxSale = -1;
    let topDebt = null, maxDebt = -1;
    activeReps.forEach(r => {
        const vals = getRepValues(r, mIdx);
        if (vals.sales > maxSale) { maxSale = vals.sales; topSeller = r; }
        if (vals.debt > maxDebt) { maxDebt = vals.debt; topDebt = r; }
    });

    const totalResp = totalBf + totalSales;
    let msg = `<b><i class="bi bi-cpu-fill text-primary me-1"></i> วิเคราะห์ผลงานทีม (${teamTitle}):</b> `;
    msg += `ลูกหนี้ยกมา <b>${formatMoney(totalBf)}</b> บาท + ยอดขาย <b>${formatMoney(totalSales)}</b> บาท `;
    msg += `(รวมฐานหนี้ที่ต้องติดตาม <b>${formatMoney(totalResp)}</b> บาท) | `;
    msg += `จัดเก็บได้แล้ว <b>${formatMoney(totalCol)}</b> บาท (${avgRate}%) | `;
    msg += `หนี้คงค้างปลายงวดที่ต้องบริหารจัดเก็บ <b>${formatMoney(totalDebt)}</b> บาท`;
    if (topSeller && maxSale > 0) {
        msg += `<br>• 🏆 <b>Top Sales ของทีม:</b> คุณ <b>${topSeller.name}</b> ยอดขาย ${formatMoney(maxSale)} บาท`;
    }
    if (topDebt && maxDebt > 0) {
        msg += `<br>• ⚠️ <b>จุดที่ต้องติดตามสินเชื่อ (Credit Risk):</b> คุณ <b>${topDebt.name}</b> มีหนี้คงค้าง ${formatMoney(maxDebt)} บาท แนะนำหัวหน้าทีมร่วมวางแผนการเข้าเก็บเงิน`;
    }

    box.innerHTML = msg;
}

function downloadScreenCapture(id) {
    const el = document.getElementById(id);
    if (!el) return;
    html2canvas(el, { scale: 2, useCORS: true, backgroundColor: '#ffffff' }).then(canvas => {
        const a = document.createElement('a');
        a.download = 'Sales_Charts_Dashboard_' + new Date().toISOString().slice(0, 10) + '.png';
        a.href = canvas.toDataURL('image/png', 1.0);
        a.click();
    });
}

window.addEventListener('DOMContentLoaded', () => {
    syncDateInputs();
    selectTeam('weeranut');
});
</script>
