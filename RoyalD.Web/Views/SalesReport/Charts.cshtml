@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/html2canvas@@1.4.1/dist/html2canvas.min.js"></script>
<script>
const monthsLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Months));
const repsDataStore = {
    "overall": {
        name: "เธ เธฒเธเธฃเธงเธกเธ—เธฑเนเธเธซเธกเธ”",
        sales: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OverallCompany.MonthlyData.Select(m => m.TotalSales).ToList())),
        collected: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OverallCompany.MonthlyData.Select(m => m.TotalCollected).ToList())),
        debt: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OverallCompany.MonthlyData.Select(m => m.Outstanding).ToList())),
        rates: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OverallCompany.MonthlyData.Select(m => m.CollectionRate).ToList())),
        totSales: @Model.OverallCompany.TotalSales,
        totCol: @Model.OverallCompany.TotalCollected,
        totDebt: @Model.OverallCompany.TotalOutstanding,
        totRate: @Model.OverallCompany.OverallCollectionRate
    }
    @for (int ri = 0; ri < allReps.Count; ri++)
    {
        var rep = allReps[ri];
        <text>, "@ri": {
            name: "@rep.SalesRep",
            sales: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(rep.MonthlyData.Select(m => m.TotalSales).ToList())),
            collected: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(rep.MonthlyData.Select(m => m.TotalCollected).ToList())),
            debt: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(rep.MonthlyData.Select(m => m.Outstanding).ToList())),
            rates: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(rep.MonthlyData.Select(m => m.CollectionRate).ToList())),
            totSales: @rep.TotalSales,
            totCol: @rep.TotalCollected,
            totDebt: @rep.TotalOutstanding,
            totRate: @rep.OverallCollectionRate
        }</text>
    }
};

let mainBarChart, doughnutChart, trendLineChart;

function formatNum(num) {
    if (num >= 1000000) return (num/1000000).toFixed(2) + 'M';
    if (num >= 1000) return (num/1000).toFixed(1) + 'K';
    return num.toLocaleString('th-TH');
}

function updateDashboard(key) {
    const d = repsDataStore[key];
    if (!d) return;

    // 1. Update KPIs
    document.getElementById('kpi-sales-val').innerText = formatNum(d.totSales);
    document.getElementById('kpi-collect-val').innerText = formatNum(d.totCol);
    document.getElementById('kpi-debt-val').innerText = formatNum(d.totDebt);
    
    const rateEl = document.getElementById('kpi-rate-val');
    const rateSub = document.getElementById('kpi-rate-sub');
    rateEl.innerText = d.totRate + '%';
    if(d.totRate >= 85) { rateEl.style.color = '#059669'; rateSub.innerHTML = '<span class="text-success">เธเธฃเธฐเน€เธกเธดเธ: เธ”เธตเน€เธขเธตเนเธขเธก เธเนเธฒเธเน€เธเธ“เธ‘เน</span>'; }
    else if(d.totRate >= 50) { rateEl.style.color = '#d97706'; rateSub.innerHTML = '<span class="text-warning">เธเธฃเธฐเน€เธกเธดเธ: เธเธฒเธเธเธฅเธฒเธ (เน€เธเนเธฒเธฃเธฐเธงเธฑเธ)</span>'; }
    else { rateEl.style.color = '#e11d48'; rateSub.innerHTML = '<span class="text-danger fw-bold">เธเธฃเธฐเน€เธกเธดเธ: เธ•เนเธณเธเธงเนเธฒเน€เธเธ“เธ‘เน เธ•เนเธญเธเน€เธฃเนเธเธ”เนเธงเธ!</span>'; }

    // 2. Auto Insight
    const insightEl = document.getElementById('main-insight-box');
    const maxSale = Math.max(...d.sales);
    const maxIdx = d.sales.indexOf(maxSale);
    let msg = `<b>เธชเธฃเธธเธเธขเธญเธ”เธเธฃเธฐเธเธณเธ•เธฑเธงเธเธนเนเนเธ—เธ (${d.name}):</b> เธขเธญเธ”เธเธฒเธขเธชเธนเธเธชเธธเธ”เน€เธเธดเธ”เธเธถเนเธเนเธเน€เธ”เธทเธญเธ <b>${monthsLabels[maxIdx]}</b> (${maxSale.toLocaleString('th-TH')} เธเธฒเธ—) <br>`;
    msg += `เธขเธญเธ”เน€เธเนเธเธฃเธงเธก <b>${d.totCol.toLocaleString('th-TH')}</b> เธเธฒเธ— เธเธดเธ”เน€เธเนเธ <b>${d.totRate}%</b> เธเธญเธเธขเธญเธ”เธเธฒเธข `;
    if(d.totRate < 85) msg += `<span class="text-danger fw-bold">เธเธถเนเธเธขเธฑเธเธ•เนเธณเธเธงเนเธฒเน€เธเนเธฒเธซเธกเธฒเธข 85% เธกเธตเธซเธเธตเนเธเนเธฒเธเธญเธตเธ ${d.totDebt.toLocaleString('th-TH')} เธเธฒเธ— เธ—เธตเนเธ•เนเธญเธเธ•เธดเธ”เธ•เธฒเธก</span>`;
    else msg += `<span class="text-success fw-bold">เธญเธขเธนเนเนเธเน€เธเธ“เธ‘เนเธ”เธตเน€เธขเธตเนเธขเธก (โฅ 85%)</span>`;
    insightEl.innerHTML = `<i class="bi bi-megaphone-fill text-warning me-2"></i> ${msg}`;

    // 3. Update Bar Chart
    if (mainBarChart) {
        mainBarChart.data.datasets[0].data = d.sales;
        mainBarChart.data.datasets[1].data = d.collected;
        mainBarChart.data.datasets[2].data = d.debt;
        mainBarChart.update();
    } else {
        const ctx1 = document.getElementById('mainBarChart');
        mainBarChart = new Chart(ctx1, {
            type: 'bar',
            data: {
                labels: monthsLabels,
                datasets: [
                    { label: 'เธขเธญเธ”เธเธฒเธข', data: d.sales, backgroundColor: '#38bdf8', borderRadius:4 },
                    { label: 'เน€เธเนเธเน€เธเธดเธเนเธ”เน', data: d.collected, backgroundColor: '#34d399', borderRadius:4 },
                    { label: 'เธซเธเธตเนเธเนเธฒเธ', data: d.debt, backgroundColor: '#fb7185', borderRadius:4 }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { position: 'top' }, tooltip: { callbacks: { label: c => c.dataset.label + ': ' + c.parsed.y.toLocaleString('th-TH') } } },
                scales: { y: { beginAtZero:true, ticks: { callback: v => formatNum(v) } } }
            }
        });
    }

    // 4. Update Doughnut Chart
    if (doughnutChart) {
        doughnutChart.data.datasets[0].data = [d.totCol, d.totDebt];
        doughnutChart.update();
    } else {
        const ctx2 = document.getElementById('doughnutChart');
        doughnutChart = new Chart(ctx2, {
            type: 'doughnut',
            data: {
                labels: ['เน€เธเนเธเนเธ”เนเธชเธณเน€เธฃเนเธ', 'เธซเธเธตเนเธเธเธเนเธฒเธ'],
                datasets: [{ data: [d.totCol, d.totDebt], backgroundColor: ['#10b981', '#f43f5e'], borderWidth:2, borderColor:'#fff', hoverOffset:4 }]
            },
            options: {
                responsive: true, maintainAspectRatio: false, cutout: '65%',
                plugins: { legend: { position:'bottom' } }
            }
        });
    }

    // 5. Update Line Chart
    if (trendLineChart) {
        trendLineChart.data.datasets[0].data = d.rates;
        trendLineChart.update();
    } else {
        const ctx3 = document.getElementById('trendLineChart');
        trendLineChart = new Chart(ctx3, {
            type: 'line',
            data: {
                labels: monthsLabels,
                datasets: [
