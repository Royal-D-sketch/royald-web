                    <i class="bi bi-person-badge-fill me-1 text-success"></i> เน€เธฅเธทเธญเธเธเธนเนเนเธ—เธเธเธฒเธข:
                </span>
            </div>
            <div class="col-md-4 col-lg-3">
                <select class="form-select form-select-sm fw-bold shadow-sm" id="repSelectDropdown" onchange="selectRep(this.value)" style="border:2px solid #10b981; border-radius:10px; color:#065f46;" @(isSalesRepRole ? "disabled" : "")>
                    @if (!isSalesRepRole) { <option value="overall" selected>๐ข เธ เธฒเธเธฃเธงเธกเธ—เธธเธเธเธ (เธฃเธงเธกเธ—เธฑเนเธเธเธฃเธดเธฉเธฑเธ—)</option> }
                    @for (int ri = 0; ri < allReps.Count; ri++)
                    {
                        var repName = allReps[ri].SalesRep;
                        // For sales rep role, select only their own data
                        var currentUserName = User.FindFirst("FullName")?.Value ?? User.Identity.Name;
                        if (isSalesRepRole && repName == currentUserName) { <option value="@ri" selected>๐‘ค @repName</option> }
                        else if (!isSalesRepRole) { <option value="@ri">๐‘ค @repName</option> }
