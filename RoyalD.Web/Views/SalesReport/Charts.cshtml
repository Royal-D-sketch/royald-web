function selectRep(val) {
    updateDashboard(val);
}

function downloadScreenCapture(id) {
    const el = document.getElementById(id);
    if (!el) return;
    html2canvas(el, { scale:2, useCORS:true, backgroundColor: '#ffffff' }).then(canvas => {
        const a = document.createElement('a');
        a.download = 'Dashboard_Charts_' + new Date().toISOString().slice(0,10) + '.png';
        a.href = canvas.toDataURL('image/png', 1.0);
        a.click();
    });
}

window.addEventListener('DOMContentLoaded', () => { 
    const dd = document.getElementById('repSelectDropdown');
    updateDashboard(dd ? dd.value : 'overall'); 
});
