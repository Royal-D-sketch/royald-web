<style>
/* Sub-Tabs Nav */
.sales-subnav { display:flex; gap:10px; background:#ecfdf5; padding:8px; border-radius:14px; margin-bottom:20px; border:1px solid #a7f3d0; flex-wrap:wrap; }
.sales-subnav .subnav-item { flex:1; text-align:center; padding:12px 18px; font-weight:800; font-size:1.02rem; color:#065f46; border-radius:10px; text-decoration:none; transition:all .2s ease-in-out; white-space:nowrap; }
.sales-subnav .subnav-item:hover { background:rgba(255,255,255,0.9); color:#059669; transform:translateY(-1px); }
.sales-subnav .subnav-item.active { background:#059669; color:white; box-shadow:0 4px 15px rgba(5,150,105,0.3); }

/* KPI Cards */
.kpi-card { background:#fff; border-radius:16px; padding:20px; box-shadow:0 4px 15px rgba(0,0,0,0.05); display:flex; flex-direction:column; border:1px solid #e2e8f0; position:relative; overflow:hidden; }
.kpi-title { font-size:0.95rem; font-weight:700; color:#64748b; margin-bottom:8px; }
.kpi-value { font-size:1.8rem; font-weight:800; margin-bottom:4px; letter-spacing:-0.5px; }
.kpi-icon { position:absolute; top:20px; right:20px; font-size:2rem; opacity:0.15; }
.kpi-sub { font-size:0.85rem; font-weight:600; }
.kpi-sales { border-bottom:4px solid #0ea5e9; } .kpi-sales .kpi-value { color:#0284c7; } .kpi-sales .kpi-icon { color:#0ea5e9; }
.kpi-collect { border-bottom:4px solid #10b981; } .kpi-collect .kpi-value { color:#059669; } .kpi-collect .kpi-icon { color:#10b981; }
.kpi-debt { border-bottom:4px solid #f43f5e; } .kpi-debt .kpi-value { color:#e11d48; } .kpi-debt .kpi-icon { color:#f43f5e; }
.kpi-rate { border-bottom:4px solid #f59e0b; } .kpi-rate .kpi-value { color:#d97706; } .kpi-rate .kpi-icon { color:#f59e0b; }

/* Chart Containers */
.chart-card { background:#fff; border-radius:16px; padding:22px; box-shadow:0 4px 15px rgba(0,0,0,0.05); border:1px solid #e2e8f0; margin-bottom:24px; }
.chart-header { font-size:1.1rem; font-weight:800; color:#1e293b; margin-bottom:16px; display:flex; align-items:center; }

.insight-card { background:linear-gradient(135deg,#f0fdfa 0%,#f8fafc 100%); border:1px solid #ccfbf1; border-left:5px solid #0d9488; border-radius:12px; padding:18px; box-shadow:0 2px 10px rgba(15,118,110,0.06); line-height:1.65; }

@@media print {
    .no-print, .sales-subnav, nav, .btn, .export-bar { display:none !important; }
    body { background:#fff; font-size:10pt; }
    .kpi-card, .chart-card { box-shadow:none !important; border:1px solid #ccc !important; }
}
</style>

