function formatNum(num) {
    if (num >= 1000000) return (num/1000000).toFixed(2) + 'M';
    if (num >= 1000) return (num/1000).toFixed(1) + 'K';
    return Number(num).toLocaleString('th-TH');
}

function formatMoney(num) {
    return Number(num).toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function selectTeam(teamKey) {
    currentTeam = teamKey;
    selectedIndividualId = 'team-all';
    
    // Update active button state with soothing Executive Green/White
    ['overall', 'sunya', 'weeranut', 'nampetch'].forEach(k => {
        const btn = document.getElementById('team-btn-' + k);
        if (btn) {
            btn.className = (k === teamKey) ? 'btn btn-sm team-pill team-pill-active' : 'btn btn-sm team-pill team-pill-inactive';
        }
    });

    // Reset individual dropdown
    const dd = document.getElementById('repSelectDropdown');
    if (dd) dd.value = 'team-all';

    updateDashboardView();
}

function selectIndividualRep(repVal) {
    selectedIndividualId = repVal;
    updateDashboardView();
}

function syncDateInputs() {
    const sInput = document.getElementById('filterStartDate');
    const eInput = document.getElementById('filterEndDate');
    const mSelect = document.getElementById('cycleMonthSelect');
    const mVal = mSelect.value;

    if (mVal === 'all') {
        if (currentCycleMode === 'sales25') {
            sInput.value = '2025-12-26';
            eInput.value = '2026-10-25';
        } else {
            sInput.value = '2026-01-01';
            eInput.value = '2026-10-31';
        }
    } else {
        const idx = parseInt(mVal);
        const item = monthDateRanges[idx];
        if (item) {
            if (currentCycleMode === 'sales25') {
                sInput.value = item.s25Start;
                eInput.value = item.s25End;
            } else {
                sInput.value = item.calStart;
                eInput.value = item.calEnd;
            }
        }
    }
}

function setCycleMode(mode) {
    currentCycleMode = mode;
    isCustomRange = false;
    customRangeData = null;

    const b25 = document.getElementById('btn-cycle-25');
    const bCal = document.getElementById('btn-cycle-cal');
    const bCustom = document.getElementById('btnApplyCustomRange');
    
    if (mode === 'sales25') {
        b25.className = 'btn cycle-btn-active';
        bCal.className = 'btn cycle-btn-inactive';
    } else {
        bCal.className = 'btn cycle-btn-active';
        b25.className = 'btn cycle-btn-inactive';
    }
    if (bCustom) bCustom.className = 'btn btn-sm btn-outline-primary fw-bold shadow-sm';

    syncDateInputs();
    updateDashboardView();
}

