@using RoyalD.Web.Services
@model RoyalD.Web.Services.AnnualPerformanceViewModel
@{
    ViewData["Title"] = "2. รายงานกราฟแสดงยอดขายแต่ละผู้แทนในแต่ละเดือน";
    var months = Model.Months;
    var allReps = Model.RepReports;
    var overall = Model.OverallCompany;
    bool isAdmin = User.IsInRole("admin");
    var canDownloadClaim = ViewContext.HttpContext.User.FindFirst("CanDownload")?.Value;
    bool isSalesRepRole = User.HasClaim(c => c.Type == "Position" && (c.Value.Contains("ผู้แทน") || c.Value.Contains("พนักงานขาย"))) && !isAdmin;
    bool canDownload = (isAdmin || canDownloadClaim == "true") && !isSalesRepRole;
}

<style>
/* Sub-Tabs Nav */
.sales-subnav {
    display: flex; gap: 10px;
    background: #ecfdf5; padding: 8px;
    border-radius: 14px; margin-bottom: 20px;
    border: 1px solid #a7f3d0;
}
.sales-subnav .subnav-item {
    flex: 1; text-align: center;
    padding: 12px 18px; font-weight: 800;
    font-size: 1.02rem; color: #065f46;
    border-radius: 10px; text-decoration: none;
    transition: all .2s ease-in-out;
}
.sales-subnav .subnav-item:hover { background: rgba(255,255,255,0.9); color: #059669; transform: translateY(-1px); }
.sales-subnav .subnav-item.active { background: #059669; color: white; box-shadow: 0 4px 15px rgba(5,150,105,0.3); }

/* Modern KPI Cards */
.kpi-card { border-radius:16px; padding:18px 20px; box-shadow:0 4px 20px rgba(0,0,0,.07); display:flex; align-items:center; gap:16px; transition:transform .2s,box-shadow .2s; }
.kpi-card:hover { transform:translateY(-3px); box-shadow:0 8px 28px rgba(0,0,0,.12); }
.kpi-card.blue { background:linear-gradient(135deg,#dbeafe 0%,#eff6ff 100%); border-left:5px solid #3b82f6; }
.kpi-card.green { background:linear-gradient(135deg,#dcfce7 0%,#f0fdf4 100%); border-left:5px solid #22c55e; }
.kpi-card.red { background:linear-gradient(135deg,#fee2e2 0%,#fff5f5 100%); border-left:5px solid #ef4444; }
.kpi-icon-wrap { width:52px; height:52px; border-radius:14px; display:flex; align-items:center; justify-content:center; font-size:1.6rem; flex-shrink:0; }
.kpi-icon-wrap.blue { background:#dbeafe; color:#2563eb; }
.kpi-icon-wrap.green { background:#dcfce7; color:#16a34a; }
.kpi-icon-wrap.red { background:#fee2e2; color:#dc2626; }
.kpi-label { font-size:.82rem; font-weight:700; color:#64748b; text-transform:uppercase; letter-spacing:.5px; margin-bottom:2px; }
.kpi-value { font-size:1.45rem; font-weight:900; line-height:1.1; }
.kpi-value.blue { color:#1d4ed8; }
.kpi-value.green { color:#15803d; }
.kpi-value.red { color:#b91c1c; }
.kpi-sub { font-size:.78rem; color:#94a3b8; margin-top:2px; }

/* Progress Gauge Bar */
.progress-gauge-wrap { background:white; border-radius:16px; padding:20px; box-shadow:0 4px 20px rgba(0,0,0,.07); }
.gauge-bar-outer { height:22px; background:#e2e8f0; border-radius:50px; position:relative; overflow:visible; margin-bottom:4px; }
.gauge-bar-fill { height:100%; border-radius:50px; transition:width 1s ease-in-out; }
.gauge-bar-fill.good { background:linear-gradient(90deg,#22c55e,#16a34a); }
.gauge-bar-fill.warn { background:linear-gradient(90deg,#f59e0b,#d97706); }
.gauge-bar-fill.bad { background:linear-gradient(90deg,#ef4444,#b91c1c); }
.gauge-target-line { position:absolute; top:-6px; bottom:-6px; width:3px; background:#ef4444; border-radius:2px; box-shadow:0 0 8px rgba(239,68,68,.5); }
.gauge-target-label { position:absolute; top:-26px; transform:translateX(-50%); font-size:.72rem; font-weight:800; color:#ef4444; white-space:nowrap; background:white; padding:2px 5px; border-radius:4px; border:1px solid #fca5a5; }

/* Rep Banner */
.rep-banner { border-radius:14px; padding:18px 22px; background:linear-gradient(135deg,#0f172a 0%,#1e3a5f 60%,#0070B9 100%); color:white; box-shadow:0 4px 18px rgba(0,112,185,.25); margin-bottom:18px; }

.chart-card { border-radius:14px; border:none; box-shadow:0 4px 18px rgba(0,0,0,0.08); background:white; padding:22px; }
.insight-card { background:linear-gradient(135deg,#f0fdfa 0%,#f8fafc 100%); border:1px solid #ccfbf1; border-left:5px solid #0d9488; border-radius:12px; padding:14px 18px; box-shadow:0 2px 10px rgba(15,118,110,0.06); line-height:1.65; }

@@media print {
    .no-print, .sales-subnav, nav, .btn, .export-bar { display: none !important; }
    body { font-size: 10pt; background: #fff !important; }
    .chart-card { break-inside: avoid; page-break-inside: avoid; }
    .signature-area { break-inside: avoid; page-break-inside: avoid; margin-top: 30px; }
}
</style>

<!-- Sub-Tabs Navigation Header -->
<div class="sales-subnav no-print">
    <a href="/SalesReport/Summary" class="subnav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Summary" || ViewContext.RouteData.Values["action"]?.ToString() == "Sales" ? "active" : "")">
        <i class="bi bi-table me-2"></i> 1. สรุปยอดขาย-ยอดเก็บเงิน (Pivot Matrix)
    </a>
    <a href="/SalesReport/Charts" class="subnav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Charts" ? "active" : "")">
        <i class="bi bi-bar-chart-line me-2"></i> 2. กราฟผลงานรายผู้แทน (Charts)
    </a>
    <a href="/SalesReport/ProductDetails" class="subnav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "ProductDetails" ? "active" : "")">
        <i class="bi bi-box-seam me-2"></i> 3. รายละเอียดสินค้าที่ขาย (Product Details)
    </a>
    @if (!isSalesRepRole)
    {
        <a href="/SalesReport/Compare" class="subnav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Compare" ? "active" : "")">
            <i class="bi bi-people me-2"></i> 4. กราฟเปรียบเทียบผู้แทนขาย
        </a>
    }
</div>

<!-- Header Title & Export Toolbar -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2 export-bar">
    <div>
        <h3 class="mb-1 fw-bold" style="color:#065f46;">
            <i class="bi bi-graph-up" style="color:#059669;"></i> กราฟวิเคราะห์ยอดขายและแนวโน้มผลงานสิ้นปี
        </h3>
        <span class="text-muted fw-semibold">กราฟแท่งเปรียบเทียบสัดส่วนยอดขาย เก็บเงิน หนี้ค้าง และ Trendline อัตราเก็บเงินรายบุคคล</span>
    </div>
    
    @if (canDownload)
    {
        <!-- 3 Export Buttons (Admin / Authorized Only) -->
        <div class="d-flex gap-2 no-print">
            <button onclick="window.print()" class="btn btn-outline-danger btn-sm fw-bold px-3 py-2 shadow-sm" title="สั่งพิมพ์เป็นเอกสาร PDF">
                <i class="bi bi-file-earmark-pdf me-1"></i> 📥 Export to PDF
            </button>
            <a href="/SalesReport/ExportSummaryExcel" class="btn btn-sm fw-bold px-3 py-2 shadow-sm text-white" title="ดาวน์โหลดไฟล์ Excel" style="background:#059669; border-color:#059669;">
                <i class="bi bi-file-earmark-excel me-1"></i> 📊 Export to Excel (.xlsx)
            </a>
            <button onclick="downloadScreenCapture('chart-capture-area')" class="btn btn-outline-success btn-sm fw-bold px-3 py-2 shadow-sm" title="บันทึกภาพกราฟความละเอียดสูง">
                <i class="bi bi-image me-1"></i> 🖼️ Download Image (PNG)
            </button>
        </div>
    }
</div>

<!-- ================= COMPACT SINGLE-ROW REP SELECTOR ================= -->
<div class="card border-0 shadow-sm mb-3 no-print" style="background: #f0fdf4; border: 1.5px solid #a7f3d0 !important; border-radius: 14px;">
    <div class="card-body py-2 px-3">
        <div class="row align-items-center g-2">
            <div class="col-md-auto">
                <span class="fw-bold" style="color: #065f46; font-size: 0.95rem;">
                    <i class="bi bi-person-badge-fill me-1 text-success"></i> เลือกผู้แทนขาย:
                </span>
            </div>
            <div class="col-md-4 col-lg-3">
                <select class="form-select form-select-sm fw-bold shadow-sm" id="chartsRepDropdown" onchange="switchChartRep(this.value)" style="border: 2px solid #10b981; border-radius: 10px; color: #065f46; font-size: 0.92rem; background-color: #ffffff; cursor: pointer;">
                    <option value="overall" selected>🏢 ภาพรวมผู้แทนทุกคน (รวมทั้งบริษัท)</option>
                    @for (int rIdx = 0; rIdx < allReps.Count; rIdx++)
                    {
                        var rep = allReps[rIdx];
                        <option value="@rIdx">👤 @rep.SalesRep</option>
                    }
                </select>
            </div>
            <div class="col-md-3 col-lg-3">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-success text-success"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control form-control-sm border-success fw-semibold" id="chartRepQuickSearch" placeholder="พิมพ์ชื่อผู้แทนเพื่อค้นหา..." oninput="filterChartRepByName(this.value)" />
                </div>
            </div>
            <div class="col-md-auto d-flex gap-1">
                <button type="button" class="btn btn-sm btn-outline-success fw-semibold shadow-sm" onclick="selectPreviousChartRep()" title="ผู้แทนคนก่อนหน้า" style="border-radius: 8px;">
                    <i class="bi bi-chevron-left"></i> ก่อนหน้า
                </button>
                <button type="button" class="btn btn-sm btn-outline-success fw-semibold shadow-sm" onclick="selectNextChartRep()" title="ผู้แทนคนถัดไป" style="border-radius: 8px;">
                    ถัดไป <i class="bi bi-chevron-right"></i>
                </button>
            </div>
            <div class="col-md text-end">
                <span class="badge shadow-sm" style="background:#d1fae5; color:#065f46; font-size:0.85rem; padding: 6px 12px; border-radius: 10px; border: 1px solid #a7f3d0;">
                    <i class="bi bi-people-fill me-1"></i> ผู้แทนทั้งหมด: <strong>@allReps.Count</strong> ท่าน
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Tab Contents -->
<div class="tab-content" id="chart-capture-area">
    <!-- Overall Tab -->
    <div class="tab-pane fade show active" id="tab-c-overall" role="tabpanel">
        @{
            RenderChartSection(overall, "overall", canDownload);
        }
    </div>

    <!-- Individual Rep Tabs -->
    @for (int rIdx = 0; rIdx < allReps.Count; rIdx++)
    {
        var rep = allReps[rIdx];
        <div class="tab-pane fade" id="tab-c-rep-@rIdx" role="tabpanel">
            @{
                RenderChartSection(rep, rIdx.ToString(), canDownload);
            }
        </div>
    }
</div>

@functions {
    void RenderChartSection(SalesRepMonthlyReport data, string key, bool canDownload)
    {
        decimal rate = data.OverallCollectionRate;
        string rateClass = rate >= 85 ? "good" : (rate >= 50 ? "warn" : "bad");
        string rateColor = rate >= 85 ? "#15803d" : (rate >= 50 ? "#d97706" : "#b91c1c");

        <div class="rep-banner">
            <div class="fw-bold" style="font-size:1.1rem;opacity:.85;margin-bottom:4px;">
                <i class="bi bi-person-badge me-2 text-warning"></i>@data.SalesRep
            </div>
            <div class="small" style="opacity:.7;">ผลงานสรุปยอดขายและการตามหนี้ ไทม์ไลน์ 8 เดือน ปี 2569</div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-3 col-sm-6">
                <div class="kpi-card blue h-100">
                    <div class="kpi-icon-wrap blue"><i class="bi bi-bag-fill"></i></div>
                    <div>
                        <div class="kpi-label">ยอดขายสะสม</div>
                        <div class="kpi-value blue">@data.TotalSales.ToString("N0")</div>
                        <div class="kpi-sub">บาท ตลอด 8 เดือน</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="kpi-card green h-100">
                    <div class="kpi-icon-wrap green"><i class="bi bi-cash-coin"></i></div>
                    <div>
                        <div class="kpi-label">ยอดเก็บได้</div>
                        <div class="kpi-value green">@data.TotalCollected.ToString("N0")</div>
                        <div class="kpi-sub">บาท เงินสดไหลเข้าจริง</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="kpi-card red h-100">
                    <div class="kpi-icon-wrap red"><i class="bi bi-exclamation-triangle-fill"></i></div>
                    <div>
                        <div class="kpi-label">หนี้คงค้าง</div>
                        <div class="kpi-value red">@data.TotalOutstanding.ToString("N0")</div>
                        <div class="kpi-sub">บาท ⚠️ จุดความเสี่ยง</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="progress-gauge-wrap h-100 d-flex flex-column justify-content-center">
                    <div style="font-size:.82rem;font-weight:700;color:#64748b;text-transform:uppercase;margin-bottom:8px;">📊 % เก็บสำเร็จ (Collection Rate)</div>
                    <div class="d-flex align-items-baseline gap-2 mb-2">
                        <span style="font-size:2rem;font-weight:900;line-height:1;color:@rateColor;">@data.OverallCollectionRate%</span>
                        <span class="small text-muted">เป้า 85%</span>
                    </div>
                    <div class="gauge-bar-outer">
                        <div class="gauge-bar-fill @rateClass" style="width:@(Math.Min(data.OverallCollectionRate, 100))%;" id="gauge-fill-@key"></div>
                        <div class="gauge-target-line" style="left:85%;">
                            <div class="gauge-target-label">เป้า 85%</div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between mt-1">
                        <span class="small text-muted">0%</span>
                        <span class="small text-muted">100%</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <!-- Chart 1: Grouped Bar Chart -->
            <div class="col-md-7">
                <div class="chart-card">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold" style="color:#1a1a2e; font-size:1.05rem;">
                            <i class="bi bi-bar-chart-fill text-primary"></i> 1. กราฟแท่งเปรียบเทียบ ยอดขาย vs เก็บได้ vs หนี้ค้าง
                        </span>
                        @if (canDownload)
                        {
                            <button class="btn btn-sm btn-outline-secondary no-print" onclick="downloadSingleChart('barChart-@key', 'BarChart_@key')">
                                <i class="bi bi-download"></i> PNG
                            </button>
                        }
                    </div>
                    <canvas id="barChart-@key" height="135"></canvas>
                    <div class="insight-card mt-3" id="desc-box-@key"></div>
                </div>
            </div>
            <!-- Chart 2: Trendline -->
            <div class="col-md-5">
                <div class="chart-card">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold" style="color:#1a1a2e; font-size:1.05rem;">
                            <i class="bi bi-graph-up-arrow text-success"></i> 2. เส้นแนวโน้ม % ประสิทธิภาพการเก็บเงิน
                        </span>
                        @if (canDownload)
                        {
                            <button class="btn btn-sm btn-outline-secondary no-print" onclick="downloadSingleChart('lineChart-@key', 'Trendline_@key')">
                                <i class="bi bi-download"></i> PNG
                            </button>
                        }
                    </div>
                    <canvas id="lineChart-@key" height="135"></canvas>
                    <div class="insight-card mt-3">
                        <p class="mb-0" style="font-size:0.9rem;">
                            <i class="bi bi-graph-up-arrow text-success me-1"></i>
                            ประสิทธิภาพการเก็บเงินรวมของ <strong class="text-warning">@data.SalesRep</strong> คิดเป็น <strong class="text-danger">@data.OverallCollectionRate%</strong> 
                            เงินสดไหลเข้าจริงคือ <strong class="text-success">@data.TotalCollected.ToString("N2")</strong> บาท
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
}

<!-- ================= SIGNATURE SECTION ================= -->
<div class="card shadow-sm border-0 mb-3 no-print" style="background:#f8f9fa;">
    <div class="card-body py-2">
        <div class="row align-items-center">
            <div class="col-md-6">
                <span class="fw-bold text-dark"><i class="bi bi-pen me-1"></i> ตัวเลือกการแสดงผลช่องลงนามท้ายรายงาน:</span>
            </div>
            <div class="col-md-6 d-flex justify-content-end gap-3">
