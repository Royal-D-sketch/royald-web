@using RoyalD.Web.Services
@model List<RoyalD.Web.Models.AppUser>
@{
    ViewData["Title"] = "จัดการผู้ใช้งาน";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0 fw-bold" style="color:#0f766e;"><i class="bi bi-people-fill text-primary"></i> จัดการผู้ใช้งานและกำหนดสิทธิ์ระบบ</h4>
        <small class="text-muted">กำหนดสิทธิ์การเข้าดูหน้าจอ ขอบเขตพื้นที่ ตำแหน่งงาน และความปลอดภัย</small>
    </div>
    <a href="/Account/CreateUser" class="btn btn-primary fw-bold shadow-sm" style="background:#0d9488; border-color:#0d9488;">
        <i class="bi bi-person-plus-fill me-1"></i> เพิ่มผู้ใช้ใหม่
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0 mb-4" style="border-radius:12px; overflow:hidden;">
    <div class="card-header bg-white py-3 border-bottom">
        <form method="get" id="userFilterForm" class="row g-2 align-items-end">
            <!-- 1. ค้นหาคำค้นทั่วไป (พิมพ์เองได้) -->
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted mb-1">
                    <i class="bi bi-search me-1"></i> ค้นหาข้อความ (พิมพ์เองได้)
                </label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" id="filterSearch" class="form-control" 
                           placeholder="ชื่อผู้ใช้, ชื่อ-สกุล, รหัสผู้แทน..." value="@ViewBag.Search" />
                </div>
            </div>

            <!-- 2. ตำแหน่งงาน (มีให้เลือกจาก Dropdown หรือพิมพ์เองได้อิสระ) -->
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted mb-1">
                    <i class="bi bi-person-badge me-1"></i> ตำแหน่ง (เลือก/พิมพ์เอง)
                </label>
                <div class="input-group input-group-sm">
                    <input type="text" name="position" id="filterPosition" list="positionOptions" class="form-control" 
                           placeholder="-- เลือกหรือพิมพ์ --" value="@ViewBag.Position" />
                    <datalist id="positionOptions">
                        <option value="ผู้แทนขาย">👔 ผู้แทนขาย</option>
                        <option value="พนักงาน">💼 พนักงาน</option>
                        <option value="หัวหน้างาน">🎖️ หัวหน้างาน</option>
                        <option value="ผู้บริหาร">👑 ผู้บริหาร</option>
                        @if (ViewBag.AllPositions != null)
                        {
                            foreach (var pos in (List<string>)ViewBag.AllPositions)
                            {
                                if (pos != "ผู้แทนขาย" && pos != "พนักงาน" && pos != "หัวหน้างาน" && pos != "ผู้บริหาร")
                                {
                                    <option value="@pos">@pos</option>
                                }
                            }
                        }
                    </datalist>
                </div>
            </div>

            <!-- 3. บทบาท (Role) -->
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted mb-1">
                    <i class="bi bi-shield-check me-1"></i> บทบาทระบบ
                </label>
                <select name="role" id="filterRole" class="form-select form-select-sm">
                    <option value="">-- ทั้งหมด --</option>
                    <option value="admin" selected="@(ViewBag.Role == "admin")">Admin (ผู้ดูแลระบบ)</option>
                    <option value="user" selected="@(ViewBag.Role == "user")">User (ผู้ใช้ทั่วไป)</option>
                </select>
            </div>

            <!-- 4. พื้นที่/ภาค (มีให้เลือกหรือพิมพ์เองได้) -->
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted mb-1">
                    <i class="bi bi-geo-alt me-1"></i> พื้นที่/ภาค (เลือก/พิมพ์เอง)
                </label>
                <input type="text" name="region" id="filterRegion" list="regionOptions" class="form-control form-control-sm" 
                       placeholder="-- เลือกหรือพิมพ์ --" value="@ViewBag.Region" />
                <datalist id="regionOptions">
                    @if (ViewBag.AllRegions != null)
                    {
                        foreach (var reg in (List<string>)ViewBag.AllRegions)
                        {
                            <option value="@reg">@reg</option>
                        }
                    }
                    <option value="กรุงเทพมหานคร">กรุงเทพมหานคร</option>
                    <option value="ปริมณฑล">ปริมณฑล</option>
                </datalist>
            </div>

            <!-- 5. สิทธิ์และกลุ่มผู้ใช้ -->
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted mb-1">
                    <i class="bi bi-sliders me-1"></i> สิทธิ์และกลุ่มผู้ใช้
                </label>
                <select name="permission" id="filterPermission" class="form-select form-select-sm">
                    <option value="">-- สิทธิ์ทั้งหมด --</option>
                    <option value="restore" selected="@(ViewBag.Permission == "restore")">♻️ มีสิทธิ์กู้บิลยกเลิก</option>
                    <option value="cancel_view" selected="@(ViewBag.Permission == "cancel_view")">👁️ มีสิทธิ์ดูบิลยกเลิก</option>
                    <option value="salesrep" selected="@(ViewBag.Permission == "salesrep")">👔 เฉพาะผู้แทนขาย (ไม่มีสิทธิ์ดูบิล)</option>
                </select>
            </div>

            <!-- 6. สถานะบัญชี & ปุ่มกดค้นหา/ล้างตัวกรอง -->
            <div class="col-md-2 mt-2">
                <label class="form-label small fw-bold text-muted mb-1">
                    <i class="bi bi-toggle-on me-1"></i> สถานะบัญชี
                </label>
                <select name="status" id="filterStatus" class="form-select form-select-sm">
                    <option value="">-- ทุกสถานะ --</option>
                    <option value="active" selected="@(ViewBag.Status == "active")">🟢 ใช้งานปกติ</option>
                    <option value="inactive" selected="@(ViewBag.Status == "inactive")">🔴 ระงับการใช้งาน</option>
                </select>
            </div>

            <div class="col-md-4 mt-2 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-fill fw-bold" style="background:#0d9488; border-color:#0d9488;">
                    <i class="bi bi-funnel-fill me-1"></i> กรองข้อมูล
                </button>
                <a href="/Account/Users" class="btn btn-sm btn-outline-secondary px-3" title="ล้างตัวกรองทั้งหมด">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> ล้างตัวกรอง
                </a>
            </div>

            <div class="col-md-6 mt-2 text-md-end">
                <span class="badge bg-light text-dark border px-3 py-2 fw-normal" style="font-size:0.85rem;">
                    แสดงผู้ใช้งาน: <strong id="filterUserCount" class="text-primary">@Model.Count</strong> คน
                </span>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="usersTable">
                <thead class="table-light" style="background:#f8fafc; border-bottom:2px solid #e2e8f0;">
                    <tr>
                        <th style="width:40px;">#</th>
                        <th style="min-width:140px;">บัญชีผู้ใช้</th>
                        <th style="width:110px;">ตำแหน่งงาน</th>
                        <th class="text-center" style="width:80px;">บทบาท</th>
                        <th style="min-width:180px;">สิทธิ์หน้าจอที่เข้าได้</th>
                        <th style="min-width:130px;">พื้นที่รับผิดชอบ</th>
                        <th style="min-width:180px;">สิทธิ์เปลี่ยนสถานะ</th>
                        <th class="text-center" style="width:90px;">ดูรับชำระ</th>
                        <th class="text-center" style="width:75px;">โหลดไฟล์</th>
                        <th class="text-center" style="width:75px;">แคปจอ</th>
                        <th class="text-center" style="width:85px;">สถานะ</th>
                        <th class="text-center" style="width:180px;">การจัดการสิทธิ์</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr id="emptyRow"><td colspan="12" class="text-center text-muted py-4">ไม่พบข้อมูลบัญชีผู้ใช้</td></tr>
                    }
                    @{int idx = 1;}
                    @foreach (var u in Model)
                    {
                        var pages = u.AllowedPages?.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(p => p.Trim()).ToList() ?? new();
                        bool isSR = !string.IsNullOrEmpty(u.Position) && (u.Position.Contains("ผู้แทน") || u.Position.Contains("พนักงานขาย"));
                        bool canRestoreVal = u.Role == "admin" || u.CanRestoreCancelledBill || DebtStatusPermissionHelper.CanRestoreCancelledBill(u);
                        bool canViewCancelVal = u.Role == "admin" || pages.Any(p => p.Equals("Cancelled", StringComparison.OrdinalIgnoreCase) || p.Equals("DebtorCancelled", StringComparison.OrdinalIgnoreCase));
                        <tr class="user-row @(!u.IsActive ? "table-secondary" : "")"
                            data-username="@u.Username?.ToLower()"
                            data-fullname="@u.FullName?.ToLower()"
                            data-repcode="@u.SalesRepCode?.ToLower()"
                            data-position="@(string.IsNullOrEmpty(u.Position) ? "ผู้แทนขาย" : u.Position.ToLower())"
                            data-role="@u.Role?.ToLower()"
                            data-region="@((u.AllowedRegion ?? "") + " " + (u.AllowedProvinces ?? "")).ToLower()"
                            data-status="@(u.IsActive ? "active" : "inactive")"
                            data-canrestore="@(canRestoreVal ? "true" : "false")"
                            data-canviewcancel="@(canViewCancelVal ? "true" : "false")"
                            data-issalesrep="@(isSR ? "true" : "false")">
                            <td>@idx++</td>
                            <td>
                                <div class="fw-bold text-dark fs-6"><code>@u.Username</code></div>
                                <div class="text-muted small">@u.FullName</div>
                                @if (!string.IsNullOrEmpty(u.SalesRepCode))
                                {
                                    <small class="badge bg-light text-primary border mt-1">ผู้แทน: @u.SalesRepCode</small>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border px-2 py-1 fw-bold">
                                    @(string.IsNullOrEmpty(u.Position) ? "ผู้แทนขาย" : u.Position)
                                </span>
                            </td>
                            <td class="text-center">
                                @if (u.Role == "admin")
                                {
                                    <span class="badge bg-danger px-2 py-1">Admin</span>
                                }
                                else
                                {
                                    <span class="badge px-2 py-1" style="background:#0d9488;">User</span>
                                }
                            </td>
                            <td>
                                @if (u.Role == "admin")
                                {
                                    <span class="badge bg-success">เข้าได้ทุกหน้าจอ (Full Access)</span>
                                }
                                else if (!pages.Any())
                                {
                                    <span class="badge bg-danger">ไม่มีสิทธิ์ดูหน้าจอใด</span>
                                }
                                else
                                {
                                    <div class="d-flex flex-wrap gap-1" style="max-width:260px;">
                                        @foreach (var p in pages)
                                        {
                                            string pTitle = p switch {
                                                "Dashboard" => "Dashboard",
                                                "SalesBill" => "บิลขาย",
                                                "Debtor" => "การ์ดลูกหนี้",
                                                "DebtorHistory" => "ประวัติชำระ",
                                                "Cancelled" => "บิลยกเลิก",
                                                "WaitingGoods" => "บิลรอสินค้า",
                                                "SalesReport" => "รายงานผู้แทน",
                                                "Audit" => "Audit Logs",
                                                "Users" => "จัดการผู้ใช้",
                                                "Upload" => "อัปโหลดทั้งหมด",
                                                "UploadSalesBill" => "อัปโหลดบิลขาย",
                                                "UploadDebtor" => "อัปโหลดการ์ดลูกหนี้",
                                                "UploadReceipt" => "อัปโหลดสรุปรับเงิน",
                                                _ => p
                                            };
                                            <span class="badge bg-light text-dark border" style="font-size:0.75rem;">@pTitle</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                                @if (string.IsNullOrEmpty(u.AllowedRegion) && string.IsNullOrEmpty(u.AllowedProvinces))
                                {
                                    <span class="text-muted small">ทุกพื้นที่ (ทั่วประเทศ)</span>
                                }
                                else
                                {
                                    <div>
                                        @if (!string.IsNullOrEmpty(u.AllowedRegion))
                                        {
                                            <span class="badge bg-info text-dark me-1">@u.AllowedRegion</span>
                                        }
                                        @if (!string.IsNullOrEmpty(u.AllowedProvinces))
                                        {
                                            <small class="text-muted d-block">จ. @u.AllowedProvinces</small>
                                        }
                                    </div>
                                }
                            </td>
                            <!-- สิทธิ์เปลี่ยนสถานะ (4 สิทธิ์) -->
                            <td>
                                @{
                                    bool canPaid = u.Role == "admin" || u.CanChangePaidBillStatus || DebtStatusPermissionHelper.CanChangePaidBillStatus(u);
                                    bool canNormal = u.Role == "admin" || u.CanChangeDebtStatus || DebtStatusPermissionHelper.CanChangeDebtStatus(u);
                                    bool canRet = u.Role == "admin" || u.CanManageReturnedBills || DebtStatusPermissionHelper.CanManageReturnedBills(u);
                                    bool canCanc = u.Role == "admin" || u.CanCancelBill || DebtStatusPermissionHelper.CanCancelBill(u);
                                    bool canRestore = u.Role == "admin" || u.CanRestoreCancelledBill || DebtStatusPermissionHelper.CanRestoreCancelledBill(u);
                                }
                                <div class="d-flex flex-wrap gap-1" style="max-width:200px;">
                                    @if (canPaid)
                                    {
                                        <span class="badge bg-danger" style="font-size:0.72rem;" title="สิทธิ์เปลี่ยนสถานะบิลชำระครบแล้ว">🔒 บิลชำระแล้ว</span>
                                    }
                                    @if (canNormal)
                                    {
                                        <span class="badge bg-success" style="font-size:0.72rem;" title="สิทธิ์เปลี่ยนสถานะหนี้ทั่วไป">🔄 หนี้ทั่วไป</span>
                                    }
                                    @if (canCanc)
                                    {
                                        <span class="badge bg-warning text-dark" style="font-size:0.72rem;" title="สิทธิ์บิลยกเลิก">❌ ยกเลิก</span>
                                    }
                                    @if (canRestore)
                                    {
                                        <span class="badge bg-teal text-white" style="background:#0d9488; font-size:0.72rem;" title="สิทธิ์กู้คืนบิลยกเลิก">♻️ กู้คืนบิล</span>
                                    }
                                    @if (canRet)
                                    {
                                        <span class="badge bg-primary" style="font-size:0.72rem;" title="สิทธิ์บิลส่งกลับบัญชี">📦 ส่งคืนบัญชี</span>
                                    }
                                    @if (!canPaid && !canNormal && !canCanc && !canRet && !canRestore)
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </div>
                            </td>
                            <!-- สิทธิ์ดูรับชำระ -->
                            <td class="text-center">
                                @if (u.Role == "admin" || u.CanViewPaymentDetails)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> ได้</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i class="bi bi-lock-fill"></i> ซ่อน</span>
                                }
                            </td>
                            <!-- โหลดไฟล์ -->
                            <td class="text-center">
                                @if (u.Role == "admin" || u.CanDownload)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> ได้</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-x-circle"></i> ปิด</span>
                                }
                            </td>
                            <!-- แคปจอ -->
                            <td class="text-center">
                                @if (u.Role == "admin" || u.CanScreenCapture)
                                {
                                    <span class="badge bg-success"><i class="bi bi-camera"></i> ได้</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger" title="หากแคปจอ จะจอดำ+เตะออกทันที"><i class="bi bi-shield-x"></i> ห้าม</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (u.IsActive)
                                {
                                    <span class="badge bg-success">ใช้งานปกติ</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">ปิดใช้งาน</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="d-flex gap-2 justify-content-center">
                                    <a href="/Account/EditUser/@u.Id" class="btn btn-sm btn-primary fw-bold text-nowrap shadow-sm" style="background:#0d9488; border-color:#0d9488;" title="แก้ไขสิทธิ์และขอบเขตพื้นที่">
                                        <i class="bi bi-pencil-square"></i> แก้ไขสิทธิ์
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-warning text-dark fw-bold text-nowrap shadow-sm" 
                                            onclick="openResetPasswordModal(@u.Id, '@u.Username', '@u.FullName')" title="รีเซ็ตรหัสผ่าน">
                                        <i class="bi bi-key-fill text-warning"></i> รีเซ็ตรหัส
                                    </button>
                                    @if (u.Username != "admin")
                                    {
                                        <form asp-controller="Account" asp-action="DeleteUser" method="post"
                                              onsubmit="return confirm('⚠️ ยืนยันการลบสิทธิ์และบัญชี @u.Username (@u.FullName)?\nผู้ใช้นี้จะไม่สามารถเข้าสู่ระบบได้อีกต่อไป');" class="mb-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger fw-bold text-nowrap shadow-sm" title="ลบสิทธิ์การใช้งาน">
                                                <i class="bi bi-trash3-fill"></i> ลบสิทธิ์
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary py-1 px-2 align-self-center"><i class="bi bi-lock-fill"></i> แอดมินหลัก</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal รีเซ็ตรหัสผ่าน -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius:16px; overflow:hidden;">
            <div class="modal-header bg-warning bg-opacity-10 border-0">
                <h5 class="modal-title fw-bold text-dark" id="resetPasswordModalLabel">
                    <i class="bi bi-key-fill text-warning me-2"></i> รีเซ็ตรหัสผ่านผู้ใช้งาน
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Account" asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="resetUserId" value="" />
                <div class="modal-body p-4">
                    <div class="alert alert-light border mb-3">
                        <div class="fw-bold fs-6 text-dark" id="resetUsernameDisplay"></div>
                        <small class="text-muted" id="resetFullNameDisplay"></small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">รหัสผ่านใหม่ที่ต้องการกำหนดให้ผู้ใช้คนนี้ <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="password" name="newPassword" id="resetNewPasswordInput" class="form-control fw-bold" placeholder="กรอกรหัสผ่านใหม่ (ไม่ต่ำกว่า 6 ตัวอักษร)" required autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary" onclick="togglePasswordVisibility('resetNewPasswordInput', 'resetEyeIcon')" title="กดเพื่อดู/ซ่อนรหัสผ่าน">
                                <i class="bi bi-eye" id="resetEyeIcon"></i>
                            </button>
                        </div>
                        <small class="text-muted d-block mt-1">กรุณากำหนดรหัสผ่านเฉพาะของแต่ละผู้ใช้งานตามที่ต้องการ</small>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="submit" class="btn btn-warning fw-bold text-dark px-4 shadow-sm">
                        <i class="bi bi-check-circle-fill me-1"></i> ยืนยันตั้งรหัสผ่านใหม่
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function togglePasswordVisibility(inputId, iconId) {
    var input = document.getElementById(inputId);
    var icon = document.getElementById(iconId);
    if (!input || !icon) return;
    if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'bi bi-eye-slash';
    } else {
        input.type = 'password';
        icon.className = 'bi bi-eye';
    }
}

function openResetPasswordModal(id, username, fullName) {
    document.getElementById('resetUserId').value = id;
    document.getElementById('resetUsernameDisplay').innerHTML = '<i class="bi bi-person-fill text-primary"></i> บัญชี: <code>' + username + '</code>';
    document.getElementById('resetFullNameDisplay').innerText = 'ชื่อ-นามสกุล: ' + fullName;
    var pwdInput = document.getElementById('resetNewPasswordInput');
    pwdInput.value = '';
    pwdInput.type = 'password';
    var eyeIcon = document.getElementById('resetEyeIcon');
    if (eyeIcon) eyeIcon.className = 'bi bi-eye';
    var modal = new bootstrap.Modal(document.getElementById('resetPasswordModal'));
    modal.show();
}

// Instant Real-time Filter (พิมพ์หรือเลือกปุ๊บ กรองผลลัพธ์ทันที)
function applyClientUserFilter() {
    const qSearch = (document.getElementById('filterSearch')?.value || '').trim().toLowerCase();
    const qPos = (document.getElementById('filterPosition')?.value || '').trim().toLowerCase();
    const qRole = (document.getElementById('filterRole')?.value || '').trim().toLowerCase();
    const qRegion = (document.getElementById('filterRegion')?.value || '').trim().toLowerCase();
    const qStatus = (document.getElementById('filterStatus')?.value || '').trim().toLowerCase();
    const qPerm = (document.getElementById('filterPermission')?.value || '').trim().toLowerCase();

    const rows = document.querySelectorAll('.user-row');
    let visibleCount = 0;

    rows.forEach(row => {
        const uName = row.getAttribute('data-username') || '';
        const fName = row.getAttribute('data-fullname') || '';
        const repCode = row.getAttribute('data-repcode') || '';
        const pos = row.getAttribute('data-position') || '';
        const role = row.getAttribute('data-role') || '';
        const reg = row.getAttribute('data-region') || '';
        const status = row.getAttribute('data-status') || '';
        const canRestore = row.getAttribute('data-canrestore') === 'true';
        const canViewCancel = row.getAttribute('data-canviewcancel') === 'true';
        const isSR = row.getAttribute('data-issalesrep') === 'true';

        let match = true;

        if (qSearch) {
            if (!uName.includes(qSearch) && !fName.includes(qSearch) && !repCode.includes(qSearch) && !pos.includes(qSearch)) {
                match = false;
            }
        }
        if (match && qPos) {
            if (!pos.includes(qPos)) match = false;
        }
        if (match && qRole) {
            if (role !== qRole) match = false;
        }
        if (match && qRegion) {
            if (!reg.includes(qRegion)) match = false;
        }
        if (match && qStatus) {
            if (status !== qStatus) match = false;
        }
        if (match && qPerm) {
            if (qPerm === 'restore' && !canRestore) match = false;
            else if (qPerm === 'cancel_view' && !canViewCancel) match = false;
            else if (qPerm === 'salesrep' && !isSR) match = false;
        }

        if (match) {
            row.style.display = '';
            visibleCount++;
        } else {
            row.style.display = 'none';
        }
    });

    const countElem = document.getElementById('filterUserCount');
    if (countElem) countElem.innerText = visibleCount;
}

document.addEventListener('DOMContentLoaded', () => {
    const inputs = ['filterSearch', 'filterPosition', 'filterRegion'];
    inputs.forEach(id => {
        const el = document.getElementById(id);
        if (el) {
            el.addEventListener('input', applyClientUserFilter);
            el.addEventListener('change', applyClientUserFilter);
        }
    });

    const selects = ['filterRole', 'filterStatus', 'filterPermission'];
    selects.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.addEventListener('change', applyClientUserFilter);
    });
});
</script>

