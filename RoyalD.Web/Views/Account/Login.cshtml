@{
    ViewData["Title"] = "เข้าสู่ระบบ";
    Layout = null;
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>ระบบลูกหนี้ บริษัท รอแยล-ดี(ไทยแลนด์) จำกัด — เข้าสู่ระบบ</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700;800&family=Noto+Sans+Thai:wght@300;400;500;600;700&display=swap" />
    <style>
        body {
            background: linear-gradient(135deg, #0f766e 0%, #1a2942 100%);
            min-height: 100vh;
            font-family: 'Sarabun', 'Noto Sans Thai', 'Leelawadee UI', 'Leelawadee', Tahoma, Arial, sans-serif;
        }
        .login-card {
            border-radius: 20px;
            box-shadow: 0 25px 60px rgba(0,0,0,0.4);
            max-width: 460px;
            border: 1px solid rgba(255,255,255,0.2);
            background: #ffffff;
        }
        .logo-circle {
            width: 85px; height: 85px;
            background: linear-gradient(135deg, #0d9488 0%, #0f766e 100%);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 16px;
            box-shadow: 0 8px 20px rgba(13,148,136,0.35);
        }
        .form-control:focus {
            border-color: #0d9488;
            box-shadow: 0 0 0 0.25rem rgba(13,148,136,0.25);
        }
        .btn-teal {
            background: #0d9488;
            color: #ffffff;
            border: none;
            transition: all 0.2s ease;
        }
        .btn-teal:hover {
            background: #0f766e;
            color: #ffffff;
            transform: translateY(-1px);
        }
        .gps-box {
            border-radius: 12px;
            padding: 12px;
            margin-bottom: 16px;
            font-size: 0.88rem;
            transition: all 0.3s ease;
        }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center p-3">
<div class="login-card card p-4 w-100">
    <div class="text-center mb-4">
        <div class="text-center mb-3">
            <img src="/images/company_building.jpg?v=20261106" alt="บจก.รอแยล-ดี (ไทยแลนด์)" style="width: 165px; height: 165px; object-fit: cover; border-radius: 22px; box-shadow: 0 12px 30px rgba(13,148,136,0.28); border: 3.5px solid #ffffff; outline: 2.5px solid #0d9488; margin: 0 auto; display: block;" /></div>
        <h3 class="fw-bold mb-1" style="color:#0f766e;">ระบบลูกหนี้</h3>
        <h5 class="fw-bold text-dark mb-1">บริษัท รอแยล-ดี(ไทยแลนด์) จำกัด</h5>
        <small class="text-muted fw-semibold">ระบบติดตามบิลขายและการชำระเงิน (Cloud Production)</small>
    </div>

    <!-- GPS Status Notice -->
    <div id="gps-status-box" class="gps-box alert alert-warning mb-3">
        <div class="d-flex align-items-center gap-2">
            <div class="spinner-border spinner-border-sm text-warning" role="status" id="gps-spinner"></div>
            <i class="bi bi-geo-alt-fill text-danger fs-5 d-none" id="gps-icon-warn"></i>
            <i class="bi bi-check-circle-fill text-success fs-5 d-none" id="gps-icon-ok"></i>
            <span id="gps-status-text" class="fw-semibold">กำลังตรวจสอบพิกัดตำแหน่ง GPS...</span>
        </div>
        <div id="gps-help-text" class="small text-muted mt-1">
            ระบบกำหนดให้ต้องอนุญาตพิกัดตำแหน่ง (GPS Location) จึงจะสามารถเข้าใช้งานได้
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger py-2" style="border-radius:10px; font-size:0.9rem;">
            <i class="bi bi-exclamation-triangle-fill me-1"></i>
            @Html.ValidationSummary(true)
        </div>
    }

    @if (Context.Request.Query["expired"] == "1")
    {
        <div class="alert alert-warning py-2" style="border-radius:10px; font-size:0.9rem;">
            <i class="bi bi-clock-history me-1"></i> หมดเวลาการเข้าใช้งานตามที่กำหนด กรุณาเข้าสู่ระบบใหม่
        </div>
    }

    @if (Context.Request.Query["blocked"] == "capture")
    {
        <div class="alert alert-danger py-2 fw-bold" style="border-radius:10px; font-size:0.88rem;">
            <i class="bi bi-shield-x me-1"></i> ตรวจพบการพยายามแคปภาพหน้าจอ! บัญชีของคุณไม่มีสิทธิ์แคปภาพ ระบบได้ทำการล็อกเอาต์อัตโนมัติ กรุณาเข้าสู่ระบบใหม่
        </div>
    }
    @if (Context.Request.Query["blocked"] == "idle")
    {
        <div class="alert alert-warning py-2 fw-bold text-center" style="border-radius:10px; font-size:0.88rem;">
            <i class="bi bi-clock-history me-1"></i> ระบบได้ทำการล็อกเอาต์อัตโนมัติ เนื่องจากไม่มีการใช้งานเกิน 5 นาที เพื่อความปลอดภัย
        </div>
    }
    @if (Context.Request.Query["blocked"] == "concurrent")
    {
        <div class="alert alert-danger py-2 fw-bold text-center shadow-sm" style="border-radius:10px; font-size:0.88rem; border-left: 5px solid #dc3545; background-color: #fff5f5; color: #b91c1c;">
            <i class="bi bi-shield-lock-fill me-1"></i> มีการเข้าสู่ระบบจากเครื่องหรืออุปกรณ์อื่นแล้ว ระบบจึงออกจากระบบบนเครื่องนี้โดยอัตโนมัติ (1 บัญชีใช้งานได้ทีละ 1 เครื่อง)
        </div>
    }

    <form method="post" action="/Account/Login" asp-antiforgery="false" id="login-form" autocomplete="off" onsubmit="return validateGpsBeforeSubmit(event)">
        <!-- AntiForgery not needed on Login -->
        <!-- Hidden geolocation fields -->
        <input type="hidden" name="lat" id="lat-field" value=""/>
        <input type="hidden" name="lng" id="lng-field" value=""/>
        <input type="hidden" name="accuracy" id="accuracy-field" value=""/>
        <input type="hidden" name="locationName" id="location-name-field" value=""/>

        <div class="mb-3">
            <label class="form-label fw-bold small text-muted">ชื่อผู้ใช้งาน (Username)</label>
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                <input type="text" name="username" id="username-input" class="form-control" placeholder="ชื่อผู้ใช้งาน" required autofocus autocomplete="off" autocorrect="off" autocapitalize="none" spellcheck="false" value=""/>
            </div>
        </div>
        <div class="mb-4">
            <label class="form-label fw-bold small text-muted">รหัสผ่าน (Password)</label>
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                <input type="password" name="password" id="pwd" class="form-control" placeholder="กรอกรหัสผ่าน" required autocomplete="new-password"/>
                <button type="button" class="btn btn-outline-secondary" onclick="togglePwd()">
                    <i class="bi bi-eye" id="eye-icon"></i>
                </button>
            </div>
        </div>

        <button type="submit" id="submit-btn" class="btn btn-teal w-100 py-2 fs-6 fw-bold shadow-sm" style="border-radius:10px;" disabled>
            <i class="bi bi-box-arrow-in-right me-1"></i> เข้าสู่ระบบ
        </button>
    </form>

    <div class="text-center mt-3" id="gps-retry-block" style="display:none;">
        <button type="button" class="btn btn-outline-primary btn-sm" onclick="requestLocationPermission()">
            <i class="bi bi-geo-alt"></i> กดเพื่ออนุญาตเข้าถึงตำแหน่ง GPS อีกครั้ง
        </button>
    </div>

    <hr class="my-4"/>
    <div class="text-center text-muted small">
        <i class="bi bi-shield-lock text-success"></i> ระบบความปลอดภัยระดับองค์กร บันทึกพิกัดและเวลาใช้งานทุกครั้ง
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
function togglePwd() {
    var pwd = document.getElementById('pwd');
    var icon = document.getElementById('eye-icon');
    if (pwd.type === 'password') { pwd.type = 'text'; icon.className = 'bi bi-eye-slash'; }
    else { pwd.type = 'password'; icon.className = 'bi bi-eye'; }
}

let hasGps = false;
let gpsWatchId = null;
let gpsTimeoutTimer = null;
let bestGpsSample = null;
let isGpsLocked = false;

function requestLocationPermission() {
    const box = document.getElementById('gps-status-box');
    const spinner = document.getElementById('gps-spinner');
    const iconWarn = document.getElementById('gps-icon-warn');
    const iconOk = document.getElementById('gps-icon-ok');
    const statusText = document.getElementById('gps-status-text');
    const helpText = document.getElementById('gps-help-text');
    const submitBtn = document.getElementById('submit-btn');
    const retryBlock = document.getElementById('gps-retry-block');

    // Reset state
    isGpsLocked = false;
    bestGpsSample = null;
    if (gpsWatchId !== null) {
        navigator.geolocation.clearWatch(gpsWatchId);
        gpsWatchId = null;
    }
    if (gpsTimeoutTimer) {
        clearTimeout(gpsTimeoutTimer);
        gpsTimeoutTimer = null;
    }

    spinner.classList.remove('d-none');
    iconWarn.classList.add('d-none');
    iconOk.classList.add('d-none');
    box.className = 'gps-box alert alert-warning mb-3 shadow-sm';
    statusText.innerText = 'กำลังเปิดชิปดาวเทียม GPS เพื่อความแม่นยำสูงสุด...';
    helpText.innerHTML = '🛰️ กำลังค้นหาสัญญาณดาวเทียม (กรุณากด "อนุญาต / Allow" หากมีข้อความแจ้งเตือน)';

    if (!navigator.geolocation) {
        spinner.classList.add('d-none');
        iconWarn.classList.remove('d-none');
        box.className = 'gps-box alert alert-danger mb-3';
        statusText.innerText = 'เบราว์เซอร์นี้ไม่รองรับการระบุตำแหน่ง GPS';
        helpText.innerText = 'กรุณาใช้งานผ่าน Google Chrome, Edge หรือ Safari บนมือถือ/คอมพิวเตอร์';
        retryBlock.style.display = 'block';
        return;
    }

    // High-accuracy Geolocation Options
    const geoOptions = {
        enableHighAccuracy: true, // บังคับใช้งานชิป GPS จากดาวเทียมจริง
        timeout: 12000,           // ให้เวลาระบบ 12 วินาทีเพื่อล็อคสัญญาณดาวเทียม
        maximumAge: 0             // ไม่รับตำแหน่งแคชเก่าเด็ดขาด ต้องเป็นสัญญาณสด ณ วินาทีนี้
    };

    // ฟังก์ชันประมวลผลและล็อคพิกัดที่ดีที่สุด
    async function finalizeLocation(pos) {
        if (isGpsLocked) return;
        isGpsLocked = true;

        if (gpsWatchId !== null) {
            navigator.geolocation.clearWatch(gpsWatchId);
            gpsWatchId = null;
        }
        if (gpsTimeoutTimer) {
            clearTimeout(gpsTimeoutTimer);
            gpsTimeoutTimer = null;
        }

        hasGps = true;
        const lat = pos.coords.latitude;
        const lng = pos.coords.longitude;
        const accuracy = Math.round(pos.coords.accuracy || 0);

        document.getElementById('lat-field').value = lat.toFixed(7);
        document.getElementById('lng-field').value = lng.toFixed(7);
        const accField = document.getElementById('accuracy-field');
        if (accField) accField.value = accuracy;

        statusText.innerText = 'กำลังระบุชื่อสถานที่ ถนน ตำบล อำเภอ และจังหวัด...';
        helpText.innerHTML = `<i class="bi bi-crosshair"></i> พิกัด: ${lat.toFixed(6)}, ${lng.toFixed(6)} (รัศมี ±${accuracy} ม.)`;

        let detectedLocation = await getDetailedThaiLocation(lat, lng);

        // Fallback ออฟไลน์หากไม่สามารถติดต่อภายนอกได้
        if (!detectedLocation) {
            detectedLocation = resolveLocationName(lat, lng);
        }

        document.getElementById('location-name-field').value = detectedLocation;

        spinner.classList.add('d-none');
        iconWarn.classList.add('d-none');
        iconOk.classList.remove('d-none');
        box.className = 'gps-box alert alert-success mb-3 shadow-sm border-success';
        
        let accBadge = accuracy <= 20 
            ? `<span class="badge bg-success ms-1"><i class="bi bi-shield-check"></i> แม่นยำสูงสุด (±${accuracy} ม.)</span>`
            : (accuracy <= 60 
                ? `<span class="badge bg-primary ms-1"><i class="bi bi-geo-alt"></i> แม่นยำดี (±${accuracy} ม.)</span>`
                : `<span class="badge bg-secondary ms-1">ความแม่นยำ ±${accuracy} ม.</span>`);

        statusText.innerHTML = `<strong>ล็อคพิกัด GPS แม่นยำสูงสุดสำเร็จ</strong> ${accBadge}`;
        helpText.innerHTML = `📍 <strong>${detectedLocation}</strong><br/><small class="text-muted"><i class="bi bi-crosshair"></i> พิกัดดาวเทียม: ${lat.toFixed(6)}, ${lng.toFixed(6)}</small>`;
        submitBtn.disabled = false;
        retryBlock.style.display = 'none';
    }

    // วนรับสัญญาณดาวเทียมเพื่อคัดเลือกพิกัดที่แม่นยำที่สุด (Multi-Sample GPS Locking)
    gpsWatchId = navigator.geolocation.watchPosition(
        function(pos) {
            const acc = pos.coords.accuracy || 9999;
            if (!bestGpsSample || acc < (bestGpsSample.coords.accuracy || 9999)) {
                bestGpsSample = pos;
            }

            // หากสัญญาณดาวเทียมแม่นยำสูงระดับ <= 25 เมตร ให้ล็อคทันทีไม่ต้องรอ
            if (acc <= 25) {
                finalizeLocation(pos);
                return;
            }

            // แสดงสถานะการปรับเทียบความแม่นยำให้ผู้ใช้เห็น
            statusText.innerText = 'กำลังปรับเทียบสัญญาณ GPS ให้แม่นยำสูงสุด...';
            helpText.innerHTML = `🛰️ สัญญาณดาวเทียมสด: ความคลาดเคลื่อนปัจจุบัน ±${Math.round(acc)} เมตร (กำลังปรับค่าให้ละเอียดที่สุด)...`;
        },
        function(err) {
            if (isGpsLocked) return;
            if (bestGpsSample) {
                finalizeLocation(bestGpsSample);
                return;
            }

            hasGps = false;
            spinner.classList.add('d-none');
            iconWarn.classList.remove('d-none');
            iconOk.classList.add('d-none');
            box.className = 'gps-box alert alert-danger mb-3';
            submitBtn.disabled = true;
            retryBlock.style.display = 'block';

            if (err.code === 1) { // PERMISSION_DENIED
                statusText.innerText = '⚠️ ไม่อนุญาตให้เข้าถึงตำแหน่งที่ตั้ง';
                helpText.innerText = 'คุณต้องกด "อนุญาต (Allow)" การเข้าถึงตำแหน่งที่ตั้ง จึงจะสามารถเข้าสู่ระบบได้';
            } else if (err.code === 2) { // POSITION_UNAVAILABLE
                statusText.innerText = '⚠️ ไม่สามารถระบุตำแหน่งที่ตั้งได้';
                helpText.innerText = 'กรุณาเปิดบริการ Location Services (GPS) ในอุปกรณ์ของคุณ';
            } else {
                statusText.innerText = '⚠️ หมดเวลาการค้นหาตำแหน่งที่ตั้ง';
                helpText.innerText = 'กรุณากดปุ่มลองใหม่อีกครั้ง';
            }
        },
        geoOptions
    );

    // Timeout fallback: หากผ่านไป 5 วินาทีแล้ว ให้ใช้ตัวอย่างพิกัดที่ดีที่สุดที่รวบรวมมาได้ทันที
    gpsTimeoutTimer = setTimeout(function() {
        if (!isGpsLocked && bestGpsSample) {
            finalizeLocation(bestGpsSample);
        }
    }, 5500);
}

async function getDetailedThaiLocation(lat, lng) {
    let place = '';
    let road = '';
    let subdistrict = '';
    let district = '';
    let province = '';

    // วิธีที่ 1: ดึงจาก OpenStreetMap Nominatim zoom=18 (ความแม่นยำระดับอาคาร ถนน ซอย และตำบล/แขวง)
    try {
        const osmRes = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&zoom=18&addressdetails=1&accept-language=th`, { signal: AbortSignal.timeout(3500) });
        if (osmRes.ok) {
            const osmData = await osmRes.json();
            if (osmData && osmData.address) {
                const a = osmData.address;
                place = a.building || a.amenity || a.shop || a.office || a.tourism || a.leisure || '';
                road = a.road || a.street || a.soi || '';
                subdistrict = a.suburb || a.subdistrict || a.quarter || a.village || a.neighbourhood || '';
                district = a.county || a.district || a.city_district || a.town || '';
                province = a.province || a.state || '';
            }
        }
    } catch(e) {}

    // วิธีที่ 2: เสริมข้อมูลจาก BigDataCloud หากข้อมูลระดับตำบลหรืออำเภอยังไม่สมบูรณ์
    try {
        const bdcRes = await fetch(`https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${lat}&longitude=${lng}&localityLanguage=th`, { signal: AbortSignal.timeout(3500) });
        if (bdcRes.ok) {
            const bdcData = await bdcRes.json();
            if (!province) province = bdcData.principalSubdivision || '';

            if (bdcData.localityInfo && Array.isArray(bdcData.localityInfo.administrative)) {
                const adminList = bdcData.localityInfo.administrative;
                if (!subdistrict) {
                    const subItem = adminList.find(x => x.adminLevel === 8 || (x.name && (x.name.startsWith('ตำบล') || x.name.startsWith('แขวง'))));
                    if (subItem) subdistrict = subItem.name;
                }
                if (!district) {
                    const amphoeItem = adminList.find(a => a.adminLevel === 6 || (a.name && (a.name.startsWith('อำเภอ') || a.name.startsWith('เขต'))));
                    if (amphoeItem) district = amphoeItem.name;
                }
                if (!province) {
                    const pItem = adminList.find(a => a.adminLevel === 4 || (a.name && (a.name.startsWith('จังหวัด') || a.name.includes('กรุงเทพ'))));
                    if (pItem) province = pItem.name;
                }
            }
            if (!subdistrict && bdcData.locality) subdistrict = bdcData.locality;
            if (!district && bdcData.city) district = bdcData.city;
        }
    } catch(e) {}

    return formatFullThaiAddress(place, road, subdistrict, district, province, lat, lng);
}

function formatFullThaiAddress(place, road, subdistrict, district, province, lat, lng) {
    let cleanProv = (province || '').trim();
    if (cleanProv.startsWith('จังหวัด')) cleanProv = cleanProv.replace(/^จังหวัด\s*/, '');
    else if (cleanProv.startsWith('จ.')) cleanProv = cleanProv.replace(/^จ\.\s*/, '');
    cleanProv = cleanProv.trim();

    let cleanDist = (district || '').trim();
    cleanDist = cleanDist.replace(/^(อำเภอ|อ\.|เขต|แขวง|เทศบาลนคร|เทศบาลเมือง|เทศบาลตำบล)\s*/, '').trim();

    let cleanSub = (subdistrict || '').trim();
    cleanSub = cleanSub.replace(/^(ตำบล|ต\.|แขวง|เทศบาลนคร|เทศบาลเมือง|เทศบาลตำบล)\s*/, '').trim();

    let cleanRoad = (road || '').trim();
    if (cleanRoad && !cleanRoad.startsWith('ถ.') && !cleanRoad.startsWith('ถนน') && !cleanRoad.startsWith('ซอย') && !cleanRoad.startsWith('ซ.')) {
        cleanRoad = 'ถ.' + cleanRoad;
    }

    let cleanPlace = (place || '').trim();
    if (cleanPlace === cleanRoad || cleanPlace === cleanSub || cleanPlace === cleanDist) {
        cleanPlace = '';
    }

    // ตรวจสอบว่าเป็นพื้นที่ กรุงเทพมหานคร หรือไม่
    const isBkk = cleanProv.includes('กรุงเทพ') || cleanDist.includes('บางพลัด') || cleanDist.includes('บางอ้อ') || cleanDist.includes('บางซื่อ') || cleanDist.includes('ดุสิต') || cleanDist.includes('จตุจักร');
    
    let parts = [];
    if (cleanPlace) parts.push(cleanPlace);
    if (cleanRoad) parts.push(cleanRoad);

    if (isBkk) {
        if (cleanDist.includes('บางพลัด') || cleanDist.includes('บางอ้อ')) {
            cleanDist = 'บางพลัด';
            if (!cleanSub) cleanSub = 'บางอ้อ';
        } else if (cleanDist.includes('บางซื่อ')) {
            cleanDist = 'บางซื่อ';
        }

        if (cleanSub) parts.push('แขวง' + cleanSub);
        if (cleanDist) parts.push('เขต' + cleanDist);
        parts.push('กรุงเทพมหานคร');
    } else {
        if (cleanProv.includes('นนทบุรี')) {
            cleanProv = 'นนทบุรี';
            if (cleanDist.includes('บางบัวทอง') || cleanSub.includes('โสนลอย') || cleanSub.includes('พิมลราช')) {
                cleanDist = 'บางบัวทอง';
            } else if (cleanDist.includes('บางใหญ่') || cleanSub.includes('เสาธงหิน')) {
                cleanDist = 'บางใหญ่';
            }
        }

        if (cleanSub) parts.push('ต.' + cleanSub);
        if (cleanDist) parts.push('อ.' + cleanDist);
        if (cleanProv) parts.push('จ.' + cleanProv);
    }

    let result = parts.join(' ').trim();
    if (!result) {
        return resolveLocationName(lat, lng);
    }
    return result;
}

function resolveLocationName(lat, lng) {
    // เขตบางพลัด / บางซื่อ กรุงเทพมหานคร (Lat 13.78 - 13.825, Lng 100.48 - 100.535) สำนักงานใหญ่
    if (lat >= 13.78 && lat <= 13.825 && lng >= 100.48 && lng <= 100.535) {
        if (lng <= 100.512) return 'เขตบางพลัด กรุงเทพมหานคร';
        return 'เขตบางซื่อ กรุงเทพมหานคร';
    }

    // นนทบุรี
    if (lat >= 13.825 && lat <= 14.10 && lng >= 100.18 && lng <= 100.60) {
        if (lat >= 13.95 && lng <= 100.35) return 'อ.ไทรน้อย จ.นนทบุรี';
        if (lat >= 13.905 && lng <= 100.455) return 'อ.บางบัวทอง จ.นนทบุรี';
        if (lat >= 13.89 && lng > 100.455) return 'อ.ปากเกร็ด จ.นนทบุรี';
        if (lat < 13.84 && lng <= 100.51) return 'อ.บางกรวย จ.นนทบุรี';
        if (lat >= 13.825 && lat < 13.905 && lng >= 100.30 && lng <= 100.455) return 'อ.บางใหญ่ จ.นนทบุรี';
        return 'อ.เมืองนนทบุรี จ.นนทบุรี';
    }
    if (lat >= 13.60 && lat <= 13.95 && lng >= 100.40 && lng <= 100.85) return 'กรุงเทพมหานคร';
    if (lat >= 13.95 && lat <= 14.20 && lng >= 100.45 && lng <= 100.85) return 'จ.ปทุมธานี';
    if (lat >= 13.45 && lat < 13.65 && lng >= 100.50 && lng <= 100.90) return 'จ.สมุทรปราการ';
    if (lat >= 13.45 && lat <= 13.65 && lng >= 100.15 && lng < 100.45) return 'จ.สมุทรสาคร';
    if (lat >= 13.70 && lat <= 14.10 && lng >= 99.90 && lng < 100.35) return 'จ.นครปฐม';
    if (lat >= 12.50 && lat <= 13.50 && lng >= 100.80 && lng <= 101.50) return 'จ.ชลบุรี';
    if (lat >= 18.50 && lat <= 19.50 && lng >= 98.50 && lng <= 99.50) return 'จ.เชียงใหม่';
    if (lat >= 16.00 && lat <= 17.00 && lng >= 102.50 && lng <= 103.20) return 'จ.ขอนแก่น';
    if (lat >= 14.50 && lat <= 15.50 && lng >= 101.50 && lng <= 102.50) return 'จ.นครราชสีมา';
    if (lat >= 6.80 && lat <= 7.30 && lng >= 100.40 && lng <= 100.80) return 'จ.สงขลา (หาดใหญ่)';
    if (lat >= 7.75 && lat <= 8.20 && lng >= 98.25 && lng <= 98.45) return 'จ.ภูเก็ต';
    return 'ประเทศไทย';
}

function validateGpsBeforeSubmit(e) {
    if (!hasGps || !document.getElementById('lat-field').value) {
        e.preventDefault();
        alert('⚠️ จำเป็นต้องอนุญาตการระบุตำแหน่งที่ตั้ง (GPS Location) จึงจะสามารถเข้าสู่ระบบได้ กรุณากดอนุญาตตำแหน่งในเบราว์เซอร์');
        requestLocationPermission();
        return false;
    }
    return true;
}

function clearLoginInputs() {
    var u = document.getElementById('username-input');
    var p = document.getElementById('pwd');
    if (u) u.value = '';
    if (p) p.value = '';
}

window.addEventListener('pageshow', function() {
    clearLoginInputs();
});

document.addEventListener('DOMContentLoaded', () => {
    clearLoginInputs();
    setTimeout(clearLoginInputs, 50);
    setTimeout(clearLoginInputs, 200);
    requestLocationPermission();
});
</script>
</body>
</html>

