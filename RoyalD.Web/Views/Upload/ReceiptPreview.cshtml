@using RoyalD.Web.Services
@model ReceiptPreviewResult
@{
    ViewData["Title"] = "ศูนย์ตรวจสอบใบเสร็จรับเงินก่อนจับคู่บิล";
}

<style>
.preview-card { border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.07); margin-bottom: 24px; }
.dup-table th { background: #1e293b; color: white; padding: 10px 12px; font-size: 0.90rem; }
.dup-table td { padding: 10px 12px; border-bottom: 1px solid #f1f5f9; vertical-align: middle; font-size: 0.88rem; }
.badge-new { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; border-radius: 20px; padding: 4px 10px; font-size: 0.82rem; font-weight: 700; }
.badge-same { background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; border-radius: 20px; padding: 4px 10px; font-size: 0.82rem; font-weight: 700; }
.badge-changed { background: #fef9c3; color: #854d0e; border: 1px solid #fde68a; border-radius: 20px; padding: 4px 10px; font-size: 0.82rem; font-weight: 700; }
.badge-notfound { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; border-radius: 20px; padding: 4px 10px; font-size: 0.82rem; font-weight: 700; }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1 fw-bold text-success">
            <i class="bi bi-receipt-cutoff me-2"></i>ระบบตรวจสอบใบเสร็จรับเงินก่อนจับคู่บิล (Pre-Match Verification)
        </h3>
        <p class="text-muted mb-0 small">
            ไฟล์: <strong>@Model.FileName</strong> | ข้อมูลใบเสร็จล่าสุดในไฟล์: <strong>@(Model.LatestDate != DateTime.MinValue ? Model.LatestDate.ToString("dd/MM/yyyy") : "-")</strong> | ตรวจสอบทั้งหมด <strong>@Model.TotalRows.ToString("N0")</strong> รายการ
        </p>
    </div>
    <form method="post" asp-action="CancelReceiptPreview" id="cancelFormTop">
        @Html.AntiForgeryToken()
        <input type="hidden" name="previewId" value="@Model.PreviewId" />
        <button type="submit" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> ยกเลิกและกลับหน้าอัปโหลด
        </button>
    </form>
</div>

<!-- 4 Summary Metrics Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-success bg-opacity-10 border-start border-success border-4 h-100">
            <div class="card-body py-3">
                <div class="text-success fw-bold small text-uppercase">
                    <i class="bi bi-check-circle-fill me-1"></i> บิลใหม่พร้อมจับคู่
                </div>
                <div class="fs-2 fw-black text-success">
                    @Model.NewMatchCount.ToString("N0") <small class="fs-6 fw-normal text-muted">รายการ</small>
                </div>
                <div class="small text-muted">ยอดเงิน: <strong>@Model.NewMatchAmount.ToString("N2")</strong> บาท</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-info bg-opacity-10 border-start border-info border-4 h-100">
            <div class="card-body py-3">
                <div class="text-info-emphasis fw-bold small text-uppercase">
                    <i class="bi bi-shield-check me-1"></i> บิลเดิมที่บันทึกแล้ว (ตรงกัน)
                </div>
                <div class="fs-2 fw-black text-primary">
                    @Model.AlreadyMatchedCount.ToString("N0") <small class="fs-6 fw-normal text-muted">รายการ</small>
                </div>
                <div class="small text-muted">ยอดเงิน: <strong>@Model.AlreadyMatchedAmount.ToString("N2")</strong> บาท</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-danger bg-opacity-10 border-start border-danger border-4 h-100">
            <div class="card-body py-3">
                <div class="text-danger fw-bold small text-uppercase">
                    <i class="bi bi-exclamation-octagon-fill me-1"></i> ไม่พบบิลในระบบ
                </div>
                <div class="fs-2 fw-black text-danger">
                    @Model.NotFoundCount.ToString("N0") <small class="fs-6 fw-normal text-muted">รายการ</small>
                </div>
                <div class="small text-muted">ยอดเงิน: <strong>@Model.NotFoundAmount.ToString("N2")</strong> บาท (ยังไม่ได้นำเข้าบิลขาย)</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-warning bg-opacity-10 border-start border-warning border-4 h-100">
            <div class="card-body py-3">
                <div class="text-dark fw-bold small text-uppercase">
                    <i class="bi bi-pencil-square me-1"></i> เปลี่ยนเลขที่ใบเสร็จ
                </div>
                <div class="fs-2 fw-black text-dark">
                    @Model.ReceiptChangedCount.ToString("N0") <small class="fs-6 fw-normal text-muted">รายการ</small>
                </div>
                <div class="small text-muted">ยอดเงิน: <strong>@Model.ReceiptChangedAmount.ToString("N2")</strong> บาท</div>
            </div>
        </div>
    </div>
</div>

@if (Model.NotFoundCount > 0)
{
    <div class="alert alert-danger shadow-sm border-0 border-start border-danger border-4 d-flex align-items-center justify-content-between mb-4">
        <div>
            <h6 class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-2"></i>แจ้งเตือนทางบัญชี: พบใบเสร็จรับเงินที่ไม่พบบิลในระบบ @Model.NotFoundCount รายการ (ยอดเงิน @Model.NotFoundAmount.ToString("N2") บาท)</h6>
            <div class="small text-muted">อาจเกิดจากยังไม่ได้นำเข้าบิลขายประจำวัน หรือพิมพ์เลขที่บิลผิดในระบบ CD ระบบจะไม่สามารถจับคู่บิลเหล่านี้ได้จนกว่าจะนำเข้าบิลขายเข้าระบบ</div>
        </div>
        <button type="button" class="btn btn-outline-danger btn-sm fw-bold" onclick="filterTable('NOT_FOUND', document.querySelector('.btn-filter-notfound'))">
            ดูรายการที่ไม่พบบิล <i class="bi bi-arrow-right"></i>
        </button>
    </div>
}

<form asp-action="ConfirmReceiptImport" method="post" id="confirmReceiptForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="previewId" value="@Model.PreviewId" />

    <!-- Confirmation Decision & Actions Bar -->
    <div class="card shadow-sm border-0 mb-4 bg-light" style="border-radius: 12px;">
        <div class="card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <h6 class="fw-bold text-dark mb-1">
                    <i class="bi bi-check2-all text-success me-1"></i> พร้อมดำเนินการจับคู่บิลกับใบเสร็จรับเงิน
                </h6>
                <div class="small text-muted">
                    ระบบจะทำการบันทึกเลขที่ใบเสร็จ วันที่รับเงิน และปรับสถานะบิลขายและการ์ดลูกหนี้เป็น "ชำระเงินแล้ว (Paid)"
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary px-4 fw-bold" onclick="document.getElementById('cancelFormTop').submit()">
                    <i class="bi bi-x-circle me-1"></i> ยกเลิก
                </button>
                <button type="submit" class="btn btn-success btn-lg fw-bold px-5 shadow">
                    <i class="bi bi-check2-circle me-2"></i> ยืนยันการจับคู่บิล (@(Model.NewMatchCount + Model.AlreadyMatchedCount) รายการ)
                </button>
            </div>
        </div>
    </div>

    <!-- Table of all items -->
    <div class="card shadow-sm border-0 preview-card" style="border-radius: 12px; overflow: hidden;">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-2 flex-wrap gap-2">
            <span class="fw-bold fs-6">
                <i class="bi bi-table me-1"></i> รายละเอียดการตรวจสอบใบเสร็จรับเงินก่อนจับคู่บิล
            </span>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn btn-outline-light active" onclick="filterTable('ALL', this)">ทั้งหมด (@Model.TotalRows)</button>
                <button type="button" class="btn btn-outline-success" onclick="filterTable('NEW_MATCH', this)">บิลใหม่พร้อมจับคู่ (@Model.NewMatchCount)</button>
                <button type="button" class="btn btn-outline-danger btn-filter-notfound" onclick="filterTable('NOT_FOUND', this)">ไม่พบบิลในระบบ (@Model.NotFoundCount)</button>
                <button type="button" class="btn btn-outline-warning" onclick="filterTable('RECEIPT_CHANGED', this)">เปลี่ยนเลขที่ (@Model.ReceiptChangedCount)</button>
                <button type="button" class="btn btn-outline-info" onclick="filterTable('ALREADY_MATCHED', this)">บันทึกแล้ว (@Model.AlreadyMatchedCount)</button>
            </div>
        </div>

        @if (Model.ReceiptChangedCount > 0)
        {
            <div class="px-3 py-2 bg-warning bg-opacity-10 border-bottom d-flex gap-3 align-items-center">
                <span class="fw-bold text-dark small"><i class="bi bi-gear-fill me-1"></i> สำหรับรายการที่เปลี่ยนเลขที่ใบเสร็จ:</span>
                <button type="button" class="btn btn-sm btn-outline-dark fw-bold" onclick="checkAll(true)">
                    <i class="bi bi-check-all"></i> เลือกเปลี่ยนทั้งหมด
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary fw-bold" onclick="checkAll(false)">
                    <i class="bi bi-x-lg"></i> ไม่เปลี่ยน (ข้ามทั้งหมด)
                </button>
                <small class="text-muted ms-auto">รายการที่ไม่ได้เลือก ✓ จะคงเลขที่ใบเสร็จเดิมไว้</small>
            </div>
        }

        <div class="table-responsive" style="max-height: 520px; overflow-y: auto;">
            <table class="table dup-table align-middle mb-0 w-100" id="receiptTable">
                <thead>
                    <tr>
                        <th style="width: 50px;">ลำดับ</th>
                        <th style="width: 140px;">สถานะตรวจพบ</th>
                        <th style="width: 130px;">เลขที่บิล</th>
                        <th style="width: 110px;" class="text-center">วันที่รับเงิน</th>
                        <th style="width: 130px;">เลขที่ใบเสร็จ (ใหม่)</th>
                        <th style="width: 130px;">ใบเสร็จเดิมในระบบ</th>
                        <th style="min-width: 180px;">ลูกค้า</th>
                        <th style="width: 120px;" class="text-end">ยอดตามใบเสร็จ</th>
                        <th style="width: 120px;" class="text-end">ยอดบิลในระบบ</th>
                        <th style="width: 110px;" class="text-center">ตรวจสอบยอด</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int idx = 1; }
                    @foreach (var r in Model.AllRows)
                    {
                        <tr data-status="@r.Status" class="@(r.Status == "NEW_MATCH" ? "table-success bg-opacity-25" : (r.Status == "NOT_FOUND" ? "table-danger bg-opacity-25" : (r.Status == "RECEIPT_CHANGED" ? "table-warning bg-opacity-25" : "")))">
                            <td class="text-muted small">@(idx++)</td>
                            <td>
                                @if (r.Status == "NEW_MATCH")
                                {
                                    <span class="badge-new"><i class="bi bi-plus-circle me-1"></i>บิลใหม่พร้อมจับคู่</span>
                                }
                                else if (r.Status == "ALREADY_MATCHED")
                                {
                                    <span class="badge-same"><i class="bi bi-check-all me-1"></i>บันทึกแล้ว (ตรงกัน)</span>
                                }
                                else if (r.Status == "RECEIPT_CHANGED")
                                {
                                    <div class="d-flex align-items-center gap-1">
                                        <input type="checkbox" name="selectedDuplicates" value="@r.BillNo" class="dup-check form-check-input" checked />
                                        <span class="badge-changed"><i class="bi bi-pencil-fill me-1"></i>เปลี่ยนเลขที่</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="badge-notfound"><i class="bi bi-x-circle me-1"></i>ไม่พบบิลในระบบ</span>
                                }
                            </td>
                            <td><code class="fw-bold fs-6">@r.BillNo</code></td>
                            <td class="text-center small text-muted">@r.ReceiptDateStr</td>
                            <td><span class="fw-bold text-success">@r.ReceiptNo</span></td>
                            <td>
                                @if (!string.IsNullOrEmpty(r.ExistingReceiptNo))
                                {
                                    <span class="@(r.Status == "RECEIPT_CHANGED" ? "text-muted text-decoration-line-through" : "text-muted")">@r.ExistingReceiptNo</span>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(r.CustomerCode))
                                {
                                    <span class="badge bg-light text-dark border me-1">@r.CustomerCode</span>
                                }
                                <span class="fw-semibold">@(string.IsNullOrEmpty(r.CustomerName) ? "-" : r.CustomerName)</span>
                            </td>
                            <td class="text-end fw-bold text-dark">@r.Amount.ToString("N2")</td>
                            <td class="text-end text-muted">
                                @(r.BillAmount > 0 ? r.BillAmount.ToString("N2") : "-")
                            </td>
                            <td class="text-center">
                                @if (r.Status == "NOT_FOUND")
                                {
                                    <span class="badge bg-danger">ไม่พบบิล</span>
                                }
                                else if (r.BillAmount > 0 && Math.Abs(r.Amount - r.BillAmount) < 0.01m)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-lg"></i> ยอดตรงกัน</span>
                                }
                                else if (r.BillAmount > 0)
                                {
                                    <span class="badge bg-warning text-dark" title="ต่างกัน @r.AmountDiff.ToString("N2") บาท">
                                        <i class="bi bi-exclamation-triangle"></i> ยอดต่าง @r.AmountDiff.ToString("N2")
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</form>

@section Scripts {
<script>
function checkAll(val) {
    document.querySelectorAll('.dup-check').forEach(cb => cb.checked = val);
}

function filterTable(status, btn) {
    if (btn) {
        btn.parentElement.querySelectorAll('.btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
    }

    var rows = document.querySelectorAll('#receiptTable tbody tr');
    rows.forEach(r => {
        if (status === 'ALL') {
            r.style.display = '';
        } else {
            r.style.display = (r.getAttribute('data-status') === status) ? '' : 'none';
        }
    });
}
</script>
}
