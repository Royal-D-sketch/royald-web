@using RoyalD.Web.Services
@model ReceiptPreviewResult
@{
    ViewData["Title"] = "ตรวจสอบก่อนนำเข้าใบเสร็จ";
}

<style>
.preview-card { border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.07); margin-bottom: 24px; }
.dup-table th { background: #1e293b; color: white; padding: 10px 14px; font-size: 0.93rem; }
.dup-table td { padding: 10px 14px; border-bottom: 1px solid #f1f5f9; vertical-align: middle; font-size: 0.92rem; }
.badge-new { background: #dcfce7; color: #166534; border: 1px solid #bbf7d0; border-radius: 20px; padding: 3px 10px; font-size: 0.82rem; font-weight: 700; }
.badge-dup { background: #fef9c3; color: #854d0e; border: 1px solid #fde68a; border-radius: 20px; padding: 3px 10px; font-size: 0.82rem; font-weight: 700; }
</style>

<div class="d-flex align-items-center mb-4 gap-3">
    <div>
        <h3 class="mb-0 fw-bold" style="color:#b45309;"><i class="bi bi-exclamation-triangle-fill me-2"></i>พบใบเสร็จซ้ำ — โปรดยืนยันก่อนนำเข้า</h3>
        <span class="text-muted small">ไฟล์: <b>@Model.FileName</b></span>
    </div>
</div>

<form asp-action="ConfirmReceiptImport" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="previewId" value="@Model.PreviewId" />

    @if (Model.NewRows.Any())
    {
        <div class="preview-card card border-0">
            <div class="card-header fw-bold text-white" style="background:#059669; border-radius:12px 12px 0 0;">
                <i class="bi bi-check-circle me-2"></i>
                รายการใหม่ที่จะนำเข้า (<b>@Model.NewRows.Count</b> รายการ) — จะถูกนำเข้าอัตโนมัติ
            </div>
            <div class="card-body p-0">
                <div style="max-height:260px;overflow-y:auto;">
                <table class="table dup-table mb-0 w-100">
                    <thead><tr>
                        <th>เลขที่บิล</th>
                        <th>เลขที่ใบเสร็จ (ใหม่)</th>
                        <th>วันที่รับเงิน</th>
                        <th>สถานะ</th>
                    </tr></thead>
                    <tbody>
                    @foreach (var r in Model.NewRows)
                    {
                        <tr>
                            <td class="fw-bold text-primary">@r.BillNo</td>
                            <td>@r.NewReceiptNo</td>
                            <td>@r.ReceiptDateStr</td>
                            <td><span class="badge-new">ใหม่</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
            </div>
        </div>
    }

    @if (Model.Duplicates.Any())
    {
        <div class="preview-card card border-warning border-2">
            <div class="card-header fw-bold" style="background:#fef3c7; color:#92400e; border-radius:12px 12px 0 0;">
                <i class="bi bi-exclamation-triangle me-2"></i>
                พบใบเสร็จซ้ำ (<b>@Model.Duplicates.Count</b> รายการ) — เลือก ✓ รายการที่ต้องการอัปเดต
            </div>
            <div class="card-body p-0">
                <div class="px-3 py-2 bg-light border-bottom d-flex gap-3 align-items-center">
                    <button type="button" class="btn btn-sm btn-outline-warning fw-bold" onclick="checkAll(true)">
                        <i class="bi bi-check-all"></i> เลือกทั้งหมด
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary fw-bold" onclick="checkAll(false)">
                        <i class="bi bi-x-lg"></i> ยกเลิกทั้งหมด
                    </button>
                    <small class="text-muted">รายการที่ไม่ได้เลือก จะถูก <b>ข้าม</b> (ไม่อัปเดต)</small>
                </div>
                <div style="max-height:340px;overflow-y:auto;">
                <table class="table dup-table mb-0 w-100">
                    <thead><tr>
                        <th style="width:50px;"><input type="checkbox" id="checkAllBox" onchange="checkAll(this.checked)"></th>
                        <th>เลขที่บิล</th>
                        <th>ใบเสร็จเดิม</th>
                        <th>ใบเสร็จใหม่ (จากไฟล์)</th>
                        <th>วันที่รับเงิน</th>
                    </tr></thead>
                    <tbody>
                    @foreach (var r in Model.Duplicates)
                    {
                        <tr>
                            <td class="text-center">
                                <input type="checkbox" name="selectedDuplicates" value="@r.BillNo" class="dup-check form-check-input" />
                            </td>
                            <td class="fw-bold text-warning-emphasis">@r.BillNo</td>
                            <td><span class="text-muted text-decoration-line-through">@r.ExistingReceiptNo</span></td>
                            <td class="fw-bold text-success">@r.NewReceiptNo</td>
                            <td>@r.ReceiptDateStr</td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
            </div>
        </div>
    }

    <div class="d-flex gap-3 mt-3">
        <button type="submit" class="btn btn-success btn-lg fw-bold px-5">
            <i class="bi bi-check2-circle me-2"></i>ยืนยันนำเข้า
        </button>
        <button type="button" class="btn btn-outline-secondary btn-lg fw-bold px-4"
                onclick="document.getElementById('cancelForm').submit()">
            <i class="bi bi-x-circle me-2"></i>ยกเลิก
        </button>
    </div>
</form>

<form id="cancelForm" asp-action="CancelReceiptPreview" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="previewId" value="@Model.PreviewId" />
</form>

@section Scripts {
<script>
function checkAll(val) {
    document.querySelectorAll('.dup-check').forEach(cb => cb.checked = val);
    var cb = document.getElementById('checkAllBox');
    if (cb) cb.checked = val;
}
</script>
}
