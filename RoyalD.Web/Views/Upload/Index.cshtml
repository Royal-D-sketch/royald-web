@{
    ViewData["Title"] = "อัปโหลดข้อมูล";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
  <h3><i class="bi bi-cloud-upload"></i> Data Upload Portal</h3>

  <div class="row g-4 mt-2">

    <!-- กล่องที่ 1: บิลขาย -->
    <div class="col-12">
      <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
          <i class="bi bi-file-earmark-spreadsheet"></i> ส่วนที่ 1: อัปโหลดไฟล์รายละเอียดบิลขาย
          <small class="ms-2">(รองรับสูงสุด 8 ไฟล์พร้อมกัน)</small>
        </div>
        <div class="card-body">
          <form asp-action="UploadSalesBills" method="post" enctype="multipart/form-data" id="formBills">
            @Html.AntiForgeryToken()
            <div class="mb-3">
              <label class="form-label">เลือกไฟล์บิลขาย (.xls / .xlsx / .csv)</label>
              <input type="file" name="files" multiple accept=".xls,.xlsx,.csv" class="form-control" id="billFiles" required>
              <div class="form-text">เลือกได้สูงสุด 8 ไฟล์ในครั้งเดียว ระบบจะรวมไฟล์และนำเข้าอัตโนมัติ</div>
            </div>
            <div id="billFileList" class="mb-3"></div>
            <div class="progress mb-3 d-none" id="billProgress">
              <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" style="width:100%">กำลังประมวลผล...</div>
            </div>
            <button type="submit" class="btn btn-primary" onclick="showProgress('billProgress')"><i class="bi bi-upload"></i> อัปโหลดบิลขาย</button>
          </form>
        </div>
      </div>
    </div>

    <!-- กล่องที่ 2: การ์ดลูกหนี้ -->
    <div class="col-md-6">
      <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark">
          <i class="bi bi-person-lines-fill"></i> ส่วนที่ 2: อัปโหลดการ์ดลูกหนี้ค้างชำระ
        </div>
        <div class="card-body">
          <form asp-action="Upload" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="fileType" value="outstanding">
            <input type="hidden" name="isCurrentMonth" value="false">
            <div class="mb-3">
              <label class="form-label">เลือกไฟล์การ์ดลูกหนี้ (.xls / .xlsx / .csv)</label>
              <input type="file" name="file" accept=".xls,.xlsx,.csv" class="form-control" required>
              <div class="form-text">ระบบจะเขียนทับข้อมูลลูกหนี้ทั้งหมดที่สถานะ Outstanding</div>
            </div>
            <div class="progress mb-3 d-none" id="debtProgress">
              <div class="progress-bar progress-bar-striped progress-bar-animated bg-warning" style="width:100%">กำลังประมวลผล...</div>
            </div>
            <button type="submit" class="btn btn-warning" onclick="showProgress('debtProgress')"><i class="bi bi-upload"></i> อัปโหลดการ์ดลูกหนี้</button>
          </form>
        </div>
      </div>
    </div>

    <!-- กล่องที่ 3: สรุปรับเงิน -->
    <div class="col-md-6">
      <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
          <i class="bi bi-receipt"></i> ส่วนที่ 3: อัปโหลดสรุปการรับเงินตามใบเสร็จ
        </div>
        <div class="card-body">
          <form asp-action="UploadReceipt" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="mb-3">
              <label class="form-label">เลือกไฟล์สรุปรับเงิน (.xls / .xlsx / .csv)</label>
              <input type="file" name="file" accept=".xls,.xlsx,.csv" class="form-control" required>
              <div class="form-text">ระบบจะจับคู่ข้อมูลเลขที่ใบเสร็จและวันที่รับเงินเข้าสู่การ์ดลูกหนี้</div>
            </div>
            <div class="progress mb-3 d-none" id="receiptProgress">
              <div class="progress-bar progress-bar-striped progress-bar-animated bg-success" style="width:100%">กำลังประมวลผล...</div>
            </div>
            <button type="submit" class="btn btn-success" onclick="showProgress('receiptProgress')"><i class="bi bi-upload"></i> อัปโหลดสรุปรับเงิน</button>
          </form>
        </div>
      </div>
    </div>

  </div><!-- /row -->
</div>

<script>
function showProgress(id) {
  document.getElementById(id).classList.remove('d-none');
}
// แสดงรายชื่อไฟล์ที่เลือก
document.getElementById('billFiles').addEventListener('change', function(){
  var list = document.getElementById('billFileList');
  list.innerHTML = '';
  if (this.files.length > 8) {
    alert('เลือกได้สูงสุด 8 ไฟล์');
    this.value = '';
    return;
  }
  var ul = '<ul class="list-group">';
  for(var i=0; i<this.files.length; i++){
    ul += '<li class="list-group-item list-group-item-light py-1"><i class="bi bi-file-earmark-excel text-success"></i> '+this.files[i].name+'</li>';
  }
  ul += '</ul>';
  list.innerHTML = ul;
});
</script>
