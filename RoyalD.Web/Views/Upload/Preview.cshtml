@model RoyalD.Web.Models.ImportPreviewResult
@{
    ViewData["Title"] = "ตรวจสอบและยืนยันการนำเข้าบิลขาย";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1 fw-bold text-primary">
            <i class="bi bi-file-earmark-check-fill"></i> ตรวจสอบและยืนยันการนำเข้าข้อมูลบิลขาย
        </h3>
        <p class="text-muted mb-0 small">
            ไฟล์: <strong>@Model.FileName</strong> | ประจำเดือน: <strong>@Model.FileType</strong> | จำนวนบิลที่พบทั้งหมด: <strong>@Model.TotalRows.ToString("N0")</strong> บิล
        </p>
    </div>
    <form method="post" asp-action="CancelPreview">
        @Html.AntiForgeryToken()
        <input type="hidden" name="previewId" value="@Model.PreviewId" />
        <button type="submit" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> ยกเลิกและกลับหน้าอัปโหลด
        </button>
    </form>
</div>

<!-- Summary Metrics Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-success bg-opacity-10 border-start border-success border-4 h-100">
            <div class="card-body py-3">
                <div class="text-success fw-bold small text-uppercase">
                    <i class="bi bi-plus-circle-fill me-1"></i> บิลใหม่ (ยังไม่เคยมี)
                </div>
                <div class="fs-2 fw-black text-success">
                    @Model.NewCount.ToString("N0") <small class="fs-6 fw-normal text-muted">บิล</small>
                </div>
                <div class="small text-muted">ยอดรวม: @Model.NewAmount.ToString("N2") บาท</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-warning bg-opacity-10 border-start border-warning border-4 h-100">
            <div class="card-body py-3">
                <div class="text-dark fw-bold small text-uppercase">
                    <i class="bi bi-arrow-repeat me-1"></i> บิลซ้ำ (ยอด/ข้อมูลเปลี่ยน)
                </div>
                <div class="fs-2 fw-black text-dark">
                    @Model.DuplicateChangedCount.ToString("N0") <small class="fs-6 fw-normal text-muted">บิล</small>
                </div>
                <div class="small text-muted">มียอดเงินในระบบเดิมไม่ตรงกัน</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-secondary bg-opacity-10 border-start border-secondary border-4 h-100">
            <div class="card-body py-3">
                <div class="text-muted fw-bold small text-uppercase">
                    <i class="bi bi-check-all me-1"></i> บิลซ้ำเดิม (ข้อมูลตรงกัน)
                </div>
                <div class="fs-2 fw-black text-secondary">
                    @Model.DuplicateSameCount.ToString("N0") <small class="fs-6 fw-normal text-muted">บิล</small>
                </div>
                <div class="small text-muted">มีข้อมูลสมบูรณ์ในระบบแล้ว</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-primary bg-opacity-10 border-start border-primary border-4 h-100">
            <div class="card-body py-3">
                <div class="text-primary fw-bold small text-uppercase">
                    <i class="bi bi-cash-stack me-1"></i> ยอดเงินรวมทั้งไฟล์
                </div>
                <div class="fs-3 fw-black text-primary">
                    @Model.TotalAmount.ToString("N2") <small class="fs-6 fw-normal text-muted">บาท</small>
                </div>
                <div class="small text-muted">รวม @Model.TotalRows รายการ</div>
            </div>
        </div>
    </div>
</div>

<!-- Confirmation Decision Box -->
<div class="card shadow-sm border-0 mb-4 bg-light" style="border-radius: 12px;">
    <div class="card-body p-4">
        <h5 class="fw-bold text-dark mb-3">
            <i class="bi bi-gear-wide-connected text-primary"></i> เลือกรูปแบบการนำเข้าข้อมูล
        </h5>
        
        <form method="post" asp-action="ConfirmImport" id="confirmForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="previewId" value="@Model.PreviewId" />

            <div class="mb-3">
                <div class="form-check p-3 bg-white rounded border mb-2 shadow-sm">
                    <input class="form-check-input ms-0 me-2" type="radio" name="importChoice" id="opt1" value="update" checked>
                    <label class="form-check-label fw-bold text-dark" for="opt1">
                        ?? นำเข้าบิลใหม่ทั้งหมด และอัปเดตทับบิลซ้ำที่มีการเปลี่ยนแปลงข้อมูล (แนะนำ)
                    </label>
                    <div class="small text-muted ms-4">
                        บิลใหม่จะถูกเพิ่มเข้าระบบ และบิลที่เคยมีอยู่แล้วจะถูกอัปเดตยอดสินค้าและข้อมูลให้เป็นปัจจุบันล่าสุด
                    </div>
                </div>

                <div class="form-check p-3 bg-white rounded border mb-2 shadow-sm">
                    <input class="form-check-input ms-0 me-2" type="radio" name="importChoice" id="opt2" value="skip">
                    <label class="form-check-label fw-bold text-dark" for="opt2">
                        ??? นำเข้าเฉพาะบิลใหม่เท่านั้น (ข้ามบิลซ้ำทั้งหมด)
                    </label>
                    <div class="small text-muted ms-4">
                        บิลใหม่จะถูกเพิ่มเข้าระบบ ส่วนบิลที่เคยมีเลขที่บิลนี้อยู่แล้วจะไม่ถูกแตะต้องใดๆ
                    </div>
                </div>
            </div>

            <!-- Hidden actual boolean fields -->
            <input type="hidden" name="updateDuplicates" id="updateDuplicates" value="true" />
            <input type="hidden" name="skipDuplicates" id="skipDuplicates" value="false" />

            <div class="d-flex gap-2 justify-content-end mt-4">
                <button type="button" class="btn btn-outline-secondary px-4" onclick="document.querySelector('form[action*=CancelPreview]').submit()">
                    <i class="bi bi-x-circle"></i> ยกเลิก
                </button>
                <button type="submit" class="btn btn-success btn-lg fw-bold px-5 shadow">
                    <i class="bi bi-check-circle-fill"></i> ยืนยันการนำเข้าข้อมูล (@Model.TotalRows บิล)
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Detailed Bills Table with Filter Tabs -->
<div class="card shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
        <span class="fw-bold fs-6">
            <i class="bi bi-table"></i> รายละเอียดบิลทั้งหมดในไฟล์ที่กำลังนำเข้า
        </span>
        <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn btn-outline-light active" onclick="filterTable('ALL', this)">ทั้งหมด (@Model.TotalRows)</button>
            <button type="button" class="btn btn-outline-success" onclick="filterTable('NEW', this)">บิลใหม่ (@Model.NewCount)</button>
            <button type="button" class="btn btn-outline-warning" onclick="filterTable('CHANGED', this)">บิลซ้ำ-ยอดเปลี่ยน (@Model.DuplicateChangedCount)</button>
            <button type="button" class="btn btn-outline-secondary" onclick="filterTable('SAME', this)">บิลซ้ำเดิม (@Model.DuplicateSameCount)</button>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="previewTable">
            <thead class="table-light">
                <tr>
                    <th style="width: 70px;">ลำดับ</th>
                    <th style="width: 140px;">สถานะตรวจพบ</th>
                    <th style="width: 110px;">เลขที่บิล</th>
                    <th style="width: 100px;" class="text-center">วันที่บิล</th>
                    <th style="width: 100px;">รหัสลูกค้า</th>
                    <th style="min-width: 180px;">ชื่อลูกค้า</th>
                    <th style="width: 120px;">เขต/จังหวัด</th>
                    <th style="width: 120px;">ผู้แทนขาย</th>
                    <th style="width: 80px;" class="text-center">รายการ</th>
                    <th style="width: 120px;" class="text-end">ยอดในไฟล์</th>
                    <th style="width: 120px;" class="text-end">ยอดเดิมในระบบ</th>
                </tr>
            </thead>
            <tbody>
                @{ int idx = 1; }
                @foreach (var b in Model.Items)
                {
                    <tr data-status="@b.StatusType" class="@(b.StatusType == "NEW" ? "table-success bg-opacity-25" : (b.StatusType == "CHANGED" ? "table-warning bg-opacity-25" : ""))">
                        <td class="text-muted small">@(idx++)</td>
                        <td>
                            @if (b.StatusType == "NEW")
                            {
                                <span class="badge bg-success"><i class="bi bi-plus-circle"></i> บิลใหม่</span>
                            }
                            else if (b.StatusType == "CHANGED")
                            {
                                <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle"></i> บิลซ้ำ (ยอดเปลี่ยน)</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary"><i class="bi bi-check-all"></i> บิลซ้ำเดิม</span>
                            }
                        </td>
                        <td><code class="fw-bold fs-6">@b.BillNo</code></td>
                        <td class="text-center small text-muted">@b.BillDate.ToString("dd/MM/yyyy")</td>
                        <td><span class="badge bg-light text-dark border">@b.CustomerCode</span></td>
                        <td class="fw-semibold">@b.CustomerName</td>
                        <td class="small text-muted">@b.District @b.Province</td>
                        <td class="small">@b.SalesRep</td>
                        <td class="text-center"><span class="badge bg-info text-dark">@b.ItemCount</span></td>
                        <td class="text-end fw-bold text-dark">@b.TotalAmount.ToString("N2")</td>
                        <td class="text-end text-muted small">
                            @(b.StatusType == "NEW" ? "-" : b.ExistingAmount.ToString("N2"))
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    document.querySelectorAll('input[name="importChoice"]').forEach(r => {
        r.addEventListener('change', function() {
            if (this.value === 'update') {
                document.getElementById('updateDuplicates').value = 'true';
                document.getElementById('skipDuplicates').value = 'false';
            } else {
                document.getElementById('updateDuplicates').value = 'false';
                document.getElementById('skipDuplicates').value = 'true';
            }
        });
    });

    function filterTable(status, btn) {
        document.querySelectorAll('.card-header .btn-group button').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const rows = document.querySelectorAll('#previewTable tbody tr');
        rows.forEach(r => {
            if (status === 'ALL' || r.getAttribute('data-status') === status) {
                r.style.display = '';
            } else {
                r.style.display = 'none';
            }
        });
    }
</script>
