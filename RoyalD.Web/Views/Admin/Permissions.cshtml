@using RoyalD.Web.Models
@model List<AppUser>
@{
    ViewData["Title"] = "ตั้งค่าสิทธิ์การเข้าถึงเมนู";
    var menus = ViewBag.Menus as Dictionary<string, string> ?? new Dictionary<string, string>();
    var permissions = ViewBag.Permissions as List<UserMenuPermission> ?? new List<UserMenuPermission>();
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0 text-dark fw-bold"><i class="bi bi-shield-lock-fill text-primary me-2"></i> ตั้งค่าสิทธิ์การใช้งาน</h4>
        <button class="btn btn-outline-secondary" onclick="location.reload()"><i class="bi bi-arrow-clockwise me-1"></i> รีเฟรช</button>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle mb-0">
                    <thead class="table-light text-center">
                        <tr>
                            <th class="text-start text-dark fw-bold" style="min-width: 250px;">ผู้ใช้งาน (Username)</th>
                            @foreach (var m in menus)
                            {
                                <th style="min-width: 150px; font-size: 0.9rem;">
                                    <div class="text-wrap">@m.Value</div>
                                    <div class="text-muted fw-normal" style="font-size: 0.75rem;">@m.Key</div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model)
                        {
                            if (u.Username.ToLower() == "admin") continue;
                            <tr>
                                <td class="fw-semibold">
                                    <i class="bi bi-person-fill text-secondary me-1"></i> @u.Username
                                    <div class="text-muted small fw-normal ms-3">@u.Position</div>
                                </td>
                                @foreach (var m in menus)
                                {
                                    var perm = permissions.FirstOrDefault(p => p.Username == u.Username && p.MenuKey == m.Key);
                                    // Default logic matching PermissionService
                                    bool isAllowed = true;
                                    if (perm != null) { isAllowed = perm.IsAllowed; }
                                    else {
                                        if (m.Key == "Upload") isAllowed = false;
                                    }

                                    <td class="text-center">
                                        <div class="form-check form-switch d-inline-block">
                                            <input class="form-check-input perm-toggle" type="checkbox" role="switch" 
                                                   data-username="@u.Username" 
                                                   data-menu="@m.Key" 
                                                   @(isAllowed ? "checked" : "")>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.querySelectorAll('.perm-toggle').forEach(el => {
        el.addEventListener('change', async function() {
            const username = this.getAttribute('data-username');
            const menuKey = this.getAttribute('data-menu');
            const isAllowed = this.checked;

            try {
                const res = await fetch('/Admin/UpdatePermissions', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, menuKey, isAllowed })
                });

                if (!res.ok) throw new Error('Failed to update');
                
                // Show toast or slight visual feedback
                this.classList.add('is-valid');
                setTimeout(() => this.classList.remove('is-valid'), 1500);

            } catch (err) {
                console.error(err);
                alert('เกิดข้อผิดพลาดในการบันทึกสิทธิ์');
                this.checked = !isAllowed; // revert
            }
        });
    });
</script>
}

