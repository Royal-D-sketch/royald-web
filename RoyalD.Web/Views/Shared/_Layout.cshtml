<script src="~/js/site.js"></script>

@if (User.Identity?.IsAuthenticated == true)
{
    var sessionTimeoutClaim = ViewContext.HttpContext.User.FindFirst("SessionTimeout")?.Value;
    int sessionSeconds = 0;
    if (int.TryParse(sessionTimeoutClaim, out var stMinutes) && stMinutes > 0)
    {
        sessionSeconds = stMinutes * 60;
    }
    else if (isSalesRep)
    {
        // ค่าเริ่มต้นสำหรับผู้แทนขาย: จำกัดเวลาใช้งานไม่เกิน 10 นาที (600 วินาที)
        sessionSeconds = 600;
    }

    // ขยายเวลาใช้งานและปิดระบบตัดการเชื่อมต่อเมื่ออยู่นิ่ง (No idle blackout)
    int idleMaxSeconds = 0; 
    sessionSeconds = 0; // ไม่จำกัดเวลาล็อกอิน

    <script>
    // ===== 1. Session & Inactivity settings =====
    const SESSION_SECONDS = @sessionSeconds;
    const IDLE_MAX_SECONDS = @idleMaxSeconds;

    let remainingSession = SESSION_SECONDS;
    let remainingIdle = IDLE_MAX_SECONDS;
    const timerEl = document.getElementById('timer-display');

    function resetIdleTimer() {
        remainingIdle = IDLE_MAX_SECONDS;
    }

    // ดักฟังการขยับรายการของผู้ใช้ (ขยับเมาส์, คลิก, เลื่อนหน้าจอ, กดปุ่ม, แตะจอสัมผัส)
    if (IDLE_MAX_SECONDS > 0) {
        ['mousemove', 'mousedown', 'keydown', 'touchstart', 'touchmove', 'scroll', 'click'].forEach(evt => {
            window.addEventListener(evt, resetIdleTimer, { passive: true });
        });
    }

    function updateSessionAndIdleTimers() {
        // ตรวจสอบ Inactivity Timeout (ไม่มีการขยับรายการนานเกิน 5 นาที)
        if (IDLE_MAX_SECONDS > 0) {
            remainingIdle--;
            if (remainingIdle <= 0) {
                clearInterval(masterTimerInterval);
                autoLogout('IDLE_INACTIVITY_5_MIN');
                return;
            }
        }

        // ตรวจสอบ Total Session Timeout (จำกัดเวลาล็อกอินไม่เกิน 10 นาที)
        if (SESSION_SECONDS > 0) {
            if (remainingSession <= 0) {
                clearInterval(masterTimerInterval);
                if (timerEl) timerEl.textContent = '00:00';
                autoLogout('SESSION_TIMEOUT_10_MIN');
                return;
            }
            const m = Math.floor(remainingSession / 60).toString().padStart(2, '0');
            const s = (remainingSession % 60).toString().padStart(2, '0');
            if (timerEl) timerEl.textContent = m + ':' + s;
            if (remainingSession <= 60) {
                const timerBox = document.getElementById('session-timer');
                if (timerBox) {
                    timerBox.className = 'badge bg-danger text-white px-2 py-1';
                }
            }
            remainingSession--;
        }
    }

    const masterTimerInterval = setInterval(updateSessionAndIdleTimers, 1000);

    function autoLogout(reason) {
        try {
            if (navigator.sendBeacon) {
                navigator.sendBeacon('/Account/ForceLogout', JSON.stringify({ reason: reason || 'SESSION_EXPIRED' }));
            }
        } catch(e) {}
        window.location.replace('/Account/Login?expired=1');
    }

    // ===== Sidebar Toggle =====
    function toggleSidebar() {
        const sb = document.getElementById('sidebar');
        if (sb) {
            sb.classList.toggle('collapsed');
            localStorage.setItem('sidebar_collapsed', sb.classList.contains('collapsed') ? '1' : '0');
            setTimeout(() => { window.dispatchEvent(new Event('resize')); }, 300);
        }
    }
    if (localStorage.getItem('sidebar_collapsed') === '1') {
        document.getElementById('sidebar')?.classList.add('collapsed');
    }

    // ===== PWA 1-Click Install Handler =====
    let deferredPrompt;
    window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;
    });

    window.addEventListener('appinstalled', () => {
        deferredPrompt = null;
        const btn = document.getElementById('pwaInstallBtn');
        if (btn) {
            btn.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> ติดตั้งแล้ว';
            btn.disabled = true;
        }
    });

    function triggerPwaInstall() {
        if (deferredPrompt) {
            deferredPrompt.prompt();
            deferredPrompt.userChoice.then((choiceResult) => {
                if (choiceResult.outcome === 'accepted') {
                    console.log('PWA installed');
                }
                deferredPrompt = null;
            });
        } else {
            alert('💡 วิธีติดตั้งไอคอนลงบนหน้าจอ Desktop:\n\n1. มองที่แถบช่องพิมพ์ URL ด้านบนขวาสุด จะมีไอคอน "รูปจอคอมฯ ลูกศรชี้ลง" หรือไอคอนรูปแอป (Install App)\n2. หรือกดปุ่ม 3 จุด (⋮) ที่มุมขวาบนสุดของ Chrome / Edge\n3. เลือก "บันทึกและแชร์" (Save and share) -> เลือก "ติดตั้งระบบลูกหนี้ รอแยล-ดี" (Install Royal-D)\n4. ไอคอนจะถูกสร้างบน Desktop พร้อมเปิดใช้งานเป็นแอปได้ทันที!');
        }
    }
    </script>

    @if (!canScreenCapture)
    {
