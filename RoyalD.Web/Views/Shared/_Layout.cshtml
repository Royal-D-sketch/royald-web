    </style>
        
        <canvas id="watermarkCanvas" width="450" height="250" style="display:none;"></canvas>
        <div class="security-watermark-overlay" id="watermarkOverlay"></div>

        <script>
        // =========================================================================
        //  ANTI-SCREEN CAPTURE & ANTI-RECORDING: INSTANT SOLID BLACKOUT + IMMEDIATE LOGOUT
        // =========================================================================
        (function() {
            let isBlackoutTriggered = false;

            // 1. Watermark แบบไดนามิกครอบคลุมทั้งจอ
            try {
                const canvas = document.getElementById('watermarkCanvas');
                if (canvas) {
                    const ctx = canvas.getContext('2d');
                    ctx.clearRect(0, 0, 450, 250);
                    ctx.save();
                    ctx.translate(225, 125);
                    ctx.rotate(-22 * Math.PI / 180);
                    ctx.textAlign = 'center';
                    
                    ctx.fillStyle = 'rgba(220, 38, 38, 0.45)';
                    ctx.font = 'bold 16px sans-serif';
                    const userName = '⚠️ @(User.Identity?.Name ?? "USER") - @(ViewContext.HttpContext.User.FindFirst("FullName")?.Value ?? "ผู้แทนขาย")';
                    ctx.fillText(userName, 0, -10);

                    ctx.fillStyle = 'rgba(15, 23, 42, 0.55)';
                    ctx.font = 'bold 13px sans-serif';
                    const nowStr = 'ห้ามบันทึกภาพ/อัดวิดีโอ ' + new Date().toLocaleDateString('th-TH');
                    ctx.fillText(nowStr, 0, 16);
                    ctx.restore();

                    const overlay = document.getElementById('watermarkOverlay');
                    if (overlay) {
                        overlay.style.backgroundImage = 'url(' + canvas.toDataURL('image/png') + ')';
                    }
                }
            } catch(e) {}

            function triggerScreenCaptureBlackout(reason) {
                // ปิดการจอดำสนิทเพื่อให้สามารถใช้งานเว็บได้ปกติ
                console.warn('Security capture warning:', reason);
            }

            // 2. ดักจับการใช้ Screen Recording API (WebRTC getDisplayMedia & MediaRecorder)
            if (navigator.mediaDevices && navigator.mediaDevices.getDisplayMedia) {
                navigator.mediaDevices.getDisplayMedia = function() {
                    triggerScreenCaptureBlackout('GET_DISPLAY_MEDIA_API');
                    return Promise.reject(new Error('Screen capture/recording prohibited'));
                };
            }
            if (window.MediaRecorder) {
                const OrigMediaRecorder = window.MediaRecorder;
                window.MediaRecorder = function(stream, options) {
                    triggerScreenCaptureBlackout('MEDIA_RECORDER_CONSTRUCTOR');
                    return new OrigMediaRecorder(stream, options);
                };
            }

            // 3. ตัวแปรเก็บสถานะการกดปุ่ม Modifier เพื่อดักจับ Win + Shift + S และ Snipping Tool
            let isShiftDown = false;
            let isMetaDown = false;
            let isCtrlDown = false;
            let isAltDown = false;

            window.addEventListener('keydown', function(e) {
                if (e.key === 'Shift' || e.code === 'ShiftLeft' || e.code === 'ShiftRight') isShiftDown = true;
                if (e.key === 'Meta' || e.key === 'OS' || e.code === 'MetaLeft' || e.code === 'MetaRight' || e.code === 'OSLeft' || e.code === 'OSRight') isMetaDown = true;
                if (e.key === 'Control' || e.code === 'ControlLeft' || e.code === 'ControlRight') isCtrlDown = true;
                if (e.key === 'Alt' || e.code === 'AltLeft' || e.code === 'AltRight') isAltDown = true;

                // 1. ปุ่ม PrintScreen / Snapshot (ทุกรูปแบบ)
                if (e.key === 'PrintScreen' || e.key === 'Snapshot' || e.code === 'PrintScreen' || e.keyCode === 44 || e.which === 44) {
                    e.preventDefault();
                    triggerScreenCaptureBlackout('KEY_PRINTSCREEN');
                    return false;
                }

                // 2. Windows Snipping Tool (Win + Shift + S หรือ Shift + S ขณะมี Meta/Ctrl หรือ Shift+S)
                if ((isShiftDown || e.shiftKey) && (e.key === 'S' || e.key === 's' || e.code === 'KeyS' || e.keyCode === 83)) {
                    if (isMetaDown || isCtrlDown || e.metaKey || e.ctrlKey || isShiftDown) {
                        e.preventDefault();
                        triggerScreenCaptureBlackout('SNIPPING_TOOL_WIN_SHIFT_S');
                        return false;
                    }
                }

                // 3. Mac Shortcuts: Cmd + Shift + 3, 4, 5
                if ((e.shiftKey || isShiftDown) && (e.metaKey || isMetaDown || e.ctrlKey || isCtrlDown)) {
                    if (['3', '4', '5', 's', 'S'].includes(e.key) || ['Digit3', 'Digit4', 'Digit5', 'KeyS'].includes(e.code)) {
                        e.preventDefault();
                        triggerScreenCaptureBlackout('MAC_SCREEN_CAPTURE_SHORTCUT');
                        return false;
                    }
                }

                // 4. LINE PC Screen Capture & Video Capture Shortcuts (Alt + Ctrl + C / Alt + C / Alt + Ctrl + V)
                if ((isAltDown || e.altKey) && (e.key === 'c' || e.key === 'C' || e.code === 'KeyC' || e.key === 'v' || e.key === 'V' || e.code === 'KeyV')) {
                    e.preventDefault();
                    triggerScreenCaptureBlackout('LINE_APP_SCREEN_CAPTURE_SHORTCUT');
                    return false;
                }

                // 5. Windows Game Bar / Recorder: Win + G / Win + Alt + R
                if ((e.metaKey || isMetaDown || e.ctrlKey || isCtrlDown) && (e.key === 'G' || e.key === 'g' || e.code === 'KeyG' || e.key === 'R' || e.key === 'r' || e.code === 'KeyR')) {
                    e.preventDefault();
                    triggerScreenCaptureBlackout('GAME_BAR_RECORDING_SHORTCUT');
                    return false;
                }

                // 6. Alt + PrintScreen
                if ((e.altKey || isAltDown) && (e.key === 'PrintScreen' || e.code === 'PrintScreen' || e.keyCode === 44 || e.which === 44)) {
                    e.preventDefault();
                    triggerScreenCaptureBlackout('ALT_PRINTSCREEN');
                    return false;
                }

                // 7. Print Page (Ctrl+P / Cmd+P)
                if ((e.ctrlKey || e.metaKey || isCtrlDown || isMetaDown) && (e.key === 'P' || e.key === 'p' || e.code === 'KeyP')) {
                    e.preventDefault();
                    triggerScreenCaptureBlackout('PRINT_PAGE_SHORTCUT');
                    return false;
                }

                // 8. DevTools (F12, Ctrl+Shift+I, Ctrl+Shift+J, Ctrl+Shift+C, Ctrl+U)
                if (e.key === 'F12' || e.keyCode === 123 || ((e.ctrlKey || e.metaKey || isCtrlDown || isMetaDown) && (e.shiftKey || isShiftDown) && (e.key === 'I' || e.key === 'C' || e.key === 'J')) || ((e.ctrlKey || e.metaKey) && (e.key === 'U' || e.key === 'u'))) {
                    e.preventDefault();
                    triggerScreenCaptureBlackout('DEV_TOOLS_SHORTCUT');
                    return false;
                }
            }, true);

            window.addEventListener('keyup', function(e) {
                if (e.key === 'Shift' || e.code === 'ShiftLeft' || e.code === 'ShiftRight') isShiftDown = false;
                if (e.key === 'Meta' || e.key === 'OS' || e.code === 'MetaLeft' || e.code === 'MetaRight' || e.code === 'OSLeft' || e.code === 'OSRight') isMetaDown = false;
                if (e.key === 'Control' || e.code === 'ControlLeft' || e.code === 'ControlRight') isCtrlDown = false;
                if (e.key === 'Alt' || e.code === 'AltLeft' || e.code === 'AltRight') isAltDown = false;

                if (e.key === 'PrintScreen' || e.key === 'Snapshot' || e.code === 'PrintScreen' || e.keyCode === 44 || e.which === 44) {
                    e.preventDefault();
                    triggerScreenCaptureBlackout('KEYUP_PRINTSCREEN');
                }
            }, true);

            // (Removed aggressive 'blur' check that accidentally triggers on Alt+Tab or Ctrl+Tab)

            // 5. ป้องกัน Right Click, Copy, Drag
            document.addEventListener('contextmenu', function(e) {
                e.preventDefault();
                return false;
            });
            document.addEventListener('copy', function(e) {
                e.preventDefault();
                triggerScreenCaptureBlackout('COPY_DATA');
                return false;
            });
            document.addEventListener('dragstart', function(e) {
                e.preventDefault();
                return false;
            });
            window.addEventListener('beforeprint', function() {
                triggerScreenCaptureBlackout('BEFORE_PRINT');
            });

            // 6. ปิดระบบจอดำเมื่อไม่มีการใช้งาน (Disabled idle blackout)
            // เพื่อให้ผู้ใช้สามารถเปิดหน้าจอค้างไว้ใช้งานได้ตลอดทั้งวันโดยไม่จอดำ

        })();
        </script>
    }
}
@RenderSection("Scripts", required: false)
