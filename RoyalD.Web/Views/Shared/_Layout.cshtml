<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <!-- Navbar (Teal / Ocean Green) -->
    <nav class="navbar navbar-dark py-1" style="background: linear-gradient(135deg, #0f766e 0%, #0d9488 100%) !important;">
        <div class="container-fluid">
            <div class="d-flex align-items-center">
                <button class="btn btn-outline-light me-2 py-0 px-2 border-0 shadow-none" type="button" onclick="toggleSidebar()" title="ซ่อน/แสดง เมนูซ้ายมือ (กางหน้าจอเต็ม 100%)">
                    <i class="bi bi-list fs-3"></i>
                </button>
                <a class="navbar-brand mb-0" href="/">
                    <i class="bi bi-building"></i> บจก.รอแยล-ดี (ไทยแลนด์)
                </a>
            </div>
            <div class="ms-auto d-flex align-items-center gap-3">
                @{
                    var sessionTimeoutClaim = ViewContext.HttpContext.User.FindFirst("SessionTimeout")?.Value;
                    int sessionTimeoutSec = 0;
                    if (int.TryParse(sessionTimeoutClaim, out var stMin) && stMin > 0)
                        sessionTimeoutSec = stMin * 60;
                }
                @if (sessionTimeoutSec > 0)
                {
                    <span id="session-timer" class="badge bg-warning text-dark px-2 py-1" title="ระยะเวลาเข้าใช้งานระบบคงเหลือ">
                        <i class="bi bi-stopwatch"></i> เวลาเข้าใช้งานคงเหลือ: <span id="timer-display">@($"{stMin:D2}:00")</span>
                    </span>
                }
                <!-- PWA 1-Click Install Button -->
                <button id="pwaInstallBtn" class="btn btn-sm btn-warning fw-bold text-dark d-inline-flex align-items-center shadow-sm" style="border-radius:20px; font-size:0.82rem;" title="ติดตั้งไอคอนแอปบนหน้าจอ Desktop / มือถือ" onclick="triggerPwaInstall()">
                    <i class="bi bi-download me-1"></i> ติดตั้งแอปลง PC / มือถือ
                </button>
                <span class="text-white">
                    <i class="bi bi-person-circle"></i>
                    @(ViewContext.HttpContext.User.FindFirst("FullName")?.Value ?? User.Identity.Name)
                </span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-box-arrow-right"></i> ออกจากระบบ
                    </button>
                </form>
            </div>
        </div>
                        @if (await PermissionService.CanAccessAsync("AdminPermissions"))
                    {
                        <hr class="dropdown-divider my-2 border-secondary" style="opacity:0.2;">
                        <a class="nav-link" href="/Admin/Permissions">
                            <i class="bi bi-shield-lock"></i> ตั้งค่าสิทธิ์เมนู
                        </a>
                    }
</nav>

    <div class="d-flex" id="app-wrapper">
        <!-- Sidebar (แสดงเฉพาะเมนูที่ได้รับอนุญาต) -->
        <div class="sidebar" id="sidebar">
            <nav class="pt-3">
                @if (hasDash)
                {
                    <div class="nav-section">หลัก</div>
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                       href="/Dashboard">
                        <i class="bi bi-speedometer2"></i> Accounts Receivable Dashboard
                    </a>
                }

                @if (hasBill || hasCancel)
                {
                    <div class="nav-section">บิลขาย</div>
                    @if (await PermissionService.CanAccessAsync("SalesBillList")) { <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SalesBill" ? "active" : "")"
                       href="/SalesBill">
                        <i class="bi bi-receipt"></i> รายการบิลขาย
                    </a> }
                    @if (isAdmin || allowedPagesList.Contains("customerproduct")) { <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SalesReport" && ViewContext.RouteData.Values["action"]?.ToString() == "CustomerProduct" ? "active" : "")"
                       href="/SalesReport/CustomerProduct">
                        <i class="bi bi-shop"></i> รายการขายรายลูกค้า
                    </a> }
                    @if (isAdmin || allowedPagesList.Contains("waitinggoodsreport")) { <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" && ViewContext.RouteData.Values["action"]?.ToString() == "WaitingGoods" ? "active" : "")"
                       href="/Report/WaitingGoods">
                        <i class="bi bi-box-seam"></i> บิลรอเอกสาร/รอสินค้า
                    </a> }
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" && ViewContext.RouteData.Values["action"]?.ToString() == "ReturnNotes" ? "active" : "")"
                       href="/Report/ReturnNotes">
                        <i class="bi bi-arrow-return-left"></i> รับคืนสินค้า
                    </a>
                    @if (hasCancel)
                    {
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Cancelled" ? "active" : "")"
                           href="/Debtor/Cancelled">
                            <i class="bi bi-trash3"></i> บิลยกเลิก (30 วัน)
                        </a>
                    }
                    
                }

                @if (hasDebt || hasHist)
                {
                    <div class="nav-section">ลูกหนี้</div>
                    @if (hasDebt)
                    {
                        @if (await PermissionService.CanAccessAsync("DebtorList")) { <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Debtor" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                           href="/Debtor">
                            <i class="bi bi-credit-card-2-front"></i> การ์ดลูกหนี้
                        </a> }
                    }
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Installment" ? "active" : "")"
                       href="/Debtor/Installment">
                        <i class="bi bi-credit-card-fill" style="color:#d97706;"></i> ลูกค้าผ่อนชำระ
                    </a>
                    @if (hasHist)
                    {
                        <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "History" ? "active" : "")"
                           href="/Debtor/History">
                            <i class="bi bi-clock-history"></i> ประวัติชำระครบ
                        </a>
                    }
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "BadDebt" ? "active" : "")"
                       href="/Debtor/BadDebt">
                        <i class="bi bi-exclamation-octagon"></i> หนี้สูญ
                    </a>
                }

                @if (hasRep || hasWaiting)
                {
                    <div class="nav-section">รายงาน</div>
                    @if (hasRep)
                    {
                        @if (isAdmin || allowedPagesList.Contains("salesreport")) { <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SalesReport" && (ViewContext.RouteData.Values["action"]?.ToString() == "Summary" || ViewContext.RouteData.Values["action"]?.ToString() == "Charts" || ViewContext.RouteData.Values["action"]?.ToString() == "ProductDetails" || ViewContext.RouteData.Values["action"]?.ToString() == "ProductDetailsAmount" || ViewContext.RouteData.Values["action"]?.ToString() == "Compare") ? "active" : "")"
                           href="/SalesReport/Summary">
                            <i class="bi bi-graph-up-arrow"></i> รายงานผู้แทนขาย
                        </a> }
                        @if (isAdmin || allowedPagesList.Contains("customerpurchasesummary")) { <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SalesReport" && ViewContext.RouteData.Values["action"]?.ToString() == "CustomerPurchaseSummary" ? "active" : "")"
                           href="/SalesReport/CustomerPurchaseSummary">
                            <i class="bi bi-person-lines-fill"></i> สรุปการซื้อรายลูกค้า
                        </a> }
                    }
                }

                @if (hasUpload || hasUsers || hasAudit)
                {
                    <div class="nav-section">จัดการระบบ</div>
                    @if (hasUpload)
                    {
                        @if (await PermissionService.CanAccessAsync("Upload")) { <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Upload" ? "active" : "")"
                           href="/Upload">
                            <i class="bi bi-cloud-upload"></i> อัปโหลดไฟล์
                        </a> }
                    }
                    @if (hasUsers)
                    {
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Account" && ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")"
                           href="/Account/Users">
                            <i class="bi bi-people"></i> จัดการผู้ใช้
                        </a>
                    }
                    @if (hasAudit)
                    {
                        @if (await PermissionService.CanAccessAsync("AuditLogs")) { <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Audit" ? "active" : "")"
                           href="/Audit">
                            <i class="bi bi-journal-text"></i> ประวัติการใช้งาน
                        </a> }
                    }
                }
                                @if (await PermissionService.CanAccessAsync("AdminPermissions"))
                    {
                        <hr class="dropdown-divider my-2 border-secondary" style="opacity:0.2;">
                        <a class="nav-link" href="/Admin/Permissions">
                            <i class="bi bi-shield-lock"></i> ตั้งค่าสิทธิ์เมนู
                        </a>
                    }
</nav>
        </div>

        <!-- Main Content -->
        <main class="main-content p-4 @(!canScreenCapture ? "pb-5" : "")">
            @RenderBody()

            @if (!canScreenCapture)
            {
                <footer class="mt-4 pt-3 pb-3 text-center border-top" style="background:#fff1f2; border-color:#fecdd3 !important; border-radius:10px;">
                    <div class="fw-bold text-danger" style="font-size:0.95rem;">
                        <i class="bi bi-shield-lock-fill me-1"></i> ⚠️ เอกสารห้ามเผยแพร่ — ใช้สำหรับงานภายในบริษัท รอแยล-ดี (ไทยแลนด์) จำกัด เท่านั้น
                    </div>
                    <small class="text-muted">ห้ามบันทึกภาพ แคปหน้าจอ คัดลอก หรือส่งต่อข้อมูลสู่ภายนอกโดยเด็ดขาด (Security Protected)</small>
                </footer>

                <div class="fixed-bottom py-1 text-center text-white fw-bold shadow" style="background:#dc2626; font-size:0.82rem; z-index:999980; pointer-events:none; letter-spacing:0.5px;">
                    <i class="bi bi-shield-slash-fill me-1"></i> ⚠️ เอกสารห้ามเผยแพร่ — ข้อมูลความลับเฉพาะภายในบริษัท รอแยล-ดี (ไทยแลนด์) จำกัด
                </div>
            }
        </main>
    </div>
}
else
{
    @RenderBody()
}

