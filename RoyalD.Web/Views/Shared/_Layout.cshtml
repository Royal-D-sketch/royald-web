@using System.Security.Claims
@inject RoyalD.Web.Services.PermissionService PermissionService
@{
    bool isAdmin = User.IsInRole("admin") || (User.Identity?.Name?.ToLower() == "admin");
    bool isMasterAdmin = isAdmin;
    var positionClaim = ViewContext.HttpContext.User.FindFirst("Position")?.Value ?? "";
    bool isSalesRep = !isMasterAdmin && (positionClaim == "ผู้แทนขาย" || positionClaim == "พนักงานขาย" || positionClaim.Contains("ผู้แทน") || positionClaim.Contains("พนักงานขาย"));
    var allowedPagesClaim = ViewContext.HttpContext.User.FindFirst("AllowedPages")?.Value ?? "";
    var canDownloadClaim = ViewContext.HttpContext.User.FindFirst("CanDownload")?.Value;
    var canCaptureClaim = ViewContext.HttpContext.User.FindFirst("CanScreenCapture")?.Value;

    // สิทธิ์การดาวน์โหลดและแคปหน้าจอ:
    // 1. แอดมิน (Admin) -> ปลดล็อค 100% ไม่มีลายน้ำ และสามารถแคปจอ/ดาวน์โหลดได้ตลอดเวลา
    // 2. ตำแหน่งผู้แทนขาย (Sales Rep) -> ถูกล็อกความปลอดภัยเสมอ (มีลายน้ำ และห้ามแคปจอ/ห้ามดาวน์โหลด)
    // 3. ตำแหน่งอื่นๆ (ผู้บริหาร, พนักงาน, หัวหน้างาน, บัญชี ฯลฯ) -> ถ้าแอดมินติ๊กอนุญาต ก็จะไม่มีลายน้ำ และแคปจอ/ดาวน์โหลดได้ตามปกติ
    var roleClaim = ViewContext.HttpContext.User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    bool isManager = positionClaim.Contains("ผู้จัดการ") || positionClaim.ToLower().Contains("manager") || roleClaim.ToLower() == "manager";
    bool canDownload = (isMasterAdmin || isManager || canDownloadClaim == "true") && !isSalesRep;
    bool canScreenCapture = (isMasterAdmin || isManager || canCaptureClaim == "true") && !isSalesRep;

    var allowedPagesList = allowedPagesClaim.Split(',', StringSplitOptions.RemoveEmptyEntries)
                                           .Select(p => p.Trim().ToLower())
                                           .ToList();

    bool hasDash = isAdmin || allowedPagesList.Contains("dashboard");
    bool hasBill = isAdmin || allowedPagesList.Contains("salesbill");
    bool hasDebt = isAdmin || allowedPagesList.Contains("debtor");
    bool hasHist = isAdmin || allowedPagesList.Contains("debtorhistory") || allowedPagesList.Contains("history");
    bool hasCancel = isAdmin || allowedPagesList.Contains("cancelled") || allowedPagesList.Contains("debtorcancelled");
    bool hasWaiting = isAdmin || allowedPagesList.Contains("waitinggoods");
    bool hasRep = isAdmin || allowedPagesList.Contains("salesreport");
    bool hasAudit = isAdmin || allowedPagesList.Contains("audit");
    bool hasUsers = isAdmin || allowedPagesList.Contains("users");
    bool hasUpload = isAdmin || allowedPagesList.Contains("upload");
}
