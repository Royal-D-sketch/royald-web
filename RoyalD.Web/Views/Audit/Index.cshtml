@using RoyalD.Web.Models
@using RoyalD.Web.Services
@model List<RoyalD.Web.Models.AuditLog>
@{
    ViewData["Title"] = "ประวัติการใช้งานระบบ";
    var userDict = ViewBag.UserDict as Dictionary<string, AppUser> ?? new();
    var usersList = ViewBag.UsersList as List<AppUser> ?? new();
    int curPage = ViewBag.CurrentPage ?? 1;
    int totPages = ViewBag.TotalPages ?? 1;
    int pSize = ViewBag.PageSize ?? 50;
    int totalCount = ViewBag.TotalCount ?? 0;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3">
    <div>
        <h4 class="mb-0 fw-bold" style="color:#0f766e;">
            <i class="bi bi-journal-check text-primary me-2"></i> ประวัติการใช้งานระบบ (Audit Logs)
        </h4>
        <small class="text-muted">ตรวจสอบความปลอดภัย เวลาเข้า-ออก จำนวนนาทีใช้งาน และพิกัดตำแหน่งพื้นที่การใช้งานทุกครั้ง</small>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <span class="badge bg-primary fs-6 px-3 py-2 shadow-sm" style="background:#0d9488 !important;">รวม @totalCount.ToString("N0") รายการ</span>
        <a href="@Url.Action("ExportExcel", new { search = ViewBag.SearchTerm, salesRep = ViewBag.SelectedSalesRep, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate })" 
           class="btn btn-sm btn-success fw-bold shadow-sm px-3" style="background:#15803d; border-color:#15803d;" title="ส่งออกเป็น Excel">
            <i class="bi bi-file-earmark-excel-fill me-1"></i> Export Excel
        </a>
        <a href="@Url.Action("ExportPdf", new { search = ViewBag.SearchTerm, salesRep = ViewBag.SelectedSalesRep, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate })" 
           target="_blank" class="btn btn-sm btn-danger fw-bold shadow-sm px-3" style="background:#b91c1c; border-color:#b91c1c;" title="ส่งออกเป็น PDF">
            <i class="bi bi-file-earmark-pdf-fill me-1"></i> Export PDF
        </a>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card mb-3 shadow-sm border-0" style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:12px;">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end" id="audit-filter-form">
            <input type="hidden" name="pageSize" value="@pSize" />
            
            <div class="col-12 col-md-3">
                <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-search"></i> 1. ค้นหาทั่วไป</label>
                <input type="text" name="search" class="form-control form-control-sm"
                       placeholder="Action / พิกัด / จังหวัด / IP..." value="@ViewBag.SearchTerm" />
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-person-badge"></i> 2. ผู้แทนขาย / พนักงาน</label>
                <div class="input-group input-group-sm">
                    <input type="text" name="salesRep" id="auditSalesRepInput" list="auditSalesRepList" class="form-control"
                           placeholder="พิมพ์ชื่อหรือคลิกเลือก..." value="@ViewBag.SelectedSalesRep" autocomplete="off" />
                    <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="เลือกจากรายชื่อ">
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow" style="max-height: 280px; overflow-y: auto;">
                        <li><a class="dropdown-item py-1" href="javascript:void(0)" onclick="selectAuditRep('')"><span class="text-muted">-- พนักงาน/ผู้แทนทั้งหมด --</span></a></li>
                        <li><hr class="dropdown-divider my-1"></li>
                        @foreach (var u in usersList)
                        {
                            string displayName = !string.IsNullOrEmpty(u.FullName) ? u.FullName : u.Username;
                            <li>
                                <a class="dropdown-item py-1 text-truncate" href="javascript:void(0)" onclick="selectAuditRep('@displayName')">
                                    <strong>@displayName</strong> <small class="text-muted">(@u.Username @(!string.IsNullOrEmpty(u.Position) ? "- " + u.Position : ""))</small>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
                <datalist id="auditSalesRepList">
                    @foreach (var u in usersList)
                    {
                        string displayName = !string.IsNullOrEmpty(u.FullName) ? u.FullName : u.Username;
                        <option value="@displayName">@u.Username @(!string.IsNullOrEmpty(u.Position) ? $"({u.Position})" : "")</option>
                        @if (!string.IsNullOrEmpty(u.Username) && u.Username != displayName)
                        {
                            <option value="@u.Username">@displayName</option>
                        }
                    }
                </datalist>
            </div>

            <div class="col-12 col-md-2">
                <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-calendar-event"></i> 3. ตั้งแต่วันที่</label>
                <input type="date" name="startDate" class="form-control form-control-sm" value="@ViewBag.StartDate" />
            </div>

            <div class="col-12 col-md-2">
                <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-calendar-check"></i> 4. ถึงวันที่</label>
                <input type="date" name="endDate" class="form-control form-control-sm" value="@ViewBag.EndDate" />
            </div>

            <div class="col-6 col-md-1">
                <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold" style="background:#0d9488; border-color:#0d9488;">
                    <i class="bi bi-search"></i> ค้นหา
                </button>
            </div>

            <div class="col-6 col-md-1">
                <a href="/Audit" class="btn btn-outline-secondary btn-sm w-100" title="ล้างตัวกรอง">
                    <i class="bi bi-arrow-counterclockwise"></i> ล้าง
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0" style="border-radius:12px; overflow:hidden;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
                <thead class="table-light" style="background:#f8fafc; border-bottom:2px solid #e2e8f0;">
                    <tr>
                        <th class="text-center" style="width: 150px;">วัน-เวลาที่ทำรายการ</th>
                        <th style="min-width: 150px;">ชื่อ-นามสกุล / บัญชี</th>
                        <th class="text-center" style="width: 110px;">ตำแหน่งงาน</th>
                        <th class="text-center" style="width: 130px;">กิจกรรม (Action)</th>
                        <th class="text-center" style="width: 100px;">เวลาใช้งาน</th>
                        <th style="min-width: 220px;">📍 ตำแหน่งโลเคชั่น (Location)</th>
                        <th style="min-width: 200px;">รายละเอียด</th>
                        <th style="width: 110px;">IP Address</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                ไม่พบข้อมูลประวัติการใช้งานตามเงื่อนไขที่เลือก
                            </td>
                        </tr>
                    }
                    @foreach (var log in Model)
                    {
                        userDict.TryGetValue(log.Username, out var usr);
                        string fullName = usr != null && !string.IsNullOrEmpty(usr.FullName) ? usr.FullName : (log.Username == "admin" ? "ผู้ดูแลระบบ (Admin)" : "-");
                        string posDisplay = usr != null && !string.IsNullOrEmpty(usr.Position) ? usr.Position : (log.Username == "admin" ? "ผู้ดูแลระบบ" : "ผู้แทนขาย");

                        string badgeClass = log.Action switch {
                            "LOGIN" => "bg-success",
                            "LOGOUT" => "bg-secondary",
                            "LOGIN_FAILED" or "LOGIN_BLOCKED_NOLOCATION" or "SCREEN_CAPTURE" or "SECURITY_VIOLATION_LOGOUT" => "bg-danger",
                            "CREATE_USER" or "EDIT_USER" or "DELETE_USER" => "bg-primary",
                            "PAYMENT" or "UPDATE_STATUS" => "bg-warning text-dark",
                            _ => "bg-info text-dark"
                        };

                        string locationText = GeoLocationHelper.ReverseGeocode(log.Latitude, log.Longitude, log.Area);

                        <tr>
                            <!-- 1. วันเวลา -->
                            <td class="text-center text-muted fw-semibold text-nowrap">
                                @log.CreatedAtThai.ToString("dd/MM/yyyy HH:mm:ss")
                            </td>

                            <!-- 2. ชื่อ-นามสกุล และ บัญชีผู้ใช้ -->
                            <td>
                                <div class="fw-bold text-dark">@fullName</div>
                                <code class="small text-muted">@log.Username</code>
                            </td>

                            <!-- 3. ตำแหน่งงาน -->
                            <td class="text-center">
                                <span class="badge bg-light text-dark border px-2 py-1">@posDisplay</span>
                            </td>

                            <!-- 4. กิจกรรม -->
                            <td class="text-center">
                                <span class="badge @badgeClass px-2 py-1">@log.Action</span>
                            </td>

                            <!-- 5. ระยะเวลาใช้งาน -->
                            <td class="text-center">
                                @if (log.DurationMinutes.HasValue && log.DurationMinutes > 0)
                                {
                                    <span class="badge bg-light text-primary border fw-bold">
                                        <i class="bi bi-stopwatch"></i> @log.DurationMinutes น.
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>

                            <!-- 6. พิกัดและพื้นที่ใช้งาน (โลเคชั่น) -->
                            <td>
                                @if (!string.IsNullOrEmpty(locationText) && locationText != "ไม่ระบุตำแหน่ง" && locationText != "-")
                                {
                                    <div class="fw-bold text-dark mb-1">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> @locationText
                                    </div>
                                    @if (!string.IsNullOrEmpty(log.Latitude) && !string.IsNullOrEmpty(log.Longitude))
                                    {
                                        <small class="text-muted" style="font-size:0.75rem;">GPS: @log.Latitude, @log.Longitude</small>
                                    }
                                }
                                else if (!string.IsNullOrEmpty(log.Area))
                                {
                                    <div class="fw-bold text-dark"><i class="bi bi-geo-alt-fill text-danger me-1"></i> @log.Area</div>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>

                            <!-- 7. รายละเอียด -->
                            <td>
                                <small class="text-muted" style="line-height:1.3; display:block;">@log.Detail</small>
                            </td>

                            <!-- 8. IP Address -->
                            <td>
                                <code class="small text-muted">@(!string.IsNullOrEmpty(log.IPAddress) ? log.IPAddress : "-")</code>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Pagination Toolbar -->
<div class="d-flex flex-wrap justify-content-between align-items-center mt-3 gap-2 px-1">
    <div class="d-flex align-items-center gap-2">
        <span class="text-muted small">
            แสดง @((curPage - 1) * pSize + (Model.Any() ? 1 : 0)) ถึง @(Math.Min(curPage * pSize, totalCount)) จากทั้งหมด @totalCount.ToString("N0") รายการ
        </span>
        <div class="d-flex align-items-center gap-1 ms-2 small text-muted">
            <label>แสดง:</label>
            <select class="form-select form-select-sm" style="width: auto; padding: 2px 24px 2px 8px; font-size: 0.8rem;" onchange="changeAuditPageSize(this.value)">
                <option value="30" selected="@(pSize == 30)">30</option>
                <option value="50" selected="@(pSize == 50)">50</option>
                <option value="100" selected="@(pSize == 100)">100</option>
                <option value="200" selected="@(pSize == 200)">200</option>
            </select>
        </div>
    </div>

    @if (totPages > 1)
    {
        <nav>
            <ul class="pagination pagination-sm mb-0">
                @if (curPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { search = ViewBag.SearchTerm, salesRep = ViewBag.SelectedSalesRep, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate, page = 1, pageSize = pSize })" title="หน้าแรก">«</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { search = ViewBag.SearchTerm, salesRep = ViewBag.SelectedSalesRep, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate, page = curPage - 1, pageSize = pSize })">‹ ก่อนหน้า</a>
                    </li>
                }

                @for (int p = Math.Max(1, curPage - 2); p <= Math.Min(totPages, curPage + 2); p++)
                {
                    if (p == curPage)
                    {
                        <li class="page-item active"><span class="page-link" style="background:#0d9488; border-color:#0d9488;">@p</span></li>
                    }
                    else
                    {
                        <li class="page-item"><a class="page-link" href="@Url.Action("Index", new { search = ViewBag.SearchTerm, salesRep = ViewBag.SelectedSalesRep, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate, page = p, pageSize = pSize })">@p</a></li>
                    }
                }

                @if (curPage < totPages)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { search = ViewBag.SearchTerm, salesRep = ViewBag.SelectedSalesRep, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate, page = curPage + 1, pageSize = pSize })">ถัดไป ›</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index", new { search = ViewBag.SearchTerm, salesRep = ViewBag.SelectedSalesRep, startDate = ViewBag.StartDate, endDate = ViewBag.EndDate, page = totPages, pageSize = pSize })" title="หน้าสุดท้าย">»</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

@section Scripts {
<script>
    function selectAuditRep(name) {
        var inp = document.getElementById('auditSalesRepInput');
        if (inp) {
            inp.value = name;
            document.getElementById('audit-filter-form').submit();
        }
    }

    function changeAuditPageSize(size) {
        const url = new URL(window.location.href);
        url.searchParams.set('pageSize', size);
        url.searchParams.set('page', '1');
        window.location.href = url.toString();
    }
</script>
}
