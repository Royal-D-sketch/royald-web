@model RoyalD.Web.Models.ComparisonBoardViewModel
@{
    Layout = null;
    var summary = Model.Summary;
    string sec = ViewBag.Section as string ?? "all";
    string fType = ViewBag.FilterType as string ?? "all";
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>กระดานเปรียบเทียบข้อมูล 3 ส่วน (AR Comparison Board) — บริษัท รอแยล-ดี (ไทยแลนด์) จำกัด</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700;800&display=swap" />
    <style>
        body {
            font-family: 'Sarabun', 'Noto Sans Thai', Tahoma, sans-serif;
            background: #ffffff;
            color: #0f172a;
            font-size: 0.82rem;
            padding: 20px;
        }
        .header-box {
            border-bottom: 2px solid #0f766e;
            padding-bottom: 12px;
            margin-bottom: 14px;
        }
        .table-pdf th {
            font-weight: 700;
            text-align: center;
            vertical-align: middle;
            font-size: 0.78rem;
            padding: 6px 4px;
            color: #ffffff !important;
        }
        .table-pdf.th-iceblue th { background-color: #0284c7 !important; }
        .table-pdf.th-warmsand th { background-color: #d97706 !important; }
        .table-pdf.th-purple th { background-color: #7c3aed !important; }
        .table-pdf td {
            vertical-align: middle;
            padding: 5px 4px;
            border-bottom: 1px solid #e2e8f0;
            font-size: 0.78rem;
        }
        .total-row {
            background-color: #f8fafc !important;
            font-weight: 800;
        }
        @@media print {
            body { padding: 0; }
            .no-print { display: none !important; }
            .table-pdf th { -webkit-print-color-adjust: exact; }
            .total-row { -webkit-print-color-adjust: exact; }
        }
            /* PDF Table Word Wrapping */
        .table-pdf td, .table-pdf th, table td, table th { white-space: normal !important; word-break: break-word !important; }
    </style>
</head>
<body>
    <div class="no-print d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded border">
        <div>
            <h5 class="mb-0 fw-bold" style="color:#0f766e;">
                <i class="bi bi-file-earmark-pdf-fill text-danger me-2"></i> เอกสารรายงานกระดานเปรียบเทียบข้อมูล 3 ส่วน (PDF)
            </h5>
            <small class="text-muted">คลิกปุ่ม "พิมพ์ / บันทึกเป็น PDF" เพื่อสั่งพิมพ์หรือ Save เป็น PDF</small>
        </div>
        <button onclick="window.print()" class="btn btn-danger btn-sm fw-bold px-4 py-2 shadow-sm">
            <i class="bi bi-printer-fill me-1"></i> สั่งพิมพ์ / บันทึกเป็น PDF
        </button>
    </div>

    <div class="header-box text-center">
        <h4 class="fw-bold mb-1" style="color:#0f766e;">บริษัท รอแยล-ดี (ไทยแลนด์) จำกัด</h4>
        <h6 class="fw-bold mb-1">กระดานสรุปผลเปรียบเทียบข้อมูลระดับบริหาร (AR Comparison Board)</h6>
        <div class="text-muted small">
            พิมพ์ ณ วันที่: <strong>@DateTime.Now.ToString("dd/MM/yyyy HH:mm") น.</strong> | ผู้พิมพ์: <strong>@(ViewBag.PrintedBy ?? "Admin")</strong>
        </div>
    </div>

    @if (sec == "all" || sec == "1")
    {
        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0" style="color:#0284c7;"><i class="bi bi-buildings-fill me-1"></i> 1. บิลเก็บสด 7 วัน (กทม.&ปริมณฑล ณ 14/09+) - ธีมสีฟ้าพาสเทลนุ่มนวล</h6>
                <span class="badge" style="background:#0284c7; color:#fff;">จำนวน @Model.Table1_Cash7Bkk.Count.ToString("N0") รายการ | ยอดรวม @Model.Table1_TotalAmount.ToString("N2") บาท</span>
            </div>
            <table class="table table-bordered table-sm table-pdf th-iceblue">
                <thead>
                    <tr><th>#</th><th>เลขที่บิล</th><th>วันที่บิล</th><th>รหัส</th><th>ชื่อลูกค้า</th><th>อำเภอ</th><th>จังหวัด</th><th>เครดิต</th><th>อายุหนี้</th><th>จำนวนเงิน (บาท)</th><th>ผู้แทนขาย</th></tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Table1_Cash7Bkk.Count; i++) {
                        var b = Model.Table1_Cash7Bkk[i];
                        <tr>
                            <td class="text-center">@(i+1)</td>
                            <td class="text-center fw-bold">@b.BillNo</td>
                            <td class="text-center">@b.BillDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">@b.CustomerCode</td>
                            <td class="fw-bold">@b.CustomerName</td>
                            <td>@b.District</td>
                            <td>@b.Province</td>
                            <td class="text-center">@(b.Credit > 0 ? b.Credit.ToString() : "สด")</td>
                            <td class="text-center">@(b.IsPaid ? "ชำระแล้ว" : (b.AgingDays > 0 ? $"{b.AgingDays} วัน" : "-"))</td>
                            <td class="text-end fw-bold" style="color:#0284c7;">@b.Amount.ToString("N2")</td>
                            <td>@b.SalesRep</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="total-row">
                        <td colspan="9" class="text-end">ยอดรวมทั้งสิ้น (@Model.Table1_Cash7Bkk.Count.ToString("N0") รายการ):</td>
                        <td class="text-end fw-bold" style="color:#0284c7;">@Model.Table1_TotalAmount.ToString("N2")</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }

    @if (sec == "all" || sec == "2")
    {
        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0" style="color:#b45309;"><i class="bi bi-hourglass-split me-1"></i> 2. บิลเงินสดนโยบายรวมสายเวลา (กทม.&ปริมณฑล) - ธีมสีชาไทยพาสเทล / ครีมอุ่น</h6>
                <span class="badge" style="background:#d97706; color:#fff;">จำนวน @Model.Table2_CashTimelineBkk.Count.ToString("N0") รายการ | ยอดรวม @Model.Table2_TotalAmount.ToString("N2") บาท</span>
            </div>
            <table class="table table-bordered table-sm table-pdf th-warmsand">
                <thead>
                    <tr><th>#</th><th>เลขที่บิล</th><th>วันที่บิล</th><th>รหัส</th><th>ชื่อลูกค้า</th><th>อำเภอ</th><th>จังหวัด</th><th>เครดิต</th><th>อายุหนี้</th><th>จำนวนเงิน (บาท)</th><th>ผู้แทนขาย</th></tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Table2_CashTimelineBkk.Count; i++) {
                        var b = Model.Table2_CashTimelineBkk[i];
                        <tr>
                            <td class="text-center">@(i+1)</td>
                            <td class="text-center fw-bold">@b.BillNo</td>
                            <td class="text-center">@b.BillDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">@b.CustomerCode</td>
                            <td class="fw-bold">@b.CustomerName</td>
                            <td>@b.District</td>
                            <td>@b.Province</td>
                            <td class="text-center">@(b.Credit > 0 ? b.Credit.ToString() : "สด")</td>
                            <td class="text-center">@(b.IsPaid ? "ชำระแล้ว" : (b.AgingDays > 0 ? $"{b.AgingDays} วัน" : "-"))</td>
                            <td class="text-end fw-bold" style="color:#b45309;">@b.Amount.ToString("N2")</td>
                            <td>@b.SalesRep</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="total-row">
                        <td colspan="9" class="text-end">ยอดรวมทั้งสิ้น (@Model.Table2_CashTimelineBkk.Count.ToString("N0") รายการ):</td>
                        <td class="text-end fw-bold" style="color:#b45309;">@Model.Table2_TotalAmount.ToString("N2")</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }

    @if (sec == "all" || sec == "3")
    {
        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0" style="color:#7c3aed;"><i class="bi bi-geo-alt-fill me-1"></i> 3. บิลค้างชำระ ต่างจังหวัด (ทุกภาค) - ธีมสีม่วงพาสเทลสุภาพ / ลาเวนเดอร์</h6>
                <span class="badge" style="background:#7c3aed; color:#fff;">จำนวน @Model.Table3_Upcountry.Count.ToString("N0") รายการ | ยอดรวม @Model.Table3_TotalAmount.ToString("N2") บาท</span>
            </div>
            <table class="table table-bordered table-sm table-pdf th-purple">
                <thead>
                    <tr><th>#</th><th>เลขที่บิล</th><th>วันที่บิล</th><th>รหัส</th><th>ชื่อลูกค้า</th><th>อำเภอ</th><th>จังหวัด</th><th>เครดิต</th><th>อายุหนี้</th><th>จำนวนเงิน (บาท)</th><th>ผู้แทนขาย</th></tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Table3_Upcountry.Count; i++) {
                        var b = Model.Table3_Upcountry[i];
                        <tr>
                            <td class="text-center">@(i+1)</td>
                            <td class="text-center fw-bold">@b.BillNo</td>
                            <td class="text-center">@b.BillDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">@b.CustomerCode</td>
                            <td class="fw-bold">@b.CustomerName</td>
                            <td>@b.District</td>
                            <td>@b.Province</td>
                            <td class="text-center">@(b.Credit > 0 ? b.Credit.ToString() : "สด")</td>
                            <td class="text-center">@(b.IsPaid ? "ชำระแล้ว" : (b.AgingDays > 0 ? $"{b.AgingDays} วัน" : "-"))</td>
                            <td class="text-end fw-bold" style="color:#7c3aed;">@b.Amount.ToString("N2")</td>
                            <td>@b.SalesRep</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="total-row">
                        <td colspan="9" class="text-end">ยอดรวมทั้งสิ้น (@Model.Table3_Upcountry.Count.ToString("N0") รายการ):</td>
                        <td class="text-end fw-bold" style="color:#7c3aed;">@Model.Table3_TotalAmount.ToString("N2")</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</body>
</html>
