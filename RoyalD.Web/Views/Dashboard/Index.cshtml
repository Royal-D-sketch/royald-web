@model List<RoyalD.Web.Models.OutstandingDebt>
@{
    ViewData["Title"] = "1. หน้าหลักภาพรวมและแดชบอร์ด (AR Executive Summary)";
    var summary = ViewBag.Summary as RoyalD.Web.Models.DashboardSummary ?? new RoyalD.Web.Models.DashboardSummary();
    var drilldownBills = ViewBag.DrilldownBills as List<RoyalD.Web.Models.DashboardBillItem> ?? new List<RoyalD.Web.Models.DashboardBillItem>();
    var today = DateTime.Today;

    // Calculate AR 3 Segments for Pie Chart
    decimal pieCash7 = summary.Cash7Days.TotalAmount;
    decimal pieCashTimeline = summary.Cash10Days.TotalAmount;
    decimal pieUpcountry = summary.UpcountryDebts.TotalAmount;
    decimal totalArPie = pieCash7 + pieCashTimeline + pieUpcountry;
    if (totalArPie == 0) totalArPie = summary.TotalOutstandingAmount;
    if (totalArPie == 0) totalArPie = 1; // avoid divide by zero

    double pctCash7 = (double)Math.Round((pieCash7 / totalArPie) * 100, 1);
    double pctCashTimeline = (double)Math.Round((pieCashTimeline / totalArPie) * 100, 1);
    double pctUpcountry = (double)Math.Round((pieUpcountry / totalArPie) * 100, 1);

    var salesRepList = drilldownBills
        .Select(x => x.SalesRep?.Trim())
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .OrderBy(x => x)
        .ToList();
}

<style>
/* ===== EXECUTIVE DASHBOARD STYLES (EXECUTIVE BUSINESS PALETTE) ===== */
body { font-family: 'Sarabun', 'Noto Sans Thai', 'Leelawadee UI', Tahoma, sans-serif !important; }

/* Sub-Nav Bar (2 Main Pages Switcher) */
.ar-nav-bar {
    display: flex;
    gap: 12px;
    background: #ffffff;
    padding: 8px;
    border-radius: 14px;
    margin-bottom: 22px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}
.ar-nav-btn {
    flex: 1;
    text-align: center;
    padding: 12px 18px;
    font-weight: 800;
    font-size: 0.96rem;
    color: #475569;
    border-radius: 10px;
    text-decoration: none;
    transition: all .2s ease-in-out;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}
.ar-nav-btn:hover {
    background: #f0fdfa;
    color: #0f766e;
    transform: translateY(-1px);
}
.ar-nav-btn.active {
    background: linear-gradient(135deg, #0f766e 0%, #0d9488 100%);
    color: #ffffff !important;
    box-shadow: 0 4px 14px rgba(13, 148, 136, 0.35);
}

/* 4 Main Top Cards (Eye-Friendly Executive Palette) */
.exec-card {
    border-radius: 16px;
    padding: 20px 22px;
    box-shadow: 0 4px 18px rgba(0,0,0,0.07);
    border: 2px solid transparent;
    color: white;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.25s ease-in-out;
}
.exec-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.16);
    filter: brightness(1.03);
}
.exec-card.active-card {
    border-color: #facc15 !important;
    box-shadow: 0 0 0 3px rgba(250, 204, 21, 0.5), 0 8px 25px rgba(0,0,0,0.2) !important;
}
.exec-card::before {
    content: '';
    position: absolute;
    top: -25px; right: -25px;
    width: 95px; height: 95px;
    border-radius: 50%;
    background: rgba(255,255,255,0.14);
}
.exec-card-label { font-size: 0.88rem; font-weight: 700; opacity: 0.95; display: flex; align-items: center; justify-content: space-between; }
.exec-card-value { font-size: 2.15rem; font-weight: 900; line-height: 1.15; letter-spacing: -0.5px; margin: 8px 0 4px 0; }
.exec-card-sub { font-size: 0.80rem; opacity: 0.90; }
.collection-rate-tag {
    display: inline-block;
    background: rgba(255,255,255,0.22);
    border: 1px solid rgba(255,255,255,0.4);
    padding: 3px 10px;
    border-radius: 20px;
    font-weight: 800;
    font-size: 0.85rem;
    margin-top: 6px;
}

/* Palette Themes */
.theme-iceblue { background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); }      /* Soft Ice Blue */
.theme-warmsand { background: linear-gradient(135deg, #d97706 0%, #b45309 100%); }     /* Warm Sand / Terracotta */
.theme-crimson { background: linear-gradient(135deg, #be123c 0%, #9f1239 100%); }      /* Crimson Red (สุภาพ) */
.theme-mint { background: linear-gradient(135deg, #059669 0%, #047857 100%); }         /* Mint Green / Sage */

/* Section Panels */
.chart-panel {
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    border: 1px solid #e2e8f0;
    background: #ffffff;
    padding: 22px;
    height: 100%;
}
.panel-title {
    font-size: 1.08rem;
    font-weight: 800;
    color: #1e293b;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
}

/* Drilldown & Table Container */
.drilldown-container {
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    border: 1px solid #e2e8f0;
    background: #ffffff;
    padding: 24px;
    margin-bottom: 30px;
}
.category-btn {
    border-radius: 20px;
    font-weight: 700;
    font-size: 0.84rem;
    padding: 6px 16px;
    transition: all 0.2s ease;
}
.category-btn.active {
    background-color: #0f766e !important;
    color: white !important;
    border-color: #0f766e !important;
    box-shadow: 0 2px 8px rgba(15, 118, 110, 0.3);
}

.search-input-group .form-control {
    border-radius: 10px;
    font-size: 0.86rem;
    padding: 8px 12px;
}

/* Detail Table */
.detail-table th {
    font-size: 0.83rem;
    font-weight: 700;
    background-color: #0f766e;
    color: #ffffff;
    padding: 10px 10px;
    white-space: nowrap;
}
.detail-table td {
    font-size: 0.86rem;
    vertical-align: middle;
    padding: 8px 10px;
}
.detail-table tbody tr:hover {
    background-color: #f8fafc;
}

.blink-icon {
    animation: blinkIcon 1.2s infinite;
    display: inline-block;
}
@@keyframes blinkIcon {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.2; }
}
</style>

<!-- ===== SUB-NAV BAR: 2 MAIN PAGES SWITCHER ===== -->
<div class="ar-nav-bar">
    <a href="/Dashboard" class="ar-nav-btn active">
        <i class="bi bi-speedometer2 fs-5"></i> 1. หน้าหลักภาพรวมและแดชบอร์ด (AR Executive Summary)
    </a>
    <a href="/Dashboard/Comparison" class="ar-nav-btn">
        <i class="bi bi-layout-three-columns fs-5"></i> 2. กระดานเปรียบเทียบข้อมูล 3 ส่วนคู่ขนาน (AR Detailed Comparison Board)
    </a>
</div>

<!-- ===== PAGE HEADER ===== -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-2">
    <div>
        <h4 class="mb-0 fw-bold" style="color:#0f766e; font-size:1.55rem;">
            <i class="bi bi-pie-chart-fill" style="color:#0d9488;"></i> แดชบอร์ดวิเคราะห์เครดิตเชิงกลยุทธ์ (AR Executive Summary)
        </h4>
        <small class="text-muted">
            <i class="bi bi-calendar3"></i>
            @DateTime.Now.ToString("dd MMMM yyyy HH:mm", new System.Globalization.CultureInfo("th-TH")) น.
            &nbsp;|&nbsp; อัปเดตข้อมูลแบบเรียลไทม์
        </small>
        <div class="d-flex flex-wrap gap-2 mt-2">
            <span class="badge px-3 py-2 fs-7 shadow-sm" style="background-color: #f0fdfa; color: #0f766e; border: 1.5px solid #0d9488;">
                <i class="bi bi-file-earmark-spreadsheet me-1" style="color: #0d9488;"></i> บิลขายล่าสุด: <strong style="color: #115e59;">@(ViewBag.LatestBillDate != null ? ((DateTime)ViewBag.LatestBillDate).ToString("dd/MM/yyyy") : "-")</strong>
            </span>
            <span class="badge px-3 py-2 fs-7 shadow-sm" style="background-color: #fefce8; color: #854d0e; border: 1.5px solid #eab308;">
                <i class="bi bi-person-lines-fill me-1" style="color: #ca8a04;"></i> การ์ดลูกหนี้ล่าสุด: <strong style="color: #713f12;">@(ViewBag.LatestDebtorDate != null ? ((DateTime)ViewBag.LatestDebtorDate).ToString("dd/MM/yyyy") : "-")</strong>
            </span>
            <span class="badge px-3 py-2 fs-7 shadow-sm" style="background-color: #f0fdf4; color: #166534; border: 1.5px solid #22c55e;">
                <i class="bi bi-receipt me-1" style="color: #16a34a;"></i> สรุปรับเงินล่าสุด: <strong style="color: #14532d;">@(ViewBag.LatestReceiptDate != null ? ((DateTime)ViewBag.LatestReceiptDate).ToString("dd/MM/yyyy") : "-")</strong>
            </span>
        </div>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm fw-bold">
            <i class="bi bi-printer"></i> พิมพ์หน้าจอ
        </button>
        <a href="/Dashboard/Comparison" class="btn btn-sm fw-bold text-white" style="background:#0f766e; border-color:#0f766e;">
            <i class="bi bi-layout-three-columns me-1"></i> ดูกระดานเปรียบเทียบ 3 ส่วน
        </a>
        <a href="/SalesBill" class="btn btn-outline-primary btn-sm fw-bold">
            <i class="bi bi-receipt"></i> บิลขายทั้งหมด
        </a>
    </div>
</div>

<!-- ===== 1. ส่วนบนสุด: กล่องแดชบอร์ดสรุปภาพรวม 4 การ์ดหลัก (EXECUTIVE BUSINESS PALETTE) ===== -->
<div class="row g-3 mb-4">
    <!-- Card 1: 7 วัน กทม. ธีมสีฟ้าพาสเทลนุ่มนวล (Soft Ice Blue) -->
    <div class="col-6 col-lg-3">
        <div class="exec-card theme-iceblue" id="card-cash7" onclick="selectCategory('cash7')" title="คลิกเพื่อดูรายละเอียดบิล เก็บสด 7 วัน">
            <div class="exec-card-label">
                <span><i class="bi bi-buildings-fill me-1"></i> 7 วัน กทม.&ปริมณฑล</span>
                <span class="badge bg-white fw-bold" style="color:#0284c7;" id="badgeCount-cash7">@summary.Cash7Days.BillCount.ToString("N0") บิล</span>
            </div>
            <div class="exec-card-value" id="cardAmount-cash7">@summary.Cash7Days.TotalAmount.ToString("N0")</div>
            <div class="exec-card-sub">
                กทม.&ปริมณฑล ณ 14/09+ <i class="bi bi-arrow-down-circle ms-1"></i>
            </div>
            <div class="collection-rate-tag">
                สัดส่วนหนี้: <strong id="tagPct-cash7">@pctCash7.ToString("0.0")%</strong>
            </div>
        </div>
    </div>

    <!-- Card 2: นโยบายรวมสายเวลาเงินสด กทม. ธีมสีชาไทยพาสเทล / ครีมอุ่น (Warm Sand) -->
    <div class="col-6 col-lg-3">
        <div class="exec-card theme-warmsand" id="card-cash10" onclick="selectCategory('cash10')" title="คลิกเพื่อดูรายละเอียดบิล เงินสดรวมสายเวลา">
            <div class="exec-card-label">
                <span><i class="bi bi-hourglass-split me-1"></i> รวมสายเวลาเงินสด กทม.</span>
                <span class="badge bg-white fw-bold" style="color:#b45309;" id="badgeCount-cash10">@summary.Cash10Days.BillCount.ToString("N0") บิล</span>
            </div>
            <div class="exec-card-value" id="cardAmount-cash10">@summary.Cash10Days.TotalAmount.ToString("N0")</div>
            <div class="exec-card-sub">
                กทม. ก่อน 14/09 (7 วัน) + หลัง 14/09 (10 วัน) <i class="bi bi-arrow-down-circle ms-1"></i>
            </div>
            <div class="collection-rate-tag">
                สัดส่วนหนี้: <strong id="tagPct-cash10">@pctCashTimeline.ToString("0.0")%</strong>
            </div>
        </div>
    </div>

    <!-- Card 3: ค้างวิกฤต > 120 วัน ธีมสีแดงทับทิมสุภาพ (Crimson Red) -->
    <div class="col-6 col-lg-3">
        <div class="exec-card theme-crimson" id="card-over120" onclick="selectCategory('over120')" title="คลิกเพื่อดูรายละเอียดบิล ค้างชำระเกิน 120 วัน">
            <div class="exec-card-label">
                <span><span class="blink-icon">⚠️</span> ค้างวิกฤต > 120 วัน</span>
                <span class="badge bg-white fw-bold" style="color:#be123c;" id="badgeCount-over120">@summary.Overdue120Days.BillCount.ToString("N0") บิล</span>
            </div>
            <div class="exec-card-value" id="cardAmount-over120">@summary.Overdue120Days.TotalAmount.ToString("N0")</div>
            <div class="exec-card-sub">
                หนี้เกินกำหนดชำระ 120 วัน <i class="bi bi-arrow-down-circle ms-1"></i>
            </div>
            <div class="collection-rate-tag">
                หนี้วิกฤต: <strong id="tagPct-over120">@(((summary.TotalSalesAmount > 0) ? (summary.Overdue120Days.TotalAmount / summary.TotalSalesAmount * 100) : 0).ToString("0.0"))%</strong> ของยอดขาย
            </div>
        </div>
    </div>

    <!-- Card 4: ยอดเก็บสำเร็จประจำเดือน ธีมสีเขียวมินต์พาสเทล / ใบไม้ (Mint Green) -->
    <div class="col-6 col-lg-3">
        <div class="exec-card theme-mint" id="card-collected" onclick="selectCategory('collected')" title="คลิกเพื่อดูรายละเอียดบิล ยอดเก็บเงินสำเร็จ">
            <div class="exec-card-label">
                <span><i class="bi bi-check-circle-fill me-1"></i> ยอดเก็บสำเร็จ</span>
                <span class="badge bg-white fw-bold" style="color:#047857;" id="badgeCount-collected">@summary.Collected.BillCount.ToString("N0") บิล</span>
            </div>
            <div class="exec-card-value" id="cardAmount-collected">@summary.Collected.TotalAmount.ToString("N0")</div>
            <div class="exec-card-sub">
                ชำระเงินเรียบร้อยแล้ว <i class="bi bi-arrow-down-circle ms-1"></i>
            </div>
            <div class="collection-rate-tag" style="background: rgba(255,255,255,0.32); border-color:#ffffff;">
                % Collection Rate = <strong style="font-size:0.92rem;" id="tagCollectionRate">@summary.CollectionRate.ToString("0.00")%</strong>
            </div>
        </div>
    </div>
</div>

<!-- ===== 2. ส่วนกลาง: ระบบกราฟวงกลมพรีเซนต์ (AR Allocation Pie Chart) ===== -->
<div class="row g-3 mb-4">
    <!-- Chart: AR Allocation Pie Chart -->
    <div class="col-12 col-lg-6">
        <div class="chart-panel">
            <div class="panel-title">
                <i class="bi bi-pie-chart-fill" style="color:#0f766e;"></i>
                กราฟวงกลมสรุปสัดส่วนหนี้ค้างชำระรวม (AR Allocation Pie Chart)
            </div>
            <div class="d-flex justify-content-center align-items-center" style="position:relative; min-height: 270px;">
                <canvas id="arAllocationPieChart" style="max-height: 260px; max-width: 100%;"></canvas>
            </div>
            <div class="text-center mt-2 text-muted small">
                * กราฟคำนวณและปรับสัดส่วนแบบ Real-time ตามเงื่อนไขการพิมพ์ค้นหาด้านล่าง
            </div>
        </div>
    </div>

    <!-- Strategic Insights & Group Breakdown -->
    <div class="col-12 col-lg-6">
        <div class="chart-panel">
            <div class="panel-title">
                <i class="bi bi-bar-chart-steps" style="color:#0d9488;"></i>
                สรุปมูลค่าหนี้และสัดส่วนตามเกณฑ์พื้นที่และเวลา (Strategic AR Breakdown)
            </div>

            <!-- Group 1: 7 วัน กทม. (Soft Ice Blue) -->
            <div class="p-3 mb-2 rounded-3 border" style="background:#f0f9ff; border-color:#bae6fd !important;">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-bold" style="color:#0369a1;">
                        <i class="bi bi-square-fill me-1" style="color:#0284c7;"></i> 1. บิลเก็บสด 7 วัน (กทม. & ปริมณฑล)
                    </span>
                    <span class="badge px-2 py-1" style="background:#0284c7; color:#fff;" id="pctText-cash7">@pctCash7.ToString("0.0")%</span>
                </div>
                <div class="d-flex justify-content-between text-muted small">
                    <span>ยอดหนี้คงค้าง: <strong class="text-dark fs-6" id="breakdownAmount-cash7">@pieCash7.ToString("N0")</strong> บาท</span>
                    <span>จำนวน: <strong class="text-dark" id="breakdownCount-cash7">@summary.Cash7Days.BillCount.ToString("N0")</strong> บิล</span>
                </div>
                <div class="progress mt-2" style="height: 6px;">
                    <div class="progress-bar" id="progBar-cash7" role="progressbar" style="width: @pctCash7%; background:#0284c7;"></div>
                </div>
            </div>

            <!-- Group 2: รวมสายเวลา กทม. (Warm Sand / Terracotta) -->
            <div class="p-3 mb-2 rounded-3 border" style="background:#fffbeb; border-color:#fde68a !important;">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-bold" style="color:#b45309;">
                        <i class="bi bi-square-fill me-1" style="color:#d97706;"></i> 2. บิลเงินสดรวมสายเวลาต่อเนื่อง (กทม. & ปริมณฑล)
                    </span>
                    <span class="badge px-2 py-1" style="background:#d97706; color:#fff;" id="pctText-cash10">@pctCashTimeline.ToString("0.0")%</span>
                </div>
                <div class="d-flex justify-content-between text-muted small">
                    <span>ยอดหนี้คงค้าง: <strong class="text-dark fs-6" id="breakdownAmount-cash10">@pieCashTimeline.ToString("N0")</strong> บาท</span>
                    <span>จำนวน: <strong class="text-dark" id="breakdownCount-cash10">@summary.Cash10Days.BillCount.ToString("N0")</strong> บิล</span>
                </div>
                <div class="progress mt-2" style="height: 6px;">
                    <div class="progress-bar" id="progBar-cash10" role="progressbar" style="width: @pctCashTimeline%; background:#d97706;"></div>
                </div>
            </div>

            <!-- Group 3: ต่างจังหวัดทั้งหมด (Pastel Purple / Lavender Slate) -->
            <div class="p-3 mb-2 rounded-3 border" style="background:#f5f3ff; border-color:#ddd6fe !important;">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-bold" style="color:#6d28d9;">
                        <i class="bi bi-square-fill me-1" style="color:#7c3aed;"></i> 3. บิลค้างชำระฝั่งต่างจังหวัดทั้งหมด
                    </span>
                    <span class="badge px-2 py-1" style="background:#7c3aed; color:#fff;" id="pctText-upcountry">@pctUpcountry.ToString("0.0")%</span>
                </div>
                <div class="d-flex justify-content-between text-muted small">
                    <span>ยอดหนี้คงค้าง: <strong class="text-dark fs-6" id="breakdownAmount-upcountry">@pieUpcountry.ToString("N0")</strong> บาท</span>
                    <span>จำนวน: <strong class="text-dark" id="breakdownCount-upcountry">@summary.UpcountryDebts.BillCount.ToString("N0")</strong> บิล</span>
                </div>
                <div class="progress mt-2" style="height: 6px;">
                    <div class="progress-bar" id="progBar-upcountry" role="progressbar" style="width: @pctUpcountry%; background:#7c3aed;"></div>
                </div>
            </div>

            <!-- Total Overall Collection Rate Highlight -->
            <div class="p-2 bg-light rounded-3 d-flex justify-content-between align-items-center border mt-3">
                <span class="small fw-bold text-secondary">
                    <i class="bi bi-graph-up-arrow text-success me-1"></i> ประสิทธิภาพการจัดเก็บหนี้ (Collection Rate):
                </span>
                <span class="fw-black fs-6 text-success" id="totalCollectionRateDisplay">
                    @summary.CollectionRate.ToString("0.00")%
                </span>
            </div>
        </div>
    </div>
</div>

<!-- ===== 3. ส่วนล่าง: ตารางรายงานรายบิลพร้อมช่องค้นหา 4 ช่อง และปุ่ม Export ===== -->
<div class="drilldown-container" id="drilldownSection">
    <!-- Header Bar: Title + Export Buttons -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3 pb-3 border-bottom">
        <div>
            <h5 class="fw-bold mb-1" style="color:#0f766e;">
                <i class="bi bi-table me-1"></i> <span id="currentCategoryTitle">รายงานรายละเอียดรายบิล: ภาพรวมทั้งหมด</span>
            </h5>
            <small class="text-muted" id="currentCategorySub">แสดงรายการบิลและสามารถกรองค้นหา พร้อมกดส่งออกไฟล์ Excel และ PDF ได้ทันที</small>
        </div>

        <!-- Export Buttons -->
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-success btn-sm fw-bold px-3 shadow-sm" onclick="triggerExportExcel()" title="ส่งออกไฟล์ Excel สำหรับข้อมูลที่กรองอยู่">
                <i class="bi bi-file-earmark-excel-fill me-1"></i> Export Excel
            </button>
            <button type="button" class="btn btn-danger btn-sm fw-bold px-3 shadow-sm" onclick="triggerExportPdf()" title="ส่งออกไฟล์ PDF สำหรับข้อมูลที่กรองอยู่">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i> Export PDF
            </button>
        </div>
    </div>

    <!-- Category Pill Switcher -->
    <div class="d-flex flex-wrap gap-2 mb-3">
        <button type="button" class="btn btn-outline-secondary category-btn active" id="pill-all" onclick="selectCategory('all')">
            ทั้งหมด (@drilldownBills.Count.ToString("N0"))
        </button>
        <button type="button" class="btn category-btn" style="color:#0284c7; border-color:#0284c7;" id="pill-cash7" onclick="selectCategory('cash7')">
            🏢 เก็บสด 7 วัน กทม. (@summary.Cash7Days.BillCount.ToString("N0"))
        </button>
        <button type="button" class="btn category-btn" style="color:#b45309; border-color:#d97706;" id="pill-cash10" onclick="selectCategory('cash10')">
            ⏳ รวมสายเวลาเงินสด กทม. (@summary.Cash10Days.BillCount.ToString("N0"))
        </button>
        <button type="button" class="btn category-btn" style="color:#7c3aed; border-color:#7c3aed;" id="pill-upcountry" onclick="selectCategory('upcountry')">
            🚚 ต่างจังหวัดทั้งหมด (@summary.UpcountryDebts.BillCount.ToString("N0"))
        </button>
        <button type="button" class="btn category-btn" style="color:#be123c; border-color:#be123c;" id="pill-over120" onclick="selectCategory('over120')">
            ⚠️ ค้างชำระ > 120 วัน (@summary.Overdue120Days.BillCount.ToString("N0"))
        </button>
        <button type="button" class="btn category-btn" style="color:#047857; border-color:#059669;" id="pill-collected" onclick="selectCategory('collected')">
            ✅ ยอดเก็บสำเร็จ (@summary.Collected.BillCount.ToString("N0"))
        </button>
    </div>

    <!-- 7 Real-time Search Input Fields -->
    <div class="row g-2 search-input-group mb-3 p-3 bg-light rounded-3 border">
        <div class="col-12 col-md-3">
            <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-receipt"></i> 1. เลขที่บิล</label>
            <input type="text" id="inputSearchBill" class="form-control" placeholder="พิมพ์เลขที่บิล..." oninput="handleSearch()" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-qr-code"></i> 2. รหัสลูกค้า</label>
            <input type="text" id="inputSearchCustomerCode" class="form-control" placeholder="พิมพ์รหัสลูกค้า..." oninput="handleSearch()" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-shop"></i> 3. ชื่อลูกค้า</label>
            <input type="text" id="inputSearchCustomerName" class="form-control" placeholder="พิมพ์ชื่อร้านค้า / ลูกค้า..." oninput="handleSearch()" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-person-fill"></i> 4. ผู้แทนขาย</label>
            <div class="input-group">
                <input type="text" id="inputSearchSalesRep" class="form-control" list="salesRepList" placeholder="เลือก/พิมพ์ชื่อผู้แทน..." oninput="handleSearch()" />
                <button type="button" class="btn btn-outline-secondary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false" title="เลือกรายชื่อผู้แทนขาย">
                    <span class="visually-hidden">Toggle Dropdown</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow" style="max-height: 300px; overflow-y: auto;">
                    <li><a class="dropdown-item fw-bold text-primary" href="javascript:void(0)" onclick="setSalesRep('')"><i class="bi bi-x-circle me-1"></i> (ผู้แทนทั้งหมด)</a></li>
                    <li><hr class="dropdown-divider"></li>
                    @foreach (var rep in salesRepList)
                    {
                        <li><a class="dropdown-item" href="javascript:void(0)" onclick="setSalesRep('@rep')">@rep</a></li>
                    }
                </ul>
            </div>
            <datalist id="salesRepList">
                @foreach (var rep in salesRepList)
                {
                    <option value="@rep">@rep</option>
                }
            </datalist>
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-calendar-event"></i> 5. ตั้งแต่วันที่</label>
            <input type="date" id="inputSearchFromDate" class="form-control" onchange="handleSearch()" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-calendar-event"></i> 6. ถึงวันที่</label>
            <input type="date" id="inputSearchToDate" class="form-control" onchange="handleSearch()" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-clock-history"></i> 7. เครดิต (วัน)</label>
            <input type="number" id="inputSearchCredit" class="form-control" placeholder="เช่น 30" min="0" oninput="handleSearch()" />
        </div>
        <div class="col-12 col-md-3 d-flex align-items-end">
            <button type="button" class="btn btn-outline-secondary w-100 py-2 fw-bold" onclick="clearFilters()" title="ล้างตัวกรองทั้งหมด">
                <i class="bi bi-x-circle me-1"></i> ล้างตัวกรอง
            </button>
        </div>
    </div>

    <div class="alert alert-light border py-2 px-3 small d-flex flex-wrap justify-content-between align-items-center mb-3" style="background:#f0fdfa; border-color:#ccfbf1; border-radius:10px;">
        <div class="text-teal fw-semibold" style="color:#0f766e;">
            <i class="bi bi-lightning-charge-fill text-warning me-1"></i> ระบบแบ่งหน้าละ <strong id="currentBadgePageSize">50</strong> รายการ โหลดเร็วติดทันที และคลิกดูรายละเอียดของการ์ดแต่ละอันได้ครบถ้วน 100%
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-white text-secondary border px-2 py-1"><i class="bi bi-speedometer2 me-1 text-success"></i>โหลดเร็ว &lt; 0.1 วิ</span>
            <a href="/Debtor" class="btn btn-sm btn-outline-teal fw-bold" style="font-size:0.82rem; border-color:#0d9488; color:#0d9488;">
                <i class="bi bi-arrow-right-circle me-1"></i> การ์ดลูกหนี้
            </a>
        </div>
    </div>

    <!-- Pagination & Rows per page Toolbar (Top) -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 px-1 gap-2">
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted small">
                แสดง <strong id="pageStart" class="text-dark">0</strong> - <strong id="pageEnd" class="text-dark">0</strong> จากทั้งหมด <strong id="pageTotal" class="text-primary">@drilldownBills.Count.ToString("N0")</strong> รายการ (หน้า <strong id="pageCurrent" class="text-dark">1</strong>/<span id="pageMax">1</span>)
            </span>
            <div id="loadingSpinner" class="spinner-border spinner-border-sm text-teal d-none" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div class="d-flex align-items-center gap-1">
                <label for="selectPageSize" class="text-muted small fw-semibold text-nowrap mb-0">แสดงหน้าละ:</label>
                <select id="selectPageSize" class="form-select form-select-sm" style="width: auto;" onchange="changePageSize(this.value)">
                    <option value="30">30 รายการ</option>
                    <option value="50" selected>50 รายการ (แนะนำ)</option>
                    <option value="100">100 รายการ</option>
                    <option value="200">200 รายการ</option>
                </select>
            </div>
            <nav aria-label="Page navigation top">
                <ul class="pagination pagination-sm mb-0" id="paginationTop">
                    <!-- Dynamic JS pagination -->
                </ul>
            </nav>
        </div>
    </div>

    <!-- Table Responsive (11 Columns) -->
    <div class="table-responsive shadow-sm border rounded-3" style="max-height: 580px; overflow-y: auto;">
        <table class="table table-sm table-bordered table-hover align-middle detail-table mb-0" id="billsTable">
            <thead class="sticky-top">
                <tr>
                    <th style="width: 45px;" class="text-center">#</th>
                    <th style="width: 110px;" class="text-center">เลขที่บิล</th>
                    <th style="width: 95px;" class="text-center">วันที่บิล</th>
                    <th style="width: 95px;" class="text-center">รหัสลูกค้า</th>
                    <th class="col-customer-name" style="min-width: 220px;">ชื่อลูกค้า</th>
                    <th style="width: 100px;">อำเภอ</th>
                    <th style="width: 100px;">จังหวัด</th>
                    <th style="width: 60px;" class="text-center">เครดิต</th>
                    <th style="width: 100px;" class="text-center">อายุหนี้ / สถานะ</th>
                    <th style="width: 120px;" class="text-end">จำนวนเงิน (บาท)</th>
                    <th style="width: 100px;">ผู้แทนขาย</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                <tr id="loadingRow">
                    <td colspan="11" class="text-center py-5 text-muted">
                        <div class="spinner-border spinner-border-sm text-teal me-2" role="status"></div>
                        กำลังโหลดข้อมูลบิล...
                    </td>
                </tr>
            </tbody>
            <tfoot class="table-light sticky-bottom" style="font-weight: 800; border-top: 2px solid #0f766e;">
                <tr>
                    <td colspan="9" class="text-end py-2">
                        ยอดรวมทั้งสิ้น (<span id="visibleRowCount" class="text-primary">0</span> รายการ):
                    </td>
                    <td class="text-end py-2 fs-6 fw-black" style="color:#0f766e;" id="visibleTotalAmount">
                        0.00
                    </td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Pagination Toolbar (Bottom) -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 px-1 gap-2">
        <span class="text-muted small">
            แสดง <strong id="pageStartBottom" class="text-dark">0</strong> - <strong id="pageEndBottom" class="text-dark">0</strong> จากทั้งหมด <strong id="pageTotalBottom" class="text-primary">@drilldownBills.Count.ToString("N0")</strong> รายการ
        </span>
        <nav aria-label="Page navigation bottom">
            <ul class="pagination pagination-sm mb-0" id="paginationBottom">
                <!-- Dynamic JS pagination -->
            </ul>
        </nav>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>
<script>
// Register DataLabels plugin
Chart.register(ChartDataLabels);

// State Management
let currentCategory = 'all';
let currentPage = 1;
let currentPageSize = 50;
let isLoading = false;
let searchDebounceTimer = null;

const categoryTitles = {
    'all': 'ภาพรวมทั้งหมด',
    'cash7': 'เก็บสด 7 วัน (กทม.&ปริมณฑล)',
    'cash10': 'รวมสายเวลาเงินสด (กทม.&ปริมณฑล)',
    'upcountry': 'บิลค้างชำระต่างจังหวัดทั้งหมด',
    'over120': 'ค้างชำระ > 120 วัน',
    'collected': 'ยอดเก็บสำเร็จ'
};

// Global Pie Chart instance
let arPieChart = null;

function initPieChart() {
    const ctx = document.getElementById('arAllocationPieChart');
    if (!ctx) return;

    arPieChart = new Chart(ctx, {
        type: 'pie',
        data: {
            labels: [
                '1. เก็บสด 7 วัน (กทม.&ปริมณฑล)',
                '2. รวมสายเวลาเงินสด (กทม.&ปริมณฑล)',
                '3. ค้างชำระต่างจังหวัดทั้งหมด'
            ],
            datasets: [{
                data: [@pieCash7, @pieCashTimeline, @pieUpcountry],
                backgroundColor: [
                    '#0284c7', // 1. ฟ้าพาสเทลนุ่มนวล (Soft Ice Blue)
                    '#d97706', // 2. ชาไทยพาสเทล / ครีมอุ่น (Warm Sand)
                    '#7c3aed'  // 3. สีม่วงพาสเทลสุภาพ / ม่วงลาเวนเดอร์ (Pastel Purple)
                ],
                borderColor: '#ffffff',
                borderWidth: 2,
                hoverOffset: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            layout: {
                padding: {
                    top: 10,
                    bottom: 10,
                    left: 10,
                    right: 10
                }
            },
            plugins: {
                datalabels: {
                    color: '#ffffff',
                    font: {
                        weight: 'bold',
                        size: 11,
                        family: "'Sarabun', sans-serif"
                    },
                    formatter: function(value, context) {
                        if (!value || value <= 0) return '';
                        const total = context.dataset.data.reduce((a, b) => a + b, 0);
                        const pct = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                        let amtStr = '';
                        if (value >= 1000000) {
                            amtStr = (value / 1000000).toFixed(2) + 'M ฿';
                        } else if (value >= 1000) {
                            amtStr = (value / 1000).toFixed(0) + 'K ฿';
                        } else {
                            amtStr = value.toLocaleString('en-US') + ' ฿';
                        }
                        return `${pct}%
(${amtStr})`;
                    },
                    textAlign: 'center',
                    textShadowColor: 'rgba(0, 0, 0, 0.55)',
                    textShadowBlur: 4
                },
                legend: {
                    position: 'bottom',
                    labels: {
                        font: { size: 11, weight: '700' },
                        padding: 12,
                        generateLabels: function(chart) {
                            const data = chart.data;
                            if (data.labels.length && data.datasets.length) {
                                const dataset = data.datasets[0];
                                const total = dataset.data.reduce((a, b) => a + b, 0);
                                return data.labels.map((label, i) => {
                                    const val = dataset.data[i] || 0;
                                    const pct = total > 0 ? ((val / total) * 100).toFixed(1) : '0.0';
                                    return {
                                        text: `${label} (${val.toLocaleString('en-US')} บาท | ${pct}%)`,
                                        fillStyle: dataset.backgroundColor[i],
                                        strokeStyle: dataset.borderColor || '#fff',
                                        lineWidth: 1,
                                        hidden: isNaN(dataset.data[i]) || chart.getDatasetMeta(0).data[i]?.hidden,
                                        index: i
                                    };
                                });
                            }
                            return [];
                        }
                    }
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            const val = context.raw || 0;
                            const total = context.dataset.data.reduce((a, b) => a + b, 0);
                            const pct = total > 0 ? ((val / total) * 100).toFixed(1) : 0;
                            return ` ${context.label}: ${val.toLocaleString('en-US')} บาท (${pct}%)`;
                        }
                    }
                }
            }
        }
    });
}

function selectCategory(cat, autoScroll = true) {
    currentCategory = cat;
    currentPage = 1;

    // Update active state on top cards
    document.querySelectorAll('.exec-card').forEach(c => c.classList.remove('active-card'));
    const targetCard = document.getElementById('card-' + cat);
    if (targetCard) targetCard.classList.add('active-card');

    // Update active pill button
    document.querySelectorAll('.category-btn').forEach(btn => btn.classList.remove('active'));
    const activePill = document.getElementById('pill-' + cat);
    if (activePill) activePill.classList.add('active');

    // Update title text
    const titleEl = document.getElementById('currentCategoryTitle');
    if (titleEl) {
        titleEl.innerText = 'รายงานรายละเอียดรายบิล: ' + (categoryTitles[cat] || 'ภาพรวมทั้งหมด');
    }

    // Fetch paginated bills (50 per page)
    fetchBills();

    // Smooth scroll down to table
    if (autoScroll) {
        document.getElementById('drilldownSection')?.scrollIntoView({ behavior: 'smooth' });
    }
}

function handleSearch() {
    clearTimeout(searchDebounceTimer);
    searchDebounceTimer = setTimeout(() => {
        currentPage = 1;
        fetchBills();
    }, 250);
}

function changePageSize(newSize) {
    currentPageSize = parseInt(newSize, 10) || 50;
    currentPage = 1;
    const badgeEl = document.getElementById('currentBadgePageSize');
    if (badgeEl) badgeEl.innerText = currentPageSize;
    fetchBills();
}

function goToPage(page) {
    if (page < 1 || isLoading) return;
    currentPage = page;
    fetchBills();
    document.getElementById('billsTable')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

async function fetchBills() {
    if (isLoading) return;
    isLoading = true;

    const spinner = document.getElementById('loadingSpinner');
    if (spinner) spinner.classList.remove('d-none');

    const sBill = encodeURIComponent((document.getElementById('inputSearchBill')?.value || '').trim());
    const sCust = encodeURIComponent((document.getElementById('inputSearchCustomerName')?.value || document.getElementById('inputSearchCustomerCode')?.value || '').trim());
    const sRep = encodeURIComponent((document.getElementById('inputSearchSalesRep')?.value || '').trim());
    const sFromDate = encodeURIComponent((document.getElementById('inputSearchFromDate')?.value || '').trim());
    const sToDate = encodeURIComponent((document.getElementById('inputSearchToDate')?.value || '').trim());
    const sCredit = encodeURIComponent((document.getElementById('inputSearchCredit')?.value || '').trim());

    const url = `/Dashboard/GetDrilldownBills?category=${encodeURIComponent(currentCategory)}&page=${currentPage}&pageSize=${currentPageSize}&searchBill=${sBill}&searchCustomer=${sCust}&searchSalesRep=${sRep}&fromDate=${sFromDate}&toDate=${sToDate}&credit=${sCredit}`;

    try {
        const response = await fetch(url);
        if (!response.ok) throw new Error('Network error: ' + response.status);
        const data = await response.json();

        // ถ้าเซิร์ฟเวอร์ยังเตรียมข้อมูลอยู่ → แสดงสถานะและ retry อัตโนมัติใน 2 วินาที
        if (data.warming) {
            const tbody = document.getElementById('tableBody');
            if (tbody) {
                tbody.innerHTML = `<tr><td colspan="11" class="text-center py-5 text-muted">
                    <div class="spinner-border spinner-border-sm text-teal me-2" role="status"></div>
                    <span class="fw-semibold">กำลังเตรียมข้อมูล...</span>
                    <div class="text-muted small mt-1">ระบบกำลัง Warmup ข้อมูลใน Background จะโหลดอัตโนมัติ</div>
                </td></tr>`;
            }
            isLoading = false;
            if (spinner) spinner.classList.add('d-none');
            // Retry ใน 2 วินาที
            setTimeout(() => fetchBills(), 2000);
            return;
        }

        renderTable(data);
        renderPaginationControls(data);
    } catch (err) {
        console.error('Error fetching drilldown bills:', err);
        const tbody = document.getElementById('tableBody');
        if (tbody) {
            tbody.innerHTML = `<tr><td colspan="11" class="text-center text-danger py-4"><i class="bi bi-exclamation-triangle me-1"></i> เกิดข้อผิดพลาดในการโหลดข้อมูล กรุณาลองใหม่อีกครั้ง</td></tr>`;
        }
    } finally {
        isLoading = false;
        if (spinner) spinner.classList.add('d-none');
    }
}

function renderTable(data) {
    const tbody = document.getElementById('tableBody');
    if (!tbody) return;

    if (!data.items || data.items.length === 0) {
        tbody.innerHTML = `<tr id="emptyRow"><td colspan="11" class="text-center text-muted py-5"><i class="bi bi-inbox fs-3 d-block mb-1 text-muted"></i>ไม่พบรายการข้อมูลที่ตรงกับเงื่อนไข</td></tr>`;
        updateSummaryFooters(0, 0, 0, '0.00', 1, 1);
        return;
    }

    const rowsHtml = data.items.map(item => {
        let badgeHtml = '';
        if (item.isPaid) {
            badgeHtml = `<span class="badge" style="background:#059669; color:#fff;">ชำระแล้ว</span>`;
        } else if (item.agingDays > 120) {
            badgeHtml = `<span class="badge" style="background:#be123c; color:#fff;">เกิน ${item.agingDays} วัน</span>`;
        } else if (item.agingDays > 0) {
            badgeHtml = `<span class="badge" style="background:#d97706; color:#fff;">${item.agingDays} วัน</span>`;
        } else {
            badgeHtml = `<span class="badge bg-light text-muted border">ยังไม่ถึงกำหนด</span>`;
        }

        return `
            <tr>
                <td class="text-center text-muted">${item.index}</td>
                <td class="text-center fw-bold">
                    <span class="badge bg-light text-dark border">${item.billNo}</span>
                </td>
                <td class="text-center text-muted">${item.billDate}</td>
                <td class="text-center"><code class="text-dark fw-bold">${item.customerCode || '-'}</code></td>
                <td class="fw-bold text-dark col-customer-name" style="min-width: 260px; white-space: normal !important; word-break: break-word !important;">${item.customerName || '-'}</td>
                <td>${item.district || '-'}</td>
                <td>${item.province || '-'}</td>
                <td class="text-center">${item.credit}</td>
                <td class="text-center">${badgeHtml}</td>
                <td class="text-end fw-black text-dark" style="font-size:0.95rem;">${item.amountFormatted}</td>
                <td class="fw-semibold text-muted">${item.salesRep || '-'}</td>
            </tr>
        `;
    }).join('');

    tbody.innerHTML = rowsHtml;

    const startIdx = (data.currentPage - 1) * data.pageSize + 1;
    const endIdx = Math.min(startIdx + data.items.length - 1, data.totalItems);
    updateSummaryFooters(startIdx, endIdx, data.totalItems, data.totalAmountFormatted, data.currentPage, data.totalPages);
}

function updateSummaryFooters(start, end, total, totalAmtFormatted, currPage, totalPages) {
    const safeTotal = total || 0;
    const safeStart = safeTotal > 0 ? start : 0;
    const safeEnd = safeTotal > 0 ? end : 0;

    const setTxt = (id, txt) => { const el = document.getElementById(id); if (el) el.innerText = txt; };

    setTxt('pageStart', safeStart.toLocaleString('en-US'));
    setTxt('pageEnd', safeEnd.toLocaleString('en-US'));
    setTxt('pageTotal', safeTotal.toLocaleString('en-US'));
    setTxt('pageCurrent', currPage || 1);
    setTxt('pageMax', totalPages || 1);

    setTxt('pageStartBottom', safeStart.toLocaleString('en-US'));
    setTxt('pageEndBottom', safeEnd.toLocaleString('en-US'));
    setTxt('pageTotalBottom', safeTotal.toLocaleString('en-US'));

    setTxt('visibleRowCount', safeTotal.toLocaleString('en-US'));
    setTxt('visibleTotalAmount', totalAmtFormatted || '0.00');
}

function renderPaginationControls(data) {
    const { currentPage, totalPages } = data;
    const pagTop = document.getElementById('paginationTop');
    const pagBottom = document.getElementById('paginationBottom');

    if (!pagTop && !pagBottom) return;

    if (totalPages <= 1) {
        if (pagTop) pagTop.innerHTML = '';
        if (pagBottom) pagBottom.innerHTML = '';
        return;
    }

    let buttons = '';

    // First & Prev buttons
    const prevDisabled = currentPage <= 1 ? 'disabled' : '';
    buttons += `<li class="page-item ${prevDisabled}"><a class="page-link" href="javascript:void(0)" onclick="goToPage(1)" title="หน้าแรก">&laquo;</a></li>`;
    buttons += `<li class="page-item ${prevDisabled}"><a class="page-link" href="javascript:void(0)" onclick="goToPage(${currentPage - 1})" title="ก่อนหน้า">&lsaquo;</a></li>`;

    // Window of 5 pages
    const maxButtons = 5;
    let startPage = Math.max(1, currentPage - 2);
    let endPage = Math.min(totalPages, startPage + maxButtons - 1);
    if (endPage - startPage < maxButtons - 1) {
        startPage = Math.max(1, endPage - maxButtons + 1);
    }

    if (startPage > 1) {
        buttons += `<li class="page-item"><a class="page-link" href="javascript:void(0)" onclick="goToPage(1)">1</a></li>`;
        if (startPage > 2) {
            buttons += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
        }
    }

    for (let p = startPage; p <= endPage; p++) {
        if (p === currentPage) {
            buttons += `<li class="page-item active" aria-current="page"><span class="page-link" style="background:#0f766e; border-color:#0f766e;">${p}</span></li>`;
        } else {
            buttons += `<li class="page-item"><a class="page-link" href="javascript:void(0)" onclick="goToPage(${p})">${p}</a></li>`;
        }
    }

    if (endPage < totalPages) {
        if (endPage < totalPages - 1) {
            buttons += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
        }
        buttons += `<li class="page-item"><a class="page-link" href="javascript:void(0)" onclick="goToPage(${totalPages})">${totalPages}</a></li>`;
    }

    // Next & Last buttons
    const nextDisabled = currentPage >= totalPages ? 'disabled' : '';
    buttons += `<li class="page-item ${nextDisabled}"><a class="page-link" href="javascript:void(0)" onclick="goToPage(${currentPage + 1})" title="ถัดไป">&rsaquo;</a></li>`;
    buttons += `<li class="page-item ${nextDisabled}"><a class="page-link" href="javascript:void(0)" onclick="goToPage(${totalPages})" title="หน้าสุดท้าย">&raquo;</a></li>`;

    if (pagTop) pagTop.innerHTML = buttons;
    if (pagBottom) pagBottom.innerHTML = buttons;
}

