@model List<RoyalD.Web.Models.OutstandingDebt>
@{
    ViewData["Title"] = "Accounts Receivable Dashboard";
    var summary = ViewBag.Summary as RoyalD.Web.Models.DashboardSummary ?? new RoyalD.Web.Models.DashboardSummary();
    var drilldownBills = ViewBag.DrilldownBills as List<RoyalD.Web.Models.DashboardBillItem> ?? new List<RoyalD.Web.Models.DashboardBillItem>();
    var today = DateTime.Today;
}

<style>
/* ===== DASHBOARD STYLES ===== */
body { font-family: 'Sarabun', 'Noto Sans Thai', 'Leelawadee UI', 'Leelawadee', Tahoma, Arial, sans-serif !important; }

/* Interactive Top Stat Cards */
.dash-card {
    border-radius: 16px;
    padding: 20px 22px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    border: 2px solid transparent;
    color: white;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.25s ease-in-out;
}
.dash-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.18);
    filter: brightness(1.03);
}
.dash-card.active-card {
    border-color: #facc15 !important;
    box-shadow: 0 0 0 3px rgba(250, 204, 21, 0.4), 0 8px 25px rgba(0,0,0,0.2) !important;
}
.dash-card::before {
    content: '';
    position: absolute;
    top: -20px; right: -20px;
    width: 90px; height: 90px;
    border-radius: 50%;
    background: rgba(255,255,255,0.12);
}
.dash-label { font-size: 0.86rem; font-weight: 700; opacity: 0.92; letter-spacing: 0.3px; display: flex; align-items: center; justify-content: space-between; }
.dash-value { font-size: 2.1rem; font-weight: 900; line-height: 1.15; letter-spacing: -0.5px; margin: 8px 0 4px 0; }
.dash-sub { font-size: 0.78rem; opacity: 0.85; }

.bg-cash7 { background: linear-gradient(135deg, #0284c7, #0369a1); }
.bg-cash10 { background: linear-gradient(135deg, #0d9488, #0f766e); }
.bg-over120 { background: linear-gradient(135deg, #e11d48, #9f1239); }
.bg-collected { background: linear-gradient(135deg, #16a34a, #15803d); }

/* Drilldown & Table Container */
.drilldown-container {
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    border: none;
    background: white;
    padding: 24px;
    margin-bottom: 30px;
}
.category-btn {
    border-radius: 20px;
    font-weight: 700;
    font-size: 0.83rem;
    padding: 6px 16px;
    transition: all 0.2s ease;
}
.category-btn.active {
    background-color: #0f766e !important;
    color: white !important;
    border-color: #0f766e !important;
    box-shadow: 0 2px 8px rgba(15, 118, 110, 0.3);
}

.search-input-group .form-control {
    border-radius: 10px;
    font-size: 0.86rem;
    padding: 8px 12px;
}

/* Detail Table */
.detail-table th {
    font-size: 0.83rem;
    font-weight: 700;
    background-color: #1e293b;
    color: #ffffff;
    padding: 11px 12px;
    white-space: nowrap;
}
.detail-table td {
    font-size: 0.86rem;
    vertical-align: middle;
    padding: 9px 12px;
}
.detail-table tbody tr:hover {
    background-color: #f8fafc;
}

/* Comparison Cards */
.compare-panel {
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.09);
    overflow: hidden;
    border: none;
}
.compare-header {
    padding: 14px 20px;
    font-weight: 800;
    font-size: 1rem;
    display: flex;
    align-items: center;
    gap: 8px;
}
.compare-header.bkk { background: linear-gradient(90deg, #4361ee, #3a0ca3); color: white; }
.compare-header.upc { background: linear-gradient(90deg, #2d6a4f, #1b4332); color: white; }
.compare-body { background: #fff; padding: 18px 20px; }
.compare-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid #f0f0f0;
}
.compare-row:last-child { border-bottom: none; }
.compare-row-label { font-size: 0.83rem; font-weight: 700; color: #6b7a99; }
.compare-amount { font-size: 1.5rem; font-weight: 900; color: #1a1a2e; line-height: 1; }
.compare-amount.danger { color: #c1121f; }
.compare-amount.success { color: #1a7a4a; }
.compare-amount.warning { color: #b5540b; }
.compare-bills { font-size: 0.72rem; color: #9aa3b0; font-weight: 600; }

.blink-icon {
    animation: blinkIcon 1.2s infinite;
    display: inline-block;
}
@@keyframes blinkIcon {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.2; }
}

.chart-card {
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    border: none;
    padding: 20px;
    background: white;
}
</style>

<!-- ===== HEADER ===== -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-2">
    <div>
        <h4 class="mb-0 fw-bold" style="color:#0f766e; font-size:1.55rem;">
            <i class="bi bi-speedometer2" style="color:#0d9488;"></i> AR Dashboard & รายงานภาพรวมลูกหนี้
        </h4>
        <small class="text-muted">
            <i class="bi bi-calendar3"></i>
            @DateTime.Now.ToString("dd MMMM yyyy HH:mm", new System.Globalization.CultureInfo("th-TH")) น.
            &nbsp;|&nbsp; อัปเดตข้อมูลแบบเรียลไทม์
        </small>
        <div class="d-flex flex-wrap gap-2 mt-2">
            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 py-2 fs-7">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> บิลขายล่าสุด: <strong>@(ViewBag.LatestBillDate != null ? ((DateTime)ViewBag.LatestBillDate).ToString("dd/MM/yyyy") : "-")</strong>
            </span>
            <span class="badge bg-warning bg-opacity-10 text-dark border border-warning px-3 py-2 fs-7">
                <i class="bi bi-person-lines-fill me-1"></i> การ์ดลูกหนี้ล่าสุด: <strong>@(ViewBag.LatestDebtorDate != null ? ((DateTime)ViewBag.LatestDebtorDate).ToString("dd/MM/yyyy") : "-")</strong>
            </span>
            <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2 fs-7">
                <i class="bi bi-receipt me-1"></i> สรุปรับเงินล่าสุด: <strong>@(ViewBag.LatestReceiptDate != null ? ((DateTime)ViewBag.LatestReceiptDate).ToString("dd/MM/yyyy") : "-")</strong>
            </span>
        </div>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm fw-bold">
            <i class="bi bi-printer"></i> พิมพ์หน้าจอ
        </button>
        <a href="/Debtor" class="btn btn-outline-primary btn-sm fw-bold">
            <i class="bi bi-person-lines-fill"></i> การ์ดลูกหนี้
        </a>
        <a href="/SalesBill" class="btn btn-primary btn-sm fw-bold" style="background:#0f766e; border-color:#0f766e;">
            <i class="bi bi-receipt"></i> บิลขายทั้งหมด
        </a>
    </div>
</div>

<!-- ===== 4 MAIN CLICKABLE DASHBOARD SUMMARY CARDS ===== -->
<div class="row g-3 mb-4">
    <!-- Card 1: เก็บสด 7 วัน (กทม.&ปริมณฑล) -->
    <div class="col-6 col-lg-3">
        <div class="dash-card bg-cash7" id="card-cash7" onclick="selectCategory('cash7')" title="คลิกเพื่อดูรายละเอียดบิล เก็บสด 7 วัน">
            <div class="dash-label">
                <span><i class="bi bi-buildings-fill me-1"></i> เก็บสด 7 วัน</span>
                <span class="badge bg-white text-primary fw-bold" id="badgeCount-cash7">@summary.Cash7Days.BillCount.ToString("N0") บิล</span>
            </div>
            <div class="dash-value" id="cardAmount-cash7">@summary.Cash7Days.TotalAmount.ToString("N0")</div>
            <div class="dash-sub">
                กทม.&ปริมณฑล ณ 14/09+ <i class="bi bi-arrow-down-circle ms-1"></i>
            </div>
        </div>
    </div>

    <!-- Card 2: เงินสด 10 วัน (กทม.&ปริมณฑล) -->
    <div class="col-6 col-lg-3">
        <div class="dash-card bg-cash10" id="card-cash10" onclick="selectCategory('cash10')" title="คลิกเพื่อดูรายละเอียดบิล เงินสด 10 วัน">
            <div class="dash-label">
                <span><i class="bi bi-geo-alt-fill me-1"></i> เงินสด 10 วัน</span>
                <span class="badge bg-white text-dark fw-bold" id="badgeCount-cash10">@summary.Cash10Days.BillCount.ToString("N0") บิล</span>
            </div>
            <div class="dash-value" id="cardAmount-cash10">@summary.Cash10Days.TotalAmount.ToString("N0")</div>
            <div class="dash-sub">
                กทม.&ปริมณฑล ณ 14/09+ <i class="bi bi-arrow-down-circle ms-1"></i>
            </div>
        </div>
    </div>

    <!-- Card 3: ค้างชำระ > 120 วัน -->
    <div class="col-6 col-lg-3">
        <div class="dash-card bg-over120" id="card-over120" onclick="selectCategory('over120')" title="คลิกเพื่อดูรายละเอียดบิล ค้างชำระเกิน 120 วัน">
            <div class="dash-label">
                <span><span class="blink-icon">⚠️</span> ค้างชำระ > 120 วัน</span>
                <span class="badge bg-white text-danger fw-bold" id="badgeCount-over120">@summary.Overdue120Days.BillCount.ToString("N0") บิล</span>
            </div>
            <div class="dash-value" id="cardAmount-over120">@summary.Overdue120Days.TotalAmount.ToString("N0")</div>
            <div class="dash-sub">
                หนี้เกินกำหนด 120 วัน <i class="bi bi-arrow-down-circle ms-1"></i>
            </div>
        </div>
    </div>

    <!-- Card 4: ยอดเก็บเงินสำเร็จ -->
    <div class="col-6 col-lg-3">
        <div class="dash-card bg-collected" id="card-collected" onclick="selectCategory('collected')" title="คลิกเพื่อดูรายละเอียดบิล ยอดเก็บเงินสำเร็จ">
            <div class="dash-label">
                <span><i class="bi bi-check-circle-fill me-1"></i> ยอดเก็บเงินสำเร็จ</span>
                <span class="badge bg-white text-success fw-bold" id="badgeCount-collected">@summary.Collected.BillCount.ToString("N0") บิล</span>
            </div>
            <div class="dash-value" id="cardAmount-collected">@summary.Collected.TotalAmount.ToString("N0")</div>
            <div class="dash-sub">
                ชำระเรียบร้อยแล้ว <i class="bi bi-arrow-down-circle ms-1"></i>
            </div>
        </div>
    </div>
</div>

<!-- ===== INTERACTIVE DRILLDOWN DETAIL TABLE SECTION ===== -->
<div class="drilldown-container" id="drilldownSection">
    <!-- Header Bar: Title + Category Pills + Export Buttons -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3 pb-3 border-bottom">
        <div>
            <h5 class="fw-bold mb-1" style="color:#0f766e;">
                <i class="bi bi-table me-1"></i> <span id="currentCategoryTitle">รายงานรายละเอียดรายบิล: ภาพรวมทั้งหมด</span>
            </h5>
            <small class="text-muted" id="currentCategorySub">แสดงรายการบิลและสามารถกรองค้นหา พร้อมกดส่งออกไฟล์ Excel และ PDF ได้ทันที</small>
        </div>

        <!-- Export Buttons -->
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-success btn-sm fw-bold px-3" onclick="triggerExportExcel()" title="ส่งออกไฟล์ Excel สำหรับข้อมูลที่กรองอยู่">
                <i class="bi bi-file-earmark-excel-fill me-1"></i> Export Excel
            </button>
            <button type="button" class="btn btn-danger btn-sm fw-bold px-3" onclick="triggerExportPdf()" title="ส่งออกไฟล์ PDF สำหรับข้อมูลที่กรองอยู่">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i> Export PDF
            </button>
        </div>
    </div>

    <!-- Category Pill Switcher -->
    <div class="d-flex flex-wrap gap-2 mb-3">
        <button type="button" class="btn btn-outline-secondary category-btn active" id="pill-all" onclick="selectCategory('all')">
            ทั้งหมด (@drilldownBills.Count.ToString("N0"))
        </button>
        <button type="button" class="btn btn-outline-primary category-btn" id="pill-cash7" onclick="selectCategory('cash7')">
            🏢 เก็บสด 7 วัน (@summary.Cash7Days.BillCount.ToString("N0"))
        </button>
        <button type="button" class="btn btn-outline-info category-btn" id="pill-cash10" onclick="selectCategory('cash10')">
            📍 เงินสด 10 วัน (@summary.Cash10Days.BillCount.ToString("N0"))
        </button>
        <button type="button" class="btn btn-outline-danger category-btn" id="pill-over120" onclick="selectCategory('over120')">
            ⚠️ ค้างชำระ > 120 วัน (@summary.Overdue120Days.BillCount.ToString("N0"))
        </button>
        <button type="button" class="btn btn-outline-success category-btn" id="pill-collected" onclick="selectCategory('collected')">
            ✅ ยอดเก็บเงินสำเร็จ (@summary.Collected.BillCount.ToString("N0"))
        </button>
    </div>

    <!-- 3 Search Filters Toolbar -->
    <div class="row g-2 search-input-group mb-3 p-3 bg-light rounded-3 border">
        <div class="col-12 col-md-4">
            <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-receipt"></i> ค้นหาเลขที่บิล</label>
            <input type="text" id="inputSearchBill" class="form-control" placeholder="พิมพ์เลขที่บิล เช่น 630/..., R..." oninput="applyFilters()" />
        </div>
        <div class="col-12 col-md-4">
            <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-person-badge"></i> ค้นหาชื่อลูกค้า / รหัสลูกค้า</label>
            <input type="text" id="inputSearchCustomer" class="form-control" placeholder="พิมพ์ชื่อร้านค้า หรือ รหัสลูกค้า..." oninput="applyFilters()" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-person-fill"></i> ค้นหาผู้แทนขาย</label>
            <input type="text" id="inputSearchSalesRep" class="form-control" placeholder="พิมพ์ชื่อผู้แทนขาย..." oninput="applyFilters()" />
        </div>
        <div class="col-12 col-md-1 d-flex align-items-end">
            <button type="button" class="btn btn-outline-secondary w-100 btn-sm py-2" onclick="clearFilters()" title="ล้างตัวกรอง">
                <i class="bi bi-x-circle"></i> ล้าง
            </button>
        </div>
    </div>

    <!-- Table Responsive -->
    <div class="table-responsive" style="max-height: 580px; overflow-y: auto;">
        <table class="table table-sm table-bordered table-hover align-middle detail-table mb-0" id="billsTable">
            <thead class="sticky-top">
                <tr>
                    <th style="width: 45px;" class="text-center">#</th>
                    <th style="width: 120px;" class="text-center">เลขที่บิล</th>
                    <th style="width: 100px;" class="text-center">วันที่บิล</th>
                    <th style="width: 110px;">ผู้แทนขาย</th>
                    <th style="width: 100px;" class="text-center">รหัสลูกค้า</th>
                    <th>ชื่อลูกค้า</th>
                    <th style="width: 110px;">อำเภอ</th>
                    <th style="width: 110px;">จังหวัด</th>
                    <th style="width: 125px;" class="text-end">จำนวนเงิน</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                @if (!drilldownBills.Any())
                {
                    <tr id="emptyRow">
                        <td colspan="9" class="text-center text-muted py-4">ไม่พบรายการข้อมูล</td>
                    </tr>
                }
                @for (int i = 0; i < drilldownBills.Count; i++)
                {
                    var b = drilldownBills[i];
                    <tr class="bill-row"
                        data-category="@b.Category"
                        data-billno="@b.BillNo"
                        data-custcode="@b.CustomerCode"
                        data-custname="@b.CustomerName"
                        data-salesrep="@b.SalesRep"
                        data-district="@b.District"
                        data-province="@b.Province"
                        data-billdate="@b.BillDate.ToString("dd/MM/yyyy")"
                        data-amount="@b.Amount">
                        <td class="text-center text-muted row-index">@(i + 1)</td>
                        <td class="text-center fw-bold">
                            <span class="badge bg-light text-dark border">@b.BillNo</span>
                        </td>
                        <td class="text-center text-muted">@b.BillDate.ToString("dd/MM/yyyy")</td>
                        <td class="fw-semibold">@b.SalesRep</td>
                        <td class="text-center"><code class="text-dark fw-bold">@b.CustomerCode</code></td>
                        <td class="fw-bold text-dark">@b.CustomerName</td>
                        <td>@b.District</td>
                        <td>@b.Province</td>
                        <td class="text-end fw-black text-dark" style="font-size:0.95rem;">@b.Amount.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light sticky-bottom" style="font-weight: 800; border-top: 2px solid #0f766e;">
                <tr>
                    <td colspan="8" class="text-end py-2">
                        ยอดรวมทั้งสิ้น (<span id="visibleRowCount" class="text-primary">@drilldownBills.Count.ToString("N0")</span> รายการ):
                    </td>
                    <td class="text-end py-2 fs-6 fw-black" style="color:#0f766e;" id="visibleTotalAmount">
                        @drilldownBills.Sum(x => x.Amount).ToString("N2")
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<!-- ===== REGIONAL COMPARISON (กรุงเทพฯ vs ต่างจังหวัด) ===== -->
<div class="section-title mb-2 fw-bold" style="font-size:1.05rem; color:#1e293b;">
    <i class="bi bi-bar-chart-steps" style="color:#0d9488;"></i>
    เปรียบเทียบยอดลูกหนี้ — กรุงเทพฯ (เงินสด/7วัน) vs ต่างจังหวัด
</div>
<div class="row g-3 mb-4">
    <!-- Bangkok (Cash / 7 Days) -->
    <div class="col-md-6">
        <div class="compare-panel">
            <div class="compare-header bkk">
                <i class="bi bi-buildings"></i> กรุงเทพฯ (เงินสด / 7 วัน)
                <span class="ms-auto badge bg-white text-primary fw-bold">@summary.Bangkok.BillCount.ToString("N0") บิล</span>
            </div>
            <div class="compare-body">
                <div class="compare-row">
                    <div class="compare-row-label"><i class="bi bi-cash-stack text-primary me-1"></i> ยอดจำนวนเงินค้างชำระทั้งหมด</div>
                    <div class="compare-row-value">
                        <div class="compare-amount">@summary.Bangkok.OutstandingTotal.TotalAmount.ToString("N0") <small style="font-size:0.85rem;">บาท</small></div>
                        <div class="compare-bills text-primary">@summary.Bangkok.OutstandingTotal.BillCount.ToString("N0") บิล</div>
                    </div>
                </div>
                <div class="compare-row">
                    <div class="compare-row-label"><i class="bi bi-clock-history text-warning me-1"></i> ยอดเกินกำหนดชำระไม่เกิน 120 วัน</div>
                    <div class="compare-row-value">
                        <div class="compare-amount warning">@summary.Bangkok.LessThan120Days.TotalAmount.ToString("N0") <small style="font-size:0.85rem;">บาท</small></div>
                        <div class="compare-bills text-warning">@summary.Bangkok.LessThan120Days.BillCount.ToString("N0") บิล</div>
                    </div>
                </div>
                <div class="compare-row">
                    <div class="compare-row-label text-danger"><span class="blink-icon">⚠️</span> ยอดเกินกำหนดชำระเกิน 120 วัน</div>
                    <div class="compare-row-value">
                        <div class="compare-amount danger">@summary.Bangkok.Over120Days.TotalAmount.ToString("N0") <small style="font-size:0.85rem;">บาท</small></div>
                        <div class="compare-bills text-danger">@summary.Bangkok.Over120Days.BillCount.ToString("N0") บิล</div>
                    </div>
                </div>
                <div class="compare-row">
                    <div class="compare-row-label"><i class="bi bi-check-circle-fill text-success me-1"></i> ยอดเก็บได้แล้ว</div>
                    <div class="compare-row-value">
                        <div class="compare-amount success">@summary.Bangkok.Paid.TotalAmount.ToString("N0") <small style="font-size:0.85rem;">บาท</small></div>
                        <div class="compare-bills text-success">@summary.Bangkok.Paid.BillCount.ToString("N0") บิล</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Upcountry -->
    <div class="col-md-6">
        <div class="compare-panel">
            <div class="compare-header upc">
                <i class="bi bi-geo-alt"></i> ต่างจังหวัด (ทุกภาค)
                <span class="ms-auto badge bg-white text-success fw-bold">@summary.Upcountry.BillCount.ToString("N0") บิล</span>
            </div>
            <div class="compare-body">
                <div class="compare-row">
                    <div class="compare-row-label"><i class="bi bi-cash-stack text-primary me-1"></i> ยอดจำนวนเงินค้างชำระทั้งหมด</div>
                    <div class="compare-row-value">
                        <div class="compare-amount">@summary.Upcountry.OutstandingTotal.TotalAmount.ToString("N0") <small style="font-size:0.85rem;">บาท</small></div>
                        <div class="compare-bills text-primary">@summary.Upcountry.OutstandingTotal.BillCount.ToString("N0") บิล</div>
                    </div>
                </div>
                <div class="compare-row">
                    <div class="compare-row-label"><i class="bi bi-clock-history text-warning me-1"></i> ยอดเกินกำหนดชำระไม่เกิน 120 วัน</div>
                    <div class="compare-row-value">
                        <div class="compare-amount warning">@summary.Upcountry.LessThan120Days.TotalAmount.ToString("N0") <small style="font-size:0.85rem;">บาท</small></div>
                        <div class="compare-bills text-warning">@summary.Upcountry.LessThan120Days.BillCount.ToString("N0") บิล</div>
                    </div>
                </div>
                <div class="compare-row">
                    <div class="compare-row-label text-danger"><span class="blink-icon">⚠️</span> ยอดเกินกำหนดชำระเกิน 120 วัน</div>
                    <div class="compare-row-value">
                        <div class="compare-amount danger">@summary.Upcountry.Over120Days.TotalAmount.ToString("N0") <small style="font-size:0.85rem;">บาท</small></div>
                        <div class="compare-bills text-danger">@summary.Upcountry.Over120Days.BillCount.ToString("N0") บิล</div>
                    </div>
                </div>
                <div class="compare-row">
                    <div class="compare-row-label"><i class="bi bi-check-circle-fill text-success me-1"></i> ยอดเก็บได้แล้ว</div>
                    <div class="compare-row-value">
                        <div class="compare-amount success">@summary.Upcountry.Paid.TotalAmount.ToString("N0") <small style="font-size:0.85rem;">บาท</small></div>
                        <div class="compare-bills text-success">@summary.Upcountry.Paid.BillCount.ToString("N0") บิล</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ===== CHARTS ROW ===== -->
<div class="row g-3 mb-4">
    <div class="col-md-8">
        <div class="chart-card">
            <div class="section-title fw-bold" style="color:#1e293b;">
                <i class="bi bi-bar-chart-fill" style="color:#4361ee;"></i>
                ยอดขาย vs เก็บเงินได้ vs หนี้ค้างชำระ รายเดือน (Grouped Bar)
            </div>
            <canvas id="monthlyChart" height="110"></canvas>
        </div>
    </div>
    <div class="col-md-4">
        <div class="chart-card">
            <div class="section-title fw-bold" style="color:#1e293b;">
                <i class="bi bi-pie-chart-fill" style="color:#e63946;"></i>
                สัดส่วนสถานะหนี้
            </div>
            <canvas id="statusChart" height="190"></canvas>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
// State Management
let currentCategory = 'all';

const categoryTitles = {
    'all': 'ภาพรวมทั้งหมด',
    'cash7': 'เก็บสด 7 วัน (กทม.&ปริมณฑล)',
    'cash10': 'เงินสด 10 วัน (กทม.&ปริมณฑล)',
    'over120': 'ค้างชำระ > 120 วัน',
    'collected': 'ยอดเก็บเงินสำเร็จ'
};

function selectCategory(cat) {
    currentCategory = cat;

    // Update active state on top cards
    document.querySelectorAll('.dash-card').forEach(c => c.classList.remove('active-card'));
    const targetCard = document.getElementById('card-' + cat);
    if (targetCard) targetCard.classList.add('active-card');

    // Update active pill button
    document.querySelectorAll('.category-btn').forEach(btn => btn.classList.remove('active'));
    const activePill = document.getElementById('pill-' + cat);
    if (activePill) activePill.classList.add('active');

    // Update title text
    document.getElementById('currentCategoryTitle').innerText = 'รายงานรายละเอียดรายบิล: ' + (categoryTitles[cat] || 'ภาพรวมทั้งหมด');

    // Apply filters and smooth scroll
    applyFilters();

    const drilldownEl = document.getElementById('drilldownSection');
    if (drilldownEl) {
        drilldownEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
}

function applyFilters() {
    const sBill = (document.getElementById('inputSearchBill').value || '').trim().toLowerCase();
    const sCust = (document.getElementById('inputSearchCustomer').value || '').trim().toLowerCase();
    const sRep = (document.getElementById('inputSearchSalesRep').value || '').trim().toLowerCase();

    const rows = document.querySelectorAll('.bill-row');
    let visibleCount = 0;
    let visibleSum = 0;

    // Counters for recalculating top cards dynamically
    let sumCash7 = 0, countCash7 = 0;
    let sumCash10 = 0, countCash10 = 0;
    let sumOver120 = 0, countOver120 = 0;
    let sumCollected = 0, countCollected = 0;

    let index = 1;
    rows.forEach(row => {
        const cat = row.getAttribute('data-category') || '';
        const billNo = (row.getAttribute('data-billno') || '').toLowerCase();
        const custCode = (row.getAttribute('data-custcode') || '').toLowerCase();
        const custName = (row.getAttribute('data-custname') || '').toLowerCase();
        const salesRep = (row.getAttribute('data-salesrep') || '').toLowerCase();
        const amt = parseFloat(row.getAttribute('data-amount') || '0');

        // Check search conditions
        const matchSearch = (!sBill || billNo.includes(sBill)) &&
                            (!sCust || custName.includes(sCust) || custCode.includes(sCust)) &&
                            (!sRep || salesRep.includes(sRep));

        // Tally category amounts matching search
        if (matchSearch) {
            if (cat === 'cash7') { sumCash7 += amt; countCash7++; }
            else if (cat === 'cash10') { sumCash10 += amt; countCash10++; }
            else if (cat === 'over120') { sumOver120 += amt; countOver120++; }
            else if (cat === 'collected') { sumCollected += amt; countCollected++; }
        }

        // Check category filter for table row display
        const matchCat = (currentCategory === 'all' || cat === currentCategory);

        if (matchSearch && matchCat) {
            row.style.display = '';
            row.querySelector('.row-index').innerText = index++;
            visibleCount++;
            visibleSum += amt;
        } else {
            row.style.display = 'none';
        }
    });

    // Update table footer summary
    document.getElementById('visibleRowCount').innerText = visibleCount.toLocaleString('en-US');
    document.getElementById('visibleTotalAmount').innerText = visibleSum.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    // Update top summary cards dynamically based on active search
    document.getElementById('cardAmount-cash7').innerText = sumCash7.toLocaleString('en-US', { maximumFractionDigits: 0 });
    document.getElementById('badgeCount-cash7').innerText = countCash7.toLocaleString('en-US') + ' บิล';

    document.getElementById('cardAmount-cash10').innerText = sumCash10.toLocaleString('en-US', { maximumFractionDigits: 0 });
    document.getElementById('badgeCount-cash10').innerText = countCash10.toLocaleString('en-US') + ' บิล';

    document.getElementById('cardAmount-over120').innerText = sumOver120.toLocaleString('en-US', { maximumFractionDigits: 0 });
    document.getElementById('badgeCount-over120').innerText = countOver120.toLocaleString('en-US') + ' บิล';

    document.getElementById('cardAmount-collected').innerText = sumCollected.toLocaleString('en-US', { maximumFractionDigits: 0 });
    document.getElementById('badgeCount-collected').innerText = countCollected.toLocaleString('en-US') + ' บิล';
}

function clearFilters() {
    document.getElementById('inputSearchBill').value = '';
    document.getElementById('inputSearchCustomer').value = '';
    document.getElementById('inputSearchSalesRep').value = '';
    applyFilters();
}

function triggerExportExcel() {
    const sBill = encodeURIComponent((document.getElementById('inputSearchBill').value || '').trim());
    const sCust = encodeURIComponent((document.getElementById('inputSearchCustomer').value || '').trim());
    const sRep = encodeURIComponent((document.getElementById('inputSearchSalesRep').value || '').trim());
    const url = `/Dashboard/ExportExcel?category=${currentCategory}&searchBill=${sBill}&searchCustomer=${sCust}&searchSalesRep=${sRep}`;
    window.location.href = url;
}

function triggerExportPdf() {
    const sBill = encodeURIComponent((document.getElementById('inputSearchBill').value || '').trim());
    const sCust = encodeURIComponent((document.getElementById('inputSearchCustomer').value || '').trim());
    const sRep = encodeURIComponent((document.getElementById('inputSearchSalesRep').value || '').trim());
    const url = `/Dashboard/ExportPdf?category=${currentCategory}&searchBill=${sBill}&searchCustomer=${sCust}&searchSalesRep=${sRep}`;
    window.open(url, '_blank');
}

// ===== CHARTS INITIALIZATION =====
const monthlyCtx = document.getElementById('monthlyChart');
const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartLabels as List<string> ?? new List<string>()));
const values = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartValues as List<decimal> ?? new List<decimal>()));
const paidValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.PaidValues as List<decimal> ?? new List<decimal>()));
const overdueValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.OverdueValues as List<decimal> ?? new List<decimal>()));

new Chart(monthlyCtx, {
    type: 'bar',
    data: {
        labels: labels,
        datasets: [
            {
                label: 'ยอดขาย (บาท)',
                data: values,
                backgroundColor: 'rgba(67,97,238,0.80)',
                borderColor: '#4361ee',
                borderWidth: 1.5,
                borderRadius: 6
            },
            {
                label: 'ยอดเก็บเงินได้ (บาท)',
                data: paidValues.length > 0 ? paidValues : values.map(v => v * 0.75),
                backgroundColor: 'rgba(45,198,83,0.80)',
                borderColor: '#2dc653',
                borderWidth: 1.5,
                borderRadius: 6
            },
            {
                label: 'ยอดหนี้ค้างชำระ (บาท)',
                data: overdueValues.length > 0 ? overdueValues : values.map(v => v * 0.18),
                backgroundColor: 'rgba(230,57,70,0.85)',
                borderColor: '#e63946',
                borderWidth: 1.5,
                borderRadius: 6
            }
        ]
    },
    options: {
        responsive: true,
        interaction: { mode: 'index', intersect: false },
        plugins: {
            legend: { position: 'top', labels: { font: { size: 13, weight: 'bold' }, padding: 15 } }
        },
        scales: {
            x: { ticks: { font: { size: 12, weight: '700' } } },
            y: {
                beginAtZero: true,
                ticks: {
                    font: { size: 12, weight: '700' },
                    callback: v => (v >= 1000000 ? (v/1000000).toFixed(1)+'M' : (v/1000).toFixed(0)+'K')
                },
                grid: { color: '#f0f0f0' }
            }
        }
    }
});

const statusCtx = document.getElementById('statusChart');
new Chart(statusCtx, {
    type: 'doughnut',
    data: {
        labels: ['ค้างชำระ > 120 วัน', 'ผ่อนชำระ', 'เลื่อนนัด', 'หนี้สูญ'],
        datasets: [{
            data: [@ViewBag.OverdueCount, @ViewBag.InstallmentCount, @ViewBag.PostponedCount, @ViewBag.BadDebtCount],
            backgroundColor: ['#e11d48', '#f59e0b', '#64748b', '#334155'],
            borderWidth: 0
        }]
    },
    options: {
        responsive: true,
        plugins: {
            legend: { position: 'bottom', labels: { font: { size: 12, weight: '700' }, padding: 10 } }
        },
        cutout: '65%'
    }
});
</script>
}
