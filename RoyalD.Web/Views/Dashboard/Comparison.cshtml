        <div class="d-flex gap-2 flex-wrap">
            <button type="button" class="btn btn-outline-secondary btn-sm fw-bold" onclick="setFilter('all', 'all')">
                <i class="bi bi-grid-fill me-1"></i> แสดงทั้งหมดทุกกลุ่ม
            </button>
            <button type="button" class="btn btn-success btn-sm fw-bold px-3 shadow-sm" onclick="triggerExportExcel()" title="ส่งออก Excel ข้อมูลที่กรองอยู่">
                <i class="bi bi-file-earmark-excel-fill me-1"></i> Export Excel
            </button>
            <button type="button" class="btn btn-danger btn-sm fw-bold px-3 shadow-sm" onclick="triggerExportPdf()" title="ส่งออก PDF ข้อมูลที่กรองอยู่">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i> Export PDF
            </button>
        </div>
    </div>

    <!-- 4 Real-time Search Input Fields -->
    <div class="row g-2 search-input-group mb-3 p-3 bg-light rounded-3 border">
        <div class="col-12 col-md-3">
            <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-receipt"></i> 1. เลขที่บิล</label>
            <input type="text" id="compSearchBill" class="form-control form-control-sm" placeholder="พิมพ์เลขที่บิล..." oninput="applyAllFilters()" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-qr-code"></i> 2. รหัสลูกค้า</label>
            <input type="text" id="compSearchCustomerCode" class="form-control form-control-sm" placeholder="พิมพ์รหัสลูกค้า..." oninput="applyAllFilters()" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-shop"></i> 3. ชื่อลูกค้า</label>
            <input type="text" id="compSearchCustomerName" class="form-control form-control-sm" placeholder="พิมพ์ชื่อร้านค้า / ลูกค้า..." oninput="applyAllFilters()" />
        </div>
        <div class="col-12 col-md-2">
            <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-person-fill"></i> 4. ผู้แทนขาย</label>
            <div class="input-group input-group-sm">
                <input type="text" id="compSearchSalesRep" class="form-control form-control-sm" list="compSalesRepList" placeholder="เลือก/พิมพ์ผู้แทน..." oninput="applyAllFilters()" />
                <button type="button" class="btn btn-outline-secondary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false" title="เลือกรายชื่อผู้แทนขาย">
                    <span class="visually-hidden">Toggle Dropdown</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow" style="max-height: 300px; overflow-y: auto;">
                    <li><a class="dropdown-item fw-bold text-primary" href="javascript:void(0)" onclick="setCompSalesRep('')"><i class="bi bi-x-circle me-1"></i> (ผู้แทนทั้งหมด)</a></li>
                    <li><hr class="dropdown-divider"></li>
                    @foreach (var rep in compSalesReps)
                    {
                        <li><a class="dropdown-item" href="javascript:void(0)" onclick="setCompSalesRep('@rep')">@rep</a></li>
                    }
                </ul>
            </div>
            <datalist id="compSalesRepList">
                @foreach (var rep in compSalesReps)
                {
                    <option value="@rep">@rep</option>
                }
            </datalist>
        </div>
        <div class="col-12 col-md-1 d-flex align-items-end">
            <button type="button" class="btn btn-outline-secondary w-100 btn-sm py-1" onclick="clearFilters()" title="ล้างตัวกรอง">
                <i class="bi bi-x-circle"></i> ล้าง
            </button>
        </div>
    </div>

    <!-- Badge: โหลดเร็ว -->
    <div class="alert alert-light border py-2 px-3 small d-flex flex-wrap justify-content-between align-items-center mb-3" style="background:#f0fdfa; border-color:#ccfbf1; border-radius:10px;">
        <div class="text-teal fw-semibold" style="color:#0f766e;">
            <i class="bi bi-lightning-charge-fill text-warning me-1"></i> ระบบแบ่งหน้าละ <strong id="currentBadgePageSize">50</strong> รายการ โหลดเร็วติดทันที ข้อมูลทั้งหมด <strong>@totalBillCount.ToString("N0")</strong> รายการ
        </div>
        <span class="badge bg-white text-secondary border px-2 py-1"><i class="bi bi-speedometer2 me-1 text-success"></i>โหลดเร็ว &lt; 0.1 วิ</span>
    </div>

    <!-- Pagination Toolbar (Top) -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 px-1 gap-2">
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted small">
                แสดง <strong id="pageStart" class="text-dark">0</strong> - <strong id="pageEnd" class="text-dark">0</strong> จากทั้งหมด <strong id="pageTotal" class="text-primary">@totalBillCount.ToString("N0")</strong> รายการ (หน้า <strong id="pageCurrent" class="text-dark">1</strong>/<span id="pageMax">1</span>)
            </span>
            <div id="loadingSpinner" class="spinner-border spinner-border-sm text-teal d-none" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div class="d-flex align-items-center gap-1">
                <label for="compSelectPageSize" class="text-muted small fw-semibold text-nowrap mb-0">แสดงหน้าละ:</label>
                <select id="compSelectPageSize" class="form-select form-select-sm" style="width: auto;" onchange="changeCompPageSize(this.value)">
                    <option value="30">30 รายการ</option>
                    <option value="50" selected>50 รายการ (แนะนำ)</option>
                    <option value="100">100 รายการ</option>
                    <option value="200">200 รายการ</option>
                </select>
            </div>
            <nav aria-label="Page navigation top">
                <ul class="pagination pagination-sm mb-0" id="compPaginationTop">
                    <!-- Dynamic JS pagination -->
                </ul>
            </nav>
        </div>
    </div>

    <!-- 10 Columns Standard Detail Table -->
    <div class="table-responsive" style="max-height: 560px; overflow-y: auto;">
        <table class="table table-sm table-bordered table-hover align-middle detail-table mb-0" id="comparisonTable">
            <thead class="sticky-top">
                <tr>
                    <th style="width: 40px;" class="text-center">#</th>
                    <th style="width: 110px;" class="text-center">เลขที่บิล</th>
                    <th style="width: 95px;" class="text-center">วันที่บิล</th>
                    <th style="width: 95px;" class="text-center">รหัสลูกค้า</th>
                    <th class="col-customer-name" style="min-width: 260px; white-space: normal !important;">ชื่อลูกค้า</th>
                    <th style="width: 100px;">อำเภอ</th>
                    <th style="width: 100px;">จังหวัด</th>
                    <th style="width: 60px;" class="text-center">เครดิต</th>
                    <th style="width: 100px;" class="text-center">อายุหนี้</th>
                    <th style="width: 120px;" class="text-end">จำนวนเงิน (บาท)</th>
                    <th style="width: 100px;">ผู้แทนขาย</th>
                </tr>
            </thead>
            <tbody id="compTableBody">
                <tr id="compLoadingRow">
                    <td colspan="11" class="text-center py-5 text-muted">
                        <div class="spinner-border spinner-border-sm text-teal me-2" role="status"></div>
                        กำลังโหลดข้อมูลบิล...
                    </td>
                </tr>
            </tbody>
            <tfoot class="table-light sticky-bottom" style="font-weight: 800; border-top: 2px solid #0f766e;">
                <tr>
                    <td colspan="9" class="text-end py-2">
                        ยอดรวมทั้งสิ้น (<span id="visibleRowCount" class="text-primary">0</span> รายการ):
                    </td>
                    <td class="text-end py-2 fs-6 fw-black" style="color:#0f766e;" id="visibleTotalAmount">
                        0.00
                    </td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Pagination Toolbar (Bottom) -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 px-1 gap-2">
        <span class="text-muted small">
            แสดง <strong id="pageStartBottom" class="text-dark">0</strong> - <strong id="pageEndBottom" class="text-dark">0</strong> จากทั้งหมด <strong id="pageTotalBottom" class="text-primary">@totalBillCount.ToString("N0")</strong> รายการ
        </span>
        <nav aria-label="Page navigation bottom">
            <ul class="pagination pagination-sm mb-0" id="compPaginationBottom">
                <!-- Dynamic JS pagination -->
            </ul>
        </nav>
    </div>
</div>

@section Scripts {
<script>
// State
let compCurrentGroup = 'all';
let compCurrentSubFilter = 'all';
let compCurrentPage = 1;
let compPageSize = 50;
let compIsLoading = false;
let compSearchTimer = null;

const groupNames = {
    '1': '1. บิลเก็บสด 7 วัน (กทม.&ปริมณฑล)',
    '2': '2. บิลเงินสดรวมสายเวลา (กทม.&ปริมณฑล)',
    '3': '3. บิลค้างชำระ ต่างจังหวัด (ทุกภาค)',
    'all': 'ทุกกลุ่ม'
};
const subFilterNames = {
    'outstanding': 'ยอดหนี้ค้างชำระทั้งหมด',
    'under120': 'เกินกำหนดชำระไม่เกิน 120 วัน',
    'over120': 'เกินกำหนดชำระเกิน 120 วัน (หนี้วิกฤต)',
    'collected': 'ยอดเก็บเงินสดได้แล้วสำเร็จ',
    'all': 'รายการทั้งหมด'
};

function setFilter(grp, sub, autoScroll = true) {
    compCurrentGroup = grp;
    compCurrentSubFilter = sub;
    compCurrentPage = 1;

    document.querySelectorAll('.metric-row-box').forEach(b => b.classList.remove('active-filter'));
    if (grp !== 'all' && sub !== 'all') {
        const targetBtn = document.getElementById(`btn-g${grp}-${sub}`);
        if (targetBtn) targetBtn.classList.add('active-filter');
    }

    const grpTitle = groupNames[grp] || 'ทุกกลุ่ม';
    const subTitle = subFilterNames[sub] || 'รายการทั้งหมด';
    document.getElementById('currentTableTitle').innerText = `รายงานรายละเอียดรายบิล: [${grpTitle}] — ${subTitle}`;

    fetchComparisonBills();

    if (autoScroll) {
        document.getElementById('drilldownSection')?.scrollIntoView({ behavior: 'smooth' });
    }
}

function applyAllFilters() {
    clearTimeout(compSearchTimer);
    compSearchTimer = setTimeout(() => {
        compCurrentPage = 1;
        fetchComparisonBills();
    }, 250);
}

function changeCompPageSize(newSize) {
    compPageSize = parseInt(newSize, 10) || 50;
    compCurrentPage = 1;
    const badgeEl = document.getElementById('currentBadgePageSize');
    if (badgeEl) badgeEl.innerText = compPageSize;
    fetchComparisonBills();
}

function compGoToPage(page) {
    if (page < 1 || compIsLoading) return;
    compCurrentPage = page;
    fetchComparisonBills();
    document.getElementById('comparisonTable')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

async function fetchComparisonBills() {
    if (compIsLoading) return;
    compIsLoading = true;

    const spinner = document.getElementById('loadingSpinner');
    if (spinner) spinner.classList.remove('d-none');

    const sBill = encodeURIComponent((document.getElementById('compSearchBill')?.value || '').trim());
    const sCustCode = encodeURIComponent((document.getElementById('compSearchCustomerCode')?.value || '').trim());
    const sCustName = encodeURIComponent((document.getElementById('compSearchCustomerName')?.value || '').trim());
    const sRep = encodeURIComponent((document.getElementById('compSearchSalesRep')?.value || '').trim());
    const sCust = sCustName || sCustCode;

    const url = `/Dashboard/GetComparisonBills?group=${compCurrentGroup}&subFilter=${compCurrentSubFilter}&page=${compCurrentPage}&pageSize=${compPageSize}&searchBill=${sBill}&searchCustomer=${sCust}&searchSalesRep=${sRep}`;

    try {
        const response = await fetch(url);
        if (!response.ok) throw new Error('Network error: ' + response.status);
        const data = await response.json();

        if (data.warming) {
            const tbody = document.getElementById('compTableBody');
            if (tbody) {
                tbody.innerHTML = `<tr><td colspan="11" class="text-center py-5 text-muted">
                    <div class="spinner-border spinner-border-sm text-teal me-2" role="status"></div>
                    <span class="fw-semibold">กำลังเตรียมข้อมูล...</span>
                    <div class="text-muted small mt-1">ระบบกำลัง Warmup ข้อมูลใน Background จะโหลดอัตโนมัติ</div>
                </td></tr>`;
            }
            compIsLoading = false;
            if (spinner) spinner.classList.add('d-none');
            setTimeout(() => fetchComparisonBills(), 2000);
            return;
        }

        renderCompTable(data);
        renderCompPagination(data);
        updateCompMetrics(data.metrics);
    } catch (err) {
        console.error('Error fetching comparison bills:', err);
        const tbody = document.getElementById('compTableBody');
        if (tbody) tbody.innerHTML = `<tr><td colspan="11" class="text-center text-danger py-4"><i class="bi bi-exclamation-triangle me-1"></i> เกิดข้อผิดพลาด กรุณาลองใหม่</td></tr>`;
    } finally {
        compIsLoading = false;
        if (spinner) spinner.classList.add('d-none');
    }
}

function renderCompTable(data) {
    const tbody = document.getElementById('compTableBody');
    if (!tbody) return;

    if (!data.items || data.items.length === 0) {
        tbody.innerHTML = `<tr><td colspan="11" class="text-center text-muted py-5"><i class="bi bi-inbox fs-3 d-block mb-1"></i>ไม่พบรายการข้อมูลที่ตรงกับเงื่อนไข</td></tr>`;
        document.getElementById('visibleRowCount').innerText = '0';
        document.getElementById('visibleTotalAmount').innerText = '0.00';
        return;
    }

    const rowsHtml = data.items.map(item => {
        let badgeHtml = '';
        if (item.isPaid) {
            badgeHtml = `<span class="badge" style="background:#059669; color:#fff;">ชำระแล้ว</span>`;
        } else if (item.agingDays > 120) {
            badgeHtml = `<span class="badge" style="background:#be123c; color:#fff;">เกิน ${item.agingDays} วัน</span>`;
        } else if (item.agingDays > 0) {
            badgeHtml = `<span class="badge" style="background:#d97706; color:#fff;">${item.agingDays} วัน</span>`;
        } else {
            badgeHtml = `<span class="badge bg-light text-muted border">ยังไม่ถึงกำหนด</span>`;
        }
        return `<tr>
            <td class="text-center text-muted">${item.index}</td>
            <td class="text-center fw-bold"><span class="badge bg-light text-dark border">${item.billNo}</span></td>
            <td class="text-center text-muted">${item.billDate}</td>
            <td class="text-center"><code class="text-dark fw-bold">${item.customerCode || '-'}</code></td>
            <td class="fw-bold text-dark col-customer-name" style="min-width:260px;white-space:normal!important;word-break:break-word!important;">${item.customerName || '-'}</td>
            <td>${item.district || '-'}</td>
            <td>${item.province || '-'}</td>
            <td class="text-center">${item.credit}</td>
            <td class="text-center">${badgeHtml}</td>
            <td class="text-end fw-black text-dark" style="font-size:0.95rem;">${item.amountFormatted}</td>
            <td class="fw-semibold text-muted">${item.salesRep || '-'}</td>
        </tr>`;
    }).join('');

    tbody.innerHTML = rowsHtml;

    const startIdx = (data.currentPage - 1) * data.pageSize + 1;
    const endIdx = Math.min(startIdx + data.items.length - 1, data.totalItems);
    const safeStart = data.totalItems > 0 ? startIdx : 0;
    const safeEnd = data.totalItems > 0 ? endIdx : 0;

    const setTxt = (id, txt) => { const el = document.getElementById(id); if (el) el.innerText = txt; };
    setTxt('pageStart', safeStart.toLocaleString('en-US'));
    setTxt('pageEnd', safeEnd.toLocaleString('en-US'));
    setTxt('pageTotal', data.totalItems.toLocaleString('en-US'));
    setTxt('pageCurrent', data.currentPage);
    setTxt('pageMax', data.totalPages);
    setTxt('pageStartBottom', safeStart.toLocaleString('en-US'));
    setTxt('pageEndBottom', safeEnd.toLocaleString('en-US'));
    setTxt('pageTotalBottom', data.totalItems.toLocaleString('en-US'));
    setTxt('visibleRowCount', data.totalItems.toLocaleString('en-US'));
    setTxt('visibleTotalAmount', data.totalAmountFormatted);
}

function renderCompPagination(data) {
    const { currentPage, totalPages } = data;
    const buildPagination = (containerId) => {
        const container = document.getElementById(containerId);
        if (!container) return;
        let html = '';
        html += `<li class="page-item ${currentPage <= 1 ? 'disabled' : ''}"><a class="page-link" href="javascript:void(0)" onclick="compGoToPage(${currentPage - 1})">&laquo;</a></li>`;
        const delta = 2;
        let pages = [];
        for (let i = Math.max(1, currentPage - delta); i <= Math.min(totalPages, currentPage + delta); i++) pages.push(i);
        if (pages[0] > 1) { html += `<li class="page-item"><a class="page-link" href="javascript:void(0)" onclick="compGoToPage(1)">1</a></li>`; if (pages[0] > 2) html += `<li class="page-item disabled"><span class="page-link">…</span></li>`; }
        pages.forEach(p => { html += `<li class="page-item ${p === currentPage ? 'active' : ''}"><a class="page-link" href="javascript:void(0)" onclick="compGoToPage(${p})">${p}</a></li>`; });
        if (pages[pages.length - 1] < totalPages) { if (pages[pages.length - 1] < totalPages - 1) html += `<li class="page-item disabled"><span class="page-link">…</span></li>`; html += `<li class="page-item"><a class="page-link" href="javascript:void(0)" onclick="compGoToPage(${totalPages})">${totalPages}</a></li>`; }
        html += `<li class="page-item ${currentPage >= totalPages ? 'disabled' : ''}"><a class="page-link" href="javascript:void(0)" onclick="compGoToPage(${currentPage + 1})">&raquo;</a></li>`;
        container.innerHTML = html;
    };
    buildPagination('compPaginationTop');
    buildPagination('compPaginationBottom');
}

function updateCompMetrics(m) {
    if (!m) return;
    const fmt = (v) => (v || 0).toLocaleString('en-US', { maximumFractionDigits: 0 });
    const setTxt = (id, txt) => { const el = document.getElementById(id); if (el) el.innerText = txt; };
    // G1
    setTxt('g1-outstanding-amt', fmt(m.g1.outAmt)); setTxt('g1-outstanding-sub', `จำนวน ${m.g1.outCnt.toLocaleString('en-US')} บิล (ค้างชำระ)`);
    setTxt('g1-under120-amt', fmt(m.g1.under120Amt)); setTxt('g1-under120-sub', `จำนวน ${m.g1.under120Cnt.toLocaleString('en-US')} บิล`);
    setTxt('g1-over120-amt', fmt(m.g1.over120Amt)); setTxt('g1-over120-sub', `จำนวน ${m.g1.over120Cnt.toLocaleString('en-US')} บิล (วิกฤต)`);
    setTxt('g1-collected-amt', fmt(m.g1.colAmt)); setTxt('g1-collected-sub', `จำนวน ${m.g1.colCnt.toLocaleString('en-US')} บิล (ชำระแล้ว)`);
    const t1 = m.g1.outAmt + m.g1.colAmt; setTxt('rate-g1', `${t1 > 0 ? ((m.g1.colAmt / t1) * 100).toFixed(2) : '0.00'}%`);
    // G2
    setTxt('g2-outstanding-amt', fmt(m.g2.outAmt)); setTxt('g2-outstanding-sub', `จำนวน ${m.g2.outCnt.toLocaleString('en-US')} บิล (ค้างชำระ)`);
    setTxt('g2-under120-amt', fmt(m.g2.under120Amt)); setTxt('g2-under120-sub', `จำนวน ${m.g2.under120Cnt.toLocaleString('en-US')} บิล`);
    setTxt('g2-over120-amt', fmt(m.g2.over120Amt)); setTxt('g2-over120-sub', `จำนวน ${m.g2.over120Cnt.toLocaleString('en-US')} บิล (วิกฤต)`);
    setTxt('g2-collected-amt', fmt(m.g2.colAmt)); setTxt('g2-collected-sub', `จำนวน ${m.g2.colCnt.toLocaleString('en-US')} บิล (ชำระแล้ว)`);
    const t2 = m.g2.outAmt + m.g2.colAmt; setTxt('rate-g2', `${t2 > 0 ? ((m.g2.colAmt / t2) * 100).toFixed(2) : '0.00'}%`);
    // G3
    setTxt('g3-outstanding-amt', fmt(m.g3.outAmt)); setTxt('g3-outstanding-sub', `จำนวน ${m.g3.outCnt.toLocaleString('en-US')} บิล (ค้างชำระ)`);
    setTxt('g3-under120-amt', fmt(m.g3.under120Amt)); setTxt('g3-under120-sub', `จำนวน ${m.g3.under120Cnt.toLocaleString('en-US')} บิล`);
    setTxt('g3-over120-amt', fmt(m.g3.over120Amt)); setTxt('g3-over120-sub', `จำนวน ${m.g3.over120Cnt.toLocaleString('en-US')} บิล (วิกฤต)`);
    setTxt('g3-collected-amt', fmt(m.g3.colAmt)); setTxt('g3-collected-sub', `จำนวน ${m.g3.colCnt.toLocaleString('en-US')} บิล (ชำระแล้ว)`);
    const t3 = m.g3.outAmt + m.g3.colAmt; setTxt('rate-g3', `${t3 > 0 ? ((m.g3.colAmt / t3) * 100).toFixed(2) : '0.00'}%`);
}

function setCompSalesRep(name) {
    const input = document.getElementById('compSearchSalesRep');
    if (input) { input.value = name; applyAllFilters(); }
}

function clearFilters() {
    document.getElementById('compSearchBill').value = '';
    document.getElementById('compSearchCustomerCode').value = '';
    document.getElementById('compSearchCustomerName').value = '';
    document.getElementById('compSearchSalesRep').value = '';
    setFilter('all', 'all', false);
}

function getSearchParams() {
    const sBill = encodeURIComponent((document.getElementById('compSearchBill').value || '').trim());
    const sCust = encodeURIComponent((document.getElementById('compSearchCustomerName').value || document.getElementById('compSearchCustomerCode').value || '').trim());
    const sRep = encodeURIComponent((document.getElementById('compSearchSalesRep').value || '').trim());
    return `section=${compCurrentGroup}&filterType=${compCurrentSubFilter}&searchBill=${sBill}&searchCustomer=${sCust}&searchSalesRep=${sRep}`;
}

function triggerExportExcel() { window.location.href = `/Dashboard/ExportComparisonExcel?${getSearchParams()}`; }
