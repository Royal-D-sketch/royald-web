                    <div>
                        <div class="metric-title"><i class="bi bi-clock-history" style="color:#d97706;"></i> เกินกำหนดไม่เกิน 120 วัน</div>
                        <div class="metric-sub" id="g2-under120-sub">จำนวน 0 บิล</div>
                    </div>
                    <div class="metric-val-num" style="color:#b45309;" id="g2-under120-amt">0</div>
                </div>

                <!-- บรรทัดที่ 3: ยอดเกินกำหนดชำระเกิน 120 วัน (วิกฤต) -->
                <div class="metric-row-box" id="btn-g2-over120" onclick="setFilter('2', 'over120')" title="คลิกดูบิลเกินกำหนดเกิน 120 วัน (หนี้วิกฤต)">
                    <div>
                        <div class="metric-title"><i class="bi bi-shield-fill-exclamation" style="color:#be123c;"></i> เกินกำหนดเกิน 120 วัน</div>
                        <div class="metric-sub text-danger" id="g2-over120-sub">จำนวน 0 บิล (วิกฤต)</div>
                    </div>
                    <div class="metric-val-num" style="color:#be123c; font-weight:900;" id="g2-over120-amt">0</div>
                </div>

