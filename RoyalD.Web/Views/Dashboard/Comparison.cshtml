                <div class="metric-row-box" id="btn-g2-collected" onclick="setFilter('2', 'collected')" title="คลิกดูบิลที่เก็บเงินสดสำเร็จแล้ว">
                    <div>
                        <div class="metric-title"><i class="bi bi-check-circle-fill" style="color:#059669;"></i> ยอดเก็บเงินสดได้แล้วสำเร็จ</div>
                        <div class="metric-sub" style="color:#059669;" id="g2-collected-sub">จำนวน 0 บิล (ชำระแล้ว)</div>
                    </div>
                    <div class="metric-val-num" style="color:#059669; font-weight:900;" id="g2-collected-amt">0</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================================== -->
    <!-- กล่องที่ 3 (ขวาสุด): บิลค้างชำระ ต่างจังหวัด (ทุกภาค) - ม่วงพาสเทลสุภาพ -->
    <!-- ============================================================== -->
    <div class="col-12 col-lg-4">
        <div class="big-summary-card" id="card-group-3">
            <!-- Header with Collection Rate Top-Right -->
            <div class="card-header-purple">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fs-6 fw-bold"><i class="bi bi-geo-alt-fill me-1"></i> 3. บิลค้างชำระ ต่างจังหวัด (ทุกภาค)</span>
                    <span class="col-rate-badge" style="color:#7c3aed;" title="% Collection Rate = [ (ยอดเก็บเงินได้ ÷ ยอดขายรวม) x 100 ]">
                        % Collection: <strong id="rate-g3">0.00%</strong>
                    </span>
                </div>
                <small class="opacity-90" style="font-size:0.78rem;">ลูกหนี้ต่างจังหวัดทั่วประเทศทุกภาค (ธีมสีม่วงพาสเทลสุภาพ / ลาเวนเดอร์)</small>
            </div>

            <!-- 4 Vertical Metric Lines -->
            <div class="big-card-body">
                <!-- บรรทัดที่ 1: ยอดจำนวนเงินค้างชำระทั้งหมด -->
