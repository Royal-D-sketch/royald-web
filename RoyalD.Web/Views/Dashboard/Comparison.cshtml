                <div class="metric-row-box" id="btn-g3-collected" onclick="setFilter('3', 'collected')" title="คลิกดูบิลที่เก็บเงินสดสำเร็จแล้ว">
                    <div>
                        <div class="metric-title"><i class="bi bi-check-circle-fill" style="color:#059669;"></i> ยอดเก็บเงินสดได้แล้วสำเร็จ</div>
                        <div class="metric-sub" style="color:#059669;" id="g3-collected-sub">จำนวน 0 บิล (ชำระแล้ว)</div>
                    </div>
                    <div class="metric-val-num" style="color:#059669; font-weight:900;" id="g3-collected-amt">0</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================== -->
<!-- 2. ส่วนล่าง: ตารางรายงานรายละเอียด 10 คอลัมน์ + ช่องค้นหา 4 ช่อง -->
<!-- ============================================================== -->
<div class="p-4 bg-white rounded-4 border shadow-sm mb-4" id="drilldownSection">
    <!-- Header of Detail Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3 pb-3 border-bottom">
        <div>
            <h5 class="fw-bold mb-1" style="color:#0f766e;">
                <i class="bi bi-table me-1"></i> <span id="currentTableTitle">รายงานรายละเอียดรายบิล: ภาพรวมทั้งหมด</span>
            </h5>
            <small class="text-muted" id="currentTableSub">แสดงรายการบิล 10 คอลัมน์มาตรฐาน สามารถค้นหาแบบเรียลไทม์ และส่งออก Excel / PDF ได้ทันที</small>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <button type="button" class="btn btn-outline-secondary btn-sm fw-bold" onclick="setFilter('all', 'all')">
                <i class="bi bi-grid-fill me-1"></i> แสดงทั้งหมดทุกกลุ่ม
            </button>
            <button type="button" class="btn btn-success btn-sm fw-bold px-3 shadow-sm" onclick="triggerExportExcel()" title="ส่งออก Excel ข้อมูลที่กรองอยู่">
                <i class="bi bi-file-earmark-excel-fill me-1"></i> Export Excel
            </button>
            <button type="button" class="btn btn-danger btn-sm fw-bold px-3 shadow-sm" onclick="triggerExportPdf()" title="ส่งออก PDF ข้อมูลที่กรองอยู่">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i> Export PDF
            </button>
        </div>
    </div>

    <!-- 4 Real-time Search Input Fields -->
    <div class="row g-2 search-input-group mb-3 p-3 bg-light rounded-3 border">
        <div class="col-12 col-md-3">
            <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-receipt"></i> 1. เลขที่บิล</label>
            <input type="text" id="compSearchBill" class="form-control form-control-sm" placeholder="พิมพ์เลขที่บิล..." oninput="applyAllFilters()" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-qr-code"></i> 2. รหัสลูกค้า</label>
            <input type="text" id="compSearchCustomerCode" class="form-control form-control-sm" placeholder="พิมพ์รหัสลูกค้า..." oninput="applyAllFilters()" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-shop"></i> 3. ชื่อลูกค้า</label>
            <input type="text" id="compSearchCustomerName" class="form-control form-control-sm" placeholder="พิมพ์ชื่อร้านค้า / ลูกค้า..." oninput="applyAllFilters()" />
        </div>
        <div class="col-12 col-md-2">
            <label class="form-label small fw-bold text-muted mb-1"><i class="bi bi-person-fill"></i> 4. ผู้แทนขาย</label>
            <div class="input-group input-group-sm">
                <input type="text" id="compSearchSalesRep" class="form-control form-control-sm" list="compSalesRepList" placeholder="เลือก/พิมพ์ผู้แทน..." oninput="applyAllFilters()" />
                <button type="button" class="btn btn-outline-secondary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false" title="เลือกรายชื่อผู้แทนขาย">
                    <span class="visually-hidden">Toggle Dropdown</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow" style="max-height: 300px; overflow-y: auto;">
                    <li><a class="dropdown-item fw-bold text-primary" href="javascript:void(0)" onclick="setCompSalesRep('')"><i class="bi bi-x-circle me-1"></i> (ผู้แทนทั้งหมด)</a></li>
                    <li><hr class="dropdown-divider"></li>
                    @foreach (var rep in compSalesReps)
                    {
                        <li><a class="dropdown-item" href="javascript:void(0)" onclick="setCompSalesRep('@rep')">@rep</a></li>
                    }
                </ul>
            </div>
            <datalist id="compSalesRepList">
                @foreach (var rep in compSalesReps)
                {
                    <option value="@rep">@rep</option>
                }
            </datalist>
        </div>
        <div class="col-12 col-md-1 d-flex align-items-end">
            <button type="button" class="btn btn-outline-secondary w-100 btn-sm py-1" onclick="clearFilters()" title="ล้างตัวกรอง">
                <i class="bi bi-x-circle"></i> ล้าง
            </button>
        </div>
    </div>

    <!-- 10 Columns Standard Detail Table -->
    <div class="table-responsive" style="max-height: 560px; overflow-y: auto;">
        <table class="table table-sm table-bordered table-hover align-middle detail-table mb-0" id="comparisonTable">
            <thead class="sticky-top">
                <tr>
                    <th style="width: 40px;" class="text-center">#</th>
                    <th style="width: 110px;" class="text-center">เลขที่บิล</th>
                    <th style="width: 95px;" class="text-center">วันที่บิล</th>
                    <th style="width: 95px;" class="text-center">รหัสลูกค้า</th>
                    <th class="col-customer-name" style="min-width: 260px; white-space: normal !important;">ชื่อลูกค้า</th>
                    <th style="width: 100px;">อำเภอ</th>
                    <th style="width: 100px;">จังหวัด</th>
                    <th style="width: 60px;" class="text-center">เครดิต</th>
                    <th style="width: 100px;" class="text-center">อายุหนี้</th>
                    <th style="width: 120px;" class="text-end">จำนวนเงิน (บาท)</th>
                    <th style="width: 100px;">ผู้แทนขาย</th>
                </tr>
            </thead>
            <tbody id="compTableBody">
                @if (!allBills.Any())
                {
                    <tr id="emptyRow"><td colspan="11" class="text-center text-muted py-4">ไม่พบรายการข้อมูล</td></tr>
                }
                @for (int i = 0; i < allBills.Count; i++)
                {
                    var b = allBills[i];
                    <tr class="comp-bill-row"
                        data-init-idx="@i"
                        data-group="@b.GroupCode"
                        data-billno="@b.BillNo"
                        data-custcode="@b.CustomerCode"
                        data-custname="@b.CustomerName"
                        data-salesrep="@b.SalesRep"
                        data-district="@b.District"
                        data-province="@b.Province"
                        data-credit="@b.Credit"
                        data-ispaid="@(b.IsPaid ? "true" : "false")"
                        data-aging="@b.AgingDays"
                        data-ismt="@(b.IsModernTrade ? "true" : "false")"
                        data-amount="@b.Amount">
                        <td class="text-center text-muted row-idx">@(i + 1)</td>
                        <td class="text-center fw-bold">
                            <span class="badge bg-light text-dark border">@b.BillNo</span>
                        </td>
                        <td class="text-center text-muted">@b.BillDate.ToString("dd/MM/yyyy")</td>
                        <td class="text-center"><code class="text-dark fw-bold">@b.CustomerCode</code></td>
                        <td class="fw-bold text-dark col-customer-name" style="min-width: 260px; white-space: normal !important; word-break: break-word !important;">@b.CustomerName</td>
                        <td>@b.District</td>
                        <td>@b.Province</td>
                        <td class="text-center">@(b.Credit > 0 ? b.Credit.ToString() : "สด")</td>
                        <td class="text-center">
                            @if (b.IsPaid)
                            {
                                <span class="badge" style="background:#059669; color:#fff;">ชำระแล้ว</span>
                            }
                            else if (b.AgingDays > 120)
                            {
                                <span class="badge" style="background:#be123c; color:#fff;">เกิน @b.AgingDays วัน</span>
                            }
                            else if (b.AgingDays > 0)
                            {
                                <span class="badge" style="background:#d97706; color:#fff;">@b.AgingDays วัน</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border">ยังไม่ถึงกำหนด</span>
                            }
                        </td>
                        <td class="text-end fw-black text-dark" style="font-size:0.95rem;">@b.Amount.ToString("N2")</td>
                        <td class="fw-semibold text-muted text-truncate" style="max-width:110px;" title="@b.SalesRep">@b.SalesRep</td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-light sticky-bottom" style="font-weight: 800; border-top: 2px solid #0f766e;">
                <tr>
                    <td colspan="9" class="text-end py-2">
                        ยอดรวมทั้งสิ้น (<span id="visibleRowCount" class="text-primary">@allBills.Count.ToString("N0")</span> รายการ):
                    </td>
                    <td class="text-end py-2 fs-6 fw-black" style="color:#0f766e;" id="visibleTotalAmount">
                        @allBills.Sum(x => x.Amount).ToString("N2")
                    </td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

@section Scripts {
<script>
// Filter State
let currentGroup = 'all';      // '1', '2', '3', or 'all'
let currentSubFilter = 'all';  // 'outstanding', 'under120', 'over120', 'collected', 'all'

const groupNames = {
    '1': '1. บิลเก็บสด 7 วัน (กทม.&ปริมณฑล)',
    '2': '2. บิลเงินสดรวมสายเวลา (กทม.&ปริมณฑล)',
    '3': '3. บิลค้างชำระ ต่างจังหวัด (ทุกภาค)',
    'all': 'ทุกกลุ่ม'
};

const subFilterNames = {
    'outstanding': 'ยอดหนี้ค้างชำระทั้งหมด',
    'under120': 'เกินกำหนดชำระไม่เกิน 120 วัน',
    'over120': 'เกินกำหนดชำระเกิน 120 วัน (หนี้วิกฤต)',
    'collected': 'ยอดเก็บเงินสดได้แล้วสำเร็จ',
    'all': 'รายการทั้งหมด'
};

function setFilter(grp, sub, autoScroll = true) {
    currentGroup = grp;
    currentSubFilter = sub;

    // Remove active highlight from all boxes
    document.querySelectorAll('.metric-row-box').forEach(b => b.classList.remove('active-filter'));

    // Highlight selected box if any
    if (grp !== 'all' && sub !== 'all') {
        const targetBtn = document.getElementById(`btn-g${grp}-${sub}`);
        if (targetBtn) targetBtn.classList.add('active-filter');
    }

    // Update table header title
    const grpTitle = groupNames[grp] || 'ทุกกลุ่ม';
    const subTitle = subFilterNames[sub] || 'รายการทั้งหมด';
    document.getElementById('currentTableTitle').innerText = `รายงานรายละเอียดรายบิล: [${grpTitle}] — ${subTitle}`;

    // Apply filters
    applyAllFilters();

    // Smooth scroll down to table
    if (autoScroll) {
        document.getElementById('drilldownSection')?.scrollIntoView({ behavior: 'smooth' });
    }
}

function applyAllFilters() {
    const sBill = (document.getElementById('compSearchBill').value || '').trim().toLowerCase();
    const sCustCode = (document.getElementById('compSearchCustomerCode').value || '').trim().toLowerCase();
    const sCustName = (document.getElementById('compSearchCustomerName').value || '').trim().toLowerCase();
    const sRep = (document.getElementById('compSearchSalesRep').value || '').trim().toLowerCase();

    const rows = document.querySelectorAll('.comp-bill-row');

    // Counters for 3 Big Cards
    // Group 1
    let g1_outAmt = 0, g1_outCnt = 0;
    let g1_underAmt = 0, g1_underCnt = 0;
    let g1_overAmt = 0, g1_overCnt = 0;
    let g1_colAmt = 0, g1_colCnt = 0;

    // Group 2
    let g2_outAmt = 0, g2_outCnt = 0;
    let g2_underAmt = 0, g2_underCnt = 0;
    let g2_overAmt = 0, g2_overCnt = 0;
    let g2_colAmt = 0, g2_colCnt = 0;

    // Group 3
    let g3_outAmt = 0, g3_outCnt = 0;
    let g3_underAmt = 0, g3_underCnt = 0;
    let g3_overAmt = 0, g3_overCnt = 0;
    let g3_colAmt = 0, g3_colCnt = 0;

    const compTableBody = document.getElementById('compTableBody');
    if (compTableBody && rows.length > 0) {
        const rowArray = Array.from(rows);
        if (currentSubFilter === 'over120') {
            // เรียงลำดับตามหนี้ค้างนานสุดก่อน (AgingDays มากสุด -> น้อยสุด)
            rowArray.sort((a, b) => {
                const agingA = parseInt(a.getAttribute('data-aging') || '0', 10);
                const agingB = parseInt(b.getAttribute('data-aging') || '0', 10);
                if (agingB !== agingA) return agingB - agingA;
                return parseFloat(b.getAttribute('data-amount') || '0') - parseFloat(a.getAttribute('data-amount') || '0');
            });
            rowArray.forEach(r => compTableBody.appendChild(r));
        } else {
            rowArray.sort((a, b) => {
                const idxA = parseInt(a.getAttribute('data-init-idx') || '0', 10);
                const idxB = parseInt(b.getAttribute('data-init-idx') || '0', 10);
                return idxA - idxB;
            });
            rowArray.forEach(r => compTableBody.appendChild(r));
        }
    }

    let visibleCount = 0;
    let visibleSum = 0;
    let idx = 1;

    const sortedCompRows = document.querySelectorAll('.comp-bill-row');
    sortedCompRows.forEach(row => {
        const grp = row.getAttribute('data-group') || '3';
        const billNo = (row.getAttribute('data-billno') || '').toLowerCase();
        const custCode = (row.getAttribute('data-custcode') || '').toLowerCase();
        const custName = (row.getAttribute('data-custname') || '').toLowerCase();
        const salesRep = (row.getAttribute('data-salesrep') || '').toLowerCase();
        const amt = parseFloat(row.getAttribute('data-amount') || '0');
        const isPaid = row.getAttribute('data-ispaid') === 'true';
        const aging = parseInt(row.getAttribute('data-aging') || '0', 10);
        const isMt = row.getAttribute('data-ismt') === 'true';

        // Search match
        const matchSearch = (!sBill || billNo.includes(sBill)) &&
                            (!sCustCode || custCode.includes(sCustCode)) &&
                            (!sCustName || custName.includes(sCustName)) &&
                            (!sRep || salesRep.includes(sRep));

        if (matchSearch) {
            // Aggregate metrics per group
            if (grp === '1') {
                if (isPaid) { g1_colAmt += amt; g1_colCnt++; }
                else {
                    g1_outAmt += amt; g1_outCnt++;
                    if (aging > 120 && !isMt) { g1_overAmt += amt; g1_overCnt++; }
                    else if (aging <= 120) { g1_underAmt += amt; g1_underCnt++; }
                }
            } else if (grp === '2') {
                if (isPaid) { g2_colAmt += amt; g2_colCnt++; }
                else {
                    g2_outAmt += amt; g2_outCnt++;
                    if (aging > 120 && !isMt) { g2_overAmt += amt; g2_overCnt++; }
                    else if (aging <= 120) { g2_underAmt += amt; g2_underCnt++; }
                }
            } else if (grp === '3') {
                if (isPaid) { g3_colAmt += amt; g3_colCnt++; }
                else {
                    g3_outAmt += amt; g3_outCnt++;
                    if (aging > 120 && !isMt) { g3_overAmt += amt; g3_overCnt++; }
                    else if (aging <= 120) { g3_underAmt += amt; g3_underCnt++; }
                }
            }
        }

        // Check if row matches current active group and sub-filter
        let matchGroup = (currentGroup === 'all' || grp === currentGroup);
        let matchSub = true;
        if (currentSubFilter === 'outstanding') matchSub = !isPaid;
        else if (currentSubFilter === 'under120') matchSub = (!isPaid && aging <= 120);
        else if (currentSubFilter === 'over120') matchSub = (!isPaid && aging > 120 && !isMt);
        else if (currentSubFilter === 'collected') matchSub = isPaid;

        if (matchSearch && matchGroup && matchSub) {
            row.style.display = '';
            row.querySelector('.row-idx').innerText = idx++;
            visibleCount++;
            visibleSum += amt;
        } else {
            row.style.display = 'none';
        }
    });

    // Update Card 1 Metrics
    document.getElementById('g1-outstanding-amt').innerText = g1_outAmt.toLocaleString('en-US', { maximumFractionDigits: 0 });
    document.getElementById('g1-outstanding-sub').innerText = `จำนวน ${g1_outCnt.toLocaleString('en-US')} บิล (ค้างชำระ)`;
    document.getElementById('g1-under120-amt').innerText = g1_underAmt.toLocaleString('en-US', { maximumFractionDigits: 0 });
    document.getElementById('g1-under120-sub').innerText = `จำนวน ${g1_underCnt.toLocaleString('en-US')} บิล`;
    document.getElementById('g1-over120-amt').innerText = g1_overAmt.toLocaleString('en-US', { maximumFractionDigits: 0 });
    document.getElementById('g1-over120-sub').innerText = `จำนวน ${g1_overCnt.toLocaleString('en-US')} บิล (วิกฤต)`;
    document.getElementById('g1-collected-amt').innerText = g1_colAmt.toLocaleString('en-US', { maximumFractionDigits: 0 });
    document.getElementById('g1-collected-sub').innerText = `จำนวน ${g1_colCnt.toLocaleString('en-US')} บิล (ชำระแล้ว)`;
    const totalG1 = g1_outAmt + g1_colAmt;
    const rateG1 = totalG1 > 0 ? ((g1_colAmt / totalG1) * 100).toFixed(2) : '0.00';
    document.getElementById('rate-g1').innerText = `${rateG1}%`;

    // Update Card 2 Metrics
    document.getElementById('g2-outstanding-amt').innerText = g2_outAmt.toLocaleString('en-US', { maximumFractionDigits: 0 });
    document.getElementById('g2-outstanding-sub').innerText = `จำนวน ${g2_outCnt.toLocaleString('en-US')} บิล (ค้างชำระ)`;
    document.getElementById('g2-under120-amt').innerText = g2_underAmt.toLocaleString('en-US', { maximumFractionDigits: 0 });
    document.getElementById('g2-under120-sub').innerText = `จำนวน ${g2_underCnt.toLocaleString('en-US')} บิล`;
    document.getElementById('g2-over120-amt').innerText = g2_overAmt.toLocaleString('en-US', { maximumFractionDigits: 0 });
    document.getElementById('g2-over120-sub').innerText = `จำนวน ${g2_overCnt.toLocaleString('en-US')} บิล (วิกฤต)`;
    document.getElementById('g2-collected-amt').innerText = g2_colAmt.toLocaleString('en-US', { maximumFractionDigits: 0 });
    document.getElementById('g2-collected-sub').innerText = `จำนวน ${g2_colCnt.toLocaleString('en-US')} บิล (ชำระแล้ว)`;
    const totalG2 = g2_outAmt + g2_colAmt;
    const rateG2 = totalG2 > 0 ? ((g2_colAmt / totalG2) * 100).toFixed(2) : '0.00';
    document.getElementById('rate-g2').innerText = `${rateG2}%`;

    // Update Card 3 Metrics
    document.getElementById('g3-outstanding-amt').innerText = g3_outAmt.toLocaleString('en-US', { maximumFractionDigits: 0 });
    document.getElementById('g3-outstanding-sub').innerText = `จำนวน ${g3_outCnt.toLocaleString('en-US')} บิล (ค้างชำระ)`;
    document.getElementById('g3-under120-amt').innerText = g3_underAmt.toLocaleString('en-US', { maximumFractionDigits: 0 });
    document.getElementById('g3-under120-sub').innerText = `จำนวน ${g3_underCnt.toLocaleString('en-US')} บิล`;
    document.getElementById('g3-over120-amt').innerText = g3_overAmt.toLocaleString('en-US', { maximumFractionDigits: 0 });
    document.getElementById('g3-over120-sub').innerText = `จำนวน ${g3_overCnt.toLocaleString('en-US')} บิล (วิกฤต)`;
    document.getElementById('g3-collected-amt').innerText = g3_colAmt.toLocaleString('en-US', { maximumFractionDigits: 0 });
    document.getElementById('g3-collected-sub').innerText = `จำนวน ${g3_colCnt.toLocaleString('en-US')} บิล (ชำระแล้ว)`;
    const totalG3 = g3_outAmt + g3_colAmt;
    const rateG3 = totalG3 > 0 ? ((g3_colAmt / totalG3) * 100).toFixed(2) : '0.00';
    document.getElementById('rate-g3').innerText = `${rateG3}%`;

    // Update Table Footer
    document.getElementById('visibleRowCount').innerText = visibleCount.toLocaleString('en-US');
    document.getElementById('visibleTotalAmount').innerText = visibleSum.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function setCompSalesRep(name) {
    const input = document.getElementById('compSearchSalesRep');
    if (input) {
        input.value = name;
        applyAllFilters();
    }
}

function clearFilters() {
    document.getElementById('compSearchBill').value = '';
    document.getElementById('compSearchCustomerCode').value = '';
    document.getElementById('compSearchCustomerName').value = '';
    document.getElementById('compSearchSalesRep').value = '';
    setFilter('all', 'all', false);
}

function getSearchParams() {
    const sBill = encodeURIComponent((document.getElementById('compSearchBill').value || '').trim());
    const sCust = encodeURIComponent((document.getElementById('compSearchCustomerName').value || document.getElementById('compSearchCustomerCode').value || '').trim());
    const sRep = encodeURIComponent((document.getElementById('compSearchSalesRep').value || '').trim());
    return `section=${currentGroup}&filterType=${currentSubFilter}&searchBill=${sBill}&searchCustomer=${sCust}&searchSalesRep=${sRep}`;
}

function triggerExportExcel() {
    window.location.href = `/Dashboard/ExportComparisonExcel?${getSearchParams()}`;
}

function triggerExportPdf() {
    window.open(`/Dashboard/ExportComparisonPdf?${getSearchParams()}`, '_blank');
}

function triggerExportAllExcel() {
    window.location.href = `/Dashboard/ExportComparisonExcel?section=all&filterType=all`;
}

document.addEventListener('DOMContentLoaded', () => {
    applyAllFilters();
});
</script>
}
