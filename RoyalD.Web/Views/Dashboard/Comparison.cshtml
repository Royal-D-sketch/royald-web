                <div class="metric-row-box" id="btn-g3-over120" onclick="setFilter('3', 'over120')" title="คลิกดูบิลเกินกำหนดเกิน 120 วัน (หนี้วิกฤต)">
                    <div>
                        <div class="metric-title"><i class="bi bi-shield-fill-exclamation" style="color:#be123c;"></i> เกินกำหนดเกิน 120 วัน</div>
