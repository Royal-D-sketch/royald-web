@model List<RoyalD.Web.Models.DashboardBillItem>
@{
    Layout = null;
    decimal totalAmount = Model.Sum(x => x.Amount);
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.CategoryTitle ?? "รายงานบิลขายและการติดตามลูกหนี้") — บริษัท รอแยล-ดี (ไทยแลนด์) จำกัด</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700;800&family=Noto+Sans+Thai:wght@300;400;500;600;700&display=swap" />
    <style>
        body {
            font-family: 'Sarabun', 'Noto Sans Thai', 'Leelawadee UI', Tahoma, sans-serif;
            background: #ffffff;
            color: #0f172a;
            font-size: 0.85rem;
            padding: 20px;
        }
        .header-box {
            border-bottom: 2px solid #0f766e;
            padding-bottom: 12px;
            margin-bottom: 14px;
        }
        .table-pdf th {
            background-color: #0f766e !important;
            color: #ffffff !important;
            font-weight: 700;
            text-align: center;
            vertical-align: middle;
            font-size: 0.82rem;
            padding: 8px 6px;
        }
        .table-pdf td {
            vertical-align: middle;
            padding: 6px 6px;
            border-bottom: 1px solid #e2e8f0;
            font-size: 0.82rem;
        }
        .total-row {
            background-color: #f0fdfa !important;
            font-weight: 800;
        }
        @@media print {
            body { padding: 0; }
            .no-print { display: none !important; }
            .table-pdf th { background-color: #0f766e !important; -webkit-print-color-adjust: exact; }
            .total-row { background-color: #f0fdfa !important; -webkit-print-color-adjust: exact; }
        }
    </style>
</head>
<body>
    <div class="no-print d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded border">
        <div>
            <h5 class="mb-0 fw-bold" style="color:#0f766e;"><i class="bi bi-file-earmark-pdf-fill text-danger me-2"></i> เอกสารรายงานรายละเอียดบิล (PDF)</h5>
            <small class="text-muted">คลิกปุ่ม "พิมพ์ / บันทึกเป็น PDF" เพื่อบันทึกเป็นไฟล์ PDF หรือสั่งพิมพ์</small>
        </div>
        <div class="d-flex gap-2">
            <button onclick="window.print()" class="btn btn-primary btn-sm fw-bold px-3" style="background:#0f766e; border-color:#0f766e;">
                <i class="bi bi-printer-fill me-1"></i> พิมพ์ / บันทึกเป็น PDF
            </button>
            <button onclick="window.close()" class="btn btn-outline-secondary btn-sm">ปิดหน้านี้</button>
        </div>
    </div>

    <div class="header-box text-center">
        <h4 class="fw-bold mb-1" style="color:#0f766e;">บริษัท รอแยล-ดี (ไทยแลนด์) จำกัด</h4>
        <h5 class="fw-bold text-dark mb-1">รายงานรายละเอียดบิล: @(ViewBag.CategoryTitle ?? "ภาพรวมข้อมูล")</h5>
        <div class="small text-muted d-flex justify-content-between mt-2">
            <span>ผู้พิมพ์: <strong>@ViewBag.PrintedBy</strong></span>
            <span>วันที่พิมพ์: <strong>@DateTime.Now.ToString("dd/MM/yyyy HH:mm") น.</strong></span>
            <span>รวมทั้งหมด: <strong>@Model.Count.ToString("N0")</strong> รายการ | ยอดเงินรวม: <strong class="text-dark">@totalAmount.ToString("N2")</strong> บาท</span>
        </div>
        @if (!string.IsNullOrEmpty(ViewBag.SearchBill) || !string.IsNullOrEmpty(ViewBag.SearchCustomer) || !string.IsNullOrEmpty(ViewBag.SearchSalesRep))
        {
            <div class="text-start mt-2 p-2 bg-light rounded border small">
                <strong>เงื่อนไขการกรอง:</strong>
                @if (!string.IsNullOrEmpty(ViewBag.SearchBill)) { <span class="badge bg-secondary me-1">บิล: @ViewBag.SearchBill</span> }
                @if (!string.IsNullOrEmpty(ViewBag.SearchCustomer)) { <span class="badge bg-secondary me-1">ลูกค้า: @ViewBag.SearchCustomer</span> }
                @if (!string.IsNullOrEmpty(ViewBag.SearchSalesRep)) { <span class="badge bg-secondary me-1">ผู้แทนขาย: @ViewBag.SearchSalesRep</span> }
            </div>
        }
    </div>

    <table class="table table-bordered table-pdf table-sm mb-0">
        <thead>
            <tr>
                <th style="width: 40px;">#</th>
                <th style="width: 100px;">เลขที่บิล</th>
                <th style="width: 85px;">วันที่บิล</th>
                <th style="width: 100px;">ผู้แทนขาย</th>
                <th style="width: 90px;">รหัสลูกค้า</th>
                <th>ชื่อลูกค้า</th>
                <th style="width: 100px;">อำเภอ</th>
                <th style="width: 95px;">จังหวัด</th>
                <th style="width: 110px;" class="text-end">จำนวนเงิน (บาท)</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="9" class="text-center text-muted py-4">ไม่พบรายการข้อมูลตามเงื่อนไขที่เลือก</td>
                </tr>
            }
            @for (int i = 0; i < Model.Count; i++)
            {
                var item = Model[i];
                <tr>
                    <td class="text-center text-muted">@(i + 1)</td>
                    <td class="text-center fw-bold">@item.BillNo</td>
                    <td class="text-center">@item.BillDate.ToString("dd/MM/yyyy")</td>
                    <td>@item.SalesRep</td>
                    <td class="text-center"><code class="text-dark fw-bold">@item.CustomerCode</code></td>
                    <td class="fw-semibold">@item.CustomerName</td>
                    <td>@item.District</td>
                    <td>@item.Province</td>
                    <td class="text-end fw-bold">@item.Amount.ToString("N2")</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="total-row">
                <td colspan="8" class="text-end py-2 fs-6">ยอดรวมทั้งสิ้น (@Model.Count.ToString("N0") รายการ):</td>
                <td class="text-end py-2 fs-6" style="color:#0f766e;">@totalAmount.ToString("N2")</td>
            </tr>
        </tfoot>
    </table>
</body>
</html>
