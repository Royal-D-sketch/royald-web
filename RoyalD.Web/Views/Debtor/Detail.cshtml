<script>
    function setPayMethod(method) {
    document.getElementById('methodField').value = method;
}

function syncPayment() {
    var method = document.getElementById('methodField').value;
    document.getElementById('realAmount').value = document.getElementById('amount_' + method).value;
    document.getElementById('realPayDate').value = document.getElementById('payDate_' + method).value;
    document.getElementById('realNote').value = document.getElementById('note_' + method).value;
    
    // Manage files
    var ft = document.getElementById('file_Transfer');
    var fc = document.getElementById('file_Check');
    if(ft) { ft.name = method === 'Transfer' ? 'file' : ''; }
    if(fc) { fc.name = method === 'Check' ? 'file' : ''; }

    // Disable check inputs if not Check method
    if(method !== 'Check') {
        var cp = document.getElementById('check-pane');
        var checkInputs = cp.querySelectorAll('input[name="checkDate"], input[name="bank"], input[name="checkNo"]');
        checkInputs.forEach(function(inp) { inp.disabled = true; });
    }
    
    return true;
}

    function selectAllWaitingProducts(checked) {
        const checkboxes = document.querySelectorAll('.waiting-prod-chk');
        checkboxes.forEach((chk, idx) => {
            chk.checked = checked;
            toggleWaitingQtyInput(idx);
        });
    }

    function toggleWaitingQtyInput(idx) {
        const chk = document.getElementById('chk_prod_' + idx);
        const input = document.getElementById('qty_input_' + idx);
        if (chk && input) {
            input.disabled = !chk.checked;
        }
    }

    function onStatusSelectChange() {
        const val = document.getElementById('statusSelect').value;
        const sections = ['f-postponed', 'f-delivering', 'f-waiting', 'f-return', 'f-baddebt', 'f-cancelled'];
        sections.forEach(s => {
            const el = document.getElementById(s);
            if (el) el.classList.add('d-none');
        });

        if (val === 'Postponed') document.getElementById('f-postponed')?.classList.remove('d-none');
        if (val === 'Delivering') document.getElementById('f-delivering')?.classList.remove('d-none');
        if (val === 'WaitingGoods') document.getElementById('f-waiting')?.classList.remove('d-none');
        if (val === 'ReturnIssued' || val === 'ReturnPending') document.getElementById('f-return')?.classList.remove('d-none');
        if (val === 'BadDebt') document.getElementById('f-baddebt')?.classList.remove('d-none');
        if (val === 'Cancelled') document.getElementById('f-cancelled')?.classList.remove('d-none');
    }

    document.addEventListener('DOMContentLoaded', () => {
        onStatusSelectChange();
    });
</script>
