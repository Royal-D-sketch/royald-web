@using RoyalD.Web.Models
@using RoyalD.Web
@model RoyalD.Web.Models.OutstandingDebt
@{
    ViewData["Title"] = "รายละเอียดลูกหนี้";
    var isMinDate = Model.DueDate.Year < 1900;
    var overdue120 = !isMinDate && Model.DueDate < DateTime.Today.AddDays(-120);
    var overdue = !isMinDate && Model.DueDate < DateTime.Today;
    var aging = isMinDate ? 0 : (int)(DateTime.Today - Model.DueDate).TotalDays;
    if (aging < 0) aging = 0;
    bool canViewPayment = ViewBag.CanViewPaymentDetails == true;
    bool canChangeStatus = ViewBag.CanChangeDebtStatus == true;
    bool canDelete = ViewBag.CanDeleteDebtor == true;
    var bill = ViewBag.SalesBill as SalesBill;
    var billItems = ViewBag.Items as List<SalesBillItem> ?? new List<SalesBillItem>();
}

@section Styles {
<style>
.detail-card {
    border-radius: 12px;
    border: 1.5px solid #e2e8f0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}
.badge-soft {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px 12px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.85rem;
}
.badge-soft-danger { background: #ffe4e6; color: #9f1239; border: 1px solid #fecdd3; }
.badge-soft-warning { background: #fef3c7; color: #92400e; border: 1px solid #fde68a; }
.badge-soft-info { background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; }
.badge-soft-success { background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }
.badge-soft-secondary { background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; }
</style>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <a href="/Debtor" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> กลับหน้ารายการการ์ดลูกหนี้
    </a>
    <div class="d-flex gap-2 align-items-center">
        <h4 class="mb-0 fw-bold" style="color:#0f766e;">
            <i class="bi bi-person-lines-fill"></i> รายละเอียดลูกหนี้: <span class="text-dark">@Model.BillNo</span>
        </h4>
        @if (canDelete)
        {
            <form asp-controller="Debtor" asp-action="DeleteDebt" method="post" class="d-inline ms-2" onsubmit="return confirm('ยืนยันการลบการ์ดลูกหนี้บิล @Model.BillNo ออกจากระบบหรือไม่?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-danger btn-sm fw-bold">
                    <i class="bi bi-trash"></i> ลบการ์ดลูกหนี้
                </button>
            </form>
        }
    </div>
</div>

@if (Model.RemainingAmount <= 0 && Model.Status != DebtStatus.BadDebt && Model.Status != DebtStatus.ReturnIssued)
{
    <div class="alert alert-success d-flex align-items-center shadow-sm border-0 mb-4" role="alert" style="border-radius:12px; background:#dcfce7; color:#14532d;">
        <i class="bi bi-check-circle-fill fs-2 me-3 text-success"></i>
        <div>
            <h5 class="alert-heading mb-1 fw-bold">🎉 ชำระครบถ้วนแล้ว (Fully Paid)</h5>
            <p class="mb-0 small">บิลนี้ได้รับการชำระเงินครบเต็มจำนวนแล้ว เมื่อวันที่ @(Model.FullyPaidDate?.ToString("dd/MM/yyyy") ?? "-")</p>
        </div>
    </div>
}
else if (overdue120)
{
    <div class="alert alert-danger d-flex align-items-center shadow-sm border-0 mb-4" role="alert" style="border-radius:12px; background:#ffe4e6; color:#881337;">
        <i class="bi bi-exclamation-triangle-fill fs-2 me-3 text-danger"></i>
        <div>
            <h5 class="alert-heading mb-1 fw-bold">⚠️ บิลเกินกำหนดชำระมากกว่า 120 วัน (หนี้วิกฤต)</h5>
            <p class="mb-0 small">อายุหนี้ปัจจุบัน: <strong>@aging วัน</strong> (ครบกำหนดเมื่อ @Model.DueDate.ToString("dd/MM/yyyy"))</p>
        </div>
    </div>
}

<div class="row g-4 mb-4">
    <!-- ฝั่งซ้าย: ข้อมูลบิลและลูกค้า -->
    <div class="col-lg-6">
        <div class="card detail-card h-100">
            <div class="card-header bg-warning text-dark py-3 fw-bold d-flex justify-content-between align-items-center">
                <span><i class="bi bi-file-earmark-text me-1"></i> ข้อมูลบิลและลูกหนี้</span>
                <span class="badge bg-dark text-white">@Model.Status</span>
            </div>
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-4 text-muted fw-semibold">เลขที่บิล</div>
                    <div class="col-8 fw-bold fs-5 text-primary"><code>@Model.BillNo</code></div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 text-muted fw-semibold">ใบสั่งซื้อ (PO)</div>
                    <div class="col-8 fw-bold text-dark">@Model.PoNumber</div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 text-muted">วันที่ออกบิล</div>
                    <div class="col-8">@(Model.BillDate.Year < 1900 ? "-" : Model.BillDate.ToString("dd/MM/yyyy"))</div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 text-muted">วันครบกำหนด</div>
                    <div class="col-8 @(overdue || overdue120 ? "text-danger fw-bold" : "")">
                        @(isMinDate ? "-" : Model.DueDate.ToString("dd/MM/yyyy"))
                        @if (overdue || overdue120)
                        {
                            <span class="badge bg-danger ms-1">เกินกำหนด</span>
                        }
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 text-muted">เครดิตเทอม</div>
                    <div class="col-8">@(Model.Credit == 0 ? "เงินสด (0 วัน)" : $"{Model.Credit} วัน")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 text-muted">อายุหนี้</div>
                    <div class="col-8 fw-bold">@aging วัน</div>
                </div>

                <!-- สถานะเฉพาะกิจ -->
                @if (Model.Status == DebtStatus.Postponed && Model.PostponedDate.HasValue)
                {
                    <div class="row mb-2 text-warning fw-bold">
                        <div class="col-4">วันที่นัดชำระใหม่</div>
                        <div class="col-8">@Model.PostponedDate.Value.ToString("dd/MM/yyyy")</div>
                    </div>
                }
                @if (Model.Status == DebtStatus.Delivering && Model.DeliveringDate.HasValue)
                {
                    <div class="row mb-2 text-info fw-bold">
                        <div class="col-4">วันที่จัดส่ง</div>
                        <div class="col-8">@Model.DeliveringDate.Value.ToString("dd/MM/yyyy")</div>
                    </div>
                }
                @if (Model.Status == DebtStatus.WaitingGoods)
                {
                    @if (Model.WaitingGoodsDate.HasValue)
                    {
                        <div class="row mb-2 text-warning fw-bold">
                            <div class="col-4">วันที่รอสินค้า</div>
                            <div class="col-8">@Model.WaitingGoodsDate.Value.ToString("dd/MM/yyyy")</div>
                        </div>
                    }
                    @if (Model.PendingProducts != null && Model.PendingProducts.Any())
                    {
                        <div class="p-2 mb-2 rounded border border-warning bg-warning bg-opacity-10">
                            <div class="small fw-bold text-dark mb-1"><i class="bi bi-box-seam text-warning me-1"></i> รายการสินค้าที่รอส่ง/ของขาด:</div>
                            <ul class="mb-0 ps-3 small text-dark">
                                @foreach (var pp in Model.PendingProducts)
                                {
                                    <li class="mb-1">
                                        <code>@pp.ProductCode</code> <span class="fw-semibold">@pp.ProductName</span> : <span class="badge bg-danger">@pp.Quantity.ToString("N0") รายการ</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                }
                @if (Model.BadDebtAmount.HasValue && Model.BadDebtAmount > 0)
                {
                    <div class="row mb-2 text-danger fw-bold">
                        <div class="col-4">ยอดตัดหนี้สูญ</div>
                        <div class="col-8">@Model.BadDebtAmount.Value.ToString("N2") บาท (@(Model.BadDebtDate?.ToString("dd/MM/yyyy") ?? "-"))</div>
                    </div>
                }
                @if (Model.ReturnAmount.HasValue && Model.ReturnAmount > 0)
                {
                    <div class="row mb-2 text-secondary fw-bold">
                        <div class="col-4">ยอดรับคืนสินค้า</div>
                        <div class="col-8">@Model.ReturnAmount.Value.ToString("N2") บาท @(Model.IsReturnCutFromBill ? "(ตัดยอดบิลแล้ว)" : "(ยังไม่ตัดบิล)")</div>
                    </div>
                }

                <hr class="my-3" />

                <!-- ข้อมูลลูกค้า -->
                <div class="row mb-2">
                    <div class="col-4 text-muted fw-semibold">รหัสลูกค้า</div>
                    <div class="col-8 fw-bold"><code>@Model.CustomerCode</code></div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 text-muted fw-semibold">ชื่อลูกค้า/ร้านค้า</div>
                    <div class="col-8 fw-bold text-dark fs-6">@Model.CustomerName</div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 text-muted">เขต/อำเภอ</div>
                    <div class="col-8">@(!string.IsNullOrEmpty(Model.District) ? Model.District : "-")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 text-muted">จังหวัด</div>
                    <div class="col-8">@(!string.IsNullOrEmpty(Model.Province) ? Model.Province : "-")</div>
                </div>
                <div class="row mb-2">
                    <div class="col-4 text-muted">ผู้แทนขาย</div>
                    <div class="col-8"><span class="badge bg-light text-dark border">@Model.SalesRep</span></div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Note))
                {
                    <div class="row mb-2">
                        <div class="col-4 text-muted">บันทึกเพิ่มเติม</div>
                        <div class="col-8 text-break text-muted">@Model.Note</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ฝั่งขวา: สรุปยอดเงิน และสถานะการเงิน -->
    <div class="col-lg-6">
        <div class="card detail-card h-100">
            <div class="card-header bg-dark text-white py-3 fw-bold">
                <i class="bi bi-wallet2 me-1"></i> สรุปยอดเงินและการชำระ
            </div>
            <div class="card-body">
            @{
                var debtorItems = (ViewBag.SalesBillItems as List<SalesBillItem>) ?? new List<SalesBillItem>();
                decimal debtorItemSum = debtorItems.Sum(x => x.Amount);
                var dVatCalc = VatHelper.Calculate(Model.BillNo, Model.CustomerCode, Model.CustomerName, Model.Province, Model.OriginalAmount, debtorItemSum, Model.SalesRep, debtorItems);
                string dVatLabel = dVatCalc.Label;
                string dVatBadgeClass = dVatCalc.BadgeClass;
                string dVatNotice = dVatCalc.Explanation;
            }
                <div class="p-3 mb-3 rounded" style="background:#f8fafc; border:1px solid #e2e8f0;">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted">ยอดหนี้เดิม (Original Amount)</span>
                        <span class="fw-bold fs-5">@Model.OriginalAmount.ToString("N2") บาท</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted">ชำระแล้ว (Paid Amount)</span>
                        <span class="fw-bold fs-5 text-success">@((Model.OriginalAmount - Model.RemainingAmount).ToString("N2")) บาท</span>
                    </div>
                    <hr class="my-2" />
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark fs-6">ยอดหนี้คงค้าง (Remaining Debt)</span>
                        <span class="fw-black fs-4 text-danger">@Model.RemainingAmount.ToString("N2") บาท</span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.ReceiptNo) || Model.ReceiptDate.HasValue)
                {
                    <div class="p-3 rounded mt-3" style="background:#f0fdf4; border:1px solid #bbf7d0;">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-success"><i class="bi bi-receipt me-1"></i> ข้อมูลใบเสร็จรับเงิน</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editReceiptModal">
                                <i class="bi bi-pencil-square"></i> แก้ไข
                            </button>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted">เลขที่ใบเสร็จ:</span>
                            <span class="fw-bold text-dark">@(string.IsNullOrEmpty(Model.ReceiptNo) ? "-" : Model.ReceiptNo)</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">วันที่รับเงิน:</span>
                            <span class="fw-bold text-dark">@(Model.ReceiptDate?.ToString("dd/MM/yyyy") ?? "-")</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="mt-3 text-end">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editReceiptModal">
                            <i class="bi bi-plus-circle"></i> เพิ่มข้อมูลใบเสร็จ
                        </button>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@using RoyalD.Web.Services
@if (debtorItems.Any())
{
    <!-- รายการสินค้าในบิลขาย & คำนวณภาษีมูลค่าเพิ่ม (VAT 7%) -->
    <div class="card detail-card mb-4">
        <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
            <div>
                <span class="fw-bold text-dark"><i class="bi bi-box-seam me-1 text-primary"></i> รายการสินค้าในบิลขาย (@debtorItems.Count รายการ)</span>
                <span class="badge @dVatBadgeClass ms-2 px-2 py-1"><i class="bi bi-patch-check-fill me-1"></i> @dVatLabel</span>
            </div>
            <a asp-controller="SalesBill" asp-action="Detail" asp-route-id="@Model.BillNo" class="btn btn-sm btn-outline-primary" target="_blank">
                <i class="bi bi-box-arrow-up-right me-1"></i> ดูใบส่งสินค้า/ใบกำกับภาษีเต็ม
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size:0.875rem;">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center" style="width:45px;">#</th>
                            <th style="width:120px;">รหัสสินค้า</th>
                            <th>ชื่อสินค้า / รายการ</th>
                            <th class="text-center" style="width:80px;">จำนวน</th>
                            <th class="text-center" style="width:70px;">หน่วย</th>
                            <th class="text-end" style="width:100px;">ราคา/หน่วย</th>
                            <th class="text-end" style="width:80px;">ส่วนลด</th>
                            <th class="text-end" style="width:120px;">จำนวนเงิน (บาท)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int itIndex = 1; }
                        @foreach (var it in debtorItems)
                        {
                            <tr>
                                <td class="text-center text-muted">@(itIndex++)</td>
                                <td><code>@it.ProductCode</code></td>
                                <td class="fw-semibold text-dark">@it.ProductName</td>
                                <td class="text-center fw-bold">@it.Qty.ToString("N0")</td>
                                <td class="text-center text-muted">@it.Unit</td>
                                <td class="text-end">@it.Price.ToString("N2")</td>
                                <td class="text-end text-muted">@(it.Discount > 0 ? it.Discount.ToString("N2") + "%" : "-")</td>
                                <td class="text-end fw-bold text-dark">@it.Amount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light" style="border-top:2px solid #cbd5e1; background:#f8fafc;">
                        @if (dVatCalc.DiscountAmount > 0)
                        {
                            <tr>
                                <td colspan="7" class="text-end text-muted fw-semibold py-2">
                                    <i class="bi bi-tag me-1"></i> รวมเป็นเงินก่อนหักส่วนลด (Gross Total):
                                </td>
                                <td class="text-end fw-bold text-dark py-2">@dVatCalc.GrossAmount.ToString("N2") บาท</td>
                            </tr>
                            <tr>
                                <td colspan="7" class="text-end text-muted fw-semibold py-2">
                                    <i class="bi bi-percent me-1"></i> ส่วนลดการค้า (Trade Discount):
                                </td>
                                <td class="text-end fw-bold text-danger py-2">-@dVatCalc.DiscountAmount.ToString("N2") บาท</td>
                            </tr>
                            <tr style="background:#f1f5f9;">
                                <td colspan="7" class="text-end fw-bold text-dark py-2">
                                    <i class="bi bi-cash-stack me-1"></i> รวมเงินหลังหักส่วนลด (Net Total):
                                </td>
                                <td class="text-end fw-bold text-dark py-2">@dVatCalc.NetAmount.ToString("N2") บาท</td>
                            </tr>
                        }

                        @if (dVatCalc.Category == VatCategory.VatOut)
                        {
                            <tr>
                                <td colspan="7" class="text-end text-muted fw-semibold py-2">
                                    <i class="bi bi-calculator me-1"></i> รวมราคาสินค้าก่อนภาษี (Sub Total):
                                </td>
                                <td class="text-end fw-bold text-dark py-2">@dVatCalc.SubTotal.ToString("N2") บาท</td>
                            </tr>
                            <tr>
                                <td colspan="7" class="text-end text-muted fw-semibold py-2">
                                    <i class="bi bi-percent me-1"></i> ภาษีมูลค่าเพิ่ม 7% นอก (VAT 7% Extra):
                                </td>
                                <td class="text-end fw-bold text-danger py-2">+@dVatCalc.VatAmount.ToString("N2") บาท</td>
                            </tr>
                            <tr style="background:#fffbeb; border-top:2px solid #d97706;">
                                <td colspan="7" class="text-end fw-bold py-2" style="color:#b45309;">
                                    <i class="bi bi-check2-circle me-1"></i> ยอดรวมสุทธิทั้งสิ้น (Grand Total):
                                </td>
                                <td class="text-end fw-black py-2" style="font-size:1.1rem; color:#92400e;">@dVatCalc.GrandTotal.ToString("N2") บาท</td>
                            </tr>
                        }
                        else if (dVatCalc.Category == VatCategory.VatIn)
                        {
                            <tr>
                                <td colspan="7" class="text-end text-muted fw-semibold py-2">
                                    <i class="bi bi-calculator me-1"></i> รวมมูลค่าสินค้าก่อนภาษี (Amount Before VAT 7%):
                                </td>
                                <td class="text-end fw-bold text-dark py-2">@dVatCalc.SubTotal.ToString("N2") บาท</td>
                            </tr>
                            <tr>
                                <td colspan="7" class="text-end text-muted fw-semibold py-2">
                                    <i class="bi bi-percent me-1"></i> ภาษีมูลค่าเพิ่ม 7% ในตัวสินค้า (VAT 7% Included):
                                </td>
                                <td class="text-end fw-bold text-success py-2">@dVatCalc.VatAmount.ToString("N2") บาท</td>
                            </tr>
                            <tr style="background:#f0fdfa; border-top:2px solid #0d9488;">
                                <td colspan="7" class="text-end fw-bold py-2" style="color:#0f766e;">
                                    <i class="bi bi-check2-circle me-1"></i> ยอดรวมสุทธิทั้งสิ้น (Grand Total):
                                </td>
                                <td class="text-end fw-black text-primary py-2" style="font-size:1.1rem;">@dVatCalc.GrandTotal.ToString("N2") บาท</td>
                            </tr>
                        }
                        else if (dVatCalc.Category == VatCategory.VatZero)
                        {
                            <tr>
                                <td colspan="7" class="text-end text-muted fw-semibold py-2">
                                    <i class="bi bi-calculator me-1"></i> มูลค่าสินค้ารวม (Subtotal):
                                </td>
                                <td class="text-end fw-bold text-dark py-2">@dVatCalc.SubTotal.ToString("N2") บาท</td>
                            </tr>
                            <tr>
                                <td colspan="7" class="text-end text-muted fw-semibold py-2">
                                    <i class="bi bi-percent me-1"></i> ภาษีมูลค่าเพิ่ม 0% (VAT 0%):
                                </td>
                                <td class="text-end fw-bold text-info-emphasis py-2">0.00 บาท (VAT 0%)</td>
                            </tr>
                            <tr style="background:#f0f9ff; border-top:2px solid #0284c7;">
                                <td colspan="7" class="text-end fw-bold py-2" style="color:#0369a1;">
                                    <i class="bi bi-check2-circle me-1"></i> ยอดรวมสุทธิทั้งสิ้น (Grand Total):
                                </td>
                                <td class="text-end fw-black text-primary py-2" style="font-size:1.1rem;">@dVatCalc.GrandTotal.ToString("N2") บาท</td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-end text-muted fw-semibold py-2">
                                    <i class="bi bi-calculator me-1"></i> มูลค่าสินค้ารวม (Subtotal):
                                </td>
                                <td class="text-end fw-bold text-dark py-2">@dVatCalc.SubTotal.ToString("N2") บาท</td>
                            </tr>
                            <tr>
                                <td colspan="7" class="text-end text-muted fw-semibold py-2">
                                    <i class="bi bi-dash-circle me-1"></i> ภาษีมูลค่าเพิ่ม (VAT):
                                </td>
                                <td class="text-end fw-bold text-secondary py-2">0.00 บาท (NO VAT)</td>
                            </tr>
                            <tr style="background:#f8fafc; border-top:2px solid #64748b;">
                                <td colspan="7" class="text-end fw-bold py-2" style="color:#334155;">
                                    <i class="bi bi-check2-circle me-1"></i> ยอดรวมสุทธิทั้งสิ้น (Grand Total):
                                </td>
                                <td class="text-end fw-black text-dark py-2" style="font-size:1.1rem;">@dVatCalc.GrandTotal.ToString("N2") บาท</td>
                            </tr>
                        }
                    </tfoot>
                </table>
            </div>
            <div class="px-3 py-2 bg-light border-top d-flex align-items-center">
                <i class="bi bi-info-circle-fill text-primary me-2"></i>
                <small class="text-muted"><strong class="text-dark">ประเภทภาษี:</strong> <span class="badge @dVatBadgeClass me-1">@dVatLabel</span> (@dVatNotice)</small>
            </div>
        </div>
    </div>
}

@{ OutstandingDebt debt = Model; }
<!-- ส่วนการจัดการ: บันทึกรับชำระเงิน & เปลี่ยนสถานะหนี้ -->
<div class="row g-4 mb-4">
    <!-- ฟอร์มรับชำระเงิน -->
    <div class="col-lg-6">
        <div class="card detail-card h-100">
            <div class="card-header text-white py-3 fw-bold" style="background:#0d9488;">
                <i class="bi bi-cash-coin me-1"></i> บันทึกรับชำระเงิน (Payment)
            </div>
            <div class="card-body p-4">
                @if (false)
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-shield-lock-fill fs-1 text-secondary d-block mb-2"></i>
                        <h6 class="fw-bold">ไม่มีสิทธิ์ดูหรือบันทึกการรับชำระเงิน</h6>
                        <small>สิทธิ์นี้ถูกจำกัดตามนโยบายความปลอดภัยของบัญชีผู้ใช้</small>
                    </div>
                }
                else if (debt?.RemainingAmount <= 0)
                {
                    <div class="text-center py-4 text-success">
                        <i class="bi bi-check-circle fs-1 d-block mb-2"></i>
                        บิลนี้ชำระเงินครบถ้วนแล้ว ไม่มียอดคงค้าง
                    </div>
                }
                else
                {
                    <form asp-controller="SalesBill" asp-action="Pay" method="post" enctype="multipart/form-data" onsubmit="return syncPayment()">
    @Html.AntiForgeryToken()
    <input type="hidden" name="billNo" value="@Model.BillNo" />
    <input type="hidden" name="method" value="Cash" id="methodField" />
    
    <input type="hidden" name="amount" id="realAmount" value="@(debt?.RemainingAmount ?? Model.OriginalAmount)" />
    <input type="hidden" name="payDate" id="realPayDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
    <input type="hidden" name="note" id="realNote" value="" />

    <!-- Nav Tabs: เงินสด / โอนเงิน / เช็ค -->
    <ul class="nav nav-pills nav-fill mb-3" id="payTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active fw-bold" id="cash-tab" data-bs-toggle="tab" data-bs-target="#cash-pane" type="button" onclick="setPayMethod('Cash')">
                <i class="bi bi-cash"></i> เงินสด (Cash)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-bold" id="transfer-tab" data-bs-toggle="tab" data-bs-target="#transfer-pane" type="button" onclick="setPayMethod('Transfer')">
                <i class="bi bi-phone"></i> โอนเงิน (Transfer)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-bold" id="check-tab" data-bs-toggle="tab" data-bs-target="#check-pane" type="button" onclick="setPayMethod('Check')">
                <i class="bi bi-bank"></i> เช็ค (Check)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="payTabsContent">
        <!-- เงินสด -->
        <div class="tab-pane fade show active" id="cash-pane">
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">จำนวนเงินรับชำระ (Amount) <span class="text-danger">*</span></label>
                <input type="number" step="0.01" id="amount_Cash" class="form-control form-control-lg fw-bold text-success" required max="@(debt?.RemainingAmount ?? Model.OriginalAmount)" value="@(debt?.RemainingAmount ?? Model.OriginalAmount)" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">วันที่รับเงินสด (Date)</label>
                <input type="date" id="payDate_Cash" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">หมายเหตุ (Note)</label>
                <input type="text" id="note_Cash" class="form-control" placeholder="เช่น รับเงินสดหน้าร้าน" />
            </div>
        </div>

        <!-- โอนเงิน -->
        <div class="tab-pane fade" id="transfer-pane">
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">จำนวนเงินโอน (Amount) <span class="text-danger">*</span></label>
                <input type="number" step="0.01" id="amount_Transfer" class="form-control form-control-lg fw-bold text-success" max="@(debt?.RemainingAmount ?? Model.OriginalAmount)" value="@(debt?.RemainingAmount ?? Model.OriginalAmount)" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">วันที่โอนเงิน (Transfer Date)</label>
                <input type="date" id="payDate_Transfer" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">แนบรูปสลิปโอนเงิน (Slip Image)</label>
                <input type="file" id="file_Transfer" class="form-control" accept="image/*,.pdf" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">หมายเหตุ (Note)</label>
                <input type="text" id="note_Transfer" class="form-control" placeholder="เช่น โอนเข้าบัญชีกสิกร" />
            </div>
        </div>

        <!-- เช็ค -->
        <div class="tab-pane fade" id="check-pane">
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">จำนวนเงินตามเช็ค (Amount) <span class="text-danger">*</span></label>
                <input type="number" step="0.01" id="amount_Check" class="form-control form-control-lg fw-bold text-success" max="@(debt?.RemainingAmount ?? Model.OriginalAmount)" value="@(debt?.RemainingAmount ?? Model.OriginalAmount)" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">วันที่รับเช็ค (Receive Date)</label>
                <input type="date" id="payDate_Check" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold small text-muted">วันที่ในหน้าเช็ค (Cheque Date)</label>
                    <input type="date" name="checkDate" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold small text-muted">ธนาคาร (Bank)</label>
                    <input type="text" name="bank" class="form-control" placeholder="เช่น กสิกร, กรุงเทพ" />
                </div>
                <div class="col-md-12">
                    <label class="form-label fw-bold small text-muted">เลขที่เช็ค (Check No.)</label>
                    <input type="text" name="checkNo" class="form-control" placeholder="เช่น 1234567" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">แนบรูปหน้าเช็ค (Cheque Image)</label>
                <input type="file" id="file_Check" class="form-control" accept="image/*,.pdf" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">หมายเหตุ (Note)</label>
                <input type="text" id="note_Check" class="form-control" placeholder="เช่น รอเช็คเคลียร์" />
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-success w-100 fw-bold py-2 mt-2">
        <i class="bi bi-save"></i> ยืนยันการรับชำระเงิน
    </button>
</form>
                }
            </div>
        </div>
    </div>

    <!-- ฟอร์มเปลี่ยนสถานะหนี้ -->
    <div class="col-lg-6">
        @if (false)
        {
            <div class="card detail-card h-100 bg-light border-0">
                <div class="card-header bg-secondary text-white py-3 fw-bold">
                    <i class="bi bi-lock-fill me-1"></i> เปลี่ยนสถานะหนี้ / จัดการพิเศษ (ไม่มีสิทธิ์)
                </div>
                <div class="card-body p-4 text-center text-muted d-flex flex-column justify-content-center align-items-center" style="min-height:280px;">
                    <i class="bi bi-shield-lock-fill fs-1 text-secondary mb-2" style="opacity:0.4;"></i>
                    <h6 class="fw-bold text-dark mb-1">คุณไม่มีสิทธิ์ในการเปลี่ยนสถานะหนี้</h6>
                    <p class="small text-muted mb-0">เฉพาะผู้ดูแลระบบหรือผู้ที่ได้รับอนุญาตสิทธิ์เท่านั้นที่สามารถเปลี่ยนสถานะหนี้ได้</p>
                </div>
            </div>
        }
        else
        {
            <div class="card detail-card h-100">
                <div class="card-header bg-secondary text-white py-3 fw-bold">
                    <i class="bi bi-arrow-repeat me-1"></i> เปลี่ยนสถานะหนี้ / จัดการพิเศษ
                </div>
                <div class="card-body p-4">
                    <form asp-controller="SalesBill" asp-action="UpdateStatus" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="billNo" value="@Model.BillNo" />

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">เลือกสถานะใหม่ <span class="text-danger">*</span></label>
                            <select name="newStatus" class="form-select form-select-lg fw-bold" id="statusSelect" onchange="onStatusSelectChange()">
                                <option value="Outstanding" selected="@(debt?.Status == DebtStatus.Outstanding)">ค้างชำระปกติ (Outstanding)</option>
                                <option value="Installment" selected="@(debt?.Status == DebtStatus.Installment || (int?)debt?.Status == 100)">ผ่อนชำระ / จ่ายบางส่วน (Installment)</option>
                                <option value="Postponed" selected="@(debt?.Status == DebtStatus.Postponed)">เลื่อนนัดชำระ (Postponed)</option>
                                <option value="WaitingGoods" selected="@(debt?.Status == DebtStatus.WaitingGoods)">รอสินค้า / ของขาด (Waiting for Goods)</option>
                                <option value="Delivering" selected="@(debt?.Status == DebtStatus.Delivering)">บิลอยู่จัดส่ง (Delivering)</option>
                                <option value="ChangeProduct" selected="@(debt?.Status == DebtStatus.ChangeProduct)">เปลี่ยนสินค้า (Change Product)</option>
                                <option value="ReturnPending" selected="@(debt?.Status == DebtStatus.ReturnPending)">รับคืนสินค้า (รอออกใบลดหนี้)</option>
                                <option value="ReturnIssued" selected="@(debt?.Status == DebtStatus.ReturnIssued)">รับคืนสินค้า (ออกใบลดหนี้แล้ว)</option>
                                <option value="Consignment" selected="@(debt?.Status == DebtStatus.Consignment)">สินค้าฝากขาย (Consignment)</option>
                                <option value="BadDebt" selected="@(debt?.Status == DebtStatus.BadDebt)">หนี้สูญ (Bad Debt)</option>
                                <option value="Cancelled" style="color:red; font-weight:bold;">❌ บิลนี้ยกเลิก (ย้ายไปบิลยกเลิก 30 วัน)</option>
                            </select>
                        </div>

                        <!-- รายละเอียดตามสถานะ -->
                        <!-- 1. เลื่อนชำระ -->
                        <div id="f-postponed" class="d-none mb-3 p-3 bg-light rounded border">
                            <label class="form-label fw-bold small text-warning">📅 ระบุวันที่นัดชำระใหม่</label>
                            <input type="date" name="postponedDate" class="form-control" value="@(debt?.PostponedDate?.ToString("yyyy-MM-dd") ?? "")" />
                        </div>

                        <!-- 2. จัดส่ง -->
                        <div id="f-delivering" class="d-none mb-3 p-3 bg-light rounded border">
                            <label class="form-label fw-bold small text-info">🚚 ระบุวันที่จัดส่ง</label>
                            <input type="date" name="deliveringDate" class="form-control" value="@(debt?.DeliveringDate?.ToString("yyyy-MM-dd") ?? "")" />
                        </div>

                        <!-- 3. รอสินค้า -->
                        <div id="f-waiting" class="d-none mb-3 p-3 rounded border" style="background:#f0fdf4; border-color:#86efac;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-bold small text-success mb-0">
                                    <i class="bi bi-box-seam me-1"></i> เลือกรายการสินค้าที่รอส่ง / ของขาดจากบิลนี้
                                </label>
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-success btn-sm py-0" onclick="selectAllWaitingProducts(true)">
                                        <i class="bi bi-check-all"></i> เลือกทั้งหมด
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm py-0" onclick="selectAllWaitingProducts(false)">
                                        <i class="bi bi-x-circle"></i> ล้าง
                                    </button>
                                </div>
                            </div>
                            
                            <div class="mb-2">
                                <label class="form-label small text-muted mb-1">📅 วันที่รอสินค้า / นัดส่งสินค้าใหม่</label>
                                <input type="date" name="waitingGoodsDate" class="form-control form-control-sm" value="@(debt?.WaitingGoodsDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))" />
                            </div>

                            @if (billItems != null && billItems.Any())
                            {
                                <div class="table-responsive bg-white rounded border mb-2" style="max-height: 250px; overflow-y: auto;">
                                    <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.85rem;">
                                        <thead class="table-light sticky-top" style="background:#ecfdf5;">
                                            <tr>
                                                <th style="width: 40px;" class="text-center">เลือก</th>
                                                <th style="width: 100px;">รหัสสินค้า</th>
                                                <th>ชื่อสินค้า</th>
                                                <th style="width: 110px;" class="text-end">จำนวนที่รอ</th>
                                                <th style="width: 60px;" class="text-center">หน่วย</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int idx = 0; idx < billItems.Count; idx++)
                                            {
                                                var item = billItems.ElementAt(idx);
                                                var existingPending = debt?.PendingProducts?.FirstOrDefault(p => p.ProductCode == item.ProductCode);
                                                bool isChecked = existingPending != null || (debt?.Status == DebtStatus.WaitingGoods && billItems.Count == 1);
                                                int defaultQty = existingPending?.Quantity ?? (int)item.Qty;

                                                <tr>
                                                    <td class="text-center">
                                                        <input type="checkbox" name="waitingProductCodes" value="@item.ProductCode" id="chk_prod_@idx" 
                                                               class="form-check-input waiting-prod-chk" onchange="toggleWaitingQtyInput(@idx)"
                                                               @(isChecked ? "checked" : "") />
                                                        <input type="hidden" name="allProductCodes" value="@item.ProductCode" />
                                                        <input type="hidden" name="allProductNames" value="@item.ProductName" />
                                                    </td>
                                                    <td><label for="chk_prod_@idx" class="form-check-label mb-0 fw-bold text-dark"><code>@item.ProductCode</code></label></td>
                                                    <td><label for="chk_prod_@idx" class="form-check-label mb-0 fw-semibold">@item.ProductName</label></td>
                                                    <td class="text-end">
                                                        <input type="number" name="waitingQuantities_@item.ProductCode" id="qty_input_@idx" 
                                                               class="form-control form-control-sm text-end fw-bold text-danger waiting-qty-input" 
                                                               value="@defaultQty" min="1" max="@((int)item.Qty)" style="width: 85px; display: inline-block;" 
                                                               @(isChecked ? "" : "disabled") />
                                                    </td>
                                                    <td class="text-center text-muted"><small>@item.Unit</small></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info py-1 px-2 small mb-2">
                                    <i class="bi bi-info-circle me-1"></i> ไม่พบรายการสินค้าในบิลนี้ สามารถพิมพ์ระบุในหมายเหตุได้
                                </div>
                            }

                            <div>
                                <label class="form-label small text-muted mb-1">📝 หมายเหตุเพิ่มเติม (ถ้ามี)</label>
                                <input type="text" name="note" class="form-control form-control-sm" placeholder="เช่น รอของเข้าโรงงานวันศุกร์..." value="@debt?.Note" />
                            </div>
                        </div>

                        <!-- 4. รับคืนสินค้า -->
                        <div id="f-return" class="d-none mb-3 p-3 bg-light rounded border">
                            <label class="form-label fw-bold small text-secondary">↩️ ยอดเงินรับคืน (บาท)</label>
                            <input type="number" step="0.01" name="returnAmount" class="form-control mb-2" placeholder="0.00" value="@(debt?.ReturnAmount ?? 0)" />
                            <div class="form-check form-check-inline mt-2">
                                <input class="form-check-input" type="radio" name="isReturnCutFromBill" value="true" id="chkReturnCut_debtor" checked="@((debt?.IsReturnCutFromBill == true || debt?.IsReturnCutFromBill == null))" />
                                <label class="form-check-label fw-semibold" for="chkReturnCut_debtor">ตัดกับบิล</label>
                            </div>
                            <div class="form-check form-check-inline mt-2">
                                <input class="form-check-input" type="radio" name="isReturnCutFromBill" value="false" id="chkReturnWait_debtor" checked="@((debt?.IsReturnCutFromBill == false))" />
                                <label class="form-check-label fw-semibold" for="chkReturnWait_debtor">รอตัด</label>
                            </div>
                        </div>

                        <!-- 5. หนี้สูญ -->
                        <div id="f-baddebt" class="d-none mb-3 p-3 bg-danger bg-opacity-10 rounded border border-danger">
                            <label class="form-label fw-bold small text-danger">⚠️ ยอดตัดหนี้สูญ (บาท)</label>
                            <input type="number" step="0.01" name="badDebtAmount" class="form-control mb-2" value="@(debt?.BadDebtAmount ?? debt?.RemainingAmount)" />
                        </div>

                        <!-- 6. ยกเลิกบิล -->
                        <div id="f-cancelled" class="d-none mb-3 p-3 bg-danger bg-opacity-10 rounded border border-danger">
                            <label class="form-label fw-bold small text-danger">❌ เหตุผลในการยกเลิกบิล</label>
                            <input type="text" name="note" class="form-control mb-2" placeholder="เช่น ลูกค้ายกเลิกคำสั่งซื้อ / ออกบิลซ้ำ" />
                            <small class="text-danger d-block">
                                * เมื่อยกเลิก บิลจะถูกย้ายไปเก็บที่หน้า "บิลยกเลิก" เป็นเวลา 30 วัน ก่อนจะถูกลบออกจากระบบ
                            </small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">แนบเอกสาร/รูปภาพประกอบ (ถ้ามี)</label>
                            <input type="file" name="statusFile" class="form-control" accept="image/*,.pdf" />
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-secondary btn-lg fw-bold shadow">
                                <i class="bi bi-save me-1"></i> บันทึกการเปลี่ยนสถานะ
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

<!-- ประวัติการรับชำระเงิน -->
<div class="card detail-card mb-4">
    <div class="card-header bg-light py-3 fw-bold d-flex justify-content-between align-items-center">
        <span><i class="bi bi-clock-history me-1"></i> ประวัติการรับชำระเงินของบิลนี้</span>
        <span class="badge bg-secondary">@(debt?.PaymentRecords?.Count ?? 0) รายการ</span>
    </div>
    <div class="card-body p-0">
        @if (false)
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-shield-lock fs-2 text-muted d-block mb-1"></i>
                <span>ข้อมูลประวัติการรับชำระเงินถูกซ่อนไว้ตามสิทธิ์ความปลอดภัย</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>วันที่รับเงิน</th>
                            <th>วิธีการชำระ</th>
                            <th class="text-end">จำนวนเงิน (บาท)</th>
                            <th>ผู้บันทึก</th>
                            <th>เอกสารแนบ</th>
                            <th>หมายเหตุ / รายละเอียด</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (debt?.PaymentRecords == null || !debt.PaymentRecords.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">ยังไม่มีประวัติการรับชำระเงินสำหรับบิลนี้</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var p in debt?.PaymentRecords.OrderByDescending(x => x.PaidDate))
                            {
                                <tr>
                                    <td>@p.PaidDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <span class="badge bg-info text-dark">@p.Method</span>
                                        @if (!string.IsNullOrEmpty(p.CheckNumber))
                                        {
                                            <small class="d-block text-muted">เช็ค: @p.CheckNumber (@p.BankName)</small>
                                        }
                                    </td>
                                    <td class="text-end fw-bold text-success">@p.PaidAmount.ToString("N2")</td>
                                    <td><span class="badge bg-light text-dark border">@p.CreatedBy</span></td>
                                    <td>
                                        @if (p.Attachments != null && p.Attachments.Any())
                                        {
                                            @foreach (var att in p.Attachments)
                                            {
                                                <a href="@att.FilePath" target="_blank" class="btn btn-sm btn-outline-primary py-0 px-2">
                                                    <i class="bi bi-paperclip"></i> ดูไฟล์
                                                </a>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td>@p.Note</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal แก้ไขข้อมูลใบเสร็จ -->
<div class="modal fade" id="editReceiptModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-controller="Debtor" asp-action="UpdateReceipt" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="bi bi-receipt"></i> จัดการข้อมูลใบเสร็จรับเงิน</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">เลขที่ใบเสร็จ</label>
                    <input type="text" name="receiptNo" class="form-control" value="@Model.ReceiptNo" placeholder="เว้นว่างไว้หากต้องการลบออก" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">วันที่รับเงิน</label>
                    <input type="date" name="receiptDate" class="form-control" value="@(Model.ReceiptDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <hr />
                <div class="alert alert-warning small">
                    <i class="bi bi-shield-lock-fill"></i> กรุณายืนยันรหัสผ่านเพื่อบันทึกการเปลี่ยนแปลง
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">รหัสผ่านสำหรับแก้ไข</label>
                    <input type="password" name="password" class="form-control" required placeholder="กรอกรหัสผ่าน" />
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                <button type="submit" class="btn btn-success fw-bold"><i class="bi bi-save me-1"></i> บันทึกข้อมูล</button>
            </div>
        </form>
    </div>
</div>

<script>
    function setPayMethod(method) {
    document.getElementById('methodField').value = method;
}

function syncPayment() {
    var method = document.getElementById('methodField').value;
    document.getElementById('realAmount').value = document.getElementById('amount_' + method).value;
    document.getElementById('realPayDate').value = document.getElementById('payDate_' + method).value;
    document.getElementById('realNote').value = document.getElementById('note_' + method).value;
    
    // Manage files
    var ft = document.getElementById('file_Transfer');
    var fc = document.getElementById('file_Check');
    if(ft) { ft.name = method === 'Transfer' ? 'file' : ''; }
    if(fc) { fc.name = method === 'Check' ? 'file' : ''; }

    // Disable check inputs if not Check method
    if(method !== 'Check') {
        var cp = document.getElementById('check-pane');
        var checkInputs = cp.querySelectorAll('input[name="checkDate"], input[name="bank"], input[name="checkNo"]');
        checkInputs.forEach(function(inp) { inp.disabled = true; });
    }
    
    return true;
}

    function selectAllWaitingProducts(checked) {
        const checkboxes = document.querySelectorAll('.waiting-prod-chk');
        checkboxes.forEach((chk, idx) => {
            chk.checked = checked;
            toggleWaitingQtyInput(idx);
        });
    }

    function toggleWaitingQtyInput(idx) {
        const chk = document.getElementById('chk_prod_' + idx);
        const input = document.getElementById('qty_input_' + idx);
        if (chk && input) {
            input.disabled = !chk.checked;
        }
    }

    function onStatusSelectChange() {
        const val = document.getElementById('statusSelect').value;
        const sections = ['f-postponed', 'f-delivering', 'f-waiting', 'f-return', 'f-baddebt', 'f-cancelled'];
        sections.forEach(s => {
            const el = document.getElementById(s);
            if (el) el.classList.add('d-none');
        });

        if (val === 'Postponed') document.getElementById('f-postponed')?.classList.remove('d-none');
        if (val === 'Delivering') document.getElementById('f-delivering')?.classList.remove('d-none');
        if (val === 'WaitingGoods') document.getElementById('f-waiting')?.classList.remove('d-none');
        if (val === 'ReturnIssued' || val === 'ReturnPending') document.getElementById('f-return')?.classList.remove('d-none');
        if (val === 'BadDebt') document.getElementById('f-baddebt')?.classList.remove('d-none');
        if (val === 'Cancelled') document.getElementById('f-cancelled')?.classList.remove('d-none');
    }

    document.addEventListener('DOMContentLoaded', () => {
        onStatusSelectChange();
    });
</script>



