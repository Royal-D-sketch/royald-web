@model List<RoyalD.Web.Models.OutstandingDebt>
@{
    ViewData["Title"] = "รายงานหนี้สูญ";
    decimal totalAmount = Model.Sum(d => d.BadDebtAmount ?? d.RemainingAmount);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-1 fw-bold text-danger">
            <i class="bi bi-exclamation-octagon"></i> รายงานหนี้สูญ
        </h2>
        <p class="text-muted mb-0 small">
            รายการลูกหนี้ที่ถูกบันทึกเป็นหนี้สูญ
        </p>
    </div>
    <div class="d-flex gap-2">
        <!-- Optional: Add Export buttons if needed later -->
        <a href="/Debtor" class="btn btn-outline-secondary d-flex align-items-center">
            <i class="bi bi-arrow-left me-1"></i> กลับหน้ารวมลูกหนี้
        </a>
    </div>
</div>

<div class="filter-card p-3 mb-4">
    <form method="get" action="/Debtor/BadDebt">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-bold text-primary mb-1">🔍 ค้นหาบิล/ลูกค้า</label>
                <input type="text" name="search" class="form-control" placeholder="รหัสลูกค้า / เลขที่บิล / ชื่อ..." value="@ViewBag.Search"/>
            </div>
            @if (ViewBag.IsRestricted == true)
            {
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-primary mb-1">👔 ผู้แทนขาย</label>
                    <input type="text" class="form-control bg-light fw-bold text-primary" value="@ViewBag.SalesRep" readonly />
                    <input type="hidden" name="salesRep" value="@ViewBag.SalesRep" />
                </div>
            }
            else
            {
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-primary mb-1">👔 ผู้แทนขาย</label>
                    <select name="salesRep" class="form-select">
                        <option value="">-- ทุกผู้แทน --</option>
                        @foreach (var s in (ViewBag.SalesReps as List<string> ?? new())) {
                            if (s == ViewBag.SalesRep) { <option value="@s" selected>@s</option> }
                            else { <option value="@s">@s</option> }
                        }
                    </select>
                </div>
            }
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 fw-bold"><i class="bi bi-filter"></i> กรอง</button>
                <a href="/Debtor/BadDebt" class="btn btn-outline-secondary"><i class="bi bi-arrow-clockwise"></i></a>
            </div>
        </div>
    </form>
</div>

@if (!Model.Any())
{
    <div class="card p-5 text-center text-muted">
        <i class="bi bi-emoji-smile fs-1 d-block mb-3"></i>
        <h5>ไม่พบรายการหนี้สูญ</h5>
    </div>
}
else
{
    <div class="card shadow-sm p-3 table-responsive">
        <div class="mb-3 d-flex justify-content-between align-items-center">
            <span class="badge bg-danger fs-6">@Model.Count รายการ</span>
            <span class="fw-bold fs-5 text-danger">ยอดรวมหนี้สูญ: @totalAmount.ToString("N2") บาท</span>
        </div>
        <table class="table table-hover table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th>วันที่บิล</th>
                    <th>เลขที่บิล</th>
                    <th>รหัสลูกค้า</th>
                    <th style="max-width:200px;">ชื่อลูกค้า</th>
                    <th>ผู้แทนขาย</th>
                    <th class="text-end">จำนวนเงิน</th>
                    <th style="width:250px;">หมายเหตุ</th>
                    <th class="text-center">จัดการ</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.BillDate.ToString("dd/MM/yyyy")</td>
                        <td><a href="/SalesBill/Detail?id=@Uri.EscapeDataString(item.BillNo)" class="fw-bold text-decoration-none">@item.BillNo</a></td>
                        <td><code>@item.CustomerCode</code></td>
                        <td class="text-truncate" style="max-width:200px;">@item.CustomerName</td>
                        <td><span class="badge bg-light text-dark border">@item.SalesRep</span></td>
                        <td class="text-end fw-bold text-danger">@((item.BadDebtAmount ?? item.RemainingAmount).ToString("N2"))</td>
                        <td>
                            <div class="small text-muted text-wrap" style="max-width:250px; overflow-wrap: break-word;">
                                @(string.IsNullOrEmpty(item.Note) ? "-" : item.Note)
                            </div>
                        </td>
                        <td class="text-center">
                            <a href="/Debtor/Detail?id=@item.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i> ดูรายละเอียด
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
