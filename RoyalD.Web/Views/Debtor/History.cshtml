@model List<RoyalD.Web.Models.OutstandingDebt>
@using RoyalD.Web.Models
@{
    ViewData["Title"] = "ประวัติชำระครบแล้ว";
    var today = DateTime.Today;
}

@section Styles {
<style>
.debt-card-container {
    background: #f8fafc;
}
.table-hover tbody tr:hover {
    background-color: #f1f5f9;
}
@@media print {
    body * { visibility: hidden; }
    .debt-card-container, .debt-card-container * { visibility: visible; }
    .debt-card-container { position: absolute; left: 0; top: 0; width: 100%; }
    .btn, form, .input-group { display: none !important; }
}
</style>
}

<div class="debt-card-container p-4 rounded-4 shadow-sm bg-white">
        <div class="card border-0 shadow-sm mb-3 no-print" style="background:#f0f9ff; border: 1.5px solid #bae6fd !important; border-radius:12px;">
        <div class="card-body py-2 px-3">
            <form method="get" action="/Debtor/History" class="row g-2 align-items-end">
                <input type="hidden" name="pageSize" value="@(ViewBag.PageSize ?? 50)" />
                <div class="col-md-3">
                    <input type="text" name="search" class="form-control" placeholder="ค้นหา ชื่อ / บิล / ใบเสร็จ..." value="@ViewBag.Search" />
                </div>
                <div class="col-md-3">
                    <select name="salesRep" class="form-select select2-searchable">
                        <option value="">-- ทุกผู้แทน --</option>
                        @{ var __histReps = ViewBag.SalesReps as List<string> ?? new List<string>(); }
                        @foreach (var r in __histReps)
                        {
                            if (ViewBag.SalesRep as string == r) { <option value="@r" selected>@r</option> }
                            else { <option value="@r">@r</option> }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="dateType" class="form-select form-select-sm">
                        @if ((ViewBag.DateType as string) != "bill") { <option value="receipt" selected>กรองตามวันที่ใบเสร็จ</option> } else { <option value="receipt">กรองตามวันที่ใบเสร็จ</option> }
                        @if ((ViewBag.DateType as string) == "bill") { <option value="bill" selected>กรองตามวันที่บิล</option> } else { <option value="bill">กรองตามวันที่บิล</option> }
                    </select>
                </div>
                <div class="col-md-2">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">ตั้งแต่</span>
                        <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">ถึง</span>
                        <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate" />
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 fw-bold btn-sm"><i class="bi bi-search me-1"></i> ค้นหา</button>
                </div>
                @if (!string.IsNullOrEmpty(ViewBag.FromDate as string) || !string.IsNullOrEmpty(ViewBag.ToDate as string))
                {
                    <div class="col-md-2">
                        <a href="/Debtor/History" class="btn btn-outline-secondary w-100 btn-sm"><i class="bi bi-x me-1"></i> ล้างตัวกรอง</a>
                    </div>
                }
            </form>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color:#0f766e;"><i class="bi bi-clock-history"></i> ประวัติชำระครบแล้ว</h2>
            <p class="text-muted mb-0">รายการบิลที่ชำระครบถ้วนและถูกจัดเก็บเข้าประวัติอัตโนมัติ (เกิน 7 วัน ไม่เกิน 120 วัน)</p>
        </div>
        <a href="/Debtor" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> กลับไปการ์ดลูกหนี้</a>
    </div>

    @{
        int curPage = ViewBag.Page ?? 1;
        int pSize = ViewBag.PageSize ?? 50;
        int totRecords = ViewBag.TotalRecords ?? (Model?.Count ?? 0);
        int totPages = ViewBag.TotalPages ?? 1;
        int startItem = totRecords == 0 ? 0 : ((curPage - 1) * pSize) + 1;
        int endItem = Math.Min(curPage * pSize, totRecords);
    }

    <div class="d-flex justify-content-between align-items-center mb-2 px-1 text-muted small">
        <span><i class="bi bi-table me-1"></i> แสดง <strong>@startItem - @endItem</strong> จากทั้งหมด <strong>@totRecords.ToString("N0")</strong> รายการ (หน้า <strong>@curPage / @totPages</strong>)</span>
    </div>

    <!-- Data Table -->
    <div class="table-responsive bg-white rounded-3 shadow-sm border mb-3">
        <table id="historyTable" class="table table-hover align-middle mb-0" style="font-size: 0.95rem;">
            <thead style="background:#f1f5f9; color:#475569; border-bottom: 2px solid #cbd5e1;">
                <tr>
                    <th class="py-3 px-3">วันที่ใบเสร็จ</th>
                    <th>เลขที่ใบเสร็จ</th>
                    <th>รหัสลูกค้า</th>
                    <th class="col-customer-name" style="min-width: 260px; white-space: normal !important;">ชื่อลูกค้า</th>
                    <th>วันที่บิล</th>
                    <th>เลขที่บิล</th>
                    <th class="text-end pe-3">จำนวนเงินบิล (บาท)</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
                @if (Model != null && Model.Any())
                {
                    foreach (var d in Model)
                    {
                        var displayDate = d.ReceiptDate ?? d.FullyPaidDate ?? d.PaidDate;
                        <tr>
                            <td class="px-3 fw-bold text-success">@(displayDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td class="fw-bold" style="color:#0369a1;">@(string.IsNullOrEmpty(d.ReceiptNo) ? "-" : d.ReceiptNo)</td>
                            <td class="text-muted">@d.CustomerCode</td>
                            <td class="fw-bold text-dark col-customer-name" style="min-width: 260px; white-space: normal !important; word-break: break-word !important;">@d.CustomerName</td>
                            <td class="text-muted">@d.BillDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                <a href="/SalesBill/Detail/@Uri.EscapeDataString(d.BillNo)" class="text-decoration-none fw-bold" style="color:#0f766e;">
                                    @d.BillNo
                                </a>
                            </td>
                            <td class="text-end pe-3 fw-bold text-dark">@d.OriginalAmount.ToString("N2")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <div class="mb-3"><i class="bi bi-inbox fs-1 text-secondary opacity-50"></i></div>
                            <h5>ไม่มีประวัติชำระเงิน</h5>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination & Summary -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-3 py-2 bg-white rounded shadow-sm border mt-3 mb-4 no-print">
        <div class="d-flex align-items-center gap-3">
            <div class="text-muted small">
                แสดง <strong>@startItem - @endItem</strong> จากทั้งหมด <strong>@totRecords.ToString("N0")</strong> รายการ (หน้า <strong>@curPage / @totPages</strong>)
            </div>
            <div class="d-flex align-items-center gap-1 text-muted small">
                <label>แถวต่อหน้า:</label>
                <select class="form-select form-select-sm" style="width: auto; padding: 2px 24px 2px 8px; font-size: 0.8rem;" onchange="changePageSize(this.value)">
                    <option value="30" selected="@(pSize == 30)">30</option>
                    <option value="50" selected="@(pSize == 50)">50</option>
                    <option value="100" selected="@(pSize == 100)">100</option>
                    <option value="200" selected="@(pSize == 200)">200</option>
                </select>
            </div>
        </div>

        @if (totPages > 1)
        {
            <nav class="no-print">
                <ul class="pagination pagination-sm mb-0">
                    @if (curPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("History", new { search = ViewBag.Search, salesRep = ViewBag.SalesRep, dateType = ViewBag.DateType, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, page = 1, pageSize = pSize })" title="หน้าแรก">«</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("History", new { search = ViewBag.Search, salesRep = ViewBag.SalesRep, dateType = ViewBag.DateType, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, page = curPage - 1, pageSize = pSize })">‹ ก่อนหน้า</a>
                        </li>
                    }

                    @for (int p = Math.Max(1, curPage - 2); p <= Math.Min(totPages, curPage + 2); p++)
                    {
                        if (p == curPage)
                        {
                            <li class="page-item active"><span class="page-link" style="background:#0d9488; border-color:#0d9488;">@p</span></li>
                        }
                        else
                        {
                            <li class="page-item"><a class="page-link" href="@Url.Action("History", new { search = ViewBag.Search, salesRep = ViewBag.SalesRep, dateType = ViewBag.DateType, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, page = p, pageSize = pSize })">@p</a></li>
                        }
                    }

                    @if (curPage < totPages)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("History", new { search = ViewBag.Search, salesRep = ViewBag.SalesRep, dateType = ViewBag.DateType, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, page = curPage + 1, pageSize = pSize })">ถัดไป ›</a>
                        </li>
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("History", new { search = ViewBag.Search, salesRep = ViewBag.SalesRep, dateType = ViewBag.DateType, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, page = totPages, pageSize = pSize })" title="หน้าสุดท้าย">»</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>

@section Scripts {
<script>
    function changePageSize(size) {
        const url = new URL(window.location.href);
        url.searchParams.set('pageSize', size);
        url.searchParams.set('page', '1');
        window.location.href = url.toString();
    }

    function exportTableToExcel(tableID, filename = ''){
        var downloadLink;
        var dataType = 'application/vnd.ms-excel';
        var tableSelect = document.getElementById(tableID);
        var clone = tableSelect.cloneNode(true);
        var rows = clone.rows;
        for (var i = 0; i < rows.length; i++) {
            rows[i].deleteCell(-1);
        }
        var tableHTML = clone.outerHTML.replace(/ /g, '%20');
        filename = filename?filename+'.xls':'excel_data.xls';
        downloadLink = document.createElement("a");
        document.body.appendChild(downloadLink);
        if(navigator.msSaveOrOpenBlob){
            var blob = new Blob(['\ufeff', tableHTML], { type: dataType });
            navigator.msSaveOrOpenBlob( blob, filename);
        }else{
            downloadLink.href = 'data:' + dataType + ', ' + tableHTML;
            downloadLink.download = filename;
            downloadLink.click();
        }
    }
</script>
}



