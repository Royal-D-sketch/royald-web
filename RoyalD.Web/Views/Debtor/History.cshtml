@model List<RoyalD.Web.Models.OutstandingDebt>
@using RoyalD.Web.Models
@{
    ViewData["Title"] = "ประวัติชำระครบแล้ว";
    var today = DateTime.Today;
}

@section Styles {
<style>
.debt-card-container {
    background: #f8fafc;
}
.table-hover tbody tr:hover {
    background-color: #f1f5f9;
}
@@media print {
    body * { visibility: hidden; }
    .debt-card-container, .debt-card-container * { visibility: visible; }
    .debt-card-container { position: absolute; left: 0; top: 0; width: 100%; }
    .btn, form, .input-group { display: none !important; }
}
</style>
}

<div class="debt-card-container p-4 rounded-4 shadow-sm bg-white">
        <div class="card border-0 shadow-sm mb-3 no-print" style="background:#f0f9ff; border: 1.5px solid #bae6fd !important; border-radius:12px;">
        <div class="card-body py-2 px-3">
            <form method="get" action="/Debtor/History" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <input type="text" name="search" class="form-control" placeholder="ค้นหา ชื่อ / บิล / ใบเสร็จ..." value="@ViewBag.Search" />
                </div>
                <div class="col-md-3">
                    <select name="salesRep" class="form-select">
                        <option value="">-- ทุกผู้แทน --</option>
                        @{ var __histReps = ViewBag.SalesReps as List<string> ?? new List<string>(); }
                        @foreach (var r in __histReps)
                        {
                            if (ViewBag.SalesRep as string == r) { <option value="@r" selected>@r</option> }
                            else { <option value="@r">@r</option> }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="dateType" class="form-select form-select-sm">
                        @if ((ViewBag.DateType as string) != "bill") { <option value="receipt" selected>กรองตามวันที่ใบเสร็จ</option> } else { <option value="receipt">กรองตามวันที่ใบเสร็จ</option> }
                        @if ((ViewBag.DateType as string) == "bill") { <option value="bill" selected>กรองตามวันที่บิล</option> } else { <option value="bill">กรองตามวันที่บิล</option> }
                    </select>
                </div>
                <div class="col-md-2">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">ตั้งแต่</span>
                        <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">ถึง</span>
                        <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate" />
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 fw-bold btn-sm"><i class="bi bi-search me-1"></i> ค้นหา</button>
                </div>
                @if (!string.IsNullOrEmpty(ViewBag.FromDate as string) || !string.IsNullOrEmpty(ViewBag.ToDate as string))
                {
                    <div class="col-md-2">
                        <a href="/Debtor/History" class="btn btn-outline-secondary w-100 btn-sm"><i class="bi bi-x me-1"></i> ล้างตัวกรอง</a>
                    </div>
                }
            </form>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color:#0f766e;"><i class="bi bi-clock-history"></i> ประวัติชำระครบแล้ว</h2>
            <p class="text-muted mb-0">รายการบิลที่ชำระครบถ้วนและถูกจัดเก็บเข้าประวัติอัตโนมัติ (เกิน 7 วัน ไม่เกิน 120 วัน)</p>
        </div>
        <a href="/Debtor" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> กลับไปการ์ดลูกหนี้</a>
    </div>

    <!-- Search Box -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius:12px; background:#f8fafc;">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" class="form-control border-start-0" placeholder="ค้นหา: รหัส, ชื่อลูกค้า, เลขที่บิล, เลขใบเสร็จ..." value="@ViewBag.SearchTerm">
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 fw-bold"><i class="bi bi-funnel"></i> ค้นหา</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table -->
    <div class="table-responsive bg-white rounded-3 shadow-sm border mb-3">
        <table id="historyTable" class="table table-hover align-middle mb-0" style="font-size: 0.95rem;">
            <thead style="background:#f1f5f9; color:#475569; border-bottom: 2px solid #cbd5e1;">
                <tr>
                    <th class="py-3 px-3">วันที่ใบเสร็จ</th>
                    <th>เลขที่ใบเสร็จ</th>
                    <th>รหัสลูกค้า</th>
                    <th>ชื่อลูกค้า</th>
                    <th>วันที่บิล</th>
                    <th>เลขที่บิล</th>
                    <th class="text-end pe-3">จำนวนเงินบิล (บาท)</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
                @if (Model != null && Model.Any())
                {
                    foreach (var d in Model)
                    {
                        var displayDate = d.ReceiptDate ?? d.FullyPaidDate ?? d.PaidDate;
                        <tr>
                            <td class="px-3 fw-bold text-success">@(displayDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td class="fw-bold" style="color:#0369a1;">@(string.IsNullOrEmpty(d.ReceiptNo) ? "-" : d.ReceiptNo)</td>
                            <td class="text-muted">@d.CustomerCode</td>
                            <td class="fw-bold text-dark">@d.CustomerName</td>
                            <td class="text-muted">@d.BillDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                <a href="/SalesBill/Detail/@Uri.EscapeDataString(d.BillNo)" class="text-decoration-none fw-bold" style="color:#0f766e;">
                                    @d.BillNo
                                </a>
                            </td>
                            <td class="text-end pe-3 fw-bold text-dark">@d.OriginalAmount.ToString("N2")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <div class="mb-3"><i class="bi bi-inbox fs-1 text-secondary opacity-50"></i></div>
                            <h5>ไม่มีประวัติชำระเงิน</h5>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    function exportTableToExcel(tableID, filename = ''){
        var downloadLink;
        var dataType = 'application/vnd.ms-excel';
        var tableSelect = document.getElementById(tableID);
        // Clone table to remove actions column before exporting
        var clone = tableSelect.cloneNode(true);
        var rows = clone.rows;
        for (var i = 0; i < rows.length; i++) {
            rows[i].deleteCell(-1); // Delete the last column (Actions)
        }
        var tableHTML = clone.outerHTML.replace(/ /g, '%20');
        
        // Specify file name
        filename = filename?filename+'.xls':'excel_data.xls';
        
        // Create download link element
        downloadLink = document.createElement("a");
        document.body.appendChild(downloadLink);
        
        if(navigator.msSaveOrOpenBlob){
            var blob = new Blob(['\ufeff', tableHTML], {
                type: dataType
            });
            navigator.msSaveOrOpenBlob( blob, filename);
        }else{
            // Create a link to the file
            downloadLink.href = 'data:' + dataType + ', ' + tableHTML;
            // Setting the file name
            downloadLink.download = filename;
            //triggering the function
            downloadLink.click();
        }
    }
</script>
}

