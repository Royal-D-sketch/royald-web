@model RoyalD.Web.Models.SalesBill
@{
    ViewData["Title"] = $"รายละเอียดบิล {Model.BillNo}";
    bool canDelete = ViewBag.CanDeleteSalesBill == true;
}

@section Styles {
<style>
.bill-section { user-select: none; -webkit-user-select: none; }
@@media print {
    .no-print { display: none !important; }
    body { font-size: 12px; }
}
</style>
}

@using RoyalD.Web.Services
@{
    decimal itemSum = Model.Items.Sum(x => x.Amount);
    var vatCalc = VatHelper.Calculate(Model.BillNo, Model.CustomerCode, Model.CustomerName, Model.Province, Model.TotalAmount, itemSum, Model.SalesRep, Model.Items);
    string vatTypeLabel = vatCalc.Label;
    string vatShortLabel = vatCalc.ShortLabel;
    string vatBadgeClass = vatCalc.BadgeClass;
    string vatExplanation = vatCalc.Explanation;
}

@{
    var debt = ViewBag.Debt as RoyalD.Web.Models.OutstandingDebt;
    bool isInstallment = debt != null && (debt.Status == RoyalD.Web.Models.DebtStatus.Installment || (int)debt.Status == 100);
    bool isBadDebt = debt != null && debt.Status == RoyalD.Web.Models.DebtStatus.BadDebt;
    bool isWaitingGoods = debt != null && debt.Status == RoyalD.Web.Models.DebtStatus.WaitingGoods;
    bool isReturn = debt != null && (debt.Status == RoyalD.Web.Models.DebtStatus.ReturnIssued || debt.Status == RoyalD.Web.Models.DebtStatus.ReturnPending);
    bool isCancelled = debt != null && debt.Status == RoyalD.Web.Models.DebtStatus.Cancelled;

    bool isSpecialStatus = isInstallment || isBadDebt || isWaitingGoods || isReturn || isCancelled;
    
    bool isFullyPaid = !isSpecialStatus && (Model.IsFullyPaid || (debt != null && 
        (debt.RemainingAmount <= 0 || debt.FullyPaidDate.HasValue || 
         debt.Status == RoyalD.Web.Models.DebtStatus.PaidTransfer || 
         debt.Status == RoyalD.Web.Models.DebtStatus.PaidCash || 
         debt.Status == RoyalD.Web.Models.DebtStatus.PaidCheck)));
}

<div class="no-print">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <a href="/SalesBill" class="btn btn-outline-secondary btn-sm me-2">
                <i class="bi bi-arrow-left"></i> กลับหน้ารายการบิล
            </a>
            <span class="fw-bold fs-5" style="color:#0f766e;"><i class="bi bi-receipt text-primary"></i> รายละเอียดบิลขาย: <code>@Model.BillNo</code></span>
            <span class="badge @vatBadgeClass ms-2 px-2 py-1 fs-6 shadow-sm"><i class="bi bi-patch-check-fill me-1"></i> @vatTypeLabel</span>
            @if (isInstallment)
            {
                <span class="badge bg-warning text-dark ms-2 px-3 py-1 fs-6 shadow-sm"><i class="bi bi-clock-history me-1"></i> ผ่อนชำระ</span>
            }
            else if (isCancelled)
            {
                <span class="badge bg-dark ms-2 px-3 py-1 fs-6 shadow-sm"><i class="bi bi-x-circle-fill me-1"></i> บิลยกเลิก</span>
            }
            else if (isBadDebt)
            {
                <span class="badge bg-danger ms-2 px-3 py-1 fs-6 shadow-sm"><i class="bi bi-x-octagon me-1"></i> หนี้สูญ</span>
            }
            else if (isWaitingGoods)
            {
                <span class="badge bg-info text-dark ms-2 px-3 py-1 fs-6 shadow-sm"><i class="bi bi-box-seam me-1"></i> รอสินค้า</span>
            }
            else if (isReturn)
            {
                <span class="badge bg-secondary ms-2 px-3 py-1 fs-6 shadow-sm"><i class="bi bi-arrow-return-left me-1"></i> รับคืนสินค้า</span>
            }
            else if (isFullyPaid)
            {
                <span class="badge bg-success ms-2 px-3 py-1 fs-6 shadow-sm border border-success"><i class="bi bi-check-circle-fill me-1"></i> รับชำระครบแล้ว</span>
            }
        </div>
        <div class="d-flex gap-2">
            <a href="/Debtor/Index?search=@Uri.EscapeDataString(Model.BillNo)" class="btn btn-outline-primary btn-sm fw-bold">
                <i class="bi bi-credit-card"></i> ดูการ์ดลูกหนี้
            </a>
            <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-printer"></i> พิมพ์บิล
            </button>
            @if (canDelete)
            {
                <form asp-controller="SalesBill" asp-action="DeleteBill" method="post" class="d-inline" onsubmit="return confirm('ยืนยันการลบบิลขายเลขที่ @Model.BillNo ออกจากระบบหรือไม่?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.BillNo" />
                    <button type="submit" class="btn btn-danger btn-sm fw-bold">
                        <i class="bi bi-trash"></i> ลบบิลขาย
                    </button>
                </form>
            }
        </div>
    </div>
    <div class="alert alert-warning py-2 small" style="border-radius:10px;">
        <i class="bi bi-shield-exclamation text-warning"></i>
        <strong>หน้านี้มีระบบความปลอดภัย</strong> — ข้อมูลการเข้าดูและการทำรายการถูกบันทึกใน Audit Logs
    </div>
</div>

<!-- Bill Detail (protected) -->
<div class="bill-section" oncontextmenu="return false;" oncopy="return false;" onselectstart="return false;">
    @if (isInstallment)
    {
        <div class="alert alert-warning text-center py-2 mb-3 fw-bold fs-5 shadow-sm rounded-pill" style="border: 2px dashed #d97706; background:#fffbeb; color:#b45309;">
            <i class="bi bi-clock-history fs-4 me-2"></i> ผ่อนชำระ
            @if (debt != null)
            {
                <span class="fs-6 fw-normal ms-2">(ยอดคงค้างผ่อนชำระ: <strong class="text-danger">@debt.RemainingAmount.ToString("N2")</strong> บาท / ยอดบิล: @Model.TotalAmount.ToString("N2") บาท)</span>
            }
            @if (!string.IsNullOrEmpty(Model.ReceiptNo))
            {
                <span class="fs-6 fw-normal ms-2 text-muted">| เลขที่ใบเสร็จ: @Model.ReceiptNo</span>
            }
        </div>
    }
    else if (isCancelled)
    {
        <div class="alert alert-dark text-center py-2 mb-3 fw-bold fs-5 shadow-sm rounded-pill" style="border: 2px dashed #343a40;">
            <i class="bi bi-x-circle-fill fs-4 me-2"></i> บิลยกเลิก
            @if (debt != null && !string.IsNullOrEmpty(debt.Note))
            {
                <span class="fs-6 fw-normal ms-2 text-muted">(เหตุผล: @debt.Note)</span>
            }
        </div>
    }
    else if (isBadDebt)
    {
        <div class="alert alert-danger text-center py-2 mb-3 fw-bold fs-5 shadow-sm rounded-pill" style="border: 2px dashed #dc3545; background:#f8d7da; color:#842029;">
            <i class="bi bi-x-octagon fs-4 me-2"></i> หนี้สูญ
            @if (debt != null && debt.BadDebtAmount > 0)
            {
                <span class="fs-6 fw-normal ms-2">(ยอดตัดหนี้สูญ: <strong class="text-danger">@debt.BadDebtAmount?.ToString("N2")</strong> บาท)</span>
            }
        </div>
    }
    else if (isWaitingGoods)
    {
        <div class="alert alert-info text-center py-2 mb-3 fw-bold fs-5 shadow-sm rounded-pill" style="border: 2px dashed #0dcaf0; background:#cff4fc; color:#055160;">
            <i class="bi bi-box-seam fs-4 me-2"></i> รอสินค้า
        </div>
    }
    else if (isReturn)
    {
        <div class="alert alert-secondary text-center py-2 mb-3 fw-bold fs-5 shadow-sm rounded-pill" style="border: 2px dashed #6c757d; background:#e2e3e5; color:#41464b;">
            <i class="bi bi-arrow-return-left fs-4 me-2"></i> รับคืนสินค้า
            @if (debt != null && debt.ReturnAmount > 0)
            {
                <span class="fs-6 fw-normal ms-2">(ยอดรับคืน: <strong>@debt.ReturnAmount?.ToString("N2")</strong> บาท)</span>
            }
        </div>
    }
    else if (isFullyPaid)
    {
        <div class="alert alert-success text-center py-2 mb-3 fw-bold fs-5 shadow-sm rounded-pill" style="border: 2px dashed #198754;">
            <i class="bi bi-check-circle-fill fs-4 me-2"></i> ชำระครบแล้ว
            @if (!string.IsNullOrEmpty(Model.ReceiptNo))
            {
                <span class="fs-6 fw-normal ms-2">(ใบเสร็จ: @Model.ReceiptNo วันที่: @(Model.ReceiptDate?.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture)))</span>
            }
        </div>
    }

    <div class="card mb-3 shadow-sm border-0" style="border-radius:12px;">
        <div class="card-body p-4">
            <div class="text-center mb-3 position-relative">
                <h5 class="fw-bold" style="color:#0f766e;">บริษัท รอแยล-ดี (ไทยแลนด์) จำกัด (สำนักงานใหญ่)</h5>
                @if (vatShortLabel == "NOVAT")
                {
                    <h6 class="text-muted fw-semibold">ใบส่งสินค้า (Delivery Order / Invoice)</h6>
                }
                else
                {
                    <h6 class="text-muted fw-semibold">ใบกำกับภาษี / ใบส่งสินค้า (Tax Invoice)</h6>
                }
                <div class="position-absolute top-0 end-0">
                    @{
                        string bannerText = vatShortLabel == "NOVAT" ? "[ เอกสารทั่วไป - NO VAT ]" : "[ ใบกำกับภาษี/ใบเสร็จรับเงิน - VAT ]";
                    }
                    <span class="badge @vatBadgeClass px-3 py-2 fs-6"><i class="bi bi-tag-fill me-1"></i> @bannerText</span>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <table class="table table-borderless table-sm mb-0">
                        <tr><td class="fw-semibold text-muted" width="140">ชื่อลูกค้า:</td><td class="fw-bold text-dark">@Model.CustomerName</td></tr>
                        <tr><td class="fw-semibold text-muted">รหัสลูกค้า:</td><td><code>@Model.CustomerCode</code></td></tr>
                        <tr><td class="fw-semibold text-muted">เขต/อำเภอ:</td><td>@(!string.IsNullOrEmpty(Model.District) ? Model.District : "-")</td></tr>
                        <tr><td class="fw-semibold text-muted">จังหวัด:</td><td>@(!string.IsNullOrEmpty(Model.Province) ? Model.Province : "-")</td></tr>
                        <tr><td class="fw-semibold text-muted">เบอร์โทร:</td><td>@(!string.IsNullOrEmpty(Model.Phone) ? Model.Phone : "-")</td></tr>
                    </table>
                </div>
                <div class="col-md-6">
                    <table class="table table-borderless table-sm mb-0">
                        <tr><td class="fw-semibold text-muted" width="140">เลขที่บิล:</td><td><strong class="text-primary fs-6">@Model.BillNo</strong></td></tr>
                        <tr><td class="fw-semibold text-muted">วันที่บิล:</td><td>@Model.BillDate.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture)</td></tr>
                        <tr><td class="fw-semibold text-muted">ใบสั่งซื้อเลขที่:</td><td><strong class="text-dark">@(!string.IsNullOrEmpty(Model.PoNumber) ? Model.PoNumber : "-")</strong></td></tr>
                        <tr><td class="fw-semibold text-muted">เครดิตเทอม:</td><td><span class="badge bg-info text-dark border">@Model.Credit วัน</span></td></tr>
                        <tr><td class="fw-semibold text-muted">ผู้แทนขาย:</td><td><span class="badge bg-info-subtle text-info-emphasis border">@Model.SalesRep</span></td></tr>
                        <tr><td class="fw-semibold text-muted">ประเภทภาษี:</td><td><span class="badge @vatBadgeClass px-2 py-1"><i class="bi bi-patch-check-fill me-1"></i> @vatTypeLabel</span></td></tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Items -->
    <div class="card mb-3 shadow-sm border-0" style="border-radius:12px; overflow:hidden;">
        <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
            <span class="fw-bold text-dark"><i class="bi bi-box-seam me-1 text-primary"></i> รายการสินค้า (@Model.Items.Count รายการ)</span>
            <span class="badge @vatBadgeClass px-2 py-1"><i class="bi bi-info-circle me-1"></i> @vatTypeLabel</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0" style="font-size:0.9rem;">
                <thead class="table-light" style="background:#f8fafc; border-bottom:2px solid #e2e8f0;">
                    <tr>
                        <th class="text-center" style="width:50px;">#</th>
                        <th style="width:130px;">รหัสสินค้า</th>
                        <th>ชื่อสินค้า / รายการ</th>
                        <th class="text-center" style="width:90px;">จำนวน</th>
                        <th class="text-center" style="width:80px;">หน่วย</th>
                        <th class="text-end" style="width:120px;">ราคา/หน่วย</th>
                        <th class="text-end" style="width:100px;">ส่วนลด</th>
                        <th class="text-end" style="width:140px;">จำนวนเงิน (บาท)</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int idx = 1; }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="text-center text-muted">@(idx++)</td>
                            <td><code>@item.ProductCode</code></td>
                            <td class="fw-semibold text-dark">@item.ProductName</td>
                            <td class="text-center fw-bold">@item.Qty.ToString("N0")</td>
                            <td class="text-center text-muted">@item.Unit</td>
                            <td class="text-end">@item.Price.ToString("N2")</td>
                            <td class="text-end text-muted">@(item.Discount > 0 ? item.Discount.ToString("N2") + "%" : "-")</td>
                            <td class="text-end fw-bold text-dark">@item.Amount.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light" style="border-top:2px solid #cbd5e1; background:#f8fafc;">
                    <tr>
                        <td colspan="7" class="text-end text-muted fw-semibold py-2">
                            ส่วนลด (ส่วนลดท้ายบิล):
                        </td>
                        <td class="text-end fw-bold text-danger py-2">
                            @vatCalc.DiscountAmount.ToString("N2") บาท
                        </td>
                    </tr>
                    <tr>
                        <td colspan="7" class="text-end text-muted fw-semibold py-2">
                            ยอดคงเหลือ (ราคาก่อนภาษีมูลค่าเพิ่ม):
                        </td>
                        <td class="text-end fw-bold text-dark py-2">
                            @vatCalc.SubTotal.ToString("N2") บาท
                        </td>
                    </tr>
                    <tr>
                        <td colspan="7" class="text-end text-muted fw-semibold py-2">
                            VAT.= (ภาษีมูลค่าเพิ่ม VAT):
                        </td>
                        <td class="text-end fw-bold text-dark py-2">
                            @if (vatCalc.Category == VatCategory.NoVat)
                            {
                                <span>0.00 บาท</span>
                            }
                            else
                            {
                                <span>@vatCalc.VatAmount.ToString("N2") บาท</span>
                            }
                        </td>
                    </tr>
                    <tr style="background:#fffbeb; border-top:2px solid #d97706;">
                        <td colspan="7" class="text-end fw-bold py-2" style="color:#b45309; font-size:1rem;">
                            รวมทั้งสิ้น (จำนวนเงินรวมทั้งสิ้น):
                        </td>
                        <td class="text-end fw-black py-2" style="font-size:1.15rem; color:#92400e;">
                            @vatCalc.GrandTotal.ToString("N2") บาท
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- VAT Explanation Notice Box -->
    <div class="alert alert-light border shadow-sm d-flex align-items-center mb-3 py-2 px-3" style="border-radius:10px; background:#f8fafc;">
        <i class="bi bi-info-circle-fill text-primary fs-4 me-2"></i>
        <div>
            <span class="fw-bold text-dark">จุดสังเกตประเภทภาษี: </span>
            <span class="badge @vatBadgeClass me-1">@vatTypeLabel</span>
            <span class="text-muted small">— @vatExplanation</span>
        </div>
    </div>

    <!-- Signature area -->
    <div class="card shadow-sm border-0" style="border-radius:12px;">
        <div class="card-body py-4">
            <div class="row text-center">
                @foreach (var sig in new[] { "ผู้รับสินค้า", "ผู้ส่งสินค้า", "ผู้ตรวจสอบ", "ผู้มีอำนาจ" })
                {
                    <div class="col-3">
                        <div style="border-bottom: 1px solid #cbd5e1; margin: 35px 15px 6px;">&nbsp;</div>
                        <small class="fw-bold text-dark">(@sig)</small><br/>
                        <small class="text-muted" style="font-size:0.75rem;">วันที่....................</small>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (isFullyPaid)
{
    <div id="unlock-form" class="alert alert-warning text-center">
        <h6>บิลนี้ชำระครบถ้วนแล้ว ต้องการปลดล็อคเพื่อแก้ไขหรือไม่?</h6>
        <input type="password" id="admin-password" class="form-control w-25 mx-auto mb-2" placeholder="รหัสผ่าน" />
        <button class="btn btn-warning" onclick="unlockForms()">ปลดล็อค</button>
    </div>
}

<div id="management-forms" style="@(isFullyPaid ? "display:none;" : "")">
<!-- ส่วนการจัดการ: บันทึกรับชำระเงิน & เปลี่ยนสถานะหนี้ -->
<div class="row g-4 mb-4">
    <!-- ฟอร์มรับชำระเงิน -->
    <div class="col-lg-6">
        <div class="card detail-card h-100">
            <div class="card-header text-white py-3 fw-bold" style="background:#0d9488;">
                <i class="bi bi-cash-coin me-1"></i> บันทึกรับชำระเงิน (Payment)
            </div>
            <div class="card-body p-4">
                @if (false)
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-shield-lock-fill fs-1 text-secondary d-block mb-2"></i>
                        <h6 class="fw-bold">ไม่มีสิทธิ์ดูหรือบันทึกการรับชำระเงิน</h6>
                        <small>สิทธิ์นี้ถูกจำกัดตามนโยบายความปลอดภัยของบัญชีผู้ใช้</small>
                    </div>
                }
                else if (debt?.RemainingAmount <= 0 && !isInstallment)
                {
                    <div class="text-center py-4 text-success">
                        <i class="bi bi-check-circle fs-1 d-block mb-2"></i>
                        บิลนี้ชำระเงินครบถ้วนแล้ว ไม่มียอดคงค้าง
                    </div>
                }
                else
                {
                    <form asp-controller="SalesBill" asp-action="Pay" method="post" enctype="multipart/form-data" onsubmit="return syncPayment()">
    @Html.AntiForgeryToken()
    <input type="hidden" name="billNo" value="@Model.BillNo" />
    <input type="hidden" name="adminPassword" class="hidden-admin-pwd" value="" />
    <input type="hidden" name="method" value="Cash" id="methodField" />
    
    <input type="hidden" name="amount" id="realAmount" value="@(debt?.RemainingAmount > 0 ? debt.RemainingAmount : Model.TotalAmount)" />
    <input type="hidden" name="payDate" id="realPayDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
    <input type="hidden" name="note" id="realNote" value="" />

    <!-- Nav Tabs: เงินสด / โอนเงิน / เช็ค -->
    <ul class="nav nav-pills nav-fill mb-3" id="payTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active fw-bold" id="cash-tab" data-bs-toggle="tab" data-bs-target="#cash-pane" type="button" onclick="setPayMethod('Cash')">
                <i class="bi bi-cash"></i> เงินสด (Cash)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-bold" id="transfer-tab" data-bs-toggle="tab" data-bs-target="#transfer-pane" type="button" onclick="setPayMethod('Transfer')">
                <i class="bi bi-phone"></i> โอนเงิน (Transfer)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-bold" id="check-tab" data-bs-toggle="tab" data-bs-target="#check-pane" type="button" onclick="setPayMethod('Check')">
                <i class="bi bi-bank"></i> เช็ค (Check)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="payTabsContent">
        <!-- เงินสด -->
        <div class="tab-pane fade show active" id="cash-pane">
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">จำนวนเงินรับชำระ (Amount) <span class="text-danger">*</span></label>
                <input type="number" step="0.01" id="amount_Cash" class="form-control form-control-lg fw-bold text-success" required max="@(debt?.RemainingAmount > 0 ? debt.RemainingAmount : Model.TotalAmount)" value="@(debt?.RemainingAmount > 0 ? debt.RemainingAmount : Model.TotalAmount)" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">วันที่รับเงินสด (Date)</label>
                <input type="date" id="payDate_Cash" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">หมายเหตุ (Note)</label>
                <input type="text" id="note_Cash" class="form-control" placeholder="เช่น รับเงินสดหน้าร้าน" />
            </div>
        </div>

        <!-- โอนเงิน -->
        <div class="tab-pane fade" id="transfer-pane">
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">จำนวนเงินโอน (Amount) <span class="text-danger">*</span></label>
                <input type="number" step="0.01" id="amount_Transfer" class="form-control form-control-lg fw-bold text-success" max="@(debt?.RemainingAmount > 0 ? debt.RemainingAmount : Model.TotalAmount)" value="@(debt?.RemainingAmount > 0 ? debt.RemainingAmount : Model.TotalAmount)" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">วันที่โอนเงิน (Transfer Date)</label>
                <input type="date" id="payDate_Transfer" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">แนบรูปสลิปโอนเงิน (Slip Image)</label>
                <input type="file" id="file_Transfer" class="form-control" accept="image/*,.pdf" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">หมายเหตุ (Note)</label>
                <input type="text" id="note_Transfer" class="form-control" placeholder="เช่น โอนเข้าบัญชีกสิกร" />
            </div>
        </div>

        <!-- เช็ค -->
        <div class="tab-pane fade" id="check-pane">
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">จำนวนเงินตามเช็ค (Amount) <span class="text-danger">*</span></label>
                <input type="number" step="0.01" id="amount_Check" class="form-control form-control-lg fw-bold text-success" max="@(debt?.RemainingAmount > 0 ? debt.RemainingAmount : Model.TotalAmount)" value="@(debt?.RemainingAmount > 0 ? debt.RemainingAmount : Model.TotalAmount)" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">วันที่รับเช็ค (Receive Date)</label>
                <input type="date" id="payDate_Check" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold small text-muted">วันที่ในหน้าเช็ค (Cheque Date)</label>
                    <input type="date" name="checkDate" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold small text-muted">ธนาคาร (Bank)</label>
                    <input type="text" name="bank" class="form-control" placeholder="เช่น กสิกร, กรุงเทพ" />
                </div>
                <div class="col-md-12">
                    <label class="form-label fw-bold small text-muted">เลขที่เช็ค (Check No.)</label>
                    <input type="text" name="checkNo" class="form-control" placeholder="เช่น 1234567" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">แนบรูปหน้าเช็ค (Cheque Image)</label>
                <input type="file" id="file_Check" class="form-control" accept="image/*,.pdf" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">หมายเหตุ (Note)</label>
                <input type="text" id="note_Check" class="form-control" placeholder="เช่น รอเช็คเคลียร์" />
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-success w-100 fw-bold py-2 mt-2">
        <i class="bi bi-save"></i> ยืนยันการรับชำระเงิน
    </button>
</form>
                }
            </div>
        </div>
    </div>

    <!-- ฟอร์มเปลี่ยนสถานะหนี้ -->
    <div class="col-lg-6">
        @if (false)
        {
            <div class="card detail-card h-100 bg-light border-0">
                <div class="card-header bg-secondary text-white py-3 fw-bold">
                    <i class="bi bi-lock-fill me-1"></i> เปลี่ยนสถานะหนี้ / จัดการพิเศษ (ไม่มีสิทธิ์)
                </div>
                <div class="card-body p-4 text-center text-muted d-flex flex-column justify-content-center align-items-center" style="min-height:280px;">
                    <i class="bi bi-shield-lock-fill fs-1 text-secondary mb-2" style="opacity:0.4;"></i>
                    <h6 class="fw-bold text-dark mb-1">คุณไม่มีสิทธิ์ในการเปลี่ยนสถานะหนี้</h6>
                    <p class="small text-muted mb-0">เฉพาะผู้ดูแลระบบหรือผู้ที่ได้รับอนุญาตสิทธิ์เท่านั้นที่สามารถเปลี่ยนสถานะหนี้ได้</p>
                </div>
            </div>
        }
        else
        {
            <div class="card detail-card h-100">
                <div class="card-header bg-secondary text-white py-3 fw-bold">
                    <i class="bi bi-arrow-repeat me-1"></i> เปลี่ยนสถานะหนี้ / จัดการพิเศษ
                </div>
                <div class="card-body p-4">
                    <form asp-controller="SalesBill" asp-action="UpdateStatus" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="billNo" value="@Model.BillNo" />
                        <input type="hidden" name="adminPassword" class="hidden-admin-pwd" value="" />

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">เลือกสถานะใหม่ <span class="text-danger">*</span></label>
                            <select name="newStatus" class="form-select form-select-lg fw-bold" id="statusSelect" onchange="onStatusSelectChange()">
                                <option value="Outstanding" selected="@(debt?.Status == DebtStatus.Outstanding)">ค้างชำระปกติ (Outstanding)</option>
                                <option value="Installment" selected="@(isInstallment)">ผ่อนชำระ / จ่ายบางส่วน (Installment)</option>
                                <option value="Postponed" selected="@(debt?.Status == DebtStatus.Postponed)">เลื่อนนัดชำระ (Postponed)</option>
                                <option value="WaitingGoods" selected="@(debt?.Status == DebtStatus.WaitingGoods)">รอสินค้า / ของขาด (Waiting for Goods)</option>
                                <option value="Delivering" selected="@(debt?.Status == DebtStatus.Delivering)">บิลอยู่จัดส่ง (Delivering)</option>
                                <option value="ChangeProduct" selected="@(debt?.Status == DebtStatus.ChangeProduct)">เปลี่ยนสินค้า (Change Product)</option>
                                <option value="Return" selected="@(debt?.Status == DebtStatus.ReturnIssued || debt?.Status == DebtStatus.ReturnPending)">รับคืนสินค้า (Return)</option>
                                <option value="Consignment" selected="@(debt?.Status == DebtStatus.Consignment)">สินค้าฝากขาย (Consignment)</option>
                                <option value="BadDebt" selected="@(debt?.Status == DebtStatus.BadDebt)">หนี้สูญ (Bad Debt)</option>
                                <option value="Cancelled" style="color:red; font-weight:bold;">❌ บิลนี้ยกเลิก (ย้ายไปบิลยกเลิก 30 วัน)</option>
                            </select>
                        </div>

                        <!-- รายละเอียดตามสถานะ -->
                        <!-- 0. ผ่อนชำระ -->
                        <div id="f-installment" class="@(isInstallment ? "" : "d-none") mb-3 p-3 rounded border" style="background:#fffbeb; border-color:#fde68a;">
                            <label class="form-label fw-bold small text-warning">💳 ยอดหนี้คงเหลือที่ต้องผ่อนชำระ (บาท)</label>
                            <input type="number" step="0.01" name="installmentRemainingAmount" class="form-control" placeholder="ระบุยอดคงเหลือ หรือเว้นว่างเพื่อใช้ยอดตามจริง" value="@(debt?.RemainingAmount > 0 ? debt.RemainingAmount.ToString("F2") : (debt != null ? Math.Max(0, debt.OriginalAmount - (debt.PaymentRecords?.Sum(p => p.PaidAmount) ?? 0)).ToString("F2") : Model.TotalAmount.ToString("F2")))" />
                            <small class="text-muted">หากบิลนี้เคยตัดเป็นชำระครบแล้ว การเลือกผ่อนชำระจะเปิดบิลกลับมาให้สามารถชำระต่องวดได้ตามยอดนี้</small>
                        </div>
                        <!-- 1. เลื่อนชำระ -->
                        <div id="f-postponed" class="d-none mb-3 p-3 bg-light rounded border">
                            <label class="form-label fw-bold small text-warning">📅 ระบุวันที่นัดชำระใหม่</label>
                            <input type="date" name="postponedDate" class="form-control" value="@(debt?.PostponedDate?.ToString("yyyy-MM-dd") ?? "")" />
                        </div>

                        <!-- 2. จัดส่ง -->
                        <div id="f-delivering" class="d-none mb-3 p-3 bg-light rounded border">
                            <label class="form-label fw-bold small text-info">🚚 ระบุวันที่จัดส่ง</label>
                            <input type="date" name="deliveringDate" class="form-control" value="@(debt?.DeliveringDate?.ToString("yyyy-MM-dd") ?? "")" />
                        </div>

                        <!-- 3. รอสินค้า -->
                        <div id="f-waiting" class="d-none mb-3 p-3 rounded border" style="background:#f0fdf4; border-color:#86efac;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-bold small text-success mb-0">
                                    <i class="bi bi-box-seam me-1"></i> เลือกรายการสินค้าที่รอส่ง / ของขาดจากบิลนี้
                                </label>
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-success btn-sm py-0" onclick="selectAllWaitingProducts(true)">
                                        <i class="bi bi-check-all"></i> เลือกทั้งหมด
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm py-0" onclick="selectAllWaitingProducts(false)">
                                        <i class="bi bi-x-circle"></i> ล้าง
                                    </button>
                                </div>
                            </div>
                            
                            <div class="mb-2">
                                <label class="form-label small text-muted mb-1">📅 วันที่รอสินค้า / นัดส่งสินค้าใหม่</label>
                                <input type="date" name="waitingGoodsDate" class="form-control form-control-sm" value="@(debt?.WaitingGoodsDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))" />
                            </div>

                            @if (Model.Items != null && Model.Items.Any())
                            {
                                <div class="table-responsive bg-white rounded border mb-2" style="max-height: 250px; overflow-y: auto;">
                                    <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.85rem;">
                                        <thead class="table-light sticky-top" style="background:#ecfdf5;">
                                            <tr>
                                                <th style="width: 40px;" class="text-center">เลือก</th>
                                                <th style="width: 100px;">รหัสสินค้า</th>
                                                <th>ชื่อสินค้า</th>
                                                <th style="width: 110px;" class="text-end">จำนวนที่รอ</th>
                                                <th style="width: 60px;" class="text-center">หน่วย</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int idx = 0; idx < Model.Items.Count; idx++)
                                            {
                                                var item = Model.Items.ElementAt(idx);
                                                var existingPending = debt?.PendingProducts?.FirstOrDefault(p => p.ProductCode == item.ProductCode);
                                                bool isChecked = existingPending != null || (debt?.Status == DebtStatus.WaitingGoods && Model.Items.Count == 1);
                                                int defaultQty = existingPending?.Quantity ?? (int)item.Qty;

                                                <tr>
                                                    <td class="text-center">
                                                        <input type="checkbox" name="waitingProductCodes" value="@item.ProductCode" id="chk_prod_@idx" 
                                                               class="form-check-input waiting-prod-chk" onchange="toggleWaitingQtyInput(@idx)"
                                                               @(isChecked ? "checked" : "") />
                                                        <input type="hidden" name="allProductCodes" value="@item.ProductCode" />
                                                        <input type="hidden" name="allProductNames" value="@item.ProductName" />
                                                    </td>
                                                    <td><label for="chk_prod_@idx" class="form-check-label mb-0 fw-bold text-dark"><code>@item.ProductCode</code></label></td>
                                                    <td><label for="chk_prod_@idx" class="form-check-label mb-0 fw-semibold">@item.ProductName</label></td>
                                                    <td class="text-end">
                                                        <input type="number" name="waitingQuantities_@item.ProductCode" id="qty_input_@idx" 
                                                               class="form-control form-control-sm text-end fw-bold text-danger waiting-qty-input" 
                                                               value="@defaultQty" min="1" max="@((int)item.Qty)" style="width: 85px; display: inline-block;" 
                                                               @(isChecked ? "" : "disabled") />
                                                    </td>
                                                    <td class="text-center text-muted"><small>@item.Unit</small></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info py-1 px-2 small mb-2">
                                    <i class="bi bi-info-circle me-1"></i> ไม่พบรายการสินค้าในบิลนี้ สามารถพิมพ์ระบุในหมายเหตุได้
                                </div>
                            }

                            <div>
                                <label class="form-label small text-muted mb-1">📝 หมายเหตุเพิ่มเติม (ถ้ามี)</label>
                                <input type="text" name="note" class="form-control form-control-sm" placeholder="เช่น รอของเข้าโรงงานวันศุกร์..." value="@debt?.Note" />
                            </div>
                        </div>

                        <!-- 4. รับคืนสินค้า -->
                        <div id="f-return" class="d-none mb-3 p-3 bg-light rounded border">
                            <label class="form-label fw-bold small text-secondary">↩️ ยอดเงินรับคืน (บาท)</label>
                            <input type="number" step="0.01" name="returnAmount" class="form-control mb-2" placeholder="0.00" value="@(debt?.ReturnAmount ?? 0)" />
                            <div class="form-check form-check-inline mt-2">
                                <input class="form-check-input" type="radio" name="isReturnCutFromBill" value="true" id="chkReturnCut" checked="@((debt?.IsReturnCutFromBill == true || debt?.IsReturnCutFromBill == null))" />
                                <label class="form-check-label fw-semibold" for="chkReturnCut">ตัดกับบิล</label>
                            </div>
                            <div class="form-check form-check-inline mt-2">
                                <input class="form-check-input" type="radio" name="isReturnCutFromBill" value="false" id="chkReturnWait" checked="@((debt?.IsReturnCutFromBill == false))" />
                                <label class="form-check-label fw-semibold" for="chkReturnWait">รอตัด</label>
                            </div>
                        </div>

                        <!-- 5. หนี้สูญ -->
                        <div id="f-baddebt" class="d-none mb-3 p-3 bg-danger bg-opacity-10 rounded border border-danger">
                            <label class="form-label fw-bold small text-danger">⚠️ ยอดตัดหนี้สูญ (บาท)</label>
                            <input type="number" step="0.01" name="badDebtAmount" class="form-control mb-2" value="@(debt?.BadDebtAmount ?? debt?.RemainingAmount)" />
                        </div>

                        <!-- 6. ยกเลิกบิล -->
                        <div id="f-cancelled" class="d-none mb-3 p-3 bg-danger bg-opacity-10 rounded border border-danger">
                            <label class="form-label fw-bold small text-danger">❌ เหตุผลในการยกเลิกบิล</label>
                            <input type="text" name="note" class="form-control mb-2" placeholder="เช่น ลูกค้ายกเลิกคำสั่งซื้อ / ออกบิลซ้ำ" />
                            <small class="text-danger d-block">
                                * เมื่อยกเลิก บิลจะถูกย้ายไปเก็บที่หน้า "บิลยกเลิก" เป็นเวลา 30 วัน ก่อนจะถูกลบออกจากระบบ
                            </small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">แนบเอกสาร/รูปภาพประกอบ (ถ้ามี)</label>
                            <input type="file" name="statusFile" class="form-control" accept="image/*,.pdf" />
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-secondary btn-lg fw-bold shadow">
                                <i class="bi bi-save me-1"></i> บันทึกการเปลี่ยนสถานะ
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

<!-- ประวัติการรับชำระเงิน -->
<div class="card detail-card mb-4">
    <div class="card-header bg-light py-3 fw-bold d-flex justify-content-between align-items-center">
        <span><i class="bi bi-clock-history me-1"></i> ประวัติการรับชำระเงินของบิลนี้</span>
        <span class="badge bg-secondary">@(debt?.PaymentRecords?.Count ?? 0) รายการ</span>
    </div>
    <div class="card-body p-0">
        @if (false)
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-shield-lock fs-2 text-muted d-block mb-1"></i>
                <span>ข้อมูลประวัติการรับชำระเงินถูกซ่อนไว้ตามสิทธิ์ความปลอดภัย</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>วันที่รับเงิน</th>
                            <th>วิธีการชำระ</th>
                            <th class="text-end">จำนวนเงิน (บาท)</th>
                            <th>ผู้บันทึก</th>
                            <th>เอกสารแนบ</th>
                            <th>หมายเหตุ / รายละเอียด</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (debt?.PaymentRecords == null || !debt.PaymentRecords.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">ยังไม่มีประวัติการรับชำระเงินสำหรับบิลนี้</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var p in debt?.PaymentRecords.OrderByDescending(x => x.PaidDate))
                            {
                                <tr>
                                    <td>@p.PaidDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <span class="badge bg-info text-dark">@p.Method</span>
                                        @if (!string.IsNullOrEmpty(p.CheckNumber))
                                        {
                                            <small class="d-block text-muted">เช็ค: @p.CheckNumber (@p.BankName)</small>
                                        }
                                    </td>
                                    <td class="text-end fw-bold text-success">@p.PaidAmount.ToString("N2")</td>
                                    <td><span class="badge bg-light text-dark border">@p.CreatedBy</span></td>
                                    <td>
                                        @if (p.Attachments != null && p.Attachments.Any())
                                        {
                                            @foreach (var att in p.Attachments)
                                            {
                                                <a href="@att.FilePath" target="_blank" class="btn btn-sm btn-outline-primary py-0 px-2">
                                                    <i class="bi bi-paperclip"></i> ดูไฟล์
                                                </a>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td>@p.Note</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal Edit Receipt -->
<div class="modal fade" id="editReceiptModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-controller="SalesBill" asp-action="UpdateReceipt" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="billNo" value="@Model.BillNo" />
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="bi bi-receipt"></i> จัดการข้อมูลใบเสร็จรับเงิน</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">เลขที่ใบเสร็จ</label>
                    <input type="text" name="receiptNo" class="form-control" value="@Model.ReceiptNo" placeholder="เว้นว่างไว้หากต้องการลบออก" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">วันที่รับเงิน</label>
                    <input type="date" name="receiptDate" class="form-control" value="@(Model.ReceiptDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <hr />
                <div class="alert alert-warning small">
                    <i class="bi bi-shield-lock-fill"></i> กรุณายืนยันรหัสผ่านเพื่อบันทึกการเปลี่ยนแปลง
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">รหัสผ่านสำหรับแก้ไข</label>
                    <input type="password" name="adminPassword" class="form-control" required placeholder="กรอกรหัสผ่านผู้ดูแลระบบ" />
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                <button type="submit" class="btn btn-success fw-bold"><i class="bi bi-save"></i> บันทึกข้อมูล</button>
            </div>
        </form>
    </div>
</div>


    </div>
}
else
{
    <div id="management-forms">
<!-- ส่วนการจัดการ: บันทึกรับชำระเงิน & เปลี่ยนสถานะหนี้ -->
<div class="row g-4 mb-4">
    <!-- ฟอร์มรับชำระเงิน -->
    <div class="col-lg-6">
        <div class="card detail-card h-100">
            <div class="card-header text-white py-3 fw-bold" style="background:#0d9488;">
                <i class="bi bi-cash-coin me-1"></i> บันทึกรับชำระเงิน (Payment)
            </div>
            <div class="card-body p-4">
                @if (false)
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-shield-lock-fill fs-1 text-secondary d-block mb-2"></i>
                        <h6 class="fw-bold">ไม่มีสิทธิ์ดูหรือบันทึกการรับชำระเงิน</h6>
                        <small>สิทธิ์นี้ถูกจำกัดตามนโยบายความปลอดภัยของบัญชีผู้ใช้</small>
                    </div>
                }
                else if (debt?.RemainingAmount <= 0)
                {
                    <div class="text-center py-4 text-success">
                        <i class="bi bi-check-circle fs-1 d-block mb-2"></i>
                        บิลนี้ชำระเงินครบถ้วนแล้ว ไม่มียอดคงค้าง
                    </div>
                }
                else
                {
                    <form asp-controller="SalesBill" asp-action="Pay" method="post" enctype="multipart/form-data" onsubmit="return syncPayment()">
    @Html.AntiForgeryToken()
    <input type="hidden" name="billNo" value="@Model.BillNo" />
    <input type="hidden" name="adminPassword" class="hidden-admin-pwd" value="" />
    <input type="hidden" name="method" value="Cash" id="methodField" />
    
    <input type="hidden" name="amount" id="realAmount" value="@(debt?.RemainingAmount ?? Model.TotalAmount)" />
    <input type="hidden" name="payDate" id="realPayDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
    <input type="hidden" name="note" id="realNote" value="" />

    <!-- Nav Tabs: เงินสด / โอนเงิน / เช็ค -->
    <ul class="nav nav-pills nav-fill mb-3" id="payTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active fw-bold" id="cash-tab" data-bs-toggle="tab" data-bs-target="#cash-pane" type="button" onclick="setPayMethod('Cash')">
                <i class="bi bi-cash"></i> เงินสด (Cash)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-bold" id="transfer-tab" data-bs-toggle="tab" data-bs-target="#transfer-pane" type="button" onclick="setPayMethod('Transfer')">
                <i class="bi bi-phone"></i> โอนเงิน (Transfer)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link fw-bold" id="check-tab" data-bs-toggle="tab" data-bs-target="#check-pane" type="button" onclick="setPayMethod('Check')">
                <i class="bi bi-bank"></i> เช็ค (Check)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="payTabsContent">
        <!-- เงินสด -->
        <div class="tab-pane fade show active" id="cash-pane">
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">จำนวนเงินรับชำระ (Amount) <span class="text-danger">*</span></label>
                <input type="number" step="0.01" id="amount_Cash" class="form-control form-control-lg fw-bold text-success" required max="@(debt?.RemainingAmount ?? Model.TotalAmount)" value="@(debt?.RemainingAmount ?? Model.TotalAmount)" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">วันที่รับเงินสด (Date)</label>
                <input type="date" id="payDate_Cash" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">หมายเหตุ (Note)</label>
                <input type="text" id="note_Cash" class="form-control" placeholder="เช่น รับเงินสดหน้าร้าน" />
            </div>
        </div>

        <!-- โอนเงิน -->
        <div class="tab-pane fade" id="transfer-pane">
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">จำนวนเงินโอน (Amount) <span class="text-danger">*</span></label>
                <input type="number" step="0.01" id="amount_Transfer" class="form-control form-control-lg fw-bold text-success" max="@(debt?.RemainingAmount ?? Model.TotalAmount)" value="@(debt?.RemainingAmount ?? Model.TotalAmount)" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">วันที่โอนเงิน (Transfer Date)</label>
                <input type="date" id="payDate_Transfer" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">แนบรูปสลิปโอนเงิน (Slip Image)</label>
                <input type="file" id="file_Transfer" class="form-control" accept="image/*,.pdf" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">หมายเหตุ (Note)</label>
                <input type="text" id="note_Transfer" class="form-control" placeholder="เช่น โอนเข้าบัญชีกสิกร" />
            </div>
        </div>

        <!-- เช็ค -->
        <div class="tab-pane fade" id="check-pane">
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">จำนวนเงินตามเช็ค (Amount) <span class="text-danger">*</span></label>
                <input type="number" step="0.01" id="amount_Check" class="form-control form-control-lg fw-bold text-success" max="@(debt?.RemainingAmount ?? Model.TotalAmount)" value="@(debt?.RemainingAmount ?? Model.TotalAmount)" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">วันที่รับเช็ค (Receive Date)</label>
                <input type="date" id="payDate_Check" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold small text-muted">วันที่ในหน้าเช็ค (Cheque Date)</label>
                    <input type="date" name="checkDate" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold small text-muted">ธนาคาร (Bank)</label>
                    <input type="text" name="bank" class="form-control" placeholder="เช่น กสิกร, กรุงเทพ" />
                </div>
                <div class="col-md-12">
                    <label class="form-label fw-bold small text-muted">เลขที่เช็ค (Check No.)</label>
                    <input type="text" name="checkNo" class="form-control" placeholder="เช่น 1234567" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">แนบรูปหน้าเช็ค (Cheque Image)</label>
                <input type="file" id="file_Check" class="form-control" accept="image/*,.pdf" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold small text-muted">หมายเหตุ (Note)</label>
                <input type="text" id="note_Check" class="form-control" placeholder="เช่น รอเช็คเคลียร์" />
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-success w-100 fw-bold py-2 mt-2">
        <i class="bi bi-save"></i> ยืนยันการรับชำระเงิน
    </button>
</form>
                }
            </div>
        </div>
    </div>

    <!-- ฟอร์มเปลี่ยนสถานะหนี้ -->
    <div class="col-lg-6">
        @if (false)
        {
            <div class="card detail-card h-100 bg-light border-0">
                <div class="card-header bg-secondary text-white py-3 fw-bold">
                    <i class="bi bi-lock-fill me-1"></i> เปลี่ยนสถานะหนี้ / จัดการพิเศษ (ไม่มีสิทธิ์)
                </div>
                <div class="card-body p-4 text-center text-muted d-flex flex-column justify-content-center align-items-center" style="min-height:280px;">
                    <i class="bi bi-shield-lock-fill fs-1 text-secondary mb-2" style="opacity:0.4;"></i>
                    <h6 class="fw-bold text-dark mb-1">คุณไม่มีสิทธิ์ในการเปลี่ยนสถานะหนี้</h6>
                    <p class="small text-muted mb-0">เฉพาะผู้ดูแลระบบหรือผู้ที่ได้รับอนุญาตสิทธิ์เท่านั้นที่สามารถเปลี่ยนสถานะหนี้ได้</p>
                </div>
            </div>
        }
        else
        {
            <div class="card detail-card h-100">
                <div class="card-header bg-secondary text-white py-3 fw-bold">
                    <i class="bi bi-arrow-repeat me-1"></i> เปลี่ยนสถานะหนี้ / จัดการพิเศษ
                </div>
                <div class="card-body p-4">
                    <form asp-controller="SalesBill" asp-action="UpdateStatus" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="billNo" value="@Model.BillNo" />
                        <input type="hidden" name="adminPassword" class="hidden-admin-pwd" value="" />

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">เลือกสถานะใหม่ <span class="text-danger">*</span></label>
                            <select name="newStatus" class="form-select form-select-lg fw-bold" id="statusSelect" onchange="onStatusSelectChange()">
                                <option value="Outstanding" selected="@(debt?.Status == DebtStatus.Outstanding)">ค้างชำระปกติ (Outstanding)</option>
                                <option value="Installment" selected="@(isInstallment)">ผ่อนชำระ / จ่ายบางส่วน (Installment)</option>
                                <option value="Postponed" selected="@(debt?.Status == DebtStatus.Postponed)">เลื่อนนัดชำระ (Postponed)</option>
                                <option value="WaitingGoods" selected="@(debt?.Status == DebtStatus.WaitingGoods)">รอสินค้า / ของขาด (Waiting for Goods)</option>
                                <option value="Delivering" selected="@(debt?.Status == DebtStatus.Delivering)">บิลอยู่จัดส่ง (Delivering)</option>
                                <option value="ChangeProduct" selected="@(debt?.Status == DebtStatus.ChangeProduct)">เปลี่ยนสินค้า (Change Product)</option>
                                <option value="Return" selected="@(debt?.Status == DebtStatus.ReturnIssued || debt?.Status == DebtStatus.ReturnPending)">รับคืนสินค้า (Return)</option>
                                <option value="Consignment" selected="@(debt?.Status == DebtStatus.Consignment)">สินค้าฝากขาย (Consignment)</option>
                                <option value="BadDebt" selected="@(debt?.Status == DebtStatus.BadDebt)">หนี้สูญ (Bad Debt)</option>
                                <option value="Cancelled" style="color:red; font-weight:bold;">❌ บิลนี้ยกเลิก (ย้ายไปบิลยกเลิก 30 วัน)</option>
                            </select>
                        </div>

                        <!-- รายละเอียดตามสถานะ -->
                        <!-- 0. ผ่อนชำระ -->
                        <div id="f-installment-2" class="@(isInstallment ? "" : "d-none") mb-3 p-3 rounded border" style="background:#fffbeb; border-color:#fde68a;">
                            <label class="form-label fw-bold small text-warning">💳 ยอดหนี้คงเหลือที่ต้องผ่อนชำระ (บาท)</label>
                            <input type="number" step="0.01" name="installmentRemainingAmount" class="form-control" placeholder="ระบุยอดคงเหลือ หรือเว้นว่างเพื่อใช้ยอดตามจริง" value="@(debt?.RemainingAmount > 0 ? debt.RemainingAmount.ToString("F2") : (debt != null ? Math.Max(0, debt.OriginalAmount - (debt.PaymentRecords?.Sum(p => p.PaidAmount) ?? 0)).ToString("F2") : Model.TotalAmount.ToString("F2")))" />
                            <small class="text-muted">หากบิลนี้เคยตัดเป็นชำระครบแล้ว การเลือกผ่อนชำระจะเปิดบิลกลับมาให้สามารถชำระต่องวดได้ตามยอดนี้</small>
                        </div>
                        <!-- 1. เลื่อนชำระ -->
                        <div id="f-postponed" class="d-none mb-3 p-3 bg-light rounded border">
                            <label class="form-label fw-bold small text-warning">📅 ระบุวันที่นัดชำระใหม่</label>
                            <input type="date" name="postponedDate" class="form-control" value="@(debt?.PostponedDate?.ToString("yyyy-MM-dd") ?? "")" />
                        </div>

                        <!-- 2. จัดส่ง -->
                        <div id="f-delivering" class="d-none mb-3 p-3 bg-light rounded border">
                            <label class="form-label fw-bold small text-info">🚚 ระบุวันที่จัดส่ง</label>
                            <input type="date" name="deliveringDate" class="form-control" value="@(debt?.DeliveringDate?.ToString("yyyy-MM-dd") ?? "")" />
                        </div>

                        <!-- 3. รอสินค้า -->
                        <div id="f-waiting" class="d-none mb-3 p-3 rounded border" style="background:#f0fdf4; border-color:#86efac;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-bold small text-success mb-0">
                                    <i class="bi bi-box-seam me-1"></i> เลือกรายการสินค้าที่รอส่ง / ของขาดจากบิลนี้
                                </label>
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-success btn-sm py-0" onclick="selectAllWaitingProducts(true)">
                                        <i class="bi bi-check-all"></i> เลือกทั้งหมด
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm py-0" onclick="selectAllWaitingProducts(false)">
                                        <i class="bi bi-x-circle"></i> ล้าง
                                    </button>
                                </div>
                            </div>
                            
                            <div class="mb-2">
                                <label class="form-label small text-muted mb-1">📅 วันที่รอสินค้า / นัดส่งสินค้าใหม่</label>
                                <input type="date" name="waitingGoodsDate" class="form-control form-control-sm" value="@(debt?.WaitingGoodsDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))" />
                            </div>

                            @if (Model.Items != null && Model.Items.Any())
                            {
                                <div class="table-responsive bg-white rounded border mb-2" style="max-height: 250px; overflow-y: auto;">
                                    <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.85rem;">
                                        <thead class="table-light sticky-top" style="background:#ecfdf5;">
                                            <tr>
                                                <th style="width: 40px;" class="text-center">เลือก</th>
                                                <th style="width: 100px;">รหัสสินค้า</th>
                                                <th>ชื่อสินค้า</th>
                                                <th style="width: 110px;" class="text-end">จำนวนที่รอ</th>
                                                <th style="width: 60px;" class="text-center">หน่วย</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int idx = 0; idx < Model.Items.Count; idx++)
                                            {
                                                var item = Model.Items.ElementAt(idx);
                                                var existingPending = debt?.PendingProducts?.FirstOrDefault(p => p.ProductCode == item.ProductCode);
                                                bool isChecked = existingPending != null || (debt?.Status == DebtStatus.WaitingGoods && Model.Items.Count == 1);
                                                int defaultQty = existingPending?.Quantity ?? (int)item.Qty;

                                                <tr>
                                                    <td class="text-center">
                                                        <input type="checkbox" name="waitingProductCodes" value="@item.ProductCode" id="chk_prod_@idx" 
                                                               class="form-check-input waiting-prod-chk" onchange="toggleWaitingQtyInput(@idx)"
                                                               @(isChecked ? "checked" : "") />
                                                        <input type="hidden" name="allProductCodes" value="@item.ProductCode" />
                                                        <input type="hidden" name="allProductNames" value="@item.ProductName" />
                                                    </td>
                                                    <td><label for="chk_prod_@idx" class="form-check-label mb-0 fw-bold text-dark"><code>@item.ProductCode</code></label></td>
                                                    <td><label for="chk_prod_@idx" class="form-check-label mb-0 fw-semibold">@item.ProductName</label></td>
                                                    <td class="text-end">
                                                        <input type="number" name="waitingQuantities_@item.ProductCode" id="qty_input_@idx" 
                                                               class="form-control form-control-sm text-end fw-bold text-danger waiting-qty-input" 
                                                               value="@defaultQty" min="1" max="@((int)item.Qty)" style="width: 85px; display: inline-block;" 
                                                               @(isChecked ? "" : "disabled") />
                                                    </td>
                                                    <td class="text-center text-muted"><small>@item.Unit</small></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info py-1 px-2 small mb-2">
                                    <i class="bi bi-info-circle me-1"></i> ไม่พบรายการสินค้าในบิลนี้ สามารถพิมพ์ระบุในหมายเหตุได้
                                </div>
                            }

                            <div>
                                <label class="form-label small text-muted mb-1">📝 หมายเหตุเพิ่มเติม (ถ้ามี)</label>
                                <input type="text" name="note" class="form-control form-control-sm" placeholder="เช่น รอของเข้าโรงงานวันศุกร์..." value="@debt?.Note" />
                            </div>
                        </div>

                        <!-- 4. รับคืนสินค้า -->
                        <div id="f-return" class="d-none mb-3 p-3 bg-light rounded border">
                            <label class="form-label fw-bold small text-secondary">↩️ ยอดเงินรับคืน (บาท)</label>
                            <input type="number" step="0.01" name="returnAmount" class="form-control mb-2" placeholder="0.00" value="@(debt?.ReturnAmount ?? 0)" />
                            <div class="form-check form-check-inline mt-2">
                                <input class="form-check-input" type="radio" name="isReturnCutFromBill" value="true" id="chkReturnCut_mobile" checked="@((debt?.IsReturnCutFromBill == true || debt?.IsReturnCutFromBill == null))" />
                                <label class="form-check-label fw-semibold" for="chkReturnCut_mobile">ตัดกับบิล</label>
                            </div>
                            <div class="form-check form-check-inline mt-2">
                                <input class="form-check-input" type="radio" name="isReturnCutFromBill" value="false" id="chkReturnWait_mobile" checked="@((debt?.IsReturnCutFromBill == false))" />
                                <label class="form-check-label fw-semibold" for="chkReturnWait_mobile">รอตัด</label>
                            </div>
                        </div>

                        <!-- 5. หนี้สูญ -->
                        <div id="f-baddebt" class="d-none mb-3 p-3 bg-danger bg-opacity-10 rounded border border-danger">
                            <label class="form-label fw-bold small text-danger">⚠️ ยอดตัดหนี้สูญ (บาท)</label>
                            <input type="number" step="0.01" name="badDebtAmount" class="form-control mb-2" value="@(debt?.BadDebtAmount ?? debt?.RemainingAmount)" />
                        </div>

                        <!-- 6. ยกเลิกบิล -->
                        <div id="f-cancelled" class="d-none mb-3 p-3 bg-danger bg-opacity-10 rounded border border-danger">
                            <label class="form-label fw-bold small text-danger">❌ เหตุผลในการยกเลิกบิล</label>
                            <input type="text" name="note" class="form-control mb-2" placeholder="เช่น ลูกค้ายกเลิกคำสั่งซื้อ / ออกบิลซ้ำ" />
                            <small class="text-danger d-block">
                                * เมื่อยกเลิก บิลจะถูกย้ายไปเก็บที่หน้า "บิลยกเลิก" เป็นเวลา 30 วัน ก่อนจะถูกลบออกจากระบบ
                            </small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">แนบเอกสาร/รูปภาพประกอบ (ถ้ามี)</label>
                            <input type="file" name="statusFile" class="form-control" accept="image/*,.pdf" />
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-secondary btn-lg fw-bold shadow">
                                <i class="bi bi-save me-1"></i> บันทึกการเปลี่ยนสถานะ
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

<!-- ประวัติการรับชำระเงิน -->
<div class="card detail-card mb-4">
    <div class="card-header bg-light py-3 fw-bold d-flex justify-content-between align-items-center">
        <span><i class="bi bi-clock-history me-1"></i> ประวัติการรับชำระเงินของบิลนี้</span>
        <span class="badge bg-secondary">@(debt?.PaymentRecords?.Count ?? 0) รายการ</span>
    </div>
    <div class="card-body p-0">
        @if (false)
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-shield-lock fs-2 text-muted d-block mb-1"></i>
                <span>ข้อมูลประวัติการรับชำระเงินถูกซ่อนไว้ตามสิทธิ์ความปลอดภัย</span>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>วันที่รับเงิน</th>
                            <th>วิธีการชำระ</th>
                            <th class="text-end">จำนวนเงิน (บาท)</th>
                            <th>ผู้บันทึก</th>
                            <th>เอกสารแนบ</th>
                            <th>หมายเหตุ / รายละเอียด</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (debt?.PaymentRecords == null || !debt.PaymentRecords.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">ยังไม่มีประวัติการรับชำระเงินสำหรับบิลนี้</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var p in debt?.PaymentRecords.OrderByDescending(x => x.PaidDate))
                            {
                                <tr>
                                    <td>@p.PaidDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <span class="badge bg-info text-dark">@p.Method</span>
                                        @if (!string.IsNullOrEmpty(p.CheckNumber))
                                        {
                                            <small class="d-block text-muted">เช็ค: @p.CheckNumber (@p.BankName)</small>
                                        }
                                    </td>
                                    <td class="text-end fw-bold text-success">@p.PaidAmount.ToString("N2")</td>
                                    <td><span class="badge bg-light text-dark border">@p.CreatedBy</span></td>
                                    <td>
                                        @if (p.Attachments != null && p.Attachments.Any())
                                        {
                                            @foreach (var att in p.Attachments)
                                            {
                                                <a href="@att.FilePath" target="_blank" class="btn btn-sm btn-outline-primary py-0 px-2">
                                                    <i class="bi bi-paperclip"></i> ดูไฟล์
                                                </a>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td>@p.Note</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal Edit Receipt -->
