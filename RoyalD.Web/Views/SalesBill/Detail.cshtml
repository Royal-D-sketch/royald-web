@section Scripts {
<script src="~/js/anti-capture.js"></script>`n<script>
function unlockForms() {
    var pwd = document.getElementById('admin-password').value;
    if (pwd === '029030445Rd*') {
        document.getElementById('unlock-form').style.display = 'none';
        document.getElementById('management-forms').style.display = 'block';
        
        // Populate hidden password fields in the forms so backend validation passes
        var pwds = document.getElementsByClassName('hidden-admin-pwd');
        for (var i = 0; i < pwds.length; i++) {
            pwds[i].value = pwd;
        }
    } else {
        alert('รหัสผ่านไม่ถูกต้อง');
    }
}
function setPayMethod(method) {
    document.getElementById('methodField').value = method;
}

function syncPayment() {
    var method = document.getElementById('methodField').value;
    document.getElementById('realAmount').value = document.getElementById('amount_' + method).value;
    document.getElementById('realPayDate').value = document.getElementById('payDate_' + method).value;
    document.getElementById('realNote').value = document.getElementById('note_' + method).value;
    
    // Manage files
    var ft = document.getElementById('file_Transfer');
    var fc = document.getElementById('file_Check');
    if(ft) { ft.name = method === 'Transfer' ? 'file' : ''; }
    if(fc) { fc.name = method === 'Check' ? 'file' : ''; }

    // Disable check inputs if not Check method
    if(method !== 'Check') {
        var cp = document.getElementById('check-pane');
        var checkInputs = cp.querySelectorAll('input[name="checkDate"], input[name="bank"], input[name="checkNo"]');
        checkInputs.forEach(function(inp) { inp.disabled = true; });
    }
    
    return true;
}
function onStatusSelectChange() {
    var sel = document.getElementById('statusSelect');
    var val = sel ? sel.value : '';
    var fi1 = document.getElementById('f-installment');
    var fi2 = document.getElementById('f-installment-2');
    if (fi1) {
        if (val === 'Installment' || val === '100') fi1.classList.remove('d-none');
        else fi1.classList.add('d-none');
    }
    if (fi2) {
        if (val === 'Installment' || val === '100') fi2.classList.remove('d-none');
        else fi2.classList.add('d-none');
    }

    var fp = document.getElementById('f-postponed'); if (fp) fp.classList.add('d-none');
    var fd = document.getElementById('f-delivering'); if (fd) fd.classList.add('d-none');
    var fw = document.getElementById('f-waiting'); if (fw) fw.classList.add('d-none');
    var fr = document.getElementById('f-return'); if (fr) fr.classList.add('d-none');
    var fb = document.getElementById('f-baddebt'); if (fb) fb.classList.add('d-none');
    var fc = document.getElementById('f-cancelled'); if (fc) fc.classList.add('d-none');

    if (val === 'Postponed' && fp) fp.classList.remove('d-none');
    if (val === 'Delivering' && fd) fd.classList.remove('d-none');
    if (val === 'WaitingGoods' && fw) fw.classList.remove('d-none');
    if ((val === 'ReturnIssued' || val === 'ReturnPending') && fr) fr.classList.remove('d-none');
    if (val === 'BadDebt' && fb) fb.classList.remove('d-none');
    if (val === 'Cancelled' && fc) fc.classList.remove('d-none');
}
function selectAllWaitingProducts(select) {
    var checkboxes = document.querySelectorAll('.waiting-chk');
    checkboxes.forEach(function(chk) { chk.checked = select; });
}
</script>
}










