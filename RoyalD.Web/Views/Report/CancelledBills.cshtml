@model IEnumerable<RoyalD.Web.Models.OutstandingDebt>
@{
    ViewData["Title"] = "บิลยกเลิก (Cancelled Bills)";
}

<div class="card shadow-sm border-0" style="border-radius:12px;">
    <div class="card-header bg-danger text-white py-3 fw-bold">
        <i class="bi bi-x-circle me-1"></i> บิลยกเลิก (30 วันย้อนหลัง)
    </div>
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>เลขที่บิล</th>
                    <th>วันที่บิล</th>
                    <th>รหัสลูกค้า</th>
                    <th>ชื่อลูกค้า</th>
                    <th>วันที่ยกเลิก</th>
                    <th>ผู้ยกเลิก</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><a href="/SalesBill/Detail?id=@Uri.EscapeDataString(item.BillNo)" class="text-decoration-none fw-bold">@item.BillNo</a></td>
                        <td>@item.BillDate.ToString("dd/MM/yyyy")</td>
                        <td><code>@item.CustomerCode</code></td>
                        <td>@item.CustomerName</td>
                        <td>@(item.CancelledDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td>@item.CancelledBy</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


