@model List<RoyalD.Web.Models.OutstandingDebt>
@{
    ViewData["Title"] = "รายงานลูกหนี้ผ่อนชำระ";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0 fw-bold" style="color:#0f766e;">
        <i class="bi bi-clock-history text-primary"></i> รายงานลูกหนี้ผ่อนชำระ
    </h4>
</div>

<div class="card shadow-sm border-0 mb-3" style="border-radius:12px;">
    <div class="card-body p-3 bg-light">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="เลขที่บิล, รหัส/ชื่อลูกค้า..." value="@ViewBag.Search" style="width: 240px;">
                </div>
            </div>
            <div class="col-auto">
                <select name="salesRep" class="form-select form-select-sm select2-searchable" style="min-width: 160px;">
                    <option value="">@(ViewBag.IsRestricted == true ? "-- ทุกผู้แทนที่รับผิดชอบ --" : "-- พนักงานขายทั้งหมด --")</option>
                    @if(ViewBag.SalesReps != null)
                    {
                        foreach(string r in (List<string>)ViewBag.SalesReps)
                        {
                            <option value="@r" selected="@(r == ViewBag.SalesRep ? "selected" : null)">@r</option>
                        }
                    }
                </select>
            </div>
            <div class="col-auto">
                <input type="date" name="fromDate" class="form-control form-control-sm" value="@ViewBag.FromDate" title="ตั้งแต่วันที่" />
            </div>
            <div class="col-auto">
                <input type="date" name="toDate" class="form-control form-control-sm" value="@ViewBag.ToDate" title="ถึงวันที่" />
            </div>
            <div class="col-auto" style="width: 100px;">
                <input type="number" name="credit" class="form-control form-control-sm" placeholder="เครดิต (วัน)" value="@ViewBag.Credit" min="0" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary px-3">
                    <i class="bi bi-funnel"></i> ค้นหา
                </button>
                <a href="/Report/InstallmentDebtors" class="btn btn-sm btn-outline-secondary px-3">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm p-3 mb-4">
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th>เลขที่บิล</th>
                    <th>วันที่บิล</th>
                    <th class="text-center">เครดิต</th>
                    <th>รหัสลูกค้า</th>
                    <th class="col-customer-name" style="min-width: 260px; white-space: normal !important;">ชื่อลูกค้า</th>
                    <th>จังหวัด</th>
                    <th>ผู้แทนขาย</th>
                    <th class="text-end">ยอดคงเหลือ</th>
                    <th class="text-center">ดูรายละเอียด</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td class="fw-bold">@d.BillNo</td>
                        <td>@d.BillDate.ToString("dd/MM/yyyy")</td>
                        <td class="text-center"><span class="badge bg-light text-secondary border">@(d.Credit == 0 ? "สด" : $"{d.Credit} วัน")</span></td>
                        <td><code>@d.CustomerCode</code></td>
                        <td class="col-customer-name fw-bold" style="min-width: 260px; white-space: normal !important; word-break: break-word !important;">@d.CustomerName</td>
                        <td>@d.Province</td>
                        <td><span class="badge bg-light text-dark border">@d.SalesRep</span></td>
                        <td class="text-end fw-bold text-danger">@d.RemainingAmount.ToString("N2")</td>
                        <td class="text-center">
                            <a href="/SalesBill/Detail?id=@d.BillNo" class="btn btn-sm btn-outline-primary" title="ดูบิลขาย">
                                <i class="bi bi-eye"></i> บิล
                            </a>
                            <a href="/Debtor/Detail?id=@d.BillNo" class="btn btn-sm btn-outline-info" title="ดูการ์ดลูกหนี้">
                                <i class="bi bi-card-list"></i> การ์ด
                            </a>
                        </td>
                    </tr>
                }
                @if(!Model.Any()) {
                    <tr><td colspan="9" class="text-center text-muted">ไม่พบข้อมูลลูกหนี้ผ่อนชำระ</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>


