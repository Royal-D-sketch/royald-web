@model List<RoyalD.Web.Models.OutstandingDebt>
@{
    ViewData["Title"] = "รายงานลูกหนี้ผ่อนชำระ";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0 fw-bold" style="color:#0f766e;">
        <i class="bi bi-clock-history text-primary"></i> รายงานลูกหนี้ผ่อนชำระ
    </h4>
</div>

<div class="card shadow-sm p-3 mb-4">
    <div class="table-responsive">
        <table class="table table-hover table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th>เลขที่บิล</th>
                    <th>วันที่บิล</th>
                    <th>รหัสลูกค้า</th>
                    <th>ชื่อลูกค้า</th>
                    <th>จังหวัด</th>
                    <th>ผู้แทนขาย</th>
                    <th class="text-end">ยอดคงเหลือ</th>
                    <th class="text-center">ดูรายละเอียด</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td class="fw-bold">@d.BillNo</td>
                        <td>@d.BillDate.ToString("dd/MM/yyyy")</td>
                        <td><code>@d.CustomerCode</code></td>
                        <td>@d.CustomerName</td>
                        <td>@d.Province</td>
                        <td><span class="badge bg-light text-dark border">@d.SalesRep</span></td>
                        <td class="text-end fw-bold text-danger">@d.RemainingAmount.ToString("N2")</td>
                        <td class="text-center">
                            <a href="/SalesBill/Detail?id=@d.BillNo" class="btn btn-sm btn-outline-primary" title="ดูบิลขาย">
                                <i class="bi bi-eye"></i> บิล
                            </a>
                            <a href="/Debtor/Detail?id=@d.BillNo" class="btn btn-sm btn-outline-info" title="ดูการ์ดลูกหนี้">
                                <i class="bi bi-card-list"></i> การ์ด
                            </a>
                        </td>
                    </tr>
                }
                @if(!Model.Any()) {
                    <tr><td colspan="8" class="text-center text-muted">ไม่พบข้อมูลลูกหนี้ผ่อนชำระ</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

