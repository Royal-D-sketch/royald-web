@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "รายการสินค้ารอส่งมอบ/รายการรอสินค้า";
}

<div class="card shadow-sm border-0" style="border-radius:12px;">
    <div class="card-header text-white py-3 fw-bold" style="background:#0d9488;">
        <i class="bi bi-box-seam me-1"></i> รายการสินค้ารอส่งมอบ/รายการรอสินค้า
    </div>
    <div class="card-body p-3 bg-light border-bottom">
        <form method="get" class="row gx-2 gy-2 align-items-center">
            <input type="hidden" name="pageSize" value="@(ViewBag.PageSize ?? 50)" />
            <div class="col-auto">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="ค้นหาเลขที่บิล, รหัสลูกค้า, ชื่อลูกค้า..." value="@ViewBag.Search" style="width: 280px;">
                </div>
            </div>
            <div class="col-auto">
                <select name="salesRep" class="form-select form-select-sm select2-searchable" style="min-width: 180px;">
                    <option value="">-- พนักงานขายทั้งหมด --</option>
                    @if(ViewBag.SalesReps != null)
                    {
                        foreach(string r in ViewBag.SalesReps)
                        {
                            <option value="@r" selected="@(r == ViewBag.SalesRep ? "selected" : null)">@r</option>
                        }
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary px-3" style="background-color: #0d9488; border-color: #0d9488;">
                    <i class="bi bi-funnel"></i> ค้นหา
                </button>
                <a href="/Report/WaitingGoods" class="btn btn-sm btn-outline-secondary px-3">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>เลขที่บิล</th>
                    <th>วันที่บิล</th>
                    <th>รหัสลูกค้า</th>
                    <th class="col-customer-name" style="min-width: 260px; white-space: normal !important;">ชื่อลูกค้า</th>
                    <th>ผู้แทนขาย</th>
                    <th>วันที่อัปเดต</th>
                    <th style="min-width: 140px;">รหัสสินค้า</th>
                    <th>ชื่อสินค้า</th>
                    <th class="text-end">จำนวนรอส่ง</th>
                    <th>รายละเอียดเพิ่มเติม</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center py-4 text-muted">ไม่พบรายการสินค้ารอส่งมอบ</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td><a href="/SalesBill/Detail?id=@Uri.EscapeDataString(item.BillNo)" class="text-decoration-none fw-bold">@item.BillNo</a></td>
                            <td>@item.BillDate.ToString("dd/MM/yyyy")</td>
                            <td><code>@item.CustomerCode</code></td>
                            <td class="col-customer-name fw-bold" style="min-width: 260px; white-space: normal !important; word-break: break-word !important;">@item.CustomerName</td>
                            <td><span class="badge bg-light text-dark border">@item.SalesRep</span></td>
                            <td>@(item.UpdatedAt != null ? ((DateTime)item.UpdatedAt).ToString("dd/MM/yyyy") : "-")</td>
                            <td><code style="white-space: nowrap;">@item.ProductCode</code></td>
                            <td>@item.ProductName</td>
                            <td class="text-end text-danger fw-bold">@item.Quantity.ToString("N0")</td>
                            <td class="text-muted small">@(string.IsNullOrEmpty(item.Note) ? "-" : item.Note)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@{
    int curPage = ViewBag.Page ?? 1;
    int pSize = ViewBag.PageSize ?? 50;
    int totRecords = ViewBag.TotalRecords ?? 0;
    int totPages = ViewBag.TotalPages ?? 1;
    int startItem = totRecords == 0 ? 0 : ((curPage - 1) * pSize) + 1;
    int endItem = Math.Min(curPage * pSize, totRecords);
}

<!-- Pagination & Summary -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-3 py-2 bg-white rounded shadow-sm border mt-3 mb-4 no-print">
    <div class="d-flex align-items-center gap-3">
        <div class="text-muted small">
            แสดง <strong>@startItem - @endItem</strong> จากทั้งหมด <strong>@totRecords.ToString("N0")</strong> รายการ (หน้า <strong>@curPage / @totPages</strong>)
        </div>
        <div class="d-flex align-items-center gap-1 text-muted small">
            <label>แถวต่อหน้า:</label>
            <select class="form-select form-select-sm" style="width: auto; padding: 2px 24px 2px 8px; font-size: 0.8rem;" onchange="changePageSize(this.value)">
                <option value="30" selected="@(pSize == 30)">30</option>
                <option value="50" selected="@(pSize == 50)">50</option>
                <option value="100" selected="@(pSize == 100)">100</option>
                <option value="200" selected="@(pSize == 200)">200</option>
            </select>
        </div>
    </div>

    @if (totPages > 1)
    {
        <nav class="no-print">
            <ul class="pagination pagination-sm mb-0">
                @if (curPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("WaitingGoods", new { search = ViewBag.Search, salesRep = ViewBag.SalesRep, page = 1, pageSize = pSize })" title="หน้าแรก">«</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("WaitingGoods", new { search = ViewBag.Search, salesRep = ViewBag.SalesRep, page = curPage - 1, pageSize = pSize })">‹ ก่อนหน้า</a>
                    </li>
                }

                @for (int p = Math.Max(1, curPage - 2); p <= Math.Min(totPages, curPage + 2); p++)
                {
                    if (p == curPage)
                    {
                        <li class="page-item active"><span class="page-link" style="background:#0d9488; border-color:#0d9488;">@p</span></li>
                    }
                    else
                    {
                        <li class="page-item"><a class="page-link" href="@Url.Action("WaitingGoods", new { search = ViewBag.Search, salesRep = ViewBag.SalesRep, page = p, pageSize = pSize })">@p</a></li>
                    }
                }

                @if (curPage < totPages)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("WaitingGoods", new { search = ViewBag.Search, salesRep = ViewBag.SalesRep, page = curPage + 1, pageSize = pSize })">ถัดไป ›</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("WaitingGoods", new { search = ViewBag.Search, salesRep = ViewBag.SalesRep, page = totPages, pageSize = pSize })" title="หน้าสุดท้าย">»</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

@section Scripts {
<script>
    function changePageSize(size) {
        const url = new URL(window.location.href);
        url.searchParams.set('pageSize', size);
        url.searchParams.set('page', '1');
        window.location.href = url.toString();
    }
</script>
}



